---
// Hero.astro - Enhanced Hero Component with Modern Visual Effects
---

<section
  class="hero-section relative flex min-h-[calc(100vh-80px)] w-full items-center justify-center overflow-hidden px-6"
>
  <!-- Animated Grid Background -->
  <div class="absolute inset-0 -z-20">
    <div class="animated-grid"></div>
    <div class="gradient-mesh"></div>
  </div>

  <!-- Radial Glow -->
  <div class="hero-glow absolute inset-0 -z-10"></div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 grid w-full max-w-7xl items-center gap-12 lg:grid-cols-2"
  >
    <!-- Left Column: Text Content -->
    <div
      class="hero-content flex flex-col items-center text-center lg:items-start lg:text-left"
    >
      <!-- Badge -->
      <div
        class="badge-animate mb-6 flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 backdrop-blur-sm"
      >
        <span class="material-symbols-outlined text-primary text-sm"
          >shield_person</span
        >
        <span
          class="font-mono text-[10px] uppercase tracking-[0.3em] text-primary/90"
        >
          Especialistas en software
        </span>
      </div>

      <!-- Main Headline with Typing Effect -->
      <h1
        class="headline-animate max-w-2xl text-5xl font-black leading-tight tracking-tight text-white md:text-6xl lg:text-7xl"
      >
        Innovación en <br />
        <span
          class="typing-text bg-gradient-to-r from-primary via-primary/70 to-white bg-clip-text text-transparent"
        >
          Desarrollo de Software
        </span>
      </h1>

      <!-- Subheadline -->
      <p
        class="subheadline-animate mt-6 max-w-xl text-base font-normal leading-relaxed text-white/70 md:text-lg lg:text-xl"
      >
        No solo escribimos código. Diseñamos ecosistemas digitales de alto
        rendimiento y productos Frontline que definen el mercado.
      </p>

      <!-- CTA Buttons -->
      <div class="cta-animate mt-8 flex flex-col gap-4 sm:flex-row">
        <a
          href="#intro-cta"
          class="group relative overflow-hidden rounded-lg bg-gradient-to-r from-primary to-primary/80 px-8 py-4 font-semibold text-white shadow-lg shadow-primary/20 transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-primary/30"
        >
          <span class="relative z-10">Comenzar Proyecto</span>
          <div
            class="absolute inset-0 -z-0 bg-gradient-to-r from-primary/80 to-primary opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          >
          </div>
        </a>

        <a
          href="#tech-stack"
          class="group rounded-lg border-2 border-white/10 bg-white/5 px-8 py-4 font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:border-primary/50 hover:bg-white/10"
        >
          Ver Tecnologías
          <span
            class="ml-2 inline-block transition-transform duration-300 group-hover:translate-x-1"
            >→</span
          >
        </a>
      </div>

      <!-- Stats Cards -->
      <div class="stats-animate mt-12 grid grid-cols-3 gap-4">
        <div
          class="stat-card rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm"
        >
          <div class="text-2xl font-bold text-primary">99.9%</div>
          <div class="mt-1 text-xs text-white/60">Uptime</div>
        </div>
        <div
          class="stat-card rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm"
        >
          <div class="text-2xl font-bold text-primary">12ms</div>
          <div class="mt-1 text-xs text-white/60">Load Time</div>
        </div>
        <div
          class="stat-card rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm"
        >
          <div class="text-2xl font-bold text-primary">24/7</div>
          <div class="mt-1 text-xs text-white/60">Support</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Hero Image -->
    <div class="hero-image-container relative hidden lg:block">
      <div class="floating-element relative">
        <!-- Placeholder for generated image - will be added after generation -->
        <div class="hero-visual relative aspect-square w-full max-w-lg">
          <!-- Decorative floating elements -->
          <div
            class="float-1 absolute -left-4 top-1/4 h-20 w-20 rounded-2xl bg-gradient-to-br from-primary/20 to-transparent backdrop-blur-sm"
          >
          </div>
          <div
            class="float-2 absolute -right-4 top-1/2 h-16 w-16 rounded-full bg-gradient-to-br from-orange-500/20 to-transparent backdrop-blur-sm"
          >
          </div>
          <div
            class="float-3 absolute bottom-1/4 left-1/4 h-12 w-12 rounded-lg bg-gradient-to-br from-primary/30 to-transparent backdrop-blur-sm"
          >
          </div>

          <!-- Hero Illustration -->
          <div class="relative flex h-full w-full items-center justify-center">
            <img
              src="/hero-illustration.png"
              alt="Modern software development workspace illustration"
              class="h-full w-full object-contain drop-shadow-2xl"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <a
    href="#intro-cta"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 transform animate-bounce cursor-pointer transition-colors hover:text-primary"
    aria-label="Scroll to next section"
  >
    <span
      class="material-symbols-outlined text-3xl text-white/40 hover:text-primary/60"
    >
      keyboard_arrow_down
    </span>
  </a>

  <!-- Technical Decorative Accents -->
  <div
    class="absolute bottom-10 left-12 hidden font-mono text-[10px] text-white/20 xl:block"
  >
    <p>STATUS: OPTIMIZED</p>
    <p>LOAD: 12.4ms</p>
    <p>Uptime: 99.998%</p>
  </div>
  <div
    class="absolute bottom-10 right-12 hidden font-mono text-[10px] text-white/20 xl:block"
  >
    <p>LATENCY: 4.2ms</p>
    <p>REGION: GLOBAL_EDGE</p>
    <p>ENCRYPTION: AES-256</p>
  </div>
</section>

<style>
  /* Animated Grid Background */
  .animated-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(24, 160, 186, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(24, 160, 186, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 20s linear infinite;
  }

  @keyframes gridMove {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(50px, 50px);
    }
  }

  /* Gradient Mesh Background */
  .gradient-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 20% 30%,
        rgba(24, 160, 186, 0.15) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(241, 90, 36, 0.1) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 50% 50%,
        rgba(24, 160, 186, 0.05) 0%,
        transparent 70%
      );
    animation: meshPulse 8s ease-in-out infinite;
  }

  @keyframes meshPulse {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.8;
    }
  }

  /* Content Animations */
  .badge-animate {
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  .headline-animate {
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }

  .subheadline-animate {
    animation: fadeInUp 0.8s ease-out 0.6s both;
  }

  .cta-animate {
    animation: fadeInUp 0.8s ease-out 0.8s both;
  }

  .stats-animate {
    animation: fadeInUp 0.8s ease-out 1s both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Typing Effect */
  .typing-text {
    display: inline-block;
    position: relative;
  }

  /* Floating Elements */
  .floating-element {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .float-1 {
    animation: float 4s ease-in-out infinite;
  }

  .float-2 {
    animation: float 5s ease-in-out infinite 1s;
  }

  .float-3 {
    animation: float 6s ease-in-out infinite 2s;
  }

  /* Stat Cards Hover */
  .stat-card {
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(24, 160, 186, 0.3);
    background: rgba(255, 255, 255, 0.1);
  }

  /* Hero Image Container */
  .hero-image-container {
    animation: fadeIn 1s ease-out 1.2s both;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Responsive adjustments */
  @media (max-width: 1024px) {
    .hero-section {
      text-align: center;
    }
  }
</style>
