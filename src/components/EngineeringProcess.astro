---
const phases = [
  {
    id: "01_",
    title: "FrontLine PTM",
    description:
      "Gestión de publicidad exterior. Control de instalaciones, auditoría de campañas y reportes de campo en tiempo real.",
    icon: "visibility",
    color: "#06b6d4", // Cyan
  },
  {
    id: "02_",
    title: "FrontLine POS",
    description: "Punto de venta cloud con facturación electrónica nativa.",
    icon: "point_of_sale",
    color: "#10b981", // Emerald
  },
  {
    id: "03_",
    title: "FrontLine Ledger",
    description: "Contabilidad inteligente y automatización financiera.",
    icon: "account_balance",
    color: "#f59e0b", // Amber
  },
  {
    id: "04_",
    title: "FrontLine Stock",
    description: "Control de inventarios multicapa y logística avanzada.",
    icon: "inventory_2",
    color: "#f97316", // Orange
  },
  {
    id: "05_",
    title: "FrontLine Lab",
    description: "Gestión integral para laboratorios clínicos y bioanálisis.",
    icon: "biotech",
    color: "#ec4899", // Pink
  },
  {
    id: "06_",
    title: "FrontLine Fleet",
    description: "Tracking GPS en tiempo real y gestión de flotas vehiculares.",
    icon: "local_shipping",
    color: "#3b82f6", // Blue
  },
  {
    id: "07_",
    title: "FrontLine Capital",
    description: "Core bancario para financieras y gestión de créditos.",
    icon: "payments",
    color: "#8b5cf6", // Violet
  },
];
---

<section class="w-full bg-obsidian/50 py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-12">
    <div class="mb-20 grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
      <div>
        <div
          class="mb-4 font-mono text-xs uppercase tracking-[0.4em] text-primary"
        >
          Software Propietario
        </div>
        <div class="flex items-center gap-4">
          <img 
            src="/FrontLine.png" 
            alt="FrontLine Logo" 
            class="h-12 md:h-14 w-auto object-contain"
          />
          <h2 class="text-4xl font-black text-white md:text-5xl">
            Suite FrontLine
          </h2>
        </div>
        <p class="mt-6 text-lg text-white/50">
          Soluciones SaaS in-house desarrolladas por The Real Devs, listas para
          escalar tu operación con arquitectura de grado militar.
        </p>
      </div>
      <div
        class="relative overflow-hidden rounded-xl border border-glass-border p-1"
      >
        <div class="absolute inset-0 animate-pulse bg-primary/5"></div>
        <img
          alt="Dashboard de FrontLine Suite"
          class="relative h-[240px] w-full rounded-lg object-cover grayscale transition-all hover:grayscale-0"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuDIlLE13Esx2RqdFjfVaJ0ntjfOhXEK78aG0S9-bydntxNfDsF-mMNQd-MyA2oErojaG7ZlzB1MqPiraGkWBheoJ6GNu3R3GNeb9oQdz9Y-Xj1V8DE4JD0QDUUlbgpwYVSdzxsFEqYbqAASdafsTqRuo_-xo7710R1rOuz_WxdbCCU4B6nj-G2wOGq5uzpOG8PfJBwXn4a8WiqjNk8O1-ISgvXzCaINxaZ7qhsWFyTOf6kFbsDUyS7x1IBwobmSXlUk8uzWAjGpavE"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        phases.map((phase, index) => (
          <div
            class={`group relative flex flex-col justify-between overflow-hidden rounded-2xl border transition-all duration-500 hover:-translate-y-1 ${
              index === 0 || index === 3 ? "md:col-span-2" : ""
            }`}
            style={`
              border-color: ${phase.color}40;
              background: linear-gradient(145deg, ${phase.color}10 0%, rgba(255,255,255,0.03) 100%);
            `}
          >
            <!-- Hover Glow Effect -->
            <div
              class="absolute -right-10 -top-10 h-32 w-32 rounded-full blur-3xl transition-all duration-500 group-hover:opacity-100 opacity-0"
              style={`background-color: ${phase.color}20;`}
            />

            <div class="relative z-10 mb-6 flex items-start justify-between p-8 pb-0">
              {/* <span class="font-mono text-xs opacity-60" style={`color: ${phase.color}`}>
                {phase.id}
              </span> */}
              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5 transition-all duration-300 group-hover:scale-110 group-hover:text-background-dark group-hover:opacity-100"
                style={`color: ${phase.color};`}
              >
                <span class="material-symbols-outlined text-2xl">
                  {phase.icon}
                </span>
              </div>
            </div>

            <div class="relative z-10 p-8 pt-0">
              <h3 class="mb-3 text-2xl font-bold text-white transition-colors duration-300">
                {phase.title}
              </h3>
              <p class="text-sm font-light leading-relaxed text-white/70 group-hover:text-white/90">
                {phase.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
