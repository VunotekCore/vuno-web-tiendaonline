---
interface Props {
  id: string;
  colors: { name: string; hex: string }[];
  sizes: string[];
  lowStockThreshold?: number;
  readonly?: boolean;
}

const { id, colors, sizes, lowStockThreshold = 5, readonly = false } = Astro.props;
const matrixId = `vm-${id}`;
---

<div
  id={matrixId}
  class="variants-matrix"
  data-colors={JSON.stringify(colors)}
  data-sizes={JSON.stringify(sizes)}
  data-threshold={lowStockThreshold}
  data-readonly={readonly ? "1" : "0"}
>
  <!-- Header: title + threshold + grand total -->
  <div class="vm-header flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-5">
    <div>
      <h3 class="font-headline text-headline-md flex items-center gap-2 text-monolith-black">
        <span class="material-symbols-outlined text-xl">inventory</span>
        Matriz de Inventario
      </h3>
      <p class="font-body text-body-sm text-secondary mt-1">
        Define el stock por color y talle. Click en el círculo de un color para activar/desactivar la fila completa.
      </p>
    </div>
    <div class="flex items-center gap-5 shrink-0">
      <label class="flex items-center gap-2 cursor-pointer">
        <span class="font-label-caps text-label-caps text-secondary whitespace-nowrap">Alerta bajo stock</span>
        <div class="relative">
          <input
            type="number"
            min="0"
            max="99"
            step="1"
            value={lowStockThreshold}
            data-vm="threshold"
            class="vm-threshold-input w-14 h-9 px-2 pr-6 text-center font-price-display text-base bg-white border border-outline-variant rounded-sm focus:border-monolith-black focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            disabled={readonly}
          />
          <span class="absolute right-2 top-1/2 -translate-y-1/2 font-label-caps text-label-caps text-secondary text-[10px] pointer-events-none">uds</span>
        </div>
      </label>
      <div class="text-right">
        <div class="font-label-caps text-label-caps text-secondary">Total</div>
        <div class="flex items-baseline gap-1.5">
          <span data-vm="grandTotal" class="font-price-display text-price-display text-2xl text-monolith-black leading-none">0</span>
          <span class="font-label-caps text-label-caps text-secondary text-[10px]">uds</span>
        </div>
        <div data-vm="activeCount" class="font-body text-body-sm text-secondary mt-0.5">0 variantes activas</div>
      </div>
    </div>
  </div>

  <!-- Legend -->
  <div class="vm-legend flex flex-wrap items-center gap-x-5 gap-y-2 mb-5 pb-5 border-b border-outline-variant/40">
    <span class="font-label-caps text-label-caps text-secondary">Estados</span>
    <span class="flex items-center gap-1.5">
      <span class="vm-dot vm-dot-empty"></span>
      <span class="font-body text-body-sm text-secondary">Sin stock</span>
    </span>
    <span class="flex items-center gap-1.5">
      <span class="vm-dot vm-dot-low"></span>
      <span class="font-body text-body-sm text-secondary">Bajo (≤ <span data-vm="legendThreshold">{lowStockThreshold}</span>)</span>
    </span>
    <span class="flex items-center gap-1.5">
      <span class="vm-dot vm-dot-ok"></span>
      <span class="font-body text-body-sm text-secondary">Disponible</span>
    </span>
  </div>

  <!-- Desktop matrix (≥md) -->
  <div class="vm-desktop hidden md:block overflow-x-auto pb-2">
    <table class="vm-table w-full border-separate border-spacing-2">
      <thead>
        <tr>
          <th class="vm-corner w-16"></th>
          {colors.map((color) => (
            <th class="vm-color-head" data-color={color.name}>
              <div class="vm-color-card">
                <button
                  type="button"
                  class="vm-color-swatch group"
                  data-vm-action="toggle-color"
                  data-color={color.name}
                  aria-label={`Alternar color ${color.name}`}
                  disabled={readonly}
                >
                  <span class="vm-color-chip" style={`background-color: ${color.hex};`}></span>
                  <span class="vm-color-status" data-vm="colorStatus" data-color={color.name}></span>
                </button>
                <div class="vm-color-meta">
                  <div class="font-label-caps text-label-caps text-monolith-black truncate">{color.name}</div>
                  <div class="flex items-center gap-1">
                    <span data-vm="colorTotal" data-color={color.name} class="font-price-display text-price-display text-base text-monolith-black leading-none">0</span>
                    <span class="font-label-caps text-label-caps text-secondary text-[9px]">UDS</span>
                  </div>
                </div>
                <div class="vm-color-actions">
                  <button
                    type="button"
                    class="vm-mini-btn"
                    data-vm-action="fill-color"
                    data-color={color.name}
                    title="Aplicar N a todas las talles"
                    disabled={readonly}
                  >
                    <span class="material-symbols-outlined text-sm">deblur</span>
                  </button>
                  <button
                    type="button"
                    class="vm-mini-btn"
                    data-vm-action="clear-color"
                    data-color={color.name}
                    title="Limpiar color"
                    disabled={readonly}
                  >
                    <span class="material-symbols-outlined text-sm">backspace</span>
                  </button>
                </div>
              </div>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {sizes.map((size) => (
          <tr>
            <th class="vm-size-head">
              <div class="vm-size-card">
                <div class="font-label-caps text-label-caps text-secondary text-[9px]">EU</div>
                <div class="font-price-display text-price-display text-base text-monolith-black leading-none">{size}</div>
                <div class="flex items-center gap-1 mt-1">
                  <span data-vm="sizeTotal" data-size={size} class="font-body text-body-sm text-secondary leading-none">0</span>
                  <span class="font-label-caps text-label-caps text-secondary text-[9px]">uds</span>
                </div>
              </div>
            </th>
            {colors.map((color) => (
              <td class="vm-cell-wrap">
                <div
                  class="vm-stepper"
                  role="group"
                  aria-label={`Stock ${color.name} talle ${size}`}
                  data-vm-cell={color.name}
                  data-vm-size={size}
                >
                  <button
                    type="button"
                    class="vm-step-btn"
                    data-vm-action="dec"
                    data-color={color.name}
                    data-size={size}
                    aria-label="Disminuir"
                    disabled={readonly}
                  >
                    <span class="material-symbols-outlined text-base">remove</span>
                  </button>
                  <input
                    type="number"
                    min="0"
                    step="1"
                    value="0"
                    class="vm-step-input"
                    data-vm-input={color.name}
                    data-size={size}
                    aria-label={`Cantidad ${color.name} ${size}`}
                    readonly={readonly}
                  />
                  <button
                    type="button"
                    class="vm-step-btn"
                    data-vm-action="inc"
                    data-color={color.name}
                    data-size={size}
                    aria-label="Aumentar"
                    disabled={readonly}
                  >
                    <span class="material-symbols-outlined text-base">add</span>
                  </button>
                </div>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th class="vm-foot-label text-right">
            <span class="font-label-caps text-label-caps text-secondary text-[10px] tracking-widest">TOTAL</span>
          </th>
          {colors.map((color) => (
            <td class="vm-foot-cell" data-vm="footTotal" data-color={color.name}>
              <span data-vm="colorTotalFoot" data-color={color.name} class="font-price-display text-price-display text-base text-monolith-black">0</span>
            </td>
          ))}
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Mobile cards (<md) -->
  <div class="vm-mobile md:hidden space-y-4">
    {colors.map((color) => (
      <div
        class="vm-mobile-card"
        data-vm-mobile={color.name}
        data-vm-color={color.name}
      >
        <div class="flex items-center gap-3 mb-4">
          <button
            type="button"
            class="vm-color-swatch group"
            data-vm-action="toggle-color"
            data-color={color.name}
            aria-label={`Alternar color ${color.name}`}
            disabled={readonly}
          >
            <span class="vm-color-chip" style={`background-color: ${color.hex};`}></span>
            <span class="vm-color-status" data-vm="colorStatus" data-color={color.name}></span>
          </button>
          <div class="flex-1">
            <div class="font-headline text-headline-sm text-monolith-black">{color.name}</div>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span data-vm="colorTotal" data-color={color.name} class="font-price-display text-price-display text-base text-monolith-black leading-none">0</span>
              <span class="font-label-caps text-label-caps text-secondary text-[10px]">UDS TOTAL</span>
            </div>
          </div>
          <div class="vm-color-actions">
            <button
              type="button"
              class="vm-mini-btn"
              data-vm-action="fill-color"
              data-color={color.name}
              disabled={readonly}
              title="Aplicar N a todas las talles"
            >
              <span class="material-symbols-outlined text-base">deblur</span>
            </button>
            <button
              type="button"
              class="vm-mini-btn"
              data-vm-action="clear-color"
              data-color={color.name}
              disabled={readonly}
              title="Limpiar color"
            >
              <span class="material-symbols-outlined text-base">backspace</span>
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {sizes.map((size) => (
            <div
              class="vm-stepper vm-stepper-mobile"
              data-vm-cell={color.name}
              data-vm-size={size}
            >
              <button
                type="button"
                class="vm-step-btn"
                data-vm-action="dec"
                data-color={color.name}
                data-size={size}
                aria-label="Disminuir"
                disabled={readonly}
              >
                <span class="material-symbols-outlined text-base">remove</span>
              </button>
              <div class="flex flex-col items-center flex-1">
                <span class="font-label-caps text-label-caps text-secondary text-[9px]">EU {size}</span>
                <input
                  type="number"
                  min="0"
                  step="1"
                  value="0"
                  class="vm-step-input vm-step-input-mobile"
                  data-vm-input={color.name}
                  data-size={size}
                  aria-label={`Cantidad ${color.name} ${size}`}
                  readonly={readonly}
                />
              </div>
              <button
                type="button"
                class="vm-step-btn"
                data-vm-action="inc"
                data-color={color.name}
                data-size={size}
                aria-label="Aumentar"
                disabled={readonly}
              >
                <span class="material-symbols-outlined text-base">add</span>
              </button>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Fill-color inline prompt (hidden by default) -->
  <div
    data-vm="fillPrompt"
    data-color=""
    class="vm-fill-prompt hidden items-center gap-2 mt-3 p-3 bg-monolith-black/5 border border-monolith-black/10 rounded-sm"
  >
    <span class="font-label-caps text-label-caps text-monolith-black text-sm">Aplicar a <span data-vm="fillColorLabel"></span>:</span>
    <input
      type="number"
      min="0"
      step="1"
      value="5"
      data-vm="fillInput"
      class="w-16 h-8 px-2 text-center font-price-display text-base bg-white border border-outline-variant rounded-sm focus:border-monolith-black focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
    />
    <span class="font-label-caps text-label-caps text-secondary text-sm">uds a cada talle</span>
    <button
      type="button"
      class="ml-auto font-label-caps text-label-caps text-monolith-black border border-monolith-black px-3 h-8 hover:bg-monolith-black hover:text-off-white transition-all"
      data-vm-action="apply-fill"
    >
      APLICAR
    </button>
    <button
      type="button"
      class="font-label-caps text-label-caps text-secondary hover:text-monolith-black transition-colors"
      data-vm-action="cancel-fill"
    >
      CANCELAR
    </button>
  </div>
</div>

<style>
  /* ============ VariantsMatrix component styles ============ */

  .variants-matrix {
    --vm-cell-size: 80px;
    --vm-stepper-h: 36px;
  }

  /* Color swatch button */
  .vm-color-swatch {
    position: relative;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-outline-variant, #c4c7c7);
    background: transparent;
    cursor: pointer;
    border-radius: 9999px;
    transition: all 200ms;
    padding: 4px;
    flex-shrink: 0;
  }
  .vm-color-swatch:hover:not(:disabled) {
    border-color: var(--color-monolith-black, #1A1A1A);
    background: var(--color-monolith-black, #1A1A1A);
  }
  .vm-color-swatch:hover:not(:disabled) .vm-color-chip {
    transform: scale(0.85);
  }
  .vm-color-swatch:disabled {
    cursor: default;
    opacity: 0.7;
  }
  .vm-color-chip {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    transition: transform 200ms;
  }
  .vm-color-status {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    border: 2px solid var(--color-off-white, #faf9f8);
    background: var(--color-outline-variant, #c4c7c7);
  }
  .vm-color-status[data-state="ok"] { background: var(--color-monolith-black, #1A1A1A); }
  .vm-color-status[data-state="low"] { background: var(--color-clay-accent, #C18C7E); }
  .vm-color-status[data-state="empty"] { background: transparent; border-color: var(--color-outline-variant, #c4c7c7); }

  /* Color head (desktop) */
  .vm-color-head {
    padding: 0;
    vertical-align: top;
  }
  .vm-color-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 6px 10px;
    background: var(--color-surface-container-low, #f4f3f2);
    border: 1px solid var(--color-outline-variant, #c4c7c7);
    border-radius: 2px;
    min-width: 100px;
    transition: border-color 200ms;
  }
  .vm-color-card[data-state="empty"] { opacity: 0.5; }
  .vm-color-card[data-state="low"] {
    border-color: var(--color-clay-accent, #C18C7E);
    box-shadow: inset 3px 0 0 var(--color-clay-accent, #C18C7E);
  }
  .vm-color-card[data-state="ok"] {
    box-shadow: inset 3px 0 0 var(--color-monolith-black, #1A1A1A);
  }
  .vm-color-meta {
    text-align: center;
    width: 100%;
  }
  .vm-color-actions {
    display: flex;
    gap: 4px;
    margin-top: 2px;
  }
  .vm-mini-btn {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-outline-variant, #c4c7c7);
    border-radius: 2px;
    color: var(--color-secondary, #6b6b6b);
    cursor: pointer;
    transition: all 200ms;
  }
  .vm-mini-btn:hover:not(:disabled) {
    border-color: var(--color-monolith-black, #1A1A1A);
    color: var(--color-monolith-black, #1A1A1A);
    background: var(--color-monolith-black, #1A1A1A);
  }
  .vm-mini-btn:hover:not(:disabled) span { color: var(--color-off-white, #faf9f8); }
  .vm-mini-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Size head (desktop) */
  .vm-size-head {
    padding: 0;
    vertical-align: middle;
  }
  .vm-size-card {
    text-align: right;
    padding: 6px 8px 6px 0;
    border-right: 2px solid var(--color-outline-variant, #c4c7c7);
  }

  /* Stepper cell */
  .vm-cell-wrap { padding: 0; }
  .vm-stepper {
    display: inline-flex;
    align-items: stretch;
    width: 100%;
    height: var(--vm-stepper-h);
    background: var(--color-surface-container-lowest, #ffffff);
    border: 1px solid var(--color-outline-variant, #c4c7c7);
    border-radius: 2px;
    transition: all 150ms;
    overflow: hidden;
  }
  .vm-stepper[data-state="ok"] {
    border-color: var(--color-monolith-black, #1A1A1A);
    box-shadow: inset 0 -2px 0 var(--color-monolith-black, #1A1A1A);
  }
  .vm-stepper[data-state="low"] {
    border-color: var(--color-clay-accent, #C18C7E);
    box-shadow: inset 0 -2px 0 var(--color-clay-accent, #C18C7E);
  }
  .vm-stepper[data-state="empty"] {
    background: transparent;
    border-style: dashed;
  }
  .vm-stepper:focus-within {
    border-color: var(--color-monolith-black, #1A1A1A);
    box-shadow: 0 0 0 2px rgba(26, 26, 26, 0.08);
  }
  .vm-step-btn {
    width: 32px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: var(--color-secondary, #6b6b6b);
    cursor: pointer;
    transition: all 150ms;
  }
  .vm-step-btn:hover:not(:disabled) {
    background: var(--color-monolith-black, #1A1A1A);
    color: var(--color-off-white, #faf9f8);
  }
  .vm-step-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .vm-step-input {
    flex: 1;
    min-width: 0;
    text-align: center;
    font-family: var(--font-price-display, inherit);
    font-size: 14px;
    background: transparent;
    border: 0;
    color: var(--color-monolith-black, #1A1A1A);
    padding: 0;
    outline: none;
    [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none;
  }
  .vm-step-input:focus { background: rgba(26, 26, 26, 0.04); }
  .vm-step-input[data-state="low"] { color: var(--color-clay-accent, #C18C7E); font-weight: 500; }

  /* Mobile stepper */
  .vm-stepper-mobile {
    height: auto;
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding: 6px;
    gap: 4px;
  }
  .vm-step-input-mobile {
    font-size: 16px;
    font-weight: 600;
  }

  /* Mobile card */
  .vm-mobile-card {
    padding: 16px;
    background: var(--color-surface-container-low, #f4f3f2);
    border: 1px solid var(--color-outline-variant, #c4c7c7);
    border-radius: 2px;
    transition: all 200ms;
  }
  .vm-mobile-card[data-state="empty"] { opacity: 0.55; }
  .vm-mobile-card[data-state="low"] { border-color: var(--color-clay-accent, #C18C7E); }
  .vm-mobile-card[data-state="ok"] { border-color: var(--color-monolith-black, #1A1A1A); }

  /* Foot row */
  .vm-foot-label { padding: 12px 8px 0 0; vertical-align: top; }
  .vm-foot-cell {
    padding: 12px 0 0;
    text-align: center;
    border-top: 1px solid var(--color-outline-variant, #c4c7c7);
  }

  /* Status dots (legend) */
  .vm-dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    display: inline-block;
  }
  .vm-dot-empty { background: transparent; border: 1px solid var(--color-outline-variant, #c4c7c7); }
  .vm-dot-low { background: var(--color-clay-accent, #C18C7E); }
  .vm-dot-ok { background: var(--color-monolith-black, #1A1A1A); }

  /* Threshold input */
  .vm-threshold-input { padding-right: 28px; }

  /* Fill prompt */
  .vm-fill-prompt { animation: vm-slide-down 200ms ease-out; }
  @keyframes vm-slide-down {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
  (function () {
    function initVariantsMatrix(root) {
      if (!root || root.dataset.vmInit) return;
      root.dataset.vmInit = "1";

      var colors = JSON.parse(root.dataset.colors || "[]");
      var sizes = JSON.parse(root.dataset.sizes || "[]");
      var readonly = root.dataset.readonly === "1";
      var state = {}; // { color_size: stock }
      var subscribers = [];

      // Initialize empty state
      colors.forEach(function (c) {
        sizes.forEach(function (s) {
          state[c.name + "_" + s] = 0;
        });
      });

      function key(color, size) { return color + "_" + size; }
      function clamp(n) { return Math.max(0, Math.min(9999, parseInt(n, 10) || 0)); }

      function classify(stock, threshold) {
        if (stock <= 0) return "empty";
        if (stock <= threshold) return "low";
        return "ok";
      }

      function getThreshold() {
        var input = root.querySelector('[data-vm="threshold"]');
        return input ? clamp(input.value) : 5;
      }

      function setStock(color, size, value) {
        state[key(color, size)] = clamp(value);
        render();
        notify();
      }

      function getStock(color, size) {
        return state[key(color, size)] || 0;
      }

      function getColorTotal(color) {
        var total = 0;
        sizes.forEach(function (s) { total += getStock(color, s); });
        return total;
      }

      function getSizeTotal(size) {
        var total = 0;
        colors.forEach(function (c) { total += getStock(c.name, size); });
        return total;
      }

      function getGrandTotal() {
        var total = 0;
        colors.forEach(function (c) {
          sizes.forEach(function (s) { total += getStock(c.name, s); });
        });
        return total;
      }

      function getActiveCount() {
        var count = 0;
        colors.forEach(function (c) {
          sizes.forEach(function (s) {
            if (getStock(c.name, s) > 0) count++;
          });
        });
        return count;
      }

      function getColorState(color) {
        var total = getColorTotal(color);
        if (total === 0) return "empty";
        var threshold = getThreshold();
        return total <= threshold * sizes.length / 2 ? "low" : "ok";
      }

      function render() {
        var threshold = getThreshold();
        // Update all inputs
        root.querySelectorAll("[data-vm-input]").forEach(function (input) {
          var color = input.dataset.vmInput;
          var size = input.dataset.size;
          var stock = getStock(color, size);
          if (document.activeElement !== input) {
            input.value = stock;
          }
          input.dataset.state = classify(stock, threshold);
        });

        // Update all steppers (containers)
        root.querySelectorAll("[data-vm-cell]").forEach(function (cell) {
          var color = cell.dataset.vmCell;
          var size = cell.dataset.vmSize;
          cell.dataset.state = classify(getStock(color, size), threshold);
        });

        // Update color totals + status (desktop + mobile)
        root.querySelectorAll('[data-vm="colorTotal"]').forEach(function (el) {
          el.textContent = getColorTotal(el.dataset.color);
        });
        root.querySelectorAll('[data-vm="colorTotalFoot"]').forEach(function (el) {
          el.textContent = getColorTotal(el.dataset.color);
        });
        root.querySelectorAll('[data-vm="sizeTotal"]').forEach(function (el) {
          el.textContent = getSizeTotal(el.dataset.size);
        });

        // Update color cards state
        root.querySelectorAll(".vm-color-card").forEach(function (card) {
          var color = card.parentElement.dataset.color;
          card.dataset.state = getColorState(color);
        });
        root.querySelectorAll(".vm-mobile-card").forEach(function (card) {
          card.dataset.state = getColorState(card.dataset.vmColor);
        });

        // Update status dots on color swatches
        root.querySelectorAll('[data-vm="colorStatus"]').forEach(function (dot) {
          var state = getColorState(dot.dataset.color);
          dot.dataset.state = state === "ok" ? "ok" : state === "low" ? "low" : "empty";
        });

        // Update grand total + active count
        var gt = root.querySelector('[data-vm="grandTotal"]');
        if (gt) gt.textContent = getGrandTotal();
        var ac = root.querySelector('[data-vm="activeCount"]');
        if (ac) ac.textContent = getActiveCount() + " variantes activas";

        // Update legend threshold text
        var lt = root.querySelector('[data-vm="legendThreshold"]');
        if (lt) lt.textContent = threshold;
      }

      function notify() {
        subscribers.forEach(function (fn) { fn(api); });
      }

      function showFillPrompt(color) {
        var prompt = root.querySelector('[data-vm="fillPrompt"]');
        var label = root.querySelector('[data-vm="fillColorLabel"]');
        if (!prompt || !label) return;
        prompt.dataset.color = color;
        label.textContent = color;
        prompt.classList.remove("hidden");
        prompt.classList.add("flex");
        var input = prompt.querySelector('[data-vm="fillInput"]');
        if (input) { input.value = 5; input.focus(); input.select(); }
      }

      function hideFillPrompt() {
        var prompt = root.querySelector('[data-vm="fillPrompt"]');
        if (!prompt) return;
        prompt.classList.add("hidden");
        prompt.classList.remove("flex");
        prompt.dataset.color = "";
      }

      // === Event delegation ===
      root.addEventListener("click", function (e) {
        if (readonly) return;
        var btn = e.target.closest("[data-vm-action]");
        if (!btn) return;
        var action = btn.dataset.vmAction;
        var color = btn.dataset.color;
        var size = btn.dataset.size;

        if (action === "inc") {
          setStock(color, size, getStock(color, size) + 1);
        } else if (action === "dec") {
          setStock(color, size, Math.max(0, getStock(color, size) - 1));
        } else if (action === "toggle-color") {
          var total = getColorTotal(color);
          if (total > 0) {
            sizes.forEach(function (s) { setStock(color, s, 0); });
          } else {
            var prompt = showFillPrompt;
            prompt(color);
          }
        } else if (action === "fill-color") {
          showFillPrompt(color);
        } else if (action === "clear-color") {
          sizes.forEach(function (s) { setStock(color, s, 0); });
        } else if (action === "apply-fill") {
          var promptEl = root.querySelector('[data-vm="fillPrompt"]');
          var targetColor = promptEl.dataset.color;
          var inputEl = root.querySelector('[data-vm="fillInput"]');
          var n = clamp(inputEl.value);
          sizes.forEach(function (s) { setStock(targetColor, s, n); });
          hideFillPrompt();
        } else if (action === "cancel-fill") {
          hideFillPrompt();
        }
      });

      // === Input typing ===
      root.addEventListener("input", function (e) {
        if (readonly) return;
        var target = e.target;
        if (target.matches('[data-vm="threshold"]')) {
          threshold = getThreshold();
          render();
          notify();
        } else if (target.matches("[data-vm-input]")) {
          var color = target.dataset.vmInput;
          var size = target.dataset.size;
          state[key(color, size)] = clamp(target.value);
          // Only update visual state, not value (user is typing)
          var threshold = getThreshold();
          target.dataset.state = classify(state[key(color, size)], threshold);
          var cell = root.querySelector('[data-vm-cell="' + cssEscape(color) + '"][data-vm-size="' + size + '"]');
          if (cell) cell.dataset.state = classify(state[key(color, size)], threshold);
          notify();
        }
      });

      // === Blur: normalize input ===
      root.addEventListener("blur", function (e) {
        if (!e.target.matches("[data-vm-input]")) return;
        var color = e.target.dataset.vmInput;
        var size = e.target.dataset.size;
        e.target.value = getStock(color, size);
        render();
      }, true);

      // === Keyboard nav: arrow keys ===
      root.addEventListener("keydown", function (e) {
        if (!e.target.matches("[data-vm-input]")) return;
        var color = e.target.dataset.vmInput;
        var size = e.target.dataset.size;
        var colorIdx = colors.findIndex(function (c) { return c.name === color; });
        var sizeIdx = sizes.indexOf(size);
        if (e.key === "ArrowUp" || e.key === "ArrowRight") {
          e.preventDefault();
          var nextColor = e.key === "ArrowRight" && colorIdx < colors.length - 1 ? colors[colorIdx + 1].name : color;
          var nextSize = e.key === "ArrowUp" && sizeIdx > 0 ? sizes[sizeIdx - 1] : size;
          var sel = '[data-vm-input="' + cssEscape(nextColor) + '"][data-size="' + nextSize + '"]';
          var next = root.querySelector(sel);
          if (next) next.focus();
        } else if (e.key === "ArrowDown" || e.key === "ArrowLeft") {
          e.preventDefault();
          var prevColor = e.key === "ArrowLeft" && colorIdx > 0 ? colors[colorIdx - 1].name : color;
          var prevSize = e.key === "ArrowDown" && sizeIdx < sizes.length - 1 ? sizes[sizeIdx + 1] : size;
          var sel2 = '[data-vm-input="' + cssEscape(prevColor) + '"][data-size="' + prevSize + '"]';
          var prev = root.querySelector(sel2);
          if (prev) prev.focus();
        } else if (e.key === "ArrowUp" || e.key === "ArrowDown") {
          var delta = e.key === "ArrowUp" ? 1 : -1;
          e.preventDefault();
          setStock(color, size, getStock(color, size) + delta);
        }
      });

      // === CSS.escape polyfill ===
      function cssEscape(s) {
        if (window.CSS && CSS.escape) return CSS.escape(s);
        return String(s).replace(/[^a-zA-Z0-9_-]/g, function (c) { return "\\" + c; });
      }

      // === Public API ===
      var api = {
        set: setStock,
        get: getStock,
        getColorTotal: getColorTotal,
        getSizeTotal: getSizeTotal,
        getGrandTotal: getGrandTotal,
        getActiveCount: getActiveCount,
        getThreshold: getThreshold,
        getActiveColors: function () {
          return colors.filter(function (c) { return getColorTotal(c.name) > 0; });
        },
        toPayload: function () {
          var payload = { stocks: {} };
          colors.forEach(function (c) {
            sizes.forEach(function (s) {
              payload.stocks[key(c.name, s)] = getStock(c.name, s);
            });
          });
          payload.activeColors = api.getActiveColors();
          payload.threshold = getThreshold();
          return payload;
        },
        reset: function () {
          colors.forEach(function (c) {
            sizes.forEach(function (s) { state[key(c.name, s)] = 0; });
          });
          render();
          notify();
        },
        setInitial: function (initial) {
          if (!initial) return;
          Object.keys(initial).forEach(function (k) {
            if (k in state) state[k] = clamp(initial[k]);
          });
          render();
          notify();
        },
        subscribe: function (fn) {
          subscribers.push(fn);
          return function () {
            subscribers = subscribers.filter(function (s) { return s !== fn; });
          };
        }
      };

      // Expose globally with matrix id
      window.stockMatrix = window.stockMatrix || {};
      window.stockMatrix[root.id] = api;

      // Initial render
      render();
    }

    function initAll() {
      document.querySelectorAll(".variants-matrix").forEach(initVariantsMatrix);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  })();
</script>
