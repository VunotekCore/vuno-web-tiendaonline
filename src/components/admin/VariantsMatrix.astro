---
import VunoIcon from "../atoms/VunoIcon.astro";

interface Props {
  id: string;
  colors: { name: string; hex: string }[];
  sizes: string[];
  lowStockThreshold?: number;
  readonly?: boolean;
  sizePrefix?: string;
}

const { id, colors, sizes, lowStockThreshold = 5, readonly = false, sizePrefix = "EU" } = Astro.props;
const matrixId = `vm-${id}`;
---

<div
  id={matrixId}
  class="variants-matrix w-full"
  data-id={id}
  data-colors={JSON.stringify(colors)}
  data-sizes={JSON.stringify(sizes)}
  data-threshold={lowStockThreshold}
  data-readonly={readonly ? "1" : "0"}
  data-size-prefix={sizePrefix}
>
  <!-- Header: title + threshold + grand total -->
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 lg:gap-4 mb-5">
    <div>
      <h3 class="font-headline text-headline-md flex items-center gap-2 text-monolith-black">
        <VunoIcon icon="inventory" size={24} />
        Matriz de Inventario
      </h3>
      <p class="font-body text-body-sm text-secondary mt-1">
        Define el stock por color y talle. Click en el círculo de un color para activar/desactivar la fila completa.
      </p>
    </div>
    <div class="flex items-center gap-3 lg:gap-5 shrink-0">
      <label class="flex items-center gap-2 cursor-pointer whitespace-nowrap">
        <span class="font-label-caps text-label-caps text-secondary">Alerta bajo stock</span>
        <div class="relative">
          <input
            type="number"
            min="0"
            max="99"
            step="1"
            value={lowStockThreshold}
            data-vm="threshold"
            class="w-20 h-9 pl-2 pr-10 text-center font-price-display text-base bg-white border border-outline-variant rounded-sm focus:border-monolith-black focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            disabled={readonly}
          />
          <span class="absolute right-2 top-1/2 -translate-y-1/2 font-label-caps text-label-caps text-secondary text-[10px] pointer-events-none">und</span>
        </div>
      </label>
      <div class="text-right">
        <div class="font-label-caps text-label-caps text-secondary whitespace-nowrap">Total</div>
        <div class="flex items-baseline gap-1.5 justify-end">
          <span data-vm="grandTotal" class="font-price-display text-price-display text-xl lg:text-2xl text-monolith-black leading-none">0</span>
          <span class="font-label-caps text-label-caps text-secondary text-[10px]">und</span>
        </div>
        <div data-vm="activeCount" class="font-body text-body-sm text-secondary mt-0.5 whitespace-nowrap">0 variantes activas</div>
      </div>
    </div>
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-5 pb-5 border-b border-outline-variant/40">
    <span class="font-label-caps text-label-caps text-secondary">Estados</span>
    <span class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full inline-block bg-transparent border border-outline-variant"></span>
      <span class="font-body text-body-sm text-secondary">Sin stock</span>
    </span>
    <span class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full inline-block bg-clay-accent"></span>
      <span class="font-body text-body-sm text-secondary">Bajo (≤ <span data-vm="legendThreshold">{lowStockThreshold}</span>)</span>
    </span>
    <span class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full inline-block bg-monolith-black"></span>
      <span class="font-body text-body-sm text-secondary">Disponible</span>
    </span>
  </div>

  <!-- Desktop matrix (≥md) -->
  <div class="hidden md:block overflow-x-auto pb-2">
    <table data-vm-table class="vm-table w-full border-separate border-spacing-1">
      <thead>
        <tr>
          <th class="w-16 p-0"></th>
          {colors.map((color) => (
            <th class="p-0 align-top whitespace-nowrap" data-color={color.name}>
              <div data-vm-role="colorCard" class="flex flex-col items-center gap-1.5 p-3 bg-[#f4f3f2] border border-outline-variant rounded-sm min-w-[130px] transition-colors duration-200 data-[state=empty]:opacity-50 data-[state=low]:border-clay-accent data-[state=low]:shadow-[inset_3px_0_0_#C18C7E] data-[state=ok]:shadow-[inset_3px_0_0_#1A1A1A]">
                <button
                  type="button"
                  class="relative w-9 h-9 inline-flex items-center justify-center border border-outline-variant rounded-full bg-transparent cursor-pointer p-1 shrink-0 transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black disabled:opacity-70 disabled:cursor-default group"
                  data-vm-action="toggle-color"
                  data-color={color.name}
                  aria-label={`Alternar color ${color.name}`}
                  disabled={readonly}
                >
                  <span class="block w-full h-full rounded-full shadow-[inset_0_0_0_1px_rgba(0,0,0,0.06)] transition-transform duration-200 group-hover:scale-85" style={`background-color: ${color.hex};`}></span>
                  <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-off-white data-[state=ok]:bg-monolith-black data-[state=low]:bg-clay-accent data-[state=empty]:bg-transparent data-[state=empty]:border-outline-variant" data-vm="colorStatus" data-color={color.name}></span>
                </button>
                <div class="text-center w-full">
                  <div class="font-label-caps text-label-caps text-monolith-black truncate">{color.name}</div>
                  <div class="flex items-center gap-1">
                    <span data-vm="colorTotal" data-color={color.name} class="font-price-display text-price-display text-base text-monolith-black leading-none">0</span>
                    <span class="font-label-caps text-label-caps text-secondary text-[9px]">UND</span>
                  </div>
                </div>
                <div class="flex gap-1 mt-0.5">
                  <button
                    type="button"
                    class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
                    data-vm-action="fill-color"
                    data-color={color.name}
                    title="Aplicar N a todas las talles"
                    disabled={readonly}
                  >
                    <VunoIcon icon="deblur" size={14} />
                  </button>
                  <button
                    type="button"
                    class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
                    data-vm-action="clear-color"
                    data-color={color.name}
                    title="Limpiar color"
                    disabled={readonly}
                  >
                    <VunoIcon icon="backspace" size={14} />
                  </button>
                </div>
              </div>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {sizes.map((size) => (
          <tr>
            <th class="p-0 align-middle" data-size={size}>
              <div class="text-right py-1.5 pr-2 border-r-2 border-outline-variant">
                <div class="font-label-caps text-label-caps text-secondary text-[9px]">{sizePrefix}</div>
                <div class="font-price-display text-price-display text-base text-monolith-black leading-none">{size}</div>
                <div class="flex items-center gap-1 mt-1 justify-end">
                  <span data-vm="sizeTotal" data-size={size} class="font-body text-body-sm text-secondary leading-none">0</span>
                  <span class="font-label-caps text-label-caps text-secondary text-[9px]">und</span>
                </div>
              </div>
            </th>
            {colors.map((color) => (
              <td class="p-0" data-vm-role="cell">
                <div
                  class="inline-flex items-stretch w-full h-[36px] bg-white border border-outline-variant rounded-sm transition-all duration-150 overflow-hidden data-[state=ok]:border-monolith-black data-[state=ok]:shadow-[inset_0_-2px_0_#1A1A1A] data-[state=low]:border-clay-accent data-[state=low]:shadow-[inset_0_-2px_0_#C18C7E] data-[state=empty]:bg-transparent data-[state=empty]:border-dashed focus-within:border-monolith-black focus-within:shadow-[0_0_0_2px_rgba(26,26,26,0.08)]"
                  role="group"
                  aria-label={`Stock ${color.name} talle ${size}`}
                  data-vm-cell={color.name}
                  data-vm-size={size}
                >
                  <button
                    type="button"
                    class="w-8 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
                    data-vm-action="dec"
                    data-color={color.name}
                    data-size={size}
                    aria-label="Disminuir"
                    disabled={readonly}
                  >
                    <VunoIcon icon="remove" size={16} />
                  </button>
                  <input
                    type="number"
                    min="0"
                    step="1"
                    value="0"
                    class="vm-step-input flex-1 min-w-[40px] text-center font-price-display text-sm bg-transparent border-0 text-monolith-black p-0 outline-none focus:bg-monolith-black/5"
                    data-vm-input={color.name}
                    data-size={size}
                    aria-label={`Cantidad ${color.name} ${size}`}
                    readonly={readonly}
                  />
                  <button
                    type="button"
                    class="w-8 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
                    data-vm-action="inc"
                    data-color={color.name}
                    data-size={size}
                    aria-label="Aumentar"
                    disabled={readonly}
                  >
                    <VunoIcon icon="add" size={16} />
                  </button>
                </div>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th class="text-right align-top pt-3 pr-2">
            <span class="font-label-caps text-label-caps text-secondary text-[10px] tracking-widest">TOTAL</span>
          </th>
          {colors.map((color) => (
            <td class="pt-3 text-center border-t border-outline-variant" data-vm="footTotal" data-color={color.name}>
              <span data-vm="colorTotalFoot" data-color={color.name} class="font-price-display text-price-display text-base text-monolith-black">0</span>
            </td>
          ))}
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Mobile cards (<md) -->
  <div data-vm="mobileContainer" class="md:hidden space-y-4">
    {colors.map((color) => (
      <div
        class="p-4 bg-[#f4f3f2] border border-outline-variant rounded-sm transition-all duration-200 data-[state=empty]:opacity-55 data-[state=low]:border-clay-accent data-[state=ok]:border-monolith-black"
        data-vm-mobile={color.name}
        data-vm-color={color.name}
      >
        <div class="flex items-center gap-3 mb-4">
          <button
            type="button"
            class="relative w-9 h-9 inline-flex items-center justify-center border border-outline-variant rounded-full bg-transparent cursor-pointer p-1 shrink-0 transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black disabled:opacity-70 disabled:cursor-default group"
            data-vm-action="toggle-color"
            data-color={color.name}
            aria-label={`Alternar color ${color.name}`}
            disabled={readonly}
          >
            <span class="block w-full h-full rounded-full shadow-[inset_0_0_0_1px_rgba(0,0,0,0.06)] transition-transform duration-200 group-hover:scale-85" style={`background-color: ${color.hex};`}></span>
            <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-off-white data-[state=ok]:bg-monolith-black data-[state=low]:bg-clay-accent data-[state=empty]:bg-transparent data-[state=empty]:border-outline-variant" data-vm="colorStatus" data-color={color.name}></span>
          </button>
          <div class="flex-1">
            <div class="font-headline text-headline-sm text-monolith-black">{color.name}</div>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span data-vm="colorTotal" data-color={color.name} class="font-price-display text-price-display text-base text-monolith-black leading-none">0</span>
              <span class="font-label-caps text-label-caps text-secondary text-[10px]">UND TOTAL</span>
            </div>
          </div>
          <div class="flex gap-1 mt-0.5">
            <button
              type="button"
              class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
              data-vm-action="fill-color"
              data-color={color.name}
              disabled={readonly}
              title="Aplicar N a todas las talles"
            >
              <VunoIcon icon="deblur" size={16} />
            </button>
            <button
              type="button"
              class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
              data-vm-action="clear-color"
              data-color={color.name}
              disabled={readonly}
              title="Limpiar color"
            >
              <VunoIcon icon="backspace" size={16} />
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-1.5">
          {sizes.map((size) => (
            <div
              class="inline-flex items-stretch w-full h-auto min-h-[52px] bg-white flex-row items-center p-1.5 gap-1 border border-outline-variant rounded-sm transition-all duration-150 overflow-hidden data-[state=ok]:border-monolith-black data-[state=ok]:shadow-[inset_0_-2px_0_#1A1A1A] data-[state=low]:border-clay-accent data-[state=low]:shadow-[inset_0_-2px_0_#C18C7E] data-[state=empty]:bg-transparent data-[state=empty]:border-dashed focus-within:border-monolith-black focus-within:shadow-[0_0_0_2px_rgba(26,26,26,0.08)]"
              data-vm-cell={color.name}
              data-vm-size={size}
            >
              <button
                type="button"
                class="w-9 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
                data-vm-action="dec"
                data-color={color.name}
                data-size={size}
                aria-label="Disminuir"
                disabled={readonly}
              >
                <VunoIcon icon="remove" size={16} />
              </button>
              <div class="flex flex-col items-center flex-1">
                <span class="font-label-caps text-label-caps text-secondary text-[9px]">{sizePrefix} {size}</span>
                <input
                  type="number"
                  min="0"
                  step="1"
                  value="0"
                  class="vm-step-input flex-1 min-w-[40px] text-center font-price-display text-base font-semibold bg-transparent border-0 text-monolith-black p-0 outline-none focus:bg-monolith-black/5"
                  data-vm-input={color.name}
                  data-size={size}
                  aria-label={`Cantidad ${color.name} ${size}`}
                  readonly={readonly}
                />
              </div>
              <button
                type="button"
                class="w-9 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"
                data-vm-action="inc"
                data-color={color.name}
                data-size={size}
                aria-label="Aumentar"
                disabled={readonly}
              >
                <VunoIcon icon="add" size={16} />
              </button>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Fill-color inline prompt (hidden by default) -->
  <div
    data-vm="fillPrompt"
    data-color=""
    class="hidden items-center gap-2 mt-3 p-3 bg-monolith-black/5 border border-monolith-black/10 rounded-sm animate-[vm-slide-down_200ms_ease-out]"
  >
    <span class="font-label-caps text-label-caps text-monolith-black text-sm">Aplicar a <span data-vm="fillColorLabel"></span>:</span>
    <input
      type="number"
      min="0"
      step="1"
      value="5"
      data-vm="fillInput"
      class="w-16 h-8 px-2 text-center font-price-display text-base bg-white border border-outline-variant rounded-sm focus:border-monolith-black focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
    />
    <span class="font-label-caps text-label-caps text-secondary text-sm">und a cada talle</span>
    <button
      type="button"
      class="ml-auto font-label-caps text-label-caps text-monolith-black border border-monolith-black px-3 h-8 hover:bg-monolith-black hover:text-off-white transition-all"
      data-vm-action="apply-fill"
    >
      APLICAR
    </button>
    <button
      type="button"
      class="font-label-caps text-label-caps text-secondary hover:text-monolith-black transition-colors"
      data-vm-action="cancel-fill"
    >
      CANCELAR
    </button>
  </div>
</div>

<style>
  @keyframes vm-slide-down {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .vm-step-input { appearance: textfield; }
  .vm-step-input::-webkit-outer-spin-button,
  .vm-step-input::-webkit-inner-spin-button { appearance: none; }
  .vm-table { border-spacing: 4px; }
</style>

<script is:inline>
  (function () {
    var VM_ICONS = {
      remove: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="12" x2="9" y2="12"/></svg>',
      add: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>',
      grid: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/></svg>',
      close: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
    };

    function initVariantsMatrix(root) {
      if (!root || root.dataset.vmInit) return;
      root.dataset.vmInit = "1";

      var colors = JSON.parse(root.dataset.colors || "[]");
      var sizes = JSON.parse(root.dataset.sizes || "[]");
      var readonly = root.dataset.readonly === "1";
      var sizePrefix = root.dataset.sizePrefix || "EU";
      var id = root.dataset.id;
      var state = {}; // { color_size: stock }
      var subscribers = [];

      // Initialize empty state
      colors.forEach(function (c) {
        sizes.forEach(function (s) {
          state[c.name + "_" + s] = 0;
        });
      });

      function key(color, size) { return color + "_" + size; }
      function clamp(n) { return Math.max(0, Math.min(9999, parseInt(n, 10) || 0)); }

      function classify(stock, threshold) {
        if (stock <= 0) return "empty";
        if (stock <= threshold) return "low";
        return "ok";
      }

      function getThreshold() {
        var input = root.querySelector('[data-vm="threshold"]');
        return input ? clamp(input.value) : 5;
      }

      function setStock(color, size, value) {
        state[key(color, size)] = clamp(value);
        render();
        notify();
      }

      function getStock(color, size) {
        return state[key(color, size)] || 0;
      }

      function getColorTotal(color) {
        var total = 0;
        sizes.forEach(function (s) { total += getStock(color, s); });
        return total;
      }

      function getSizeTotal(size) {
        var total = 0;
        colors.forEach(function (c) { total += getStock(c.name, size); });
        return total;
      }

      function getGrandTotal() {
        var total = 0;
        colors.forEach(function (c) {
          sizes.forEach(function (s) { total += getStock(c.name, s); });
        });
        return total;
      }

      function getActiveCount() {
        var count = 0;
        colors.forEach(function (c) {
          sizes.forEach(function (s) {
            if (getStock(c.name, s) > 0) count++;
          });
        });
        return count;
      }

      function getColorState(color) {
        var total = getColorTotal(color);
        if (total === 0) return "empty";
        var threshold = getThreshold();
        return total <= threshold * sizes.length / 2 ? "low" : "ok";
      }

      function render() {
        var threshold = getThreshold();
        // Update all inputs
        root.querySelectorAll("[data-vm-input]").forEach(function (input) {
          var color = input.dataset.vmInput;
          var size = input.dataset.size;
          var stock = getStock(color, size);
          if (document.activeElement !== input) {
            input.value = stock;
          }
          input.dataset.state = classify(stock, threshold);
        });

        // Update all steppers (containers)
        root.querySelectorAll("[data-vm-cell]").forEach(function (cell) {
          var color = cell.dataset.vmCell;
          var size = cell.dataset.vmSize;
          cell.dataset.state = classify(getStock(color, size), threshold);
        });

        // Update color totals + status (desktop + mobile)
        root.querySelectorAll('[data-vm="colorTotal"]').forEach(function (el) {
          el.textContent = getColorTotal(el.dataset.color);
        });
        root.querySelectorAll('[data-vm="colorTotalFoot"]').forEach(function (el) {
          el.textContent = getColorTotal(el.dataset.color);
        });
        root.querySelectorAll('[data-vm="sizeTotal"]').forEach(function (el) {
          el.textContent = getSizeTotal(el.dataset.size);
        });

        // Update color cards state
        root.querySelectorAll("[data-vm-role=\"colorCard\"]").forEach(function (card) {
          var color = card.parentElement.dataset.color;
          card.dataset.state = getColorState(color);
        });
        root.querySelectorAll("[data-vm-mobile]").forEach(function (card) {
          card.dataset.state = getColorState(card.dataset.vmColor);
        });

        // Update status dots on color swatches
        root.querySelectorAll('[data-vm="colorStatus"]').forEach(function (dot) {
          var state = getColorState(dot.dataset.color);
          dot.dataset.state = state === "ok" ? "ok" : state === "low" ? "low" : "empty";
        });

        // Update grand total + active count
        var gt = root.querySelector('[data-vm="grandTotal"]');
        if (gt) gt.textContent = getGrandTotal();
        var ac = root.querySelector('[data-vm="activeCount"]');
        if (ac) ac.textContent = getActiveCount() + " variantes activas";

        // Update legend threshold text
        var lt = root.querySelector('[data-vm="legendThreshold"]');
        if (lt) lt.textContent = threshold;
      }

      function notify() {
        subscribers.forEach(function (fn) { fn(api); });
      }

      function showFillPrompt(color) {
        var prompt = root.querySelector('[data-vm="fillPrompt"]');
        var label = root.querySelector('[data-vm="fillColorLabel"]');
        if (!prompt || !label) return;
        prompt.dataset.color = color;
        label.textContent = color;
        prompt.classList.remove("hidden");
        prompt.classList.add("flex");
        var input = prompt.querySelector('[data-vm="fillInput"]');
        if (input) { input.value = 5; input.focus(); input.select(); }
      }

      function hideFillPrompt() {
        var prompt = root.querySelector('[data-vm="fillPrompt"]');
        if (!prompt) return;
        prompt.classList.add("hidden");
        prompt.classList.remove("flex");
        prompt.dataset.color = "";
      }

      // === Event delegation ===
      root.addEventListener("click", function (e) {
        if (readonly) return;
        var btn = e.target.closest("[data-vm-action]");
        if (!btn) return;
        var action = btn.dataset.vmAction;
        var color = btn.dataset.color;
        var size = btn.dataset.size;

        if (action === "inc") {
          setStock(color, size, getStock(color, size) + 1);
        } else if (action === "dec") {
          setStock(color, size, Math.max(0, getStock(color, size) - 1));
        } else if (action === "toggle-color") {
          var total = getColorTotal(color);
          if (total > 0) {
            sizes.forEach(function (s) { setStock(color, s, 0); });
          } else {
            var prompt = showFillPrompt;
            prompt(color);
          }
        } else if (action === "fill-color") {
          showFillPrompt(color);
        } else if (action === "clear-color") {
          sizes.forEach(function (s) { setStock(color, s, 0); });
        } else if (action === "apply-fill") {
          var promptEl = root.querySelector('[data-vm="fillPrompt"]');
          var targetColor = promptEl.dataset.color;
          var inputEl = root.querySelector('[data-vm="fillInput"]');
          var n = clamp(inputEl.value);
          sizes.forEach(function (s) { setStock(targetColor, s, n); });
          hideFillPrompt();
        } else if (action === "cancel-fill") {
          hideFillPrompt();
        }
      });

      // === Input typing ===
      root.addEventListener("input", function (e) {
        if (readonly) return;
        var target = e.target;
        if (target.matches('[data-vm="threshold"]')) {
          threshold = getThreshold();
          render();
          notify();
        } else if (target.matches("[data-vm-input]")) {
          var color = target.dataset.vmInput;
          var size = target.dataset.size;
          state[key(color, size)] = clamp(target.value);
          // Only update visual state, not value (user is typing)
          var threshold = getThreshold();
          target.dataset.state = classify(state[key(color, size)], threshold);
          var cell = root.querySelector('[data-vm-cell="' + cssEscape(color) + '"][data-vm-size="' + size + '"]');
          if (cell) cell.dataset.state = classify(state[key(color, size)], threshold);
          notify();
        }
      });

      // === Blur: normalize input ===
      root.addEventListener("blur", function (e) {
        if (!e.target.matches("[data-vm-input]")) return;
        var color = e.target.dataset.vmInput;
        var size = e.target.dataset.size;
        e.target.value = getStock(color, size);
        render();
      }, true);

      // === Keyboard nav: arrow keys ===
      root.addEventListener("keydown", function (e) {
        if (!e.target.matches("[data-vm-input]")) return;
        var color = e.target.dataset.vmInput;
        var size = e.target.dataset.size;
        var colorIdx = colors.findIndex(function (c) { return c.name === color; });
        var sizeIdx = sizes.indexOf(size);
        if (e.key === "ArrowUp" || e.key === "ArrowRight") {
          e.preventDefault();
          var nextColor = e.key === "ArrowRight" && colorIdx < colors.length - 1 ? colors[colorIdx + 1].name : color;
          var nextSize = e.key === "ArrowUp" && sizeIdx > 0 ? sizes[sizeIdx - 1] : size;
          var sel = '[data-vm-input="' + cssEscape(nextColor) + '"][data-size="' + nextSize + '"]';
          var next = root.querySelector(sel);
          if (next) next.focus();
        } else if (e.key === "ArrowDown" || e.key === "ArrowLeft") {
          e.preventDefault();
          var prevColor = e.key === "ArrowLeft" && colorIdx > 0 ? colors[colorIdx - 1].name : color;
          var prevSize = e.key === "ArrowDown" && sizeIdx < sizes.length - 1 ? sizes[sizeIdx + 1] : size;
          var sel2 = '[data-vm-input="' + cssEscape(prevColor) + '"][data-size="' + prevSize + '"]';
          var prev = root.querySelector(sel2);
          if (prev) prev.focus();
        } else if (e.key === "ArrowUp" || e.key === "ArrowDown") {
          var delta = e.key === "ArrowUp" ? 1 : -1;
          e.preventDefault();
          setStock(color, size, getStock(color, size) + delta);
        }
      });

      // === CSS.escape polyfill ===
      function cssEscape(s) {
        if (window.CSS && CSS.escape) return CSS.escape(s);
        return String(s).replace(/[^a-zA-Z0-9_-]/g, function (c) { return "\\" + c; });
      }

      function escHtml(s) {
        return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      // === HTML builders ===
      function stpHTML(color, size) {
        var col = escHtml(color);
        var d = readonly ? " disabled" : "";
        var r = readonly ? " readonly" : "";
        return '<div class="inline-flex items-stretch w-full h-[36px] bg-white border border-outline-variant rounded-sm transition-all duration-150 overflow-hidden data-[state=ok]:border-monolith-black data-[state=ok]:shadow-[inset_0_-2px_0_#1A1A1A] data-[state=low]:border-clay-accent data-[state=low]:shadow-[inset_0_-2px_0_#C18C7E] data-[state=empty]:bg-transparent data-[state=empty]:border-dashed focus-within:border-monolith-black focus-within:shadow-[0_0_0_2px_rgba(26,26,26,0.08)]" role="group" aria-label="Stock ' + col + ' talle ' + size + '" data-vm-cell="' + col + '" data-vm-size="' + size + '">'
          + '<button type="button" class="w-8 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="dec" data-color="' + col + '" data-size="' + size + '" aria-label="Disminuir">' + VM_ICONS.remove + '</button>'
          + '<input type="number" min="0" step="1" value="0" class="vm-step-input flex-1 min-w-[40px] text-center font-price-display text-sm bg-transparent border-0 text-monolith-black p-0 outline-none focus:bg-monolith-black/5"' + r + ' data-vm-input="' + col + '" data-size="' + size + '" aria-label="Cantidad ' + col + ' ' + size + '" />'
          + '<button type="button" class="w-8 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="inc" data-color="' + col + '" data-size="' + size + '" aria-label="Aumentar">' + VM_ICONS.add + '</button>'
          + "</div>";
      }

      function mstpHTML(color, size) {
        var col = escHtml(color);
        var d = readonly ? " disabled" : "";
        var r = readonly ? " readonly" : "";
        return '<div class="inline-flex items-stretch w-full h-auto min-h-[52px] bg-white flex-row items-center p-1.5 gap-1 border border-outline-variant rounded-sm transition-all duration-150 overflow-hidden data-[state=ok]:border-monolith-black data-[state=ok]:shadow-[inset_0_-2px_0_#1A1A1A] data-[state=low]:border-clay-accent data-[state=low]:shadow-[inset_0_-2px_0_#C18C7E] data-[state=empty]:bg-transparent data-[state=empty]:border-dashed focus-within:border-monolith-black focus-within:shadow-[0_0_0_2px_rgba(26,26,26,0.08)]" data-vm-cell="' + col + '" data-vm-size="' + size + '">'
          + '<button type="button" class="w-9 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="dec" data-color="' + col + '" data-size="' + size + '" aria-label="Disminuir">' + VM_ICONS.remove + '</button>'
          + '<div class="flex flex-col items-center flex-1"><span class="font-label-caps text-label-caps text-secondary text-[9px]">' + sizePrefix + ' ' + size + '</span>'
          + '<input type="number" min="0" step="1" value="0" class="vm-step-input flex-1 min-w-[40px] text-center font-price-display text-base font-semibold bg-transparent border-0 text-monolith-black p-0 outline-none focus:bg-monolith-black/5"' + r + ' data-vm-input="' + col + '" data-size="' + size + '" aria-label="Cantidad ' + col + ' ' + size + '" /></div>'
          + '<button type="button" class="w-9 shrink-0 inline-flex items-center justify-center bg-transparent border-0 text-secondary cursor-pointer transition-all duration-150 hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="inc" data-color="' + col + '" data-size="' + size + '" aria-label="Aumentar">' + VM_ICONS.add + '</button>'
          + "</div>";
      }

      function colorHeadHTML(name, hex) {
        var col = escHtml(name);
        var d = readonly ? " disabled" : "";
        return '<div data-vm-role="colorCard" class="flex flex-col items-center gap-1.5 p-3 bg-[#f4f3f2] border border-outline-variant rounded-sm min-w-[130px] transition-colors duration-200 data-[state=empty]:opacity-50 data-[state=low]:border-clay-accent data-[state=low]:shadow-[inset_3px_0_0_#C18C7E] data-[state=ok]:shadow-[inset_3px_0_0_#1A1A1A]">'
          + '<button type="button" class="relative w-9 h-9 inline-flex items-center justify-center border border-outline-variant rounded-full bg-transparent cursor-pointer p-1 shrink-0 transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black disabled:opacity-70 disabled:cursor-default group"' + d + ' data-vm-action="toggle-color" data-color="' + col + '" aria-label="Alternar color ' + col + '">'
          + '<span class="block w-full h-full rounded-full shadow-[inset_0_0_0_1px_rgba(0,0,0,0.06)] transition-transform duration-200 group-hover:scale-85" style="background-color:' + hex + ';"></span>'
          + '<span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-off-white data-[state=ok]:bg-monolith-black data-[state=low]:bg-clay-accent data-[state=empty]:bg-transparent data-[state=empty]:border-outline-variant" data-vm="colorStatus" data-color="' + col + '"></span></button>'
          + '<div class="text-center w-full"><div class="font-label-caps text-label-caps text-monolith-black truncate">' + col + '</div>'
          + '<div class="flex items-center gap-1"><span data-vm="colorTotal" data-color="' + col + '" class="font-price-display text-price-display text-base text-monolith-black leading-none">0</span>'
          + '<span class="font-label-caps text-label-caps text-secondary text-[9px]">UND</span></div></div>'
          + '<div class="flex gap-1 mt-0.5">'
          + '<button type="button" class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="fill-color" data-color="' + col + '" title="Aplicar N a todas las talles">' + VM_ICONS.grid + '</button>'
          + '<button type="button" class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="clear-color" data-color="' + col + '" title="Limpiar color">' + VM_ICONS.close + '</button>'
          + "</div></div>";
      }

      function mobileCardHTML(name, hex) {
        var col = escHtml(name);
        var d = readonly ? " disabled" : "";
        var sizesHTML = "";
        sizes.forEach(function (s) { sizesHTML += mstpHTML(name, s); });
        return '<div class="p-4 bg-[#f4f3f2] border border-outline-variant rounded-sm transition-all duration-200 data-[state=empty]:opacity-55 data-[state=low]:border-clay-accent data-[state=ok]:border-monolith-black" data-vm-mobile="' + col + '" data-vm-color="' + col + '">'
          + '<div class="flex items-center gap-3 mb-4">'
          + '<button type="button" class="relative w-9 h-9 inline-flex items-center justify-center border border-outline-variant rounded-full bg-transparent cursor-pointer p-1 shrink-0 transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black disabled:opacity-70 disabled:cursor-default group"' + d + ' data-vm-action="toggle-color" data-color="' + col + '" aria-label="Alternar color ' + col + '">'
          + '<span class="block w-full h-full rounded-full shadow-[inset_0_0_0_1px_rgba(0,0,0,0.06)] transition-transform duration-200 group-hover:scale-85" style="background-color:' + hex + ';"></span>'
          + '<span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-off-white data-[state=ok]:bg-monolith-black data-[state=low]:bg-clay-accent data-[state=empty]:bg-transparent data-[state=empty]:border-outline-variant" data-vm="colorStatus" data-color="' + col + '"></span></button>'
          + '<div class="flex-1"><div class="font-headline text-headline-sm text-monolith-black">' + col + '</div>'
          + '<div class="flex items-center gap-1.5 mt-0.5"><span data-vm="colorTotal" data-color="' + col + '" class="font-price-display text-base text-monolith-black leading-none">0</span>'
          + '<span class="font-label-caps text-label-caps text-secondary text-[10px]">UND TOTAL</span></div></div>'
          + '<div class="flex gap-1 mt-0.5">'
          + '<button type="button" class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="fill-color" data-color="' + col + '">' + VM_ICONS.grid + '</button>'
          + '<button type="button" class="w-7 h-7 inline-flex items-center justify-center bg-transparent border border-outline-variant rounded-sm text-secondary cursor-pointer transition-all duration-200 hover:enabled:border-monolith-black hover:enabled:bg-monolith-black hover:enabled:text-off-white disabled:opacity-40 disabled:cursor-not-allowed"' + d + ' data-vm-action="clear-color" data-color="' + col + '">' + VM_ICONS.close + '</button>'
          + "</div></div>"
          + '<div class="grid grid-cols-2 md:grid-cols-3 gap-1.5">' + sizesHTML + "</div></div>";
      }

      function sizeHeadHTML(value) {
        return '<div class="text-right py-1.5 pr-2 border-r-2 border-outline-variant"><div class="font-label-caps text-label-caps text-secondary text-[9px]">' + sizePrefix + '</div>'
          + '<div class="font-price-display text-price-display text-base text-monolith-black leading-none">' + value + "</div>"
          + '<div class="flex items-center gap-1 mt-1 justify-end"><span data-vm="sizeTotal" data-size="' + value + '" class="font-body text-body-sm text-secondary leading-none">0</span>'
          + '<span class="font-label-caps text-label-caps text-secondary text-[9px]">und</span></div></div>';
      }

      // === Public API ===
      var api = {
        set: setStock,
        get: getStock,
        getColorTotal: getColorTotal,
        getSizeTotal: getSizeTotal,
        getGrandTotal: getGrandTotal,
        getActiveCount: getActiveCount,
        getThreshold: getThreshold,
        getActiveColors: function () {
          return colors.filter(function (c) { return getColorTotal(c.name) > 0; });
        },
        addColor: function (name, hex) {
          if (!name || !hex) return;
          if (colors.some(function (c) { return c.name === name; })) return;
          colors.push({ name: name, hex: hex });
          sizes.forEach(function (s) { state[key(name, s)] = 0; });

          // thead column
          var theadTr = root.querySelector("[data-vm-table] thead tr");
          var th = document.createElement("th");
          th.className = "p-0 align-top whitespace-nowrap";
          th.setAttribute("data-color", name);
          th.innerHTML = colorHeadHTML(name, hex);
          theadTr.appendChild(th);

          // tbody cells — append to each row
          root.querySelectorAll("[data-vm-table] tbody tr").forEach(function (tr) {
            var td = document.createElement("td");
            td.className = "p-0";
            td.setAttribute("data-vm-role", "cell");
            td.innerHTML = stpHTML(name, tr.querySelector("th[data-size]").dataset.size);
            tr.appendChild(td);
          });

          // tfoot cell
          var tfootTr = root.querySelector("[data-vm-table] tfoot tr");
          var footTd = document.createElement("td");
          footTd.className = "pt-3 text-center border-t border-outline-variant";
          footTd.setAttribute("data-vm", "footTotal");
          footTd.setAttribute("data-color", name);
          footTd.innerHTML = '<span data-vm="colorTotalFoot" data-color="' + escHtml(name) + '" class="font-price-display text-price-display text-base text-monolith-black">0</span>';
          tfootTr.appendChild(footTd);

          // mobile card
          root.querySelector("[data-vm=\"mobileContainer\"]").insertAdjacentHTML("beforeend", mobileCardHTML(name, hex));

          render();
          notify();
        },
        removeColor: function (name) {
          var idx = colors.findIndex(function (c) { return c.name === name; });
          if (idx === -1) return;
          colors.splice(idx, 1);
          var keys = Object.keys(state);
          keys.forEach(function (k) {
            if (k.indexOf(name + "_") === 0) delete state[k];
          });

          // remove thead column
          var th = root.querySelector('th[data-color="' + cssEscape(name) + '"]');
          if (th) th.remove();

          // remove tbody cells for this color
          root.querySelectorAll("[data-vm-table] tbody tr").forEach(function (tr) {
            var td = tr.querySelector('td[data-vm-role="cell"]:nth-child(' + (idx + 2) + ')');
            if (td) td.remove();
          });

          // remove tfoot cell
          var footTd = root.querySelector('td[data-vm="footTotal"][data-color="' + cssEscape(name) + '"]');
          if (footTd) footTd.remove();

          // remove mobile card
          var card = root.querySelector('[data-vm-mobile="' + cssEscape(name) + '"]');
          if (card) card.remove();

          render();
          notify();
        },
        addSize: function (value) {
          if (sizes.indexOf(value) !== -1) return;
          sizes.push(value);
          colors.forEach(function (c) { state[key(c.name, value)] = 0; });

          // new tbody row
          var tr = document.createElement("tr");
          var th = document.createElement("th");
          th.className = "p-0 align-middle";
          th.setAttribute("data-size", value);
          th.innerHTML = sizeHeadHTML(value);
          tr.appendChild(th);
          colors.forEach(function (c) {
            var td = document.createElement("td");
            td.className = "p-0";
            td.setAttribute("data-vm-role", "cell");
            td.innerHTML = stpHTML(c.name, value);
            tr.appendChild(td);
          });
          root.querySelector("[data-vm-table] tbody").appendChild(tr);

          // steppers in each mobile card
          root.querySelectorAll("[data-vm-mobile]").forEach(function (card) {
            var color = card.dataset.vmColor;
            var grid = card.querySelector(".grid");
            if (grid) grid.insertAdjacentHTML("beforeend", mstpHTML(color, value));
          });

          render();
          notify();
        },
        removeSize: function (value) {
          var idx = sizes.indexOf(value);
          if (idx === -1) return;
          sizes.splice(idx, 1);
          var keys = Object.keys(state);
          keys.forEach(function (k) {
            if (k.indexOf("_" + value) !== -1) delete state[k];
          });

          // remove tbody row
          var row = root.querySelector('tr th[data-size="' + value + '"]');
          if (row) row.parentElement.remove();

          // remove steppers from mobile cards
          root.querySelectorAll('[data-vm-mobile] [data-vm-size="' + value + '"]').forEach(function (el) {
            el.remove();
          });

          render();
          notify();
        },
        toPayload: function () {
          var payload = { stocks: {} };
          colors.forEach(function (c) {
            sizes.forEach(function (s) {
              payload.stocks[key(c.name, s)] = getStock(c.name, s);
            });
          });
          payload.activeColors = api.getActiveColors();
          payload.threshold = getThreshold();
          return payload;
        },
        reset: function () {
          colors.forEach(function (c) {
            sizes.forEach(function (s) { state[key(c.name, s)] = 0; });
          });
          render();
          notify();
        },
        setInitial: function (initial) {
          if (!initial) return;
          Object.keys(initial).forEach(function (k) {
            if (k in state) state[k] = clamp(initial[k]);
          });
          render();
          notify();
        },
        setSizePrefix: function (prefix) {
          sizePrefix = prefix || "EU";
          root.dataset.sizePrefix = sizePrefix;
          render();
        },
        subscribe: function (fn) {
          subscribers.push(fn);
          return function () {
            subscribers = subscribers.filter(function (s) { return s !== fn; });
          };
        }
      };

      // Expose globally with both raw id and vm-{id}
      window.stockMatrix = window.stockMatrix || {};
      window.stockMatrix[root.id] = api;       // "vm-new" / "vm-edit"
      window.stockMatrix[id] = api;            // "new" / "edit"

      // Initial render
      render();
    }

    function initAll() {
      document.querySelectorAll(".variants-matrix").forEach(initVariantsMatrix);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  })();
</script>
</content>
