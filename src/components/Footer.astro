---
// obtener el año actual
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-white/5 bg-background-dark py-12">
  <div class="mx-auto max-w-7xl px-6 md:px-12">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2 text-white">
          <svg
            class="w-32 h-16 text-primary transition-transform group-hover:scale-105"
            viewBox="0 0 2857.41 1174.24"
            fill="currentColor"
          >
            <use href="/sprite.svg#logomark"></use>
          </svg>
        </div>
        <p class="text-sm text-white/40">
          © {year} The Real Dev Pro. All rights reserved.
        </p>
      </div>
      <div
        class="flex gap-8 font-mono text-[10px] uppercase tracking-widest text-white/40"
      >
        <a class="hover:text-primary" href="#">Nosotros</a>
        <a class="hover:text-primary" href="#">Facebook</a>
        <a class="hover:text-primary" href="#">Linkedin</a>
      </div>
      <div class="flex items-center gap-2">
        <div class="size-2 rounded-full bg-primary"></div>
        <span class="font-mono text-[10px] text-white/60"
          >SYSTEM STATUS: OPTIMAL</span
        >
      </div>
    </div>
  </div>
</footer>
