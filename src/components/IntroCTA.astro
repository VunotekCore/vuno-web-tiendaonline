<section id="intro-cta" class="w-full px-6 py-24">
    <div
        class="mx-auto flex max-w-5xl flex-col items-center rounded-2xl border border-primary/20 bg-gradient-to-br from-primary/10 to-transparent p-12 text-center md:p-20"
    >
        <h2 class="text-3xl font-black text-white md:text-5xl">
            Somos The Real Devs Pro
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-white/60">
            Una agencia de desarrollo especializada en sistemas empresariales,
            Pyme, integraciones Salesforce y plataformas web de alto
            rendimiento.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <button
                class="flex h-14 min-w-[200px] items-center justify-center gap-2 rounded-lg bg-primary px-8 text-sm font-bold tracking-[0.1em] text-background-dark transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(6,249,249,0.4)]"
            >
                <span>COTIZAR PROYECTO</span>
                <span class="material-symbols-outlined text-lg"
                    >arrow_forward</span
                >
            </button>
            <button
                class="flex h-14 min-w-[200px] items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/5 px-8 text-sm font-bold tracking-[0.1em] text-white transition-all hover:bg-white/10"
            >
                <span>AGENDA UNA REUNION</span>
                <span class="material-symbols-outlined text-lg"
                    >calendar_today</span
                >
            </button>
        </div>
    </div>
</section>
