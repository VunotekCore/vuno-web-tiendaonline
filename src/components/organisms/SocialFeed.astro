---
import { t, type Locale } from "../../i18n/utils";
import type { LandingSectionData } from "../../lib/storage";

interface Props {
  lang: Locale;
  data?: LandingSectionData | null;
}

const { lang, data } = Astro.props;

if (data && data.enabled === false) return;

const title = data?.title_es && data?.title_en
  ? (lang === "es" ? data.title_es : data.title_en)
  : t("home.social.title", lang);
---

<section class="py-section-gap px-margin-mobile md:px-margin-desktop bg-background overflow-hidden" data-section="social">
  <div class="max-w-container-max mx-auto">
    <div class="text-center mb-10">
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-monolith-black leading-tight" data-field="title">
        {title}
      </h2>
      <span class="arch-line arch-line-clay mx-auto mt-6"></span>
    </div>

    <div class="flex flex-wrap justify-center gap-3 max-w-5xl mx-auto mb-10" id="socialFeedGrid">
      {[1, 2, 3, 4, 5, 6].map(() => (
        <div class="w-24 md:w-28 lg:w-32 animate-pulse">
          <div class="aspect-square bg-surface-container rounded"></div>
        </div>
      ))}
    </div>

    <div class="flex items-center justify-center gap-6 md:gap-8" id="socialFeedPlatforms">
      {[1, 2, 3, 4].map(() => (
        <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-surface-container animate-pulse"></div>
      ))}
    </div>
  </div>
</section>

<script src="/js/social-feed.js" is:inline></script>
<script is:inline>
  (function () {
    var lang = document.documentElement.lang || "es";
    SocialFeed.init(lang);
  })();
</script>
