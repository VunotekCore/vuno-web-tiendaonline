---
import { t, type Locale } from "../../i18n/utils";
import type { LandingSectionData, SocialPlatformConfig, SocialImageItem } from "../../lib/storage";

interface Props {
  lang: Locale;
  data?: LandingSectionData | null;
}

const { lang, data } = Astro.props;

if (!data?.enabled) return;

const title = data?.title_es && data?.title_en
  ? (lang === "es" ? data.title_es : data.title_en)
  : t("home.social.title", lang);

const platforms: Record<string, SocialPlatformConfig> = data?.platforms || {};
const images: SocialImageItem[] = data?.images || [];

// Fallback: migrate old flat urls into platforms if new structure is empty
if (Object.keys(platforms).length === 0) {
  const oldUrls: [string, string][] = [
    ["facebook", data?.facebook_url || ""],
    ["instagram", data?.instagram_url || ""],
    ["tiktok", data?.tiktok_url || ""],
  ];
  for (const [name, url] of oldUrls) {
    if (url) {
      platforms[name] = { enabled: true, url };
    }
  }
}

const platformLabels: Record<string, string> = {
  facebook: "Facebook",
  instagram: "Instagram",
  tiktok: "TikTok",
  linkedin: "LinkedIn",
  youtube: "YouTube",
};

const enabledPlatforms = Object.entries(platforms).filter(
  ([, cfg]) => cfg.enabled && cfg.url
);

function renderPlatformIcon(platform: string): string {
  const cls = "w-5 h-5 md:w-6 md:h-6 text-secondary group-hover:text-off-white transition-colors duration-300";
  switch (platform) {
    case "facebook":
      return `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
    case "instagram":
      return `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`;
    case "tiktok":
      return `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`;
    case "linkedin":
      return `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`;
    case "youtube":
      return `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`;
    default:
      return `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>`;
  }
}
---

<section class="py-section-gap px-margin-mobile md:px-margin-desktop bg-background overflow-hidden" data-section="social">
  <div class="max-w-container-max mx-auto">
    <div class="text-center mb-10">
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-monolith-black leading-tight" data-field="title">
        {title}
      </h2>
      <span class="arch-line arch-line-clay mx-auto mt-6"></span>
    </div>

    {images.length > 0 && (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-5xl mx-auto mb-10">
        {images.map((item) => {
          const platCfg = platforms[item.platform];
          const platLabel = platformLabels[item.platform] || item.platform;
          const href = platCfg?.url || "#";
          if (!item.image_url) return null;
          return (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative aspect-square bg-surface-container overflow-hidden block"
              aria-label={`${platLabel} — ${lang === "es" ? "Abrir en nueva ventana" : "Open in new window"}`}
            >
              <img
                src={item.image_url}
                alt=""
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-monolith-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 bg-off-white/90 backdrop-blur-sm px-2.5 py-1 text-xs font-label-caps text-monolith-black opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                {renderPlatformIcon(item.platform)}
                {platLabel}
              </span>
            </a>
          );
        })}
      </div>
    )}

    {enabledPlatforms.length > 0 && (
      <div class="flex items-center justify-center gap-6 md:gap-8">
        {enabledPlatforms.map(([name, cfg]) => (
          <a
            href={cfg.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-center w-12 h-12 md:w-14 md:h-14 rounded-full border border-outline-variant hover:border-monolith-black hover:bg-monolith-black transition-all duration-300"
            aria-label={platformLabels[name] || name}
            title={platformLabels[name] || name}
          >
            {renderPlatformIcon(name)}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
