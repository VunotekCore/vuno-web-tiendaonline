---
import type { Locale } from "../../i18n/utils";
import { t } from "../../i18n/utils";

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const otherLang: Locale = lang === "es" ? "en" : "es";
const langSwitchPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);

const navLinks = [
  { key: "nav.sandals", href: `/${lang}/catalogo` },
  { key: "nav.heels", href: `/${lang}/catalogo` },
  { key: "nav.newArrivals", href: `/${lang}/#new-arrivals` },
  { key: "nav.boots", href: `/${lang}/catalogo` },
  { key: "nav.flats", href: `/${lang}/catalogo` },
];
---

<nav class="bg-background/90 backdrop-blur-md sticky top-0 z-50 transition-all duration-300" id="topNav">
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-5 max-w-container-max mx-auto">
    <button class="md:hidden text-primary hover:opacity-70 transition-opacity" aria-label={t("nav.menu", lang)}>
      <span class="material-symbols-outlined" data-icon="menu">menu</span>
    </button>

    <div class="hidden md:flex items-center gap-8 font-label-caps text-label-caps">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-secondary hover:text-primary transition-all hover:tracking-[0.15em] relative after:absolute after:bottom-[-2px] after:left-0 after:w-0 after:h-[1px] after:bg-monolith-black after:transition-all after:duration-300 hover:after:w-full"
        >
          {t(link.key, lang)}
        </a>
      ))}
    </div>

    <a
      href={`/${lang}/`}
      class="font-headline-md text-headline-md tracking-tight text-monolith-black hover:opacity-70 transition-opacity absolute left-1/2 -translate-x-1/2 md:static md:transform-none inline-flex items-center gap-2"
    >
      <img data-store-logo alt="" class="h-8 w-auto hidden object-contain" />
      <span data-store-name>Ram;Lop</span>
      <span data-store-slogan class="hidden md:inline font-body-md text-body-md text-secondary font-normal tracking-normal max-w-48 truncate"></span>
    </a>

    <div class="flex items-center gap-1 md:gap-4 text-primary">
      <a href={langSwitchPath} class="hover:opacity-70 transition-opacity p-2 font-label-caps text-label-caps text-secondary hidden md:block" aria-label={t("nav.lang", lang)}>
        {t("nav.langSwitch", lang)}
      </a>
      <a href={`/${lang}/wishlist`} class="hover:opacity-70 transition-opacity relative p-2" aria-label={t("nav.wishlist", lang)}>
        <span class="material-symbols-outlined" data-icon="favorite">favorite</span>
        <span id="wishlistBadge" class="absolute top-0 right-0 w-4 h-4 bg-monolith-black text-off-white text-[9px] font-bold rounded-full flex items-center justify-center hidden">0</span>
      </a>
      <a href={`/${lang}/carrito`} class="hover:opacity-70 transition-opacity relative p-2" aria-label={t("nav.cart", lang)}>
        <span class="material-symbols-outlined" data-icon="shopping_bag">shopping_bag</span>
        <span id="cartBadge" class="absolute top-0 right-0 w-4 h-4 bg-monolith-black text-off-white text-[9px] font-bold rounded-full flex items-center justify-center hidden">0</span>
      </a>
      <button class="hover:opacity-70 transition-opacity p-2" aria-label={t("nav.profile", lang)}>
        <span class="material-symbols-outlined" data-icon="person">person</span>
      </button>
    </div>
  </div>
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-outline-variant to-transparent opacity-0 transition-opacity duration-300" id="navBorder"></div>
</nav>

<script>
  function updateCartBadge() {
    const badge = document.getElementById("cartBadge");
    if (!badge) return;
    const count = window.VunoCart?.getCount() || 0;
    if (count > 0) {
      badge.textContent = count > 9 ? "9+" : String(count);
      badge.classList.remove("hidden");
    } else {
      badge.classList.add("hidden");
    }
  }

  function updateWishlistBadge() {
    const badge = document.getElementById("wishlistBadge");
    if (!badge) return;
    const count = window.VunoWishlist?.getCount() || 0;
    if (count > 0) {
      badge.textContent = count > 9 ? "9+" : String(count);
      badge.classList.remove("hidden");
    } else {
      badge.classList.add("hidden");
    }
  }

  document.addEventListener("cart:updated", updateCartBadge);
  document.addEventListener("wishlist:updated", updateWishlistBadge);
  document.addEventListener("DOMContentLoaded", function () {
    updateCartBadge();
    updateWishlistBadge();
  });
  setTimeout(function () {
    updateCartBadge();
    updateWishlistBadge();
  }, 100);

  window.addEventListener("scroll", () => {
    const nav = document.getElementById("topNav");
    const border = document.getElementById("navBorder");
    if (!nav || !border) return;
    if (window.scrollY > 50) {
      nav.classList.add("bg-background/95", "shadow-sm", "backdrop-blur-md");
      nav.classList.remove("bg-background/90");
      border.classList.remove("opacity-0");
      border.classList.add("opacity-100");
    } else {
      nav.classList.remove("bg-background/95", "shadow-sm", "backdrop-blur-md");
      nav.classList.add("bg-background/90");
      border.classList.remove("opacity-100");
      border.classList.add("opacity-0");
    }
  });
</script>
