---
import { t, type Locale } from "../../i18n/utils";
import type { LandingSectionData } from "../../lib/storage";
import AnimatedReveal from "../atoms/AnimatedReveal.astro";

interface Props {
  lang: Locale;
  data?: LandingSectionData | null;
}

const { lang, data } = Astro.props;

if (data && data.enabled === false) return;

const title = data?.title_es && data?.title_en
  ? (lang === "es" ? data.title_es : data.title_en)
  : t("home.testimonials.title", lang);
const subtitle = data?.subtitle_es && data?.subtitle_en
  ? (lang === "es" ? data.subtitle_es : data.subtitle_en)
  : t("home.testimonials.subtitle", lang);
---

<section class="py-section-gap px-margin-mobile md:px-margin-desktop bg-background" data-section="testimonials">
  <div class="max-w-container-max mx-auto">
    <AnimatedReveal>
      <div class="text-center mb-12">
        <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-monolith-black leading-tight" data-field="title">
          {title}
        </h2>
        <p class="font-body-lg text-body-lg text-secondary max-w-lg mx-auto mt-3" data-field="subtitle">
          {subtitle}
        </p>
      </div>
    </AnimatedReveal>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter" id="testimonialsGrid">
      {[1, 2, 3].map((_, i) => (
        <div class="animate-pulse reveal" data-reveal-delay={i + 1}>
          <div class="border border-outline-variant p-6 md:p-8 h-full flex flex-col">
            <div class="flex items-center gap-1 mb-6">
              {[1, 2, 3, 4, 5].map(() => (
                <div class="w-4 h-4 bg-surface-container rounded"></div>
              ))}
            </div>
            <div class="h-4 bg-surface-container w-full rounded mb-2"></div>
            <div class="h-4 bg-surface-container w-3/4 rounded mb-2"></div>
            <div class="h-4 bg-surface-container w-1/2 rounded mt-auto"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script src="/js/testimonials.js" is:inline></script>
<script is:inline>
  (function () {
    var lang = document.documentElement.lang || "es";
    Testimonials.init(lang);
  })();
</script>
