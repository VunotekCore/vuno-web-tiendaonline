---
import type { Locale } from "../../i18n/utils";
import { t } from "../../i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = "es" } = Astro.props;
---

<footer class="bg-surface-container w-full mt-section-gap border-t border-outline-variant">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-mobile md:px-margin-desktop py-section-gap w-full max-w-container-max mx-auto text-secondary font-body-md text-body-md">
    <div class="md:col-span-1 flex flex-col mb-8 md:mb-0">
      <span class="font-headline-md text-headline-md text-monolith-black mb-6">Ram;Lop</span>
      <p class="text-sm max-w-xs">{t("footer.tagline", lang)}</p>
    </div>

    <div class="md:col-span-2 grid grid-cols-2 gap-8">
      <div class="flex flex-col space-y-4">
        <a href={`/${lang}/#`} class="hover:text-monolith-black transition-colors">{t("footer.sustainability", lang)}</a>
        <a href={`/${lang}/#`} class="hover:text-monolith-black transition-colors">{t("footer.shipping", lang)}</a>
        <a href={`/${lang}/#`} class="hover:text-monolith-black transition-colors">{t("footer.boutique", lang)}</a>
      </div>
      <div class="flex flex-col space-y-4">
        <a href={`/${lang}/#`} class="hover:text-monolith-black transition-colors">{t("footer.contact", lang)}</a>
        <a href={`/${lang}/#`} class="hover:text-monolith-black transition-colors">{t("footer.sizeGuide", lang)}</a>
        <a href={`/${lang}/#`} class="hover:text-monolith-black transition-colors">{t("footer.privacy", lang)}</a>
      </div>
    </div>

    <div class="md:col-span-1 flex flex-col mt-8 md:mt-0">
      <span class="font-label-caps text-label-caps text-monolith-black mb-4 uppercase">{t("footer.newsletter", lang)}</span>
      <div class="relative w-full border-b border-monolith-black mb-4">
        <input type="email" placeholder={t("footer.emailPlaceholder", lang)} class="w-full bg-transparent focus:ring-0 px-0 py-2 text-monolith-black placeholder:text-secondary focus:outline-none" />
        <button class="absolute right-0 top-1/2 -translate-y-1/2 text-monolith-black hover:opacity-70 transition-opacity" aria-label={t("footer.subscribe", lang)}>
          <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
        </button>
      </div>
    </div>

    <div class="md:col-span-4 mt-16 pt-8 border-t border-outline-variant/30 text-xs">
      &copy; 2024 Ram;Lop. {t("footer.copyright", lang)}
    </div>
  </div>
</footer>
