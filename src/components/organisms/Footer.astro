---
import type { Locale } from "../../i18n/utils";
import { t } from "../../i18n/utils";
import NewsletterSection from "./NewsletterSection.astro";

interface Props {
  lang?: Locale;
}

const { lang = "es" } = Astro.props;
---

<footer class="relative bg-monolith-black w-full mt-section-gap overflow-hidden">
  <div class="noise-overlay opacity-[0.08]"></div>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-mobile md:px-margin-desktop py-section-gap w-full max-w-container-max mx-auto text-off-white/70 font-body-md text-body-md relative z-10">
    <div class="md:col-span-1 flex flex-col mb-8 md:mb-0">
      <span class="font-headline-md text-headline-md text-off-white mb-2">
        <img data-store-logo alt="" class="h-10 w-auto hidden object-contain brightness-0 invert mb-2" />
        <span data-store-name>Ram;Lop</span>
      </span>
      <span data-store-slogan class="font-body-md text-body-md text-off-white/60 block mb-3"></span>
      <p class="text-sm max-w-xs text-off-white/60">{t("footer.tagline", lang)}</p>
    </div>

    <div class="md:col-span-2 grid grid-cols-2 gap-8">
      <div class="flex flex-col space-y-4">
        <a href={`/${lang}/#`} class="hover:text-off-white transition-colors text-off-white/60 hover:translate-x-1 inline-block transition-all duration-300">{t("footer.sustainability", lang)}</a>
        <a href={`/${lang}/#`} class="hover:text-off-white transition-colors text-off-white/60 hover:translate-x-1 inline-block transition-all duration-300">{t("footer.shipping", lang)}</a>
        <a href={`/${lang}/#`} class="hover:text-off-white transition-colors text-off-white/60 hover:translate-x-1 inline-block transition-all duration-300">{t("footer.boutique", lang)}</a>
      </div>
      <div class="flex flex-col space-y-4">
        <a href={`/${lang}/#`} class="hover:text-off-white transition-colors text-off-white/60 hover:translate-x-1 inline-block transition-all duration-300">{t("footer.contact", lang)}</a>
        <a href="javascript:void(0)" data-size-guide class="hover:text-off-white transition-colors text-off-white/60 hover:translate-x-1 inline-block transition-all duration-300">{t("footer.sizeGuide", lang)}</a>
        <a href={`/${lang}/#`} class="hover:text-off-white transition-colors text-off-white/60 hover:translate-x-1 inline-block transition-all duration-300">{t("footer.privacy", lang)}</a>
      </div>
    </div>

    <div class="md:col-span-1 flex flex-col mt-8 md:mt-0">
      <NewsletterSection lang={lang} variant="full" theme="dark" />
    </div>

    <div class="md:col-span-4 mt-16 pt-8 border-t border-off-white/10 text-xs text-off-white/40">
      &copy; 2024 <span data-store-name>Ram;Lop</span>. {t("footer.copyright", lang)}
    </div>
  </div>
</footer>
