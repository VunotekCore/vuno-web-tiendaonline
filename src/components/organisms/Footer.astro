---
import type { Locale } from "../../i18n/utils";
import { t } from "../../i18n/utils";
import NewsletterSection from "./NewsletterSection.astro";
import VunotekLogoMarca from "../atoms/VunotekLogoMarca.astro";

interface Props {
  lang?: Locale;
}

const { lang = "es" } = Astro.props;
---

<footer class="bg-monolith-black w-full mt-16 overflow-hidden">
  <div class="noise-overlay opacity-[0.08]"></div>
  <div class="max-w-6xl mx-auto px-6 py-16 relative z-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Col 1: Brand -->
      <div class="flex flex-col items-center md:items-start">
        <img data-store-logo alt="" class="h-8 w-auto hidden object-contain brightness-0 invert mb-2" />
        <span data-store-name class="font-headline-md text-headline-md text-off-white mb-1"></span>
        <span data-store-slogan class="font-body text-sm text-off-white/60 block mb-2 text-center md:text-left"></span>
        <p data-store-description class="text-sm text-off-white/40 leading-relaxed max-w-xs text-center md:text-left"></p>
      </div>

      <!-- Col 2: Shop -->
      <div>
        <h4 class="font-label-caps text-label-caps text-off-white/40 mb-4 tracking-widest">{t("footer.shop", lang)}</h4>
        <div class="flex flex-col space-y-2.5">
          <a href={`/${lang}/catalogo`} class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">{t("footer.catalog", lang)}</a>
          <a href={`/${lang}/catalogo`} class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">Heels</a>
          <a href={`/${lang}/catalogo`} class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">Sandals</a>
          <a href={`/${lang}/catalogo`} class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">Boots</a>
          <a href={`/${lang}/catalogo`} class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">Flats</a>
        </div>
      </div>

      <!-- Col 3: Help -->
      <div>
        <h4 class="font-label-caps text-label-caps text-off-white/40 mb-4 tracking-widest">{t("footer.help", lang)}</h4>
        <div class="flex flex-col space-y-2.5">
          <a href="javascript:void(0)" data-contact class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">{t("footer.contact", lang)}</a>
          <a href="javascript:void(0)" data-size-guide class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">{t("footer.sizeGuide", lang)}</a>
          <a href="javascript:void(0)" data-shipping class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">{t("footer.shipping", lang)}</a>
          <a href="javascript:void(0)" data-returns class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">{t("footer.returns", lang)}</a>
          <a href="javascript:void(0)" data-privacy class="text-sm text-off-white/60 hover:text-off-white transition-colors duration-300">{t("footer.privacy", lang)}</a>
        </div>
      </div>

      <!-- Col 4: Connect (Newsletter + Social) -->
      <div>
        <h4 class="font-label-caps text-label-caps text-off-white/40 mb-4 tracking-widest">{t("footer.connect", lang)}</h4>
        <NewsletterSection lang={lang} variant="compact" theme="dark" />
        <div id="footerSocial" class="flex items-center gap-4 mt-5">
          <a href="#" target="_blank" rel="noopener noreferrer" class="text-off-white/30 hover:text-off-white transition-colors duration-300" data-social="instagram" aria-label="Instagram">
            <span class="material-symbols-outlined text-lg">camera_alt</span>
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" class="text-off-white/30 hover:text-off-white transition-colors duration-300" data-social="facebook" aria-label="Facebook">
            <span class="material-symbols-outlined text-lg">globe</span>
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" class="text-off-white/30 hover:text-off-white transition-colors duration-300" data-social="tiktok" aria-label="TikTok">
            <span class="material-symbols-outlined text-lg">music_note</span>
          </a>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="md:col-span-4 mt-12 pt-6 border-t border-off-white/10 text-center text-xs text-off-white/40">
        <p class="flex items-center justify-center gap-2">
          &copy; <span id="footer-year"></span>
          <VunotekLogoMarca height={20} text="VUNO-ECOMERCE" accentColor="#00ABFF" />
          <span class="text-off-white/50">ENGINEERING PRECISION FOR MODERN BUSINESS</span>
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  // @ts-nocheck
  (function () {
    document.getElementById("footer-year").textContent = new Date().getFullYear();
    fetch("/api/configuracion/public.php")
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var social = data.landing && data.landing.social;
        if (social) {
          document.querySelectorAll("[data-social]").forEach(function (el) {
            var platform = el.getAttribute("data-social");
            var url = social[platform + "_url"];
            if (url) el.href = url;
          });
        }
        var store = data.store;
        if (store) {
          document.querySelectorAll("[data-store-name]").forEach(function (el) {
            el.textContent = store.name || '';
          });
          var sloganEl = document.querySelector("[data-store-slogan]");
          if (sloganEl) sloganEl.textContent = store.slogan || '';
          var descEl = document.querySelector("[data-store-description]");
          if (descEl) descEl.textContent = store.description || '';
          var logoEl = document.querySelector("[data-store-logo]");
          if (logoEl && store.logo) {
            logoEl.src = store.logo;
            logoEl.classList.remove('hidden');
          }
        }
      })
      .catch(function () {});
  })();
</script>
