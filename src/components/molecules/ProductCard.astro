---
interface Props {
  name: string;
  price: string;
  image: string;
  href: string;
  colors?: string[];
}

const { name, price, image, href, colors = [] } = Astro.props;
---

<a href={href} class="group flex flex-col cursor-pointer">
  <div class="relative bg-surface-container-lowest aspect-[4/5] overflow-hidden mb-4 flex items-center justify-center">
    <img
      src={image}
      alt={name}
      class="w-4/5 h-auto object-contain transition-transform duration-500 group-hover:scale-110"
      loading="lazy"
    />
  </div>
  <h3 class="font-body-md text-body-md text-monolith-black mb-1">{name}</h3>
  <p class="font-price-display text-price-display text-secondary">{price}</p>
  {
    colors.length > 0 && (
      <div class="flex gap-2 mt-3">
        {colors.map((color) => (
          <span
            class="w-3 h-3 rounded-full border border-surface-variant"
            style={`background-color: ${color}`}
          ></span>
        ))}
      </div>
    )
  }
</a>
