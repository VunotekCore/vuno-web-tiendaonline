---
export interface Props {
  title?: string;
  text_principal?: string;
  subtitle?: string;
}

const {
  title = "Capacidades Técnicas",
  text_principal = "Convertimos Operaciones Empresariales en ecosistemas digitales automatizaos.",
  subtitle = "Core_Expertise",
} = Astro.props;

const services = [
  {
    icon: "code_blocks",
    title: "Desarrollo de Software",
    description:
      "Aplicaciones empresariales personalizadas, web y desktop. Dominio total de .NET, Node.js, Angular, Vue y más.",
    link: "/servicios#desarrollo-software",
  },
  {
    icon: "cloud_sync",
    title: "Soluciones Salesforce",
    description:
      "Implementación y desarrollo avanzado en Salesforce (Apex, LWC, Flows). Automatización de procesos comerciales y contables.",
    link: "/servicios#soluciones-salesforce",
  },
  {
    icon: "smartphone",
    title: "Apps Móviles",
    description:
      "Desarrollo multiplataforma nativo (Android/iOS) con Flutter. Experiencias de usuario fluidas y modernas.",
    link: "/servicios#apps-moviles",
  },
  {
    icon: "dns",
    title: "Infraestructura & Cloud",
    description:
      "Administración de servidores Linux, redes, VPN y seguridad. Despliegue CI/CD y entornos de alta disponibilidad.",
    link: "/servicios#infraestructura-cloud",
  },
  {
    icon: "lightbulb",
    title: "Consultoría IT",
    description:
      "Asesoría estratégica para la transformación digital. Optimización de sistemas legacy y arquitectura de software.",
    link: "/servicios#consultoria-it",
  },
  {
    icon: "store",
    title: "Productos SaaS",
    description:
      "Desarrollo de plataformas propias como ERPs financieros, CRMs adaptables y sistemas de automatización de flujos.",
    link: "/servicios#productos-saas",
  },
];
---

<section class="w-full max-w-7xl px-6 py-24 md:px-12">
  <div
    class="mb-16 flex flex-col items-center justify-between gap-6 md:flex-row md:items-end"
  >
    <div class="max-w-xl">
      <div
        class="mb-4 font-mono text-xs uppercase tracking-[0.4em] text-primary"
      >
        {title}
      </div>
      <h2 class="text-3xl font-bold text-white md:text-4xl">
        {text_principal}
      </h2>
    </div>
    <p class="text-white/50 md:text-right">{subtitle}</p>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service) => (
        <div class="glass-card group flex flex-col gap-6 p-8 transition-all hover:border-primary/40 hover:bg-primary/5">
          <div class="flex size-14 items-center justify-center rounded-lg bg-primary/10 text-primary transition-transform group-hover:scale-110">
            <span class="material-symbols-outlined text-3xl">
              {service.icon}
            </span>
          </div>
          <div>
            <h3 class="mb-2 text-xl font-bold text-white">{service.title}</h3>
            <p class="text-sm leading-relaxed text-white/60">
              {service.description}
            </p>
          </div>
          <div class="mt-auto flex items-center gap-2 font-mono text-[10px] text-primary">
            <a
              href="/servicios"
              class="flex items-center gap-2 hover:text-primary/80"
            >
              <span>LEARN_MORE</span>
              <span class="material-symbols-outlined text-xs">
                arrow_forward
              </span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
