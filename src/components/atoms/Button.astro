---
interface Props {
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
  href?: string;
  id?: string;
  disabled?: boolean;
}

const { variant = "primary", class: className = "", href, id, disabled } = Astro.props;
const Tag = href ? "a" : "button";
const baseStyles = "inline-flex items-center justify-center font-label-caps text-label-caps min-h-[56px] transition-all duration-300 magnetic-btn";

const variantStyles = {
  primary: "bg-monolith-black text-off-white hover:bg-on-surface hover:tracking-[0.15em]",
  secondary: "border border-monolith-black text-monolith-black hover:bg-monolith-black hover:text-off-white hover:tracking-[0.15em]",
  ghost: "bg-transparent text-monolith-black hover:opacity-70",
};
---

<Tag
  href={href}
  id={id}
  disabled={disabled}
  class:list={[baseStyles, variantStyles[variant], className]}
>
  <slot />
</Tag>
