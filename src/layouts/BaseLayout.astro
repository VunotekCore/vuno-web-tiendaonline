---
import "../styles/global.css";
import type { Locale } from "../i18n/utils";
import { t } from "../i18n/utils";
import Modal from "../components/molecules/Modal.astro";
import ProfileEditModal from "../components/organisms/ProfileEditModal.astro";
import OrderDetailModal from "../components/organisms/OrderDetailModal.astro";
import SEOMeta from "../components/seo/SEOMeta.astro";
import JSONLDOrganization from "../components/seo/JSONLDOrganization.astro";
import { tenant } from "../config/tenant";

interface SEOData {
  ogImage?: string;
  ogType?: "website" | "product" | "article";
  noindex?: boolean;
  canonical?: string;
}

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  seo?: SEOData;
  hideWhatsapp?: boolean;
}

const { title, description, lang = "es", alternateUrls = {}, seo = {}, hideWhatsapp = false } = Astro.props;
const apiBase = import.meta.env.DEV ? "http://localhost:8000" : "";
const siteUrl = import.meta.env.PROD ? tenant.brand.url : "http://localhost:4321";
---

<!doctype html>
<html lang={lang} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="api-base" content={apiBase} />
    <SEOMeta
      title={`${title} | ${tenant.brand.name}`}
      description={description || tenant.seo.defaultDescription}
      ogImage={seo.ogImage || tenant.seo.ogDefaultImage}
      ogType={seo.ogType}
      noindex={seo.noindex}
      canonical={seo.canonical}
      lang={lang}
      locale={lang === "en" ? "en_US" : "es_NI"}
      siteName={tenant.brand.name}
      twitterSite={tenant.seo.twitterSite}
      googleSiteVerification={tenant.seo.googleSiteVerification}
      themeColor={tenant.seo.themeColor}
    />
    <JSONLDOrganization
      siteName={tenant.brand.name}
      siteUrl={siteUrl}
      logo={tenant.brand.logo}
      socialUrls={tenant.social.urls}
    />
    {Object.entries(alternateUrls).map(([locale, url]) => (
      <link rel="alternate" hreflang={locale} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/es/`} />
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="dns-prefetch" href="https://ik.imagekit.io" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script src="/js/cart.js" is:inline></script>
    <script src="/js/wishlist.js" is:inline></script>
    <script src="/js/auth.js" is:inline></script>
    <script src="/js/api.js" is:inline></script>
  </head>
  <body class="bg-background text-on-surface font-body-md antialiased selection:bg-monolith-black selection:text-off-white min-h-screen flex flex-col">
    <slot />
    <Modal />

    <!-- Contact Form Modal -->
    <div id="contactModal" class="hidden fixed inset-0 z-[90] flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
      <div class="bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-lg max-h-[90dvh] overflow-y-auto">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-headline text-headline-md text-monolith-black" data-i18n="contact.title">{t("contact.title", lang)}</h3>
          <button type="button" id="contactModalClose" class="text-secondary hover:text-monolith-black transition-colors p-1 -mr-1" aria-label="Close">
            <span class="material-symbols-outlined text-xl">close</span>
          </button>
        </div>
        <form id="contactForm" novalidate>
          <div class="space-y-4">
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-2" data-i18n="contact.name">{t("contact.name", lang)}</label>
              <input type="text" id="contact-name" required autocomplete="name" maxlength="200" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-2" data-i18n="contact.email">{t("contact.email", lang)}</label>
              <input type="email" id="contact-email" required autocomplete="email" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-2" data-i18n="contact.phone">{t("contact.phone", lang)}</label>
              <input type="tel" id="contact-phone" autocomplete="tel" maxlength="50" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-2" data-i18n="contact.subject">{t("contact.subject", lang)}</label>
              <select id="contact-subject" required class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none">
                <option value="" data-i18n="contact.subjectDefault">{t("contact.subjectDefault", lang)}</option>
                <option value="general" data-i18n="contact.subjectGeneral">{t("contact.subjectGeneral", lang)}</option>
                <option value="order" data-i18n="contact.subjectOrder">{t("contact.subjectOrder", lang)}</option>
                <option value="product" data-i18n="contact.subjectProduct">{t("contact.subjectProduct", lang)}</option>
                <option value="size" data-i18n="contact.subjectSize">{t("contact.subjectSize", lang)}</option>
                <option value="returns" data-i18n="contact.subjectReturns">{t("contact.subjectReturns", lang)}</option>
                <option value="custom" data-i18n="contact.subjectCustom">{t("contact.subjectCustom", lang)}</option>
                <option value="other" data-i18n="contact.subjectOther">{t("contact.subjectOther", lang)}</option>
              </select>
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-2" data-i18n="contact.message">{t("contact.message", lang)}</label>
              <textarea id="contact-message" required minlength="10" maxlength="5000" class="w-full bg-transparent border border-outline p-3 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-28"></textarea>
            </div>
            <!-- Honeypot -->
            <div class="hidden" aria-hidden="true">
              <input type="text" id="contact-website" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Hidden i18n references for JS -->
            <span class="hidden" data-i18n="contact.sending">{t("contact.sending", lang)}</span>
            <span class="hidden" data-i18n="contact.errorRequired">{t("contact.errorRequired", lang)}</span>
            <span class="hidden" data-i18n="contact.errorEmail">{t("contact.errorEmail", lang)}</span>
            <span class="hidden" data-i18n="contact.errorMessage">{t("contact.errorMessage", lang)}</span>
          </div>
          <p id="contactError" class="hidden font-body text-body-md text-sm text-error mt-4"></p>
          <button type="submit" id="contactSubmitBtn" class="mt-6 w-full font-label-caps text-label-caps bg-monolith-black text-off-white rounded-md px-6 h-11 hover:bg-monolith-black/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed" data-i18n="contact.send">{t("contact.send", lang)}</button>
        </form>
        <div id="contactSuccess" class="hidden text-center py-8">
          <span class="material-symbols-outlined text-4xl text-clay-accent mb-3 block">check_circle</span>
          <p class="font-body text-body-md text-monolith-black" data-i18n="contact.success">{t("contact.success", lang)}</p>
          <button type="button" id="contactSuccessClose" class="mt-6 font-label-caps text-label-caps bg-monolith-black text-off-white rounded-md px-6 h-11 hover:bg-monolith-black/90 transition-all" data-i18n="contact.close">{t("contact.close", lang)}</button>
        </div>
      </div>
    </div>
    <ProfileEditModal lang={lang} />
    <OrderDetailModal lang={lang} />

    {!hideWhatsapp && (
    <>
    <!-- WhatsApp Floating Button + Popover -->
    <button
      id="whatsapp-btn"
      type="button"
      aria-label="Chatea con nosotros por WhatsApp"
      class="hidden fixed bottom-6 right-6 z-[80] w-14 h-14 bg-[#25D366] hover:bg-[#20BD5A] rounded-full shadow-lg hover:shadow-xl flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#25D366] cursor-pointer"
    >
      <svg viewBox="0 0 24 24" class="w-7 h-7 fill-white pointer-events-none" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </button>

    <!-- WhatsApp Popover -->
    <div id="wa-popover" class="hidden fixed bottom-24 right-6 z-[80] w-72 bg-off-white border border-outline-variant shadow-xl rounded-sm" role="dialog" aria-label="Chat de WhatsApp">
      <div class="flex items-center justify-between px-4 py-3 border-b border-outline-variant">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-lg text-[#25D366]">chat</span>
          <span class="font-label-caps text-label-caps text-monolith-black tracking-wider">WhatsApp</span>
        </div>
        <button type="button" id="wa-popover-close" class="text-secondary hover:text-monolith-black transition-colors p-0.5" aria-label="Cerrar">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      <div class="p-4">
        <p class="font-body text-body-md text-sm text-secondary mb-3">Escribí tu mensaje y te responderemos a la brevedad:</p>
        <textarea id="wa-message" rows="4" maxlength="500" class="w-full border border-outline-variant p-3 text-monolith-black text-sm resize-none focus:border-clay-accent focus:outline-none rounded-sm" placeholder="Escribí tu mensaje..."></textarea>
      </div>
      <div class="px-4 pb-4">
        <button type="button" id="wa-send" class="w-full font-label-caps text-label-caps bg-[#25D366] text-white rounded-sm h-10 hover:bg-[#20BD5A] transition-all flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">send</span>
          Enviar por WhatsApp
        </button>
      </div>
    </div>
    </>
    )}

    <script is:inline>
      window.formatPrice = function (value) {
        if (value == null || isNaN(value)) value = 0;
        return Number(value).toLocaleString('es-NI', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      };

      // Size guide modal (delegated)
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-size-guide]')
        if (!btn) return
        e.preventDefault()
        var lang = document.documentElement.lang || 'es'

        function buildTable(data) {
          if (!data || !data.rows || !data.rows.length) return null
          var title = lang === 'es' ? data.title_es : data.title_en
          var footer = lang === 'es' ? data.footer_es : data.footer_en
          if (!title) title = data.title_es || 'Size Guide'
          var html = '<h3 class="font-headline text-headline-md mb-4">' + title + '</h3>'
          html += '<table class="w-full text-left border-collapse"><thead><tr class="border-b border-outline-variant">'
          html += '<th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">US</th>'
          html += '<th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">EU</th>'
          html += '<th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">UK</th>'
          html += '<th class="font-label-caps text-label-caps text-secondary pb-2">CM</th>'
          html += '</tr></thead><tbody>'
          for (var i = 0; i < data.rows.length; i++) {
            var r = data.rows[i]
            var cls = i < data.rows.length - 1 ? ' class="border-b border-outline-variant/50"' : ''
            html += '<tr' + cls + '>'
            html += '<td class="py-2 pr-4 font-medium">' + r.us + '</td>'
            html += '<td class="py-2 pr-4 text-secondary">' + r.eu + '</td>'
            html += '<td class="py-2 pr-4 text-secondary">' + r.uk + '</td>'
            html += '<td class="py-2 text-secondary">' + r.cm + '</td></tr>'
          }
          html += '</tbody></table>'
          if (footer) {
            html += '<p class="font-body text-body-md text-secondary mt-4 text-sm">' + footer + '</p>'
          }
          return html
        }

        fetch('/api/size-guide/public.php')
          .then(function (r) { return r.ok ? r.json() : null })
          .then(function (data) {
            var html = buildTable(data)
            if (html && window.VunoModal && window.VunoModal.show) {
              window.VunoModal.show({
                type: 'info',
                title: lang === 'es' ? 'Guía de Talles' : 'Size Guide',
                body: html
              })
            }
          })
          .catch(function () {})
      })

      // Policies modals (shipping, returns, privacy) — delegated
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-shipping], [data-returns], [data-privacy]')
        if (!btn) return
        e.preventDefault()
        var lang = document.documentElement.lang || 'es'
        var attr = ''
        if (btn.hasAttribute('data-shipping')) attr = 'shipping'
        else if (btn.hasAttribute('data-returns')) attr = 'returns'
        else attr = 'privacy'

        var titles = {
          shipping: { es: 'Envíos', en: 'Shipping' },
          returns: { es: 'Devoluciones', en: 'Returns' },
          privacy: { es: 'Política de Privacidad', en: 'Privacy Policy' }
        }

        fetch('/api/configuracion/public.php')
          .then(function (r) { return r.ok ? r.json() : null })
          .then(function (config) {
            if (!config || !config.policies) return
            var text = config.policies[attr + '_' + lang]
            if (!text) text = config.policies[attr + '_es'] || ''
            if (!text) return
            var title = titles[attr][lang] || titles[attr]['es']
            var html = '<div class="prose prose-sm max-w-none"><p class="font-body text-body-md text-secondary leading-relaxed whitespace-pre-line">' + text + '</p></div>'
            if (window.VunoModal && window.VunoModal.show) {
              window.VunoModal.show({ type: 'info', title: title, body: html })
            }
          })
          .catch(function () {})
      })

      // Contact form modal — delegated
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-contact]')
        if (!btn) return
        e.preventDefault()
        var modal = document.getElementById('contactModal')
        var form = document.getElementById('contactForm')
        var success = document.getElementById('contactSuccess')
        var error = document.getElementById('contactError')
        if (modal && form) {
          form.reset()
          modal.classList.remove('hidden')
          form.classList.remove('hidden')
          success.classList.add('hidden')
          error.classList.add('hidden')
          document.getElementById('contact-name').focus()
        }
      })

      // Close contact modal
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('#contactModalClose, #contactSuccessClose')
        if (!btn) return
        var modal = document.getElementById('contactModal')
        if (modal) modal.classList.add('hidden')
      })

      // Close on backdrop click
      document.addEventListener('click', function (e) {
        var modal = document.getElementById('contactModal')
        if (!modal || modal.classList.contains('hidden')) return
        if (e.target === modal) modal.classList.add('hidden')
      })

      // Contact form submission
      var contactForm = document.getElementById('contactForm');
      if (contactForm) {
        contactForm.addEventListener('submit', function (e) {
          e.preventDefault()
          var btn = document.getElementById('contactSubmitBtn')
          var error = document.getElementById('contactError')
          var success = document.getElementById('contactSuccess')
          error.classList.add('hidden')

          var name = document.getElementById('contact-name').value.trim()
          var email = document.getElementById('contact-email').value.trim()
          var phone = document.getElementById('contact-phone').value.trim()
          var subject = document.getElementById('contact-subject').value
          var message = document.getElementById('contact-message').value.trim()
          var website = document.getElementById('contact-website').value

          // Validation
          if (!name || !email || !subject || !message) {
            error.textContent = document.querySelector('[data-i18n="contact.errorRequired"]')?.textContent
            error.classList.remove('hidden')
            return
          }
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            error.textContent = document.querySelector('[data-i18n="contact.errorEmail"]')?.textContent
            error.classList.remove('hidden')
            return
          }

          btn.disabled = true
          btn.textContent = document.querySelector('[data-i18n="contact.sending"]')?.textContent

          fetch('/api/contact/send.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, email: email, phone: phone, subject: subject, message: message, website: website })
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d } }) })
            .then(function (res) {
              if (res.ok && res.data.success) {
                contactForm.classList.add('hidden')
                success.classList.remove('hidden')
              } else {
                throw new Error('api_error')
              }
            })
            .catch(function () {
              error.textContent = document.querySelector('[data-i18n="contact.errorMessage"]')?.textContent
              error.classList.remove('hidden')
            })
            .finally(function () {
              btn.disabled = false
              btn.textContent = document.querySelector('[data-i18n="contact.send"]')?.textContent
            })
        })
      }

      // WhatsApp floating button + popover
      (function () {
        var btn = document.getElementById('whatsapp-btn')
        var popover = document.getElementById('wa-popover')
        var closeBtn = document.getElementById('wa-popover-close')
        var sendBtn = document.getElementById('wa-send')
        var textarea = document.getElementById('wa-message')
        if (!btn || !popover) return

        var waNumber = ''
        var openedByBtn = false

        function openPopover() {
          popover.classList.remove('hidden')
          openedByBtn = true
          setTimeout(function () { textarea.focus() }, 100)
        }

        function closePopover() {
          popover.classList.add('hidden')
          openedByBtn = false
        }

        function sendMessage() {
          if (!waNumber) return
          var msg = textarea.value.trim()
          var url = 'https://wa.me/' + encodeURIComponent(waNumber)
          if (msg) url += '?text=' + encodeURIComponent(msg)
          window.open(url, '_blank')
          closePopover()
        }

        btn.addEventListener('click', function (e) {
          e.preventDefault()
          if (popover.classList.contains('hidden')) {
            openPopover()
          } else {
            closePopover()
          }
        })

        closeBtn.addEventListener('click', closePopover)
        sendBtn.addEventListener('click', sendMessage)

        // Enter en textarea envía
        textarea.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault()
            sendMessage()
          }
        })

        // Click fuera cierra
        document.addEventListener('click', function (e) {
          if (!openedByBtn) return
          var target = e.target
          if (btn.contains(target) || popover.contains(target)) return
          closePopover()
        })

        // Fetch config
        fetch('/api/configuracion/public.php')
          .then(function (r) { return r.json() })
          .then(function (data) {
            var wa = data.whatsapp || {}
            if (wa.enabled && wa.number) {
              waNumber = wa.number
              if (wa.message) textarea.value = wa.message
              btn.classList.remove('hidden')
            }
          })
          .catch(function () {})
      })()
    </script>
  </body>
</html>
