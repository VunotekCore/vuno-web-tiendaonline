---
interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const { title, currentPage = "home" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-white selection:bg-primary/30 overflow-x-hidden"
  >
    <!-- Background Elements -->
    <div class="fixed inset-0 z-0">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,_#102323_0%,_#0a1212_100%)]"
      >
      </div>
      <div
        class="absolute inset-0 opacity-20"
        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBKYIuoPbSL6nPal1EJVlYJfYzpFG5Gd8QwJFM6KTLffjTCcBiUUdG0w8XVsIRZ67pA3tKsvDN8_Z7HCDdsy63U8yY1dOyiqRsuS-KtgSxyPBPWojks-l1bNH6Oy3V3Xyq5lfPaIKzikm1h258aRPAgJGI49-zuOHh-kRZtyCDguOTnI0Y1hQL76djMikMAQwcB_rKol-614C3LlBUNCFyNOX7nwW7HpYzVIRzH9blycgRE4X_YXafuWGp4oaMOdZQH85Yv9n_VtUI");'
      >
      </div>
    </div>

    <div class="relative flex min-h-screen w-full flex-col">
      <slot />
    </div>

    <style>
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px; /* Account for fixed header */
      }

      .glass-morphism {
        background: rgba(16, 35, 35, 0.4) !important;
        backdrop-filter: blur(12px) !important;
        border: 1px solid rgba(33, 74, 74, 0.5) !important;
      }

      .hero-glow {
        background: radial-gradient(
          circle at 50% 50%,
          rgba(6, 249, 249, 0.1) 0%,
          transparent 70%
        );
      }

      .scanline {
        width: 100%;
        height: 100px;
        z-index: 5;
        background: linear-gradient(
          0deg,
          rgba(6, 249, 249, 0) 0%,
          rgba(6, 249, 249, 0.05) 50%,
          rgba(6, 249, 249, 0) 100%
        );
        opacity: 0.1;
        position: absolute;
        pointer-events: none;
      }
    </style>
  </body>
</html>
