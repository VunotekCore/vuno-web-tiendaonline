---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IconMail, IconPhone, IconMapPin, IconBrandLinkedin, IconBrandGithub, IconSend, IconTerminal } from '@tabler/icons-react';
---

<Layout title="Contacto | SYS_ENG" currentPage="contacto">
  <Header currentPage="contacto" />
  
  <main class="relative z-10 flex flex-1 flex-col items-center pt-24">
    <!-- Hero Section -->
    <div class="text-center mb-16 px-6">
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-white uppercase">
        Contacto <span class="text-primary">Terminal</span>
      </h1>
      <p class="text-white/60 max-w-2xl mx-auto mt-4 text-lg">
        Initiate communication with our engineering team. We're ready to transform your technical challenges into solutions.
      </p>
    </div>

    <div class="w-full max-w-6xl px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div class="glass-morphism rounded-xl p-8">
          <div class="flex items-center gap-3 mb-6">
            <IconTerminal className="text-primary text-2xl" />
            <h2 class="text-2xl font-bold text-white">Command Interface</h2>
          </div>
          
          <form class="space-y-6">
            <div>
              <label class="block text-white/80 text-sm font-mono mb-2">client_name@sys-eng:~$</label>
              <input 
                type="text" 
                placeholder="Enter your full name"
                class="w-full px-4 py-3 bg-background-dark/50 border border-primary/30 rounded-lg text-white placeholder-white/40 focus:outline-none focus:border-primary focus:bg-primary/5 transition-all font-mono"
                required
              />
            </div>
            
            <div>
              <label class="block text-white/80 text-sm font-mono mb-2">email@sys-eng:~$</label>
              <input 
                type="email" 
                placeholder="your.email@company.com"
                class="w-full px-4 py-3 bg-background-dark/50 border border-primary/30 rounded-lg text-white placeholder-white/40 focus:outline-none focus:border-primary focus:bg-primary/5 transition-all font-mono"
                required
              />
            </div>
            
            <div>
              <label class="block text-white/80 text-sm font-mono mb-2">company@sys-eng:~$</label>
              <input 
                type="text" 
                placeholder="Company name"
                class="w-full px-4 py-3 bg-background-dark/50 border border-primary/30 rounded-lg text-white placeholder-white/40 focus:outline-none focus:border-primary focus:bg-primary/5 transition-all font-mono"
              />
            </div>
            
            <div>
              <label class="block text-white/80 text-sm font-mono mb-2">service_type@sys-eng:~$</label>
              <select class="w-full px-4 py-3 bg-background-dark/50 border border-primary/30 rounded-lg text-white focus:outline-none focus:border-primary focus:bg-primary/5 transition-all font-mono">
                <option value="">Select service type</option>
                <option value="salesforce">Salesforce Development</option>
                <option value="backend">Backend Architecture</option>
                <option value="frontend">Frontend Engineering</option>
                <option value="infrastructure">Infrastructure & DevOps</option>
                <option value="consulting">Technical Consulting</option>
                <option value="other">Other</option>
              </select>
            </div>
            
            <div>
              <label class="block text-white/80 text-sm font-mono mb-2">message@sys-eng:~$</label>
              <textarea 
                rows="6" 
                placeholder="Describe your project requirements..."
                class="w-full px-4 py-3 bg-background-dark/50 border border-primary/30 rounded-lg text-white placeholder-white/40 focus:outline-none focus:border-primary focus:bg-primary/5 transition-all font-mono resize-none"
                required
              ></textarea>
            </div>
            
            <button type="submit" class="w-full flex items-center justify-center gap-2 bg-primary text-background-dark px-6 py-3 rounded-lg font-bold hover:bg-primary/80 transition-all hover:scale-105 font-mono">
              <IconSend className="size-5" />
              EXECUTE_TRANSMISSION
            </button>
          </form>
        </div>

        <!-- Contact Information -->
        <div class="space-y-8">
          <!-- Direct Contact -->
          <div class="glass-morphism rounded-xl p-8">
            <h3 class="text-2xl font-bold text-white mb-6">Direct Channels</h3>
            
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div class="size-12 rounded-lg bg-primary/10 flex items-center justify-center">
                  <IconMail className="text-primary text-xl" />
                </div>
                <div>
                  <p class="text-white/80 font-mono text-sm">Primary</p>
                  <p class="text-white">contact@sys-eng.com</p>
                </div>
              </div>
              
              <div class="flex items-center gap-4">
                <div class="size-12 rounded-lg bg-primary/10 flex items-center justify-center">
                  <IconPhone className="text-primary text-xl" />
                </div>
                <div>
                  <p class="text-white/80 font-mono text-sm">Global HQ</p>
                  <p class="text-white">+1 (555) 123-4567</p>
                </div>
              </div>
              
              <div class="flex items-center gap-4">
                <div class="size-12 rounded-lg bg-primary/10 flex items-center justify-center">
                  <IconMapPin className="text-primary text-xl" />
                </div>
                <div>
                  <p class="text-white/80 font-mono text-sm">Location</p>
                  <p class="text-white">San Francisco, CA</p>
                  <p class="text-white/60 text-sm">Global Remote Team</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="glass-morphism rounded-xl p-8">
            <h3 class="text-2xl font-bold text-white mb-6">Network Connections</h3>
            
            <div class="space-y-4">
              <a href="#" class="flex items-center gap-4 group hover:text-primary transition-colors">
                <div class="size-12 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                  <IconBrandLinkedin className="text-primary text-xl" />
                </div>
                <div>
                  <p class="text-white">LinkedIn</p>
                  <p class="text-white/60 text-sm">Professional Network</p>
                </div>
              </a>
              
              <a href="#" class="flex items-center gap-4 group hover:text-primary transition-colors">
                <div class="size-12 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                  <IconBrandGithub className="text-primary text-xl" />
                </div>
                <div>
                  <p class="text-white">GitHub</p>
                  <p class="text-white/60 text-sm">Open Source Projects</p>
                </div>
              </a>
            </div>
          </div>

          <!-- Response Time -->
          <div class="glass-morphism rounded-xl p-6 border border-primary/30">
            <div class="text-center">
              <p class="text-primary font-mono text-sm uppercase mb-2">System Status</p>
              <p class="text-2xl font-bold text-white mb-2">ONLINE</p>
              <p class="text-white/60 text-sm mb-4">Average Response Time: 2-4 hours</p>
              <div class="flex items-center justify-center gap-2">
                <div class="size-2 bg-primary rounded-full animate-pulse"></div>
                <span class="text-primary font-mono text-xs">ACTIVE MONITORING</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Information -->
      <div class="mt-16 glass-morphism rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Accelerate Your Project?</h2>
        <p class="text-white/60 mb-8 max-w-2xl mx-auto">
          Our engineering team is standing by to provide immediate consultation. We specialize in rapid deployment and scalable solutions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button class="bg-primary text-background-dark px-8 py-4 rounded-lg font-bold hover:bg-primary/80 transition-all hover:scale-105">
            Schedule Consultation
          </button>
          <button class="border border-primary/40 bg-primary/10 text-primary px-8 py-4 rounded-lg font-bold hover:bg-primary/20 transition-all">
            Download Technical Brief
          </button>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>