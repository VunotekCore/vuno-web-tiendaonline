---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CoreStrengths from "../components/CoreStrengths.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="SYS_ENG | Enterprise Software Agency" currentPage="home">
  <Header currentPage="home" />

  <main class="relative z-10 flex flex-1 flex-col items-center">
    <!-- Hero Section -->
    <Hero />

    <section id="core-strengths">
      <CoreStrengths />
    </section>

    <!-- Engineering Process -->
    <section class="w-full bg-obsidian/50 py-24">
      <div class="mx-auto max-w-7xl px-6 md:px-12">
        <div class="mb-20 grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
          <div>
            <div
              class="mb-4 font-mono text-xs uppercase tracking-[0.4em] text-primary"
            >
              Lifecycle_Phases
            </div>
            <h2 class="text-4xl font-black text-white md:text-5xl">
              Our Engineering Process
            </h2>
            <p class="mt-6 text-lg text-white/50">
              From technical discovery to global deployment, we apply rigorous
              engineering standards to every line of code.
            </p>
          </div>
          <div
            class="relative overflow-hidden rounded-xl border border-glass-border p-1"
          >
            <div class="absolute inset-0 bg-primary/5 animate-pulse"></div>
            <img
              alt="Engineers working on complex code structure"
              class="relative h-[240px] w-full rounded-lg object-cover grayscale transition-all hover:grayscale-0"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDIlLE13Esx2RqdFjfVaJ0ntjfOhXEK78aG0S9-bydntxNfDsF-mMNQd-MyA2oErojaG7ZlzB1MqPiraGkWBheoJ6GNu3R3GNeb9oQdz9Y-Xj1V8DE4JD0QDUUlbgpwYVSdzxsFEqYbqAASdafsTqRuo_-xo7710R1rOuz_WxdbCCU4B6nj-G2wOGq5uzpOG8PfJBwXn4a8WiqjNk8O1-ISgvXzCaINxaZ7qhsWFyTOf6kFbsDUyS7x1IBwobmSXlUk8uzWAjGpavE"
              data-alt="Modern software engineering workspace with multiple screens and code"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div
            class="rounded-lg border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-primary/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm text-primary">01_</span>
            <h3 class="mt-3 text-lg font-bold text-white">Discovery</h3>
            <p class="mt-2 text-sm text-white/50">
              Comprehensive system audit and business logic requirement
              gathering.
            </p>
          </div>
          <div
            class="rounded-lg border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-primary/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm text-primary">02_</span>
            <h3 class="mt-3 text-lg font-bold text-white">Architecture</h3>
            <p class="mt-2 text-sm text-white/50">
              Engineering high-availability blueprints and data entity
              relationship mapping.
            </p>
          </div>
          <div
            class="rounded-lg border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-primary/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm text-primary">03_</span>
            <h3 class="mt-3 text-lg font-bold text-white">Execution</h3>
            <p class="mt-2 text-sm text-white/50">
              Agile sprints with clean code standards and continuous peer-review
              protocols.
            </p>
          </div>
          <div
            class="rounded-lg border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-primary/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm text-primary">04_</span>
            <h3 class="mt-3 text-lg font-bold text-white">Deployment</h3>
            <p class="mt-2 text-sm text-white/50">
              Automated CI/CD orchestration and real-time production monitoring.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="w-full px-6 py-24">
      <div
        class="mx-auto flex max-w-5xl flex-col items-center rounded-2xl border border-primary/20 bg-gradient-to-br from-primary/10 to-transparent p-12 text-center md:p-20"
      >
        <h2 class="text-3xl font-black text-white md:text-5xl">
          Ready to upgrade your enterprise infrastructure?
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-white/60">
          Partner with our systems engineering team to build the future of your
          business operations.
        </p>
        <div class="mt-10">
          <button
            class="group relative flex h-14 items-center justify-center gap-3 overflow-hidden rounded-full bg-primary px-10 text-sm font-bold tracking-widest text-background-dark"
          >
            <span>SECURE CONSULTATION</span>
            <span
              class="material-symbols-outlined transition-transform group-hover:translate-x-1"
              >bolt</span
            >
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
