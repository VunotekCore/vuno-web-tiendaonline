---
import BaseLayout from "../layouts/BaseLayout.astro";
---


<BaseLayout title="Ram;Lop — Architectural Minimalism in Footwear">
  <script>
    // @ts-nocheck
    (function () {
      var lang = localStorage.getItem("ramlop_lang");
      if (!lang) {
        var navLang = (navigator.language || navigator.userLanguage || "es").substring(0, 2);
        lang = navLang === "en" ? "en" : "es";
        localStorage.setItem("ramlop_lang", lang);
      }
      window.location.href = "/" + lang + "/";
    })();
  </script>
  <main class="flex items-center justify-center min-h-screen">
    <p class="font-body-lg text-body-lg text-secondary">Redirigiendo...</p>
  </main>
</BaseLayout>
