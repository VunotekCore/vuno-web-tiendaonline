---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import IntroCTA from "../components/IntroCTA.astro";
import CoreStrengths from "../components/CoreStrengths.astro";
import Hero from "../components/Hero.astro";
import EngineeringProcess from "../components/EngineeringProcess.astro";
import TechStack from "../components/TechStack.astro";
---

<Layout
  title="TheRealDevs - Agencia de Desarrollo en Centroamérica"
  currentPage="Inicio"
>
  <Header currentPage="Inicio" />

  <main class="relative z-10 flex flex-1 flex-col items-center">
    <!-- Hero Section -->
    <Hero />
    <!-- Intro CTA -->
    <IntroCTA />
    <!-- Services Section -->
    <section id="core-strengths">
      <CoreStrengths />
    </section>

    <!-- Engineering Process -->
    <section id="engineering-process">
      <EngineeringProcess />
    </section>

    <!-- Tech Stack -->
    <section id="tech-stack">
      <TechStack />
    </section>
  </main>

  <Footer />
</Layout>
