---

<BaseLayout title="Architectural Minimalism in Footwear">
  <Navbar />
  <main>
    <!-- Hero Slider -->
    <section class="relative w-full h-[870px] min-h-[600px] flex items-center justify-center bg-sand-nude overflow-hidden px-margin-mobile md:px-margin-desktop" id="heroSlider">
      <div class="absolute inset-0 z-0" id="slidesContainer">
        {heroSlides.map((src, i) => (
          <div class="absolute inset-0 transition-opacity duration-700 ease-in-out" style={`opacity: ${i === 0 ? 1 : 0}`} data-slide={i}>
            <img src={src} alt={`Hero Slide ${i + 1}`} class="w-full h-full object-cover object-center opacity-90" loading={i === 0 ? "eager" : "lazy"} />
          </div>
        ))}
      </div>

      <div class="absolute inset-0 bg-monolith-black/10 z-[1]"></div>

      <div class="relative z-10 flex flex-col items-center text-center max-w-3xl px-6 py-12 bg-off-white/80 backdrop-blur-sm shadow-sm rounded-DEFAULT border border-outline-variant/30">
        <h1 class="font-headline-xl text-headline-xl text-monolith-black mb-6">Architectural Minimalism.</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-10 max-w-xl">
          Discover the new season's structural elegance. Footwear designed not to be worn, but to define space and form.
        </p>
        <a href="#new-arrivals" class="inline-flex items-center justify-center bg-monolith-black text-off-white font-label-caps text-label-caps h-14 px-10 hover:bg-inverse-surface transition-colors duration-300 w-full sm:w-auto">
          EXPLORE COLLECTION
        </a>
      </div>

      <!-- Dots -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex items-center gap-3" id="heroDots">
        {heroSlides.map((_, i) => (
          <button class="w-2.5 h-2.5 rounded-full transition-all duration-300" style={`background-color: ${i === 0 ? "#1A1A1A" : "#9A9A9A"}`} data-dot={i} aria-label={`Slide ${i + 1}`}></button>
        ))}
      </div>

      <!-- Prev / Next -->
      <button id="heroPrev" class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-20 text-off-white/70 hover:text-off-white transition-colors duration-300 hidden md:flex items-center justify-center w-10 h-10" aria-label="Previous">
        <span class="material-symbols-outlined text-3xl">chevron_left</span>
      </button>
      <button id="heroNext" class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-20 text-off-white/70 hover:text-off-white transition-colors duration-300 hidden md:flex items-center justify-center w-10 h-10" aria-label="Next">
        <span class="material-symbols-outlined text-3xl">chevron_right</span>
      </button>
    </section>

    <!-- New Arrivals (Bento Grid) -->
    <section class="py-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto" id="new-arrivals">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
        <div>
          <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-monolith-black">New Arrivals</h2>
          <p class="font-body-md text-body-md text-secondary mt-2">The latest studies in form and function.</p>
        </div>
        <a href="/catalogo" class="font-label-caps text-label-caps text-monolith-black border-b border-monolith-black pb-1 hover:text-secondary hover:border-secondary transition-colors uppercase">View All</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
        <a href={`/producto/${newArrivals[0]?.slug}`} class="group md:col-span-8 flex flex-col relative overflow-hidden bg-surface-container-low h-[500px]">
          <img src={newArrivalImages[0]} alt={newArrivals[0]?.name} class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.03]" />
          <div class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-monolith-black/60 to-transparent">
            <h3 class="font-headline-md text-headline-md text-off-white">{newArrivals[0]?.name}</h3>
            <p class="font-price-display text-price-display text-surface-container mt-2">${newArrivals[0]?.price}</p>
          </div>
        </a>
        <div class="md:col-span-4 flex flex-col gap-gutter">
          <a href={`/producto/${newArrivals[1]?.slug}`} class="group flex-1 flex flex-col relative overflow-hidden bg-surface-container-low h-[238px]">
            <img src={newArrivalImages[1]} alt={newArrivals[1]?.name} class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.05]" />
            <div class="absolute inset-0 bg-surface-container/0 group-hover:bg-surface-container/10 transition-colors duration-300"></div>
            <div class="absolute bottom-4 left-4">
              <span class="font-label-caps text-label-caps text-off-white bg-monolith-black/70 px-2 py-1">{newArrivals[1]?.name}</span>
            </div>
          </a>
          <a href={`/producto/${newArrivals[2]?.slug}`} class="group flex-1 flex flex-col relative overflow-hidden bg-sand-nude h-[238px]">
            <img src={newArrivalImages[2]} alt={newArrivals[2]?.name} class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.05] mix-blend-multiply" />
            <div class="absolute inset-0 bg-monolith-black/0 group-hover:bg-monolith-black/5 transition-colors duration-300"></div>
            <div class="absolute bottom-4 left-4">
              <span class="font-label-caps text-label-caps text-monolith-black bg-off-white/80 px-2 py-1">{newArrivals[2]?.name}</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Seasonal Trends -->
    <section class="py-section-gap px-margin-mobile md:px-margin-desktop bg-surface-container-low">
      <div class="max-w-container-max mx-auto flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
        <div class="w-full lg:w-1/2 flex justify-center lg:justify-end relative">
          <div class="absolute -inset-4 bg-sand-nude rotate-3 -z-10 rounded-lg"></div>
          <img src={seasonalTrendImage} alt="Seasonal Trend" class="w-full max-w-md h-auto object-cover rounded-DEFAULT shadow-sm" />
        </div>
        <div class="w-full lg:w-1/2 flex flex-col items-start space-y-6">
          <span class="font-label-caps text-label-caps text-secondary tracking-widest uppercase">Trend Report</span>
          <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-monolith-black leading-tight">The Return of Structure.</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-lg">
            This season, we move away from the fluid and embrace the bold. Sharp angles, distinct block heels, and rigid, high-quality leathers define a collection that stands its ground. It is an exploration of power through restraint.
          </p>
          <a href="/catalogo" class="inline-flex items-center justify-center border border-monolith-black text-monolith-black font-label-caps text-label-caps h-14 px-8 mt-4 hover:bg-monolith-black hover:text-off-white transition-colors duration-300">
            SHOP THE TREND
          </a>
        </div>
      </div>
    </section>

    <!-- Curated Selection -->
    <section class="py-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-monolith-black text-center mb-16">Curated Selection</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-gutter gap-y-16">
        {curated.map((p, i) => (
          <ProductCard
            name={p.name}
            price={`$${p.price.toFixed(2)}`}
            image={curatedImages[i] || p.images[0]}
            href={`/producto/${p.slug}`}
            colors={p.colors.map((c) => c.hex)}
            productId={p.id}
            productSlug={p.slug}
            productPrice={p.price}
          />
        ))}
      </div>
    </section>
  </main>
  <Footer />

  <script>
    // @ts-nocheck
    (function () {
      const slides = document.querySelectorAll("[data-slide]");
      const dots = document.querySelectorAll("[data-dot]");
      const prev = document.getElementById("heroPrev");
      const next = document.getElementById("heroNext");
      const section = document.getElementById("heroSlider");
      const total = slides.length;
      let current = 0;
      let interval;

      function goTo(index) {
        if (index === current) return;
        slides.forEach((s, i) => {
          s.style.opacity = i === index ? "1" : "0";
        });
        dots.forEach((d, i) => {
          d.style.backgroundColor = i === index ? "#1A1A1A" : "#9A9A9A";
        });
        current = index;
      }

      function nextSlide() {
        goTo((current + 1) % total);
      }

      function prevSlide() {
        goTo((current - 1 + total) % total);
      }

      function startAuto() {
        stopAuto();
        interval = setInterval(nextSlide, 5000);
      }

      function stopAuto() {
        if (interval) clearInterval(interval);
        interval = null;
      }

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          goTo(parseInt(dot.dataset.dot));
          startAuto();
        });
      });

      if (prev) prev.addEventListener("click", () => { prevSlide(); startAuto(); });
      if (next) next.addEventListener("click", () => { nextSlide(); startAuto(); });

      section.addEventListener("mouseenter", stopAuto);
      section.addEventListener("mouseleave", startAuto);

      startAuto();
    })();
  </script>
</BaseLayout>
