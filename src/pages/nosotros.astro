---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IconUsers, IconAward, IconTarget, IconClock, IconCheck, IconArrowRight } from '@tabler/icons-react';
---

<Layout title="Nosotros | SYS_ENG" currentPage="nosotros">
  <Header currentPage="nosotros" />
  
  <main class="relative z-10 flex flex-1 flex-col items-center pt-24">
    <!-- Hero Section -->
    <div class="text-center mb-16 px-6">
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-white uppercase">
        Nosotros <span class="text-primary">SYS_ENG</span>
      </h1>
      <p class="text-white/60 max-w-2xl mx-auto mt-4 text-lg">
        Enterprise systems engineering at the intersection of innovation and reliability. Building the future of digital infrastructure.
      </p>
    </div>

    <div class="w-full max-w-7xl px-6">
      <!-- Company Overview -->
      <div class="glass-morphism rounded-2xl p-12 mb-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-white mb-6">Engineering Excellence Since 2014</h2>
            <p class="text-white/60 mb-6 leading-relaxed">
              SYS_ENG emerged from the convergence of enterprise architecture expertise and cutting-edge technology implementation. Our team of senior engineers has successfully delivered over 500 enterprise projects across diverse industries, establishing us as trusted partners for mission-critical systems.
            </p>
            <p class="text-white/60 mb-8 leading-relaxed">
              We specialize in transforming complex business requirements into scalable, maintainable, and secure technical solutions. Our approach combines deep technical knowledge with business acumen, ensuring that every line of code serves a strategic purpose.
            </p>
            <div class="grid grid-cols-2 gap-6">
              <div class="text-center">
                <p class="text-4xl font-bold text-primary mb-2">10+</p>
                <p class="text-white/60 font-mono text-sm uppercase">Years Experience</p>
              </div>
              <div class="text-center">
                <p class="text-4xl font-bold text-primary mb-2">50+</p>
                <p class="text-white/60 font-mono text-sm uppercase">Expert Engineers</p>
              </div>
            </div>
          </div>
          <div class="relative">
            <div class="glass-morphism p-8 rounded-xl">
              <div class="aspect-square bg-gradient-to-br from-primary/20 to-transparent rounded-lg flex items-center justify-center">
                <IconUsers className="text-primary text-8xl animate-pulse" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mission & Vision -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-20">
        <div class="glass-morphism rounded-xl p-8">
          <div class="flex items-center gap-3 mb-4">
            <IconTarget className="text-primary text-2xl" />
            <h3 class="text-2xl font-bold text-white">Our Mission</h3>
          </div>
          <p class="text-white/60 leading-relaxed">
            To architect and implement enterprise-grade solutions that transform business challenges into competitive advantages through innovative engineering, reliable infrastructure, and continuous optimization.
          </p>
        </div>

        <div class="glass-morphism rounded-xl p-8">
          <div class="flex items-center gap-3 mb-4">
            <IconAward className="text-primary text-2xl" />
            <h3 class="text-2xl font-bold text-white">Our Vision</h3>
          </div>
          <p class="text-white/60 leading-relaxed">
            To be the global leader in enterprise systems engineering, setting the standard for technical excellence, innovation, and customer success in the digital transformation landscape.
          </p>
        </div>
      </div>

      <!-- Core Values -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-white text-center mb-12">Core Values</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="glass-morphism rounded-xl p-6 text-center group hover:border-primary/50 transition-all">
            <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <IconCheck className="text-primary text-2xl" />
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Technical Excellence</h3>
            <p class="text-white/60 text-sm">
              We never compromise on code quality, performance, or security standards.
            </p>
          </div>

          <div class="glass-morphism rounded-xl p-6 text-center group hover:border-primary/50 transition-all">
            <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <IconClock className="text-primary text-2xl" />
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Reliability</h3>
            <p class="text-white/60 text-sm">
              Our solutions are built to perform flawlessly under enterprise demands.
            </p>
          </div>

          <div class="glass-morphism rounded-xl p-6 text-center group hover:border-primary/50 transition-all">
            <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <IconUsers className="text-primary text-2xl" />
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Partnership</h3>
            <p class="text-white/60 text-sm">
              We work collaboratively with clients as strategic technology partners.
            </p>
          </div>

          <div class="glass-morphism rounded-xl p-6 text-center group hover:border-primary/50 transition-all">
            <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <IconTarget className="text-primary text-2xl" />
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Innovation</h3>
            <p class="text-white/60 text-sm">
              We continuously explore cutting-edge technologies to solve complex problems.
            </p>
          </div>

          <div class="glass-morphism rounded-xl p-6 text-center group hover:border-primary/50 transition-all">
            <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <IconAward className="text-primary text-2xl" />
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Integrity</h3>
            <p class="text-white/60 text-sm">
              We operate with transparency, honesty, and ethical business practices.
            </p>
          </div>

          <div class="glass-morphism rounded-xl p-6 text-center group hover:border-primary/50 transition-all">
            <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <IconCheck className="text-primary text-2xl" />
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Continuous Learning</h3>
            <p class="text-white/60 text-sm">
              Our team stays ahead of technology trends through ongoing education and research.
            </p>
          </div>
        </div>
      </div>

      <!-- Team Stats -->
      <div class="glass-morphism rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold text-white mb-12">Our Impact</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="text-center">
            <p class="text-4xl font-bold text-primary mb-2">500+</p>
            <p class="text-white/60 font-mono text-sm uppercase">Projects Completed</p>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-primary mb-2">99.9%</p>
            <p class="text-white/60 font-mono text-sm uppercase">Client Retention</p>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-primary mb-2">24/7</p>
            <p class="text-white/60 font-mono text-sm uppercase">Support Available</p>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-primary mb-2">50+</p>
            <p class="text-white/60 font-mono text-sm uppercase">Industries Served</p>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="text-center py-16">
        <h2 class="text-3xl font-bold text-white mb-4">Join Our Mission</h2>
        <p class="text-white/60 mb-8 max-w-2xl mx-auto">
          We're always looking for talented engineers who share our passion for excellence and innovation.
        </p>
        <button class="bg-primary text-background-dark px-8 py-4 rounded-lg font-bold hover:bg-primary/80 transition-all hover:scale-105 flex items-center gap-2 mx-auto">
          <span>View Careers</span>
          <IconArrowRight />
        </button>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>