---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IconSearch, IconPencil, IconCode, IconRocket, IconCheck, IconArrowRight } from '@tabler/icons-react';
---

<Layout title="Proceso | SYS_ENG" currentPage="proceso">
  <Header currentPage="proceso" />
  
  <main class="relative z-10 flex flex-1 flex-col items-center pt-24">
    <!-- Hero Section -->
    <div class="text-center mb-16 px-6">
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-white uppercase">
        Proceso de <span class="text-primary">Ingeniería</span>
      </h1>
      <p class="text-white/60 max-w-2xl mx-auto mt-4 text-lg">
        From technical discovery to global deployment, we apply rigorous engineering standards to every line of code.
      </p>
    </div>

    <div class="w-full max-w-7xl px-6">
      <!-- Process Steps -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
        <!-- Step 1 -->
        <div class="glass-morphism rounded-xl p-8 text-center group hover:border-primary/50 transition-all">
          <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <IconSearch className="text-primary text-2xl" />
          </div>
          <span class="text-primary font-mono text-sm uppercase mb-2 block">01</span>
          <h3 class="text-xl font-bold text-white mb-3">Discovery</h3>
          <p class="text-white/60 text-sm">
            Comprehensive system audit and business logic requirement gathering to understand your unique challenges.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="glass-morphism rounded-xl p-8 text-center group hover:border-primary/50 transition-all">
          <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
                <IconPencil className="text-primary text-2xl" />
          </div>
          <span class="text-primary font-mono text-sm uppercase mb-2 block">02</span>
          <h3 class="text-xl font-bold text-white mb-3">Architecture</h3>
          <p class="text-white/60 text-sm">
            Engineering high-availability blueprints and data entity relationship mapping for scalable solutions.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="glass-morphism rounded-xl p-8 text-center group hover:border-primary/50 transition-all">
          <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <IconCode className="text-primary text-2xl" />
          </div>
          <span class="text-primary font-mono text-sm uppercase mb-2 block">03</span>
          <h3 class="text-xl font-bold text-white mb-3">Execution</h3>
          <p class="text-white/60 text-sm">
            Agile sprints with clean code standards and continuous peer-review protocols for quality assurance.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="glass-morphism rounded-xl p-8 text-center group hover:border-primary/50 transition-all">
          <div class="size-16 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <IconRocket className="text-primary text-2xl" />
          </div>
          <span class="text-primary font-mono text-sm uppercase mb-2 block">04</span>
          <h3 class="text-xl font-bold text-white mb-3">Deployment</h3>
          <p class="text-white/60 text-sm">
            Automated CI/CD orchestration and real-time production monitoring for seamless rollout.
          </p>
        </div>
      </div>

      <!-- Detailed Process Breakdown -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20">
        <!-- Left Column -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-8">Engineering Methodology</h2>
          
          <div class="space-y-6">
            <div class="glass-morphism rounded-lg p-6">
              <div class="flex items-start gap-4">
                <IconCheck className="text-primary size-6 mt-1 flex-shrink-0" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Technical Assessment</h4>
                  <p class="text-white/60 text-sm">
                    Deep dive into existing infrastructure, codebase analysis, and performance bottleneck identification.
                  </p>
                </div>
              </div>
            </div>

            <div class="glass-morphism rounded-lg p-6">
              <div class="flex items-start gap-4">
                <IconCheck className="text-primary size-6 mt-1 flex-shrink-0" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Solution Design</h4>
                  <p class="text-white/60 text-sm">
                    Architecture diagrams, API specifications, database schema, and security protocols documentation.
                  </p>
                </div>
              </div>
            </div>

            <div class="glass-morphism rounded-lg p-6">
              <div class="flex items-start gap-4">
                <IconCheck className="text-primary size-6 mt-1 flex-shrink-0" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Agile Development</h4>
                  <p class="text-white/60 text-sm">
                    Two-week sprints with daily standups, sprint reviews, and continuous integration/deployment pipelines.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-8">Quality Standards</h2>
          
          <div class="space-y-6">
            <div class="glass-morphism rounded-lg p-6">
              <div class="flex items-start gap-4">
                <IconCheck className="text-primary size-6 mt-1 flex-shrink-0" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Code Review Protocol</h4>
                  <p class="text-white/60 text-sm">
                    Mandatory peer reviews, static analysis, security scanning, and performance testing for every commit.
                  </p>
                </div>
              </div>
            </div>

            <div class="glass-morphism rounded-lg p-6">
              <div class="flex items-start gap-4">
                <IconCheck className="text-primary size-6 mt-1 flex-shrink-0" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Documentation Standards</h4>
                  <p class="text-white/60 text-sm">
                    Comprehensive technical documentation, API specs, and knowledge base for maintainability.
                  </p>
                </div>
              </div>
            </div>

            <div class="glass-morphism rounded-lg p-6">
              <div class="flex items-start gap-4">
                <IconCheck className="text-primary size-6 mt-1 flex-shrink-0" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Post-Deployment Support</h4>
                  <p class="text-white/60 text-sm">
                    24/7 monitoring, SLA compliance, performance optimization, and proactive maintenance.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline Visualization -->
      <div class="glass-morphism rounded-2xl p-12 mb-20">
        <h2 class="text-3xl font-bold text-white text-center mb-12">Project Timeline</h2>
        
        <div class="relative">
          <!-- Timeline Line -->
          <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-0.5 bg-primary/30"></div>
          
          <!-- Timeline Items -->
          <div class="space-y-12">
            <div class="flex items-center gap-8">
              <div class="flex-1 text-right pr-8">
                <h4 class="text-lg font-bold text-white">Week 1-2</h4>
                <p class="text-white/60 text-sm">Discovery & Planning</p>
              </div>
              <div class="size-4 bg-primary rounded-full flex-shrink-0"></div>
              <div class="flex-1 pl-8">
                <p class="text-white/60 text-sm">Requirements gathering, stakeholder interviews</p>
              </div>
            </div>

            <div class="flex items-center gap-8">
              <div class="flex-1 text-right pr-8">
                <p class="text-white/60 text-sm">Architecture design, tech stack selection</p>
              </div>
              <div class="size-4 bg-primary rounded-full flex-shrink-0"></div>
              <div class="flex-1 pl-8">
                <h4 class="text-lg font-bold text-white">Week 3-4</h4>
                <p class="text-white/60 text-sm">Design & Prototyping</p>
              </div>
            </div>

            <div class="flex items-center gap-8">
              <div class="flex-1 text-right pr-8">
                <h4 class="text-lg font-bold text-white">Week 5-12</h4>
                <p class="text-white/60 text-sm">Development Sprints</p>
              </div>
              <div class="size-4 bg-primary rounded-full flex-shrink-0"></div>
              <div class="flex-1 pl-8">
                <p class="text-white/60 text-sm">Core functionality, testing, integration</p>
              </div>
            </div>

            <div class="flex items-center gap-8">
              <div class="flex-1 text-right pr-8">
                <p class="text-white/60 text-sm">UAT, performance tuning, deployment</p>
              </div>
              <div class="size-4 bg-primary rounded-full flex-shrink-0"></div>
              <div class="flex-1 pl-8">
                <h4 class="text-lg font-bold text-white">Week 13-14</h4>
                <p class="text-white/60 text-sm">Testing & Deployment</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="text-center py-16">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Start Your Project?</h2>
        <p class="text-white/60 mb-8 max-w-2xl mx-auto">
          Let's discuss how our proven engineering process can transform your business challenges into opportunities.
        </p>
        <button class="bg-primary text-background-dark px-8 py-4 rounded-lg font-bold hover:bg-primary/80 transition-all hover:scale-105 flex items-center gap-2 mx-auto">
          <span>Start Consultation</span>
          <IconArrowRight />
        </button>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>