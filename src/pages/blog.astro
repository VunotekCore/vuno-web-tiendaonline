---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IconArticle, IconCalendar, IconClock, IconArrowRight, IconTrendingUp } from '@tabler/icons-react';
---

<Layout title="Blog | SYS_ENG" currentPage="blog">
  <Header currentPage="blog" />
  
  <main class="relative z-10 flex flex-1 flex-col items-center pt-24">
    <!-- Hero Section -->
    <div class="text-center mb-16 px-6">
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-white uppercase">
        Blog <span class="text-primary">Técnico</span>
      </h1>
      <p class="text-white/60 max-w-2xl mx-auto mt-4 text-lg">
        Insights, tutorials, and thought leadership from our senior engineering team on enterprise systems architecture.
      </p>
    </div>

    <div class="w-full max-w-7xl px-6">
      <!-- Featured Post -->
      <div class="glass-morphism rounded-2xl p-8 mb-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <IconTrendingUp className="text-primary text-xl" />
              <span class="text-primary font-mono text-sm uppercase">Featured</span>
            </div>
            <h2 class="text-3xl font-bold text-white mb-4">
              Scaling Salesforce Applications for 10M+ Users: Architecture Patterns That Work
            </h2>
            <p class="text-white/60 mb-6 leading-relaxed">
              Deep dive into proven architectural patterns for handling massive scale in Salesforce environments, including data partitioning strategies, async processing techniques, and performance optimization best practices that have been battle-tested in production.
            </p>
            <div class="flex items-center gap-4 mb-6">
              <div class="flex items-center gap-2">
                <IconCalendar className="text-primary size-4" />
                <span class="text-white/60 text-sm">Jan 15, 2024</span>
              </div>
              <div class="flex items-center gap-2">
                <IconClock className="text-primary size-4" />
                <span class="text-white/60 text-sm">12 min read</span>
              </div>
            </div>
            <button class="flex items-center gap-2 text-primary hover:text-primary/80 font-mono text-sm">
              <span>Read Full Article</span>
              <IconArrowRight className="size-4" />
            </button>
          </div>
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-transparent rounded-lg flex items-center justify-center">
            <IconArticle className="text-primary text-6xl" />
          </div>
        </div>
      </div>

      <!-- Blog Categories -->
      <div class="flex flex-wrap gap-3 mb-12 justify-center">
        <button class="px-4 py-2 bg-primary text-background-dark rounded-lg font-mono text-sm font-bold">All Posts</button>
        <button class="px-4 py-2 border border-primary/40 bg-primary/10 text-primary rounded-lg font-mono text-sm font-bold hover:bg-primary/20">Salesforce</button>
        <button class="px-4 py-2 border border-primary/40 bg-primary/10 text-primary rounded-lg font-mono text-sm font-bold hover:bg-primary/20">Backend</button>
        <button class="px-4 py-2 border border-primary/40 bg-primary/10 text-primary rounded-lg font-mono text-sm font-bold hover:bg-primary/20">DevOps</button>
        <button class="px-4 py-2 border border-primary/40 bg-primary/10 text-primary rounded-lg font-mono text-sm font-bold hover:bg-primary/20">Architecture</button>
        <button class="px-4 py-2 border border-primary/40 bg-primary/10 text-primary rounded-lg font-mono text-sm font-bold hover:bg-primary/20">Security</button>
      </div>

      <!-- Blog Posts Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        <!-- Post 1 -->
        <article class="glass-morphism rounded-xl p-6 group hover:border-primary/50 transition-all">
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-transparent rounded-lg mb-4 flex items-center justify-center">
            <IconArticle className="text-primary text-3xl" />
          </div>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">Salesforce</span>
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">LWC</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
            Advanced Lightning Web Component Patterns for Enterprise Apps
          </h3>
          <p class="text-white/60 text-sm mb-4">
            Explore complex LWC patterns including custom events, state management, and integration strategies for large-scale applications.
          </p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 text-white/60 text-xs">
              <div class="flex items-center gap-1">
                <IconCalendar className="size-3" />
                <span>Jan 10</span>
              </div>
              <div class="flex items-center gap-1">
                <IconClock className="size-3" />
                <span>8 min</span>
              </div>
            </div>
            <IconArrowRight className="text-primary size-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </article>

        <!-- Post 2 -->
        <article class="glass-morphism rounded-xl p-6 group hover:border-primary/50 transition-all">
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-transparent rounded-lg mb-4 flex items-center justify-center">
            <IconArticle className="text-primary text-3xl" />
          </div>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">Backend</span>
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">.NET</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
            Microservices Architecture: CQRS Pattern Implementation in .NET Core
          </h3>
          <p class="text-white/60 text-sm mb-4">
            Learn how to implement Command Query Responsibility Segregation pattern for scalable microservices with real-world examples.
          </p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 text-white/60 text-xs">
              <div class="flex items-center gap-1">
                <IconCalendar className="size-3" />
                <span>Jan 8</span>
              </div>
              <div class="flex items-center gap-1">
                <IconClock className="size-3" />
                <span>15 min</span>
              </div>
            </div>
            <IconArrowRight className="text-primary size-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </article>

        <!-- Post 3 -->
        <article class="glass-morphism rounded-xl p-6 group hover:border-primary/50 transition-all">
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-transparent rounded-lg mb-4 flex items-center justify-center">
            <IconArticle className="text-primary text-3xl" />
          </div>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">DevOps</span>
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">CI/CD</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
            Zero-Downtime Deployments: Blue-Green Strategy with Kubernetes
          </h3>
          <p class="text-white/60 text-sm mb-4">
            Complete guide to implementing blue-green deployments using Kubernetes for continuous delivery without service interruption.
          </p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 text-white/60 text-xs">
              <div class="flex items-center gap-1">
                <IconCalendar className="size-3" />
                <span>Jan 5</span>
              </div>
              <div class="flex items-center gap-1">
                <IconClock className="size-3" />
                <span>10 min</span>
              </div>
            </div>
            <IconArrowRight className="text-primary size-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </article>

        <!-- Post 4 -->
        <article class="glass-morphism rounded-xl p-6 group hover:border-primary/50 transition-all">
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-transparent rounded-lg mb-4 flex items-center justify-center">
            <IconArticle className="text-primary text-3xl" />
          </div>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">Security</span>
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">Enterprise</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
            Enterprise Security: Implementing Zero Trust Architecture
          </h3>
          <p class="text-white/60 text-sm mb-4">
            Step-by-step implementation of Zero Trust security model for enterprise applications with practical code examples.
          </p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 text-white/60 text-xs">
              <div class="flex items-center gap-1">
                <IconCalendar className="size-3" />
                <span>Jan 3</span>
              </div>
              <div class="flex items-center gap-1">
                <IconClock className="size-3" />
                <span>12 min</span>
              </div>
            </div>
            <IconArrowRight className="text-primary size-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </article>

        <!-- Post 5 -->
        <article class="glass-morphism rounded-xl p-6 group hover:border-primary/50 transition-all">
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-transparent rounded-lg mb-4 flex items-center justify-center">
            <IconArticle className="text-primary text-3xl" />
          </div>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">Architecture</span>
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">Performance</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
            Database Optimization: Query Performance at Million-Record Scale
          </h3>
          <p class="text-white/60 text-sm mb-4">
            Advanced indexing strategies and query optimization techniques for handling millions of records with sub-second response times.
          </p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 text-white/60 text-xs">
              <div class="flex items-center gap-1">
                <IconCalendar className="size-3" />
                <span>Dec 28</span>
              </div>
              <div class="flex items-center gap-1">
                <IconClock className="size-3" />
                <span>18 min</span>
              </div>
            </div>
            <IconArrowRight className="text-primary size-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </article>

        <!-- Post 6 -->
        <article class="glass-morphism rounded-xl p-6 group hover:border-primary/50 transition-all">
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-transparent rounded-lg mb-4 flex items-center justify-center">
            <IconArticle className="text-primary text-3xl" />
          </div>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">Frontend</span>
            <span class="px-2 py-1 bg-primary/10 text-primary rounded text-xs font-mono">React</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
            Building Scalable React Applications: Architecture Patterns
          </h3>
          <p class="text-white/60 text-sm mb-4">
            Modern React architecture patterns including micro-frontends, state management, and performance optimization techniques.
          </p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 text-white/60 text-xs">
              <div class="flex items-center gap-1">
                <IconCalendar className="size-3" />
                <span>Dec 25</span>
              </div>
              <div class="flex items-center gap-1">
                <IconClock className="size-3" />
                <span>9 min</span>
              </div>
            </div>
            <IconArrowRight className="text-primary size-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </article>
      </div>

      <!-- Newsletter Section -->
      <div class="glass-morphism rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Stay Updated</h2>
        <p class="text-white/60 mb-8 max-w-2xl mx-auto">
          Get the latest technical insights and engineering best practices delivered directly to your inbox.
        </p>
        <form class="max-w-md mx-auto flex gap-4">
          <input 
            type="email" 
            placeholder="Enter your email"
            class="flex-1 px-4 py-3 bg-background-dark/50 border border-primary/30 rounded-lg text-white placeholder-white/40 focus:outline-none focus:border-primary focus:bg-primary/5 transition-all"
            required
          />
          <button type="submit" class="bg-primary text-background-dark px-6 py-3 rounded-lg font-bold hover:bg-primary/80 transition-all hover:scale-105">
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>