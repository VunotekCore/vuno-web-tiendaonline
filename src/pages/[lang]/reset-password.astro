---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/organisms/Navbar.astro";
import Footer from "../../components/organisms/Footer.astro";
import { t, type Locale, locales } from "../../i18n/utils";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const currentPath = Astro.url.pathname;
---

<BaseLayout title={lang === "es" ? "Nueva Contraseña | Ram;Lop" : "New Password | Ram;Lop"} lang={lang}>
  <Navbar lang={lang} currentPath={currentPath} />
  <main class="flex-grow w-full max-w-md mx-auto px-margin-mobile md:px-margin-desktop py-section-gap">
    <div class="text-center mb-10">
      <h1 class="font-headline text-headline-lg-mobile md:text-headline-lg mb-3">{t("auth.resetTitle", lang)}</h1>
      <p class="font-body text-body-md text-secondary">{t("auth.resetSubtitle", lang)}</p>
    </div>

    <div id="resetMsg" class="hidden font-body text-body-md p-3 mb-6 text-center"></div>

    <form id="resetForm" class="flex flex-col gap-6">
      <input type="hidden" id="resetToken" value="" />
      <div>
        <label class="font-label-caps text-label-caps text-secondary block mb-2 tracking-widest">{t("account.newPassword", lang)}</label>
        <input id="resetPassword" type="password" required minlength="6" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-monolith-black focus:outline-none transition-colors" />
        <p class="font-body text-body-sm text-secondary mt-1">{t("auth.passwordMinLength", lang)}</p>
      </div>
      <button type="submit" id="resetBtn" class="w-full bg-monolith-black text-off-white font-label-caps text-label-caps h-12 inline-flex items-center justify-center hover:bg-monolith-black/90 transition-all tracking-widest">
        {t("auth.resetPassword", lang)}
      </button>
    </form>

    <p class="font-body text-body-md text-secondary text-center mt-8">
      <a href={`/${lang}/login`} class="text-monolith-black underline hover:no-underline font-medium">
        {t("auth.backToLogin", lang)}
      </a>
    </p>
  </main>
  <Footer lang={lang} />

  <script>
    // @ts-nocheck
    // Read token from URL query param
    const params = new URLSearchParams(window.location.search);
    const token = params.get("token");

    document.getElementById("resetToken").value = token || "";

    if (!token) {
      document.getElementById("resetMsg").textContent = "Invalid or missing reset token.";
      document.getElementById("resetMsg").className = "font-body text-body-md p-3 mb-6 text-center bg-red-100 text-error";
      document.getElementById("resetMsg").classList.remove("hidden");
      document.getElementById("resetForm").classList.add("hidden");
    }

    document.getElementById("resetForm").addEventListener("submit", async (e) => {
      e.preventDefault();

      const password = document.getElementById("resetPassword").value;
      const btn = document.getElementById("resetBtn");
      const msg = document.getElementById("resetMsg");

      msg.classList.add("hidden");
      btn.disabled = true;
      btn.textContent = "...";

      try {
        const res = await fetch("/api/customer/reset-password.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token, password }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error");

        msg.textContent = data.message;
        msg.className = "font-body text-body-md p-3 mb-6 text-center bg-green-100 text-green-800";
        msg.classList.remove("hidden");

        // Hide the form and show login link
        document.getElementById("resetForm").classList.add("hidden");
      } catch (err) {
        msg.textContent = err.message;
        msg.className = "font-body text-body-md p-3 mb-6 text-center bg-red-100 text-error";
        msg.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "RESET PASSWORD";
      }
    });
  </script>
</BaseLayout>
