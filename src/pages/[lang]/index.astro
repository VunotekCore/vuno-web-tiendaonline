const currentPath = Astro.url.pathname;
const alternateUrls = {
  es: `${import.meta.env.PROD ? "https://vuno.com" : "http://localhost:4321"}/es/`,
  en: `${import.meta.env.PROD ? "https://vuno.com" : "http://localhost:4321"}/en/`,
};
---

<BaseLayout title="Architectural Minimalism in Footwear" lang={lang} alternateUrls={alternateUrls}>
  <Navbar lang={lang} currentPath={currentPath} />

  <!-- Editorial Hero -->
  <section class="relative w-full min-h-[90vh] flex flex-col lg:flex-row bg-monolith-black overflow-hidden">
    <div class="noise-overlay opacity-[0.06]"></div>
    <div class="hidden lg:block absolute inset-0 z-[1] grid-overlay opacity-30"></div>

    <div class="relative lg:w-[60%] min-h-[60vh] lg:min-h-[90vh] overflow-hidden">
      <img
        src={heroImage}
        alt=""
        class="w-full h-full object-cover object-center opacity-70 lg:opacity-80"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-monolith-black/60 via-transparent to-monolith-black/30"></div>
    </div>

    <div class="relative lg:w-[40%] flex flex-col justify-center px-margin-mobile md:px-16 py-16 lg:py-0 z-10">
      <span class="font-label-caps text-label-caps text-clay-accent tracking-[0.15em] mb-6 animate-slideUp">EST. 2024</span>
      <h1 class="font-headline-xl text-headline-xl text-off-white leading-[1.05] mb-6 animate-slideUp" style="animation-delay: 0.15s">
        {t("home.hero.title", lang)}
      </h1>
      <p class="font-body-lg text-body-lg text-off-white/60 max-w-md mb-10 animate-slideUp" style="animation-delay: 0.3s">
        {t("home.hero.subtitle", lang)}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 animate-slideUp" style="animation-delay: 0.45s">
        <a
          href={`/${lang}/catalogo`}
          class="inline-flex items-center justify-center bg-off-white text-monolith-black font-label-caps text-label-caps h-14 px-10 hover:bg-off-white/90 hover:tracking-[0.15em] transition-all duration-300"
        >
          {t("home.hero.cta", lang)}
        </a>
        <a
          href={`/${lang}/#new-arrivals`}
          class="inline-flex items-center justify-center border border-off-white/30 text-off-white font-label-caps text-label-caps h-14 px-10 hover:border-off-white/60 hover:tracking-[0.15em] transition-all duration-300"
        >
          {t("home.hero.explore", lang) || "EXPLORE"}
        </a>
      </div>
    </div>

    <!-- Progress indicator -->
    <div class="hidden lg:flex absolute bottom-12 left-[60%] translate-x-[-60px] z-10 items-center gap-4">
      <span class="w-12 h-[1px] bg-clay-accent"></span>
      <span class="font-label-caps text-label-caps text-off-white/50 tracking-widest">SCROLL</span>
    </div>
  </section>

  <!-- New Arrivals — Bento Grid -->
  <section class="py-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto" id="new-arrivals">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <SectionHeading
        label={t("home.newArrivals.label", lang) || "NEW IN"}
        title={t("home.newArrivals.title", lang)}
        subtitle={t("home.newArrivals.subtitle", lang)}
      />
      <AnimatedReveal delay={2}>
        <a href={`/${lang}/catalogo`} class="font-label-caps text-label-caps text-monolith-black border-b border-monolith-black pb-1 hover:text-secondary hover:border-secondary transition-all duration-300 uppercase whitespace-nowrap">{t("home.newArrivals.viewAll", lang)}</a>
      </AnimatedReveal>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <a
        href={`/${lang}/producto/${newArrivals[0]?.slug}`}
        class="group md:col-span-7 flex flex-col relative overflow-hidden bg-surface-container-low h-[500px] md:h-[600px] reveal"
      >
        <div class="absolute inset-0 bg-monolith-black/10 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <img
          src={newArrivalImages[0]}
          alt={newArrivals[0]?.name}
          class="w-full h-full object-cover object-center img-lift"
        />
        <div class="absolute bottom-0 left-0 right-0 p-10 z-20">
          <div class="flex items-center gap-3 mb-3">
            <span class="arch-line arch-line-clay"></span>
            <span class="font-label-caps text-label-caps text-clay-accent tracking-widest">NEW</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-off-white">{newArrivals[0]?.name}</h3>
          <p class="font-price-display text-price-display text-off-white/70 mt-1">${newArrivals[0]?.price}</p>
        </div>
      </a>

      <div class="md:col-span-5 flex flex-col gap-gutter">
        <a
          href={`/${lang}/producto/${newArrivals[1]?.slug}`}
          class="group flex-1 flex flex-col relative overflow-hidden bg-surface-container-low h-[240px] md:h-[286px] reveal reveal-delay-2"
        >
          <img
            src={newArrivalImages[1]}
            alt={newArrivals[1]?.name}
            class="w-full h-full object-cover object-center img-lift"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-monolith-black/50 to-transparent"></div>
          <div class="absolute bottom-5 left-5 z-10">
            <span class="font-label-caps text-label-caps text-off-white bg-monolith-black/70 px-3 py-1.5 backdrop-blur-sm">{newArrivals[1]?.name}</span>
          </div>
        </a>

        <a
          href={`/${lang}/producto/${newArrivals[2]?.slug}`}
          class="group flex-1 flex flex-col relative overflow-hidden bg-sand-nude h-[240px] md:h-[286px] reveal reveal-delay-3"
        >
          <img
            src={newArrivalImages[2]}
            alt={newArrivals[2]?.name}
            class="w-full h-full object-cover object-center img-lift mix-blend-multiply"
          />
          <div class="absolute bottom-5 left-5 z-10">
            <span class="font-label-caps text-label-caps text-monolith-black bg-off-white/80 px-3 py-1.5 backdrop-blur-sm">{newArrivals[2]?.name}</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Seasonal Trends — Concrete Texture Section -->
  <section class="relative py-section-gap px-margin-mobile md:px-margin-desktop bg-concrete overflow-hidden">
    <div class="noise-overlay opacity-[0.1]"></div>
    <div class="max-w-container-max mx-auto flex flex-col lg:flex-row items-center gap-16 lg:gap-24 relative z-10">
      <div class="w-full lg:w-1/2 flex flex-col items-start">
        <AnimatedReveal>
          <span class="font-label-caps text-label-caps text-deep-rust tracking-widest mb-4 block">{t("home.trends.label", lang)}</span>
          <span class="arch-line arch-line-clay mb-6"></span>
          <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-monolith-black leading-tight">
            {t("home.trends.title", lang)}
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-lg mt-4">
            {t("home.trends.subtitle", lang)}
          </p>
        </AnimatedReveal>
        <AnimatedReveal delay={2}>
          <a
            href={`/${lang}/catalogo`}
            class="inline-flex items-center justify-center bg-monolith-black text-off-white font-label-caps text-label-caps h-14 px-8 mt-8 hover:tracking-[0.15em] transition-all duration-300"
          >
            {t("home.trends.cta", lang)}
          </a>
        </AnimatedReveal>
      </div>
      <div class="w-full lg:w-1/2 flex justify-center lg:justify-end relative reveal reveal-delay-3">
        <div class="relative w-full max-w-md">
          <div class="absolute -inset-4 bg-monolith-black/5 rotate-2 rounded-sm"></div>
          <div class="absolute -inset-2 bg-off-white/60 -rotate-1 rounded-sm"></div>
          <img
            src={seasonalTrendImage}
            alt="Seasonal Trend"
            class="w-full h-auto object-cover relative z-10 shadow-lg"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Curated Selection -->
  <section class="py-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="text-center mb-16">
      <SectionHeading
        label={t("home.curated.label", lang) || "COLLECTION"}
        title={t("home.curated.title", lang)}
        align="center"
      />
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-gutter gap-y-16">
      {curated.map((p, i) => (
        <div class={`reveal ${i === 0 ? "reveal-delay-1" : i === 1 ? "reveal-delay-2" : i === 2 ? "reveal-delay-3" : "reveal-delay-4"}`}>
          <ProductCard
            name={p.name}
            price={`$${p.price.toFixed(2)}`}
            image={curatedImages[i] || p.images[0]}
            href={`/${lang}/producto/${p.slug}`}
            colors={p.colors.map((c) => c.hex)}
            productId={p.id}
            productSlug={p.slug}
            productPrice={p.price}
          />
        </div>
      ))}
    </div>
  </section>

  <Footer lang={lang} />

  <script>
    (function () {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    })();
  </script>
</BaseLayout>
