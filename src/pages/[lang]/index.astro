---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/organisms/Navbar.astro";
import Footer from "../../components/organisms/Footer.astro";
import ProductCard from "../../components/molecules/ProductCard.astro";
import SectionHeading from "../../components/molecules/SectionHeading.astro";
import AnimatedReveal from "../../components/atoms/AnimatedReveal.astro";
import Button from "../../components/atoms/Button.astro";
import { getProducts } from "../../lib/storage";
import { t, type Locale, locales } from "../../i18n/utils";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const products = await getProducts(lang);
