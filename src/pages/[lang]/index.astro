];

const curatedImages = [
  "https://lh3.googleusercontent.com/aida-public/AB6AXuCxt0xKD0xkmqYwRRkIppDgeQZ3WPwtuFrKTkUQIxT4SZxHzQsBb60vDyTIpmpWAr1ZPhShQRB4B9zrMt9qeDW-pKXgJ6_A_llefBCGknjvh5W16CxeZ8qJ1_H1SOaGc7S-SS2aQ-CHcsk-U3pdPEY876OIVxvLqlcupi4NSLtv5MfRI730RvZa3JSOKYgvss-UP6qya8SpNFI2X3qqd81K3FCP2tiJV_aFMKUzht4CV7MZCRmyBlEa3Xl9rosqlGitOkNiSFc-qYI",
