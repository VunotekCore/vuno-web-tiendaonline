---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/organisms/Navbar.astro'
import Footer from '../../../components/organisms/Footer.astro'
import { getProducts } from '../../../lib/storage'
import { t, type Locale } from '../../../i18n/utils'
import { tenant } from '../../../config/tenant'
import fallbackProducts from '../../../data/products.json'

interface FallbackProd {
  slug: string;
  name: string;
}

export async function getStaticPaths() {
  let esProducts = await getProducts('es')
  let enProducts = await getProducts('en')
  if (esProducts.length === 0) {
    const fb = fallbackProducts as unknown as FallbackProd[]
    esProducts = fb.map((p: FallbackProd) => ({ slug: p.slug })) as any
    enProducts = fb.map((p: FallbackProd) => ({ slug: p.slug })) as any
  }
  const paths = []
  for (const p of esProducts) paths.push({ params: { lang: 'es' as Locale, slug: p.slug } })
  for (const p of enProducts) paths.push({ params: { lang: 'en' as Locale, slug: p.slug } })
  return paths
}

const { lang } = Astro.params as { lang: Locale }

const i18n = {
  selectSize: t('product.selectSize', lang),
  addedToCart: t('product.addedToCart', lang),
  addToCart: t('product.addToCart', lang),
  reviewsTitle: t('product.reviews.title', lang),
  reviewsLeave: t('product.reviews.leave', lang),
  reviewsName: t('product.reviews.name', lang),
  reviewsEmail: t('product.reviews.email', lang),
  reviewsRating: t('product.reviews.rating', lang),
  reviewsTitlePlaceholder: t('product.reviews.titlePlaceholder', lang),
  reviewsComment: t('product.reviews.comment', lang),
  reviewsSubmit: t('product.reviews.submit', lang),
  reviewsSending: t('product.reviews.sending', lang),
  reviewsSuccess: t('product.reviews.success', lang),
  reviewsError: t('product.reviews.error', lang),
  reviewsNameRequired: t('product.reviews.nameRequired', lang),
  reviewsRatingRequired: t('product.reviews.ratingRequired', lang),
  reviewsAverage: t('product.reviews.average', lang),
  reviewsReview: t('product.reviews.review', lang),
  reviewsReviews: t('product.reviews.reviews', lang),
  reviewsEmpty: t('product.reviews.empty', lang),
  reviewsAnonymous: t('product.reviews.anonymous', lang),
  collection: t('product.collection', lang),
  sizeGuideLabel: t('product.sizeGuide', lang),
  relatedTitle: t('product.related', lang),
  relatedViewAll: t('product.related.viewAll', lang),
  shippingText: t('product.shippingText', lang),
  descriptionLabel: t('product.description', lang),
  careLabel: t('product.care', lang),
  shippingLabel: t('product.shipping', lang),
  colorLabel: t('product.color', lang),
  sizeLabel: t('product.size', lang),
}

const currentPath = Astro.url.pathname
---

<BaseLayout
  title={tenant.brand.name}
  description={tenant.seo.defaultDescription}
  lang={lang}
>
  <Navbar lang={lang} currentPath={currentPath} />

  <main class="w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pt-14 md:pt-20 pb-section-gap" id="productApp">
    <div id="productSkeleton" class="grid grid-cols-1 md:grid-cols-12 gap-gutter animate-pulse">
      <div class="md:col-span-7">
        <div class="flex gap-2">
          <div class="flex-1 min-w-0">
            <div class="w-full bg-surface-container" style="height: min(65dvh, 550px);"></div>
          </div>
          <div class="flex flex-col gap-2 w-[72px] shrink-0">
            <div class="w-full aspect-[4/5] bg-surface-container"></div>
            <div class="w-full aspect-[4/5] bg-surface-container"></div>
            <div class="w-full aspect-[4/5] bg-surface-container"></div>
          </div>
        </div>
      </div>
      <div class="md:col-span-4 md:col-start-9 pt-8 md:pt-0">
        <div class="flex flex-col gap-6">
          <div class="h-4 bg-surface-container w-1/3 rounded"></div>
          <div class="h-8 bg-surface-container w-3/4 rounded"></div>
          <div class="h-6 bg-surface-container w-1/4 rounded mt-2"></div>
          <div class="flex gap-3 mt-4">
            <div class="w-7 h-7 rounded-full bg-surface-container"></div>
            <div class="w-7 h-7 rounded-full bg-surface-container"></div>
            <div class="w-7 h-7 rounded-full bg-surface-container"></div>
          </div>
          <div class="grid grid-cols-4 gap-2 mt-4">
            <div class="h-12 bg-surface-container rounded"></div>
            <div class="h-12 bg-surface-container rounded"></div>
            <div class="h-12 bg-surface-container rounded"></div>
            <div class="h-12 bg-surface-container rounded"></div>
          </div>
          <div class="h-14 bg-surface-container mt-4 rounded"></div>
        </div>
      </div>
    </div>
    <div id="productError" class="hidden text-center py-20">
      <p class="font-headline-md text-headline-md text-secondary mb-4">Producto no encontrado</p>
      <a href={`/${lang}/catalogo`} class="inline-block bg-monolith-black text-on-primary font-label-caps text-label-caps tracking-widest h-12 px-8 leading-[48px] hover:bg-on-surface transition-all duration-300">
        {lang === 'es' ? 'VER CATÁLOGO' : 'VIEW CATALOG'}
      </a>
    </div>
  </main>

  <Footer lang={lang} />

  <script src="/js/product-detail.js" is:inline></script>
  <script is:inline define:vars={{ i18n }}>
    (function () {
      var lang = document.documentElement.lang || 'es'
      var pathParts = window.location.pathname.split('/producto/')
      var slug = pathParts[1] ? pathParts[1].replace(/\/$/, '').split('?')[0] : ''
      try { slug = decodeURIComponent(slug); } catch (e) {}

      if (slug) {
        ProductDetail.init(slug, lang, i18n)
      } else {
        var skeleton = document.getElementById('productSkeleton')
        var errorEl = document.getElementById('productError')
        if (skeleton) skeleton.classList.add('hidden')
        if (errorEl) errorEl.classList.remove('hidden')
      }
    })()
  </script>
</BaseLayout>
