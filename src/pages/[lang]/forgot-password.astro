---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/organisms/Navbar.astro";
import Footer from "../../components/organisms/Footer.astro";
import { t, type Locale, locales } from "../../i18n/utils";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const currentPath = Astro.url.pathname;
---

<BaseLayout title={lang === "es" ? "Recuperar Contraseña | Vunotek" : "Reset Password | Vunotek"} lang={lang} seo={{ noindex: true }}>
  <Navbar lang={lang} currentPath={currentPath} />
  <main class="flex-grow w-full max-w-md mx-auto px-margin-mobile md:px-margin-desktop py-section-gap">
    <div class="text-center mb-10">
      <h1 class="font-headline text-headline-lg-mobile md:text-headline-lg mb-3">{t("auth.forgotTitle", lang)}</h1>
      <p class="font-body text-body-md text-secondary">{t("auth.forgotSubtitle", lang)}</p>
    </div>

    <div id="forgotMsg" class="hidden font-body text-body-md p-3 mb-6 text-center"></div>

    <form id="forgotForm" class="flex flex-col gap-6">
      <div>
        <label class="font-label-caps text-label-caps text-secondary block mb-2 tracking-widest">{t("auth.email", lang)}</label>
        <input id="forgotEmail" type="email" required class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-monolith-black focus:outline-none transition-colors" />
      </div>
      <button type="submit" id="forgotBtn" class="w-full bg-monolith-black text-off-white font-label-caps text-label-caps h-12 inline-flex items-center justify-center hover:bg-monolith-black/90 transition-all tracking-widest">
        {t("auth.sendResetLink", lang)}
      </button>
    </form>

    <p class="font-body text-body-md text-secondary text-center mt-8">
      <a href={`/${lang}/login`} class="text-monolith-black underline hover:no-underline font-medium">
        {t("auth.backToLogin", lang)}
      </a>
    </p>
  </main>
  <Footer lang={lang} />

  <script>
    // @ts-nocheck
    const LANG = document.querySelector("html").getAttribute("lang") || "es";

    document.getElementById("forgotForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = document.getElementById("forgotEmail").value.trim();
      const btn = document.getElementById("forgotBtn");
      const msg = document.getElementById("forgotMsg");

      msg.classList.add("hidden");
      btn.disabled = true;
      btn.textContent = "...";

      try {
        const res = await window.__api.post("/api/customer/forgot-password.php", { email, lang: LANG });
        const data = res.data;
        if (data.error) throw new Error(data.error || "Error");
        msg.textContent = data.message;
        msg.className = "font-body text-body-md p-3 mb-6 text-center bg-green-100 text-green-800";
        msg.classList.remove("hidden");
      } catch (err) {
        msg.textContent = err.message;
        msg.className = "font-body text-body-md p-3 mb-6 text-center bg-red-100 text-error";
        msg.classList.remove("hidden");
      }

      btn.disabled = false;
      btn.textContent = document.querySelector("[data-send-text]")?.textContent || "SEND RESET LINK";
    });
  </script>
</BaseLayout>
