---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/organisms/Navbar.astro";
import Footer from "../components/organisms/Footer.astro";

const currentPath = Astro.url.pathname;
---

<BaseLayout title="Página no encontrada">
  <Navbar lang="es" currentPath={currentPath} />

  <main id="fallbackContent">
    <!-- Default 404 content (hidden when product URL detected) -->
    <div class="min-h-screen flex items-center justify-center px-4" id="default404">
      <div class="text-center py-20">
        <h1 class="font-headline-xl text-headline-xl text-monolith-black mb-4">404</h1>
        <p class="font-body-lg text-body-lg text-secondary mb-2">Página no encontrada</p>
        <p class="font-body-md text-body-md text-secondary mb-8">La página que buscas no existe o fue movida.</p>
        <a href="/" class="bg-monolith-black text-on-primary font-label-caps text-label-caps h-14 px-10 inline-flex items-center hover:tracking-[0.15em] transition-all duration-300">
          Volver al inicio
        </a>
      </div>
    </div>

    <!-- Product detail container (hidden by default) -->
    <div id="productApp" class="hidden w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pt-14 md:pt-20 pb-section-gap">
      <div id="productSkeleton" class="grid grid-cols-1 md:grid-cols-12 gap-gutter animate-pulse">
        <div class="md:col-span-7">
          <div class="flex gap-2">
            <div class="flex-1 min-w-0">
              <div class="w-full bg-surface-container" style="height: min(65dvh, 550px);"></div>
            </div>
            <div class="flex flex-col gap-2 w-[72px] shrink-0">
              <div class="w-full aspect-[4/5] bg-surface-container"></div>
              <div class="w-full aspect-[4/5] bg-surface-container"></div>
              <div class="w-full aspect-[4/5] bg-surface-container"></div>
            </div>
          </div>
        </div>
        <div class="md:col-span-4 md:col-start-9 pt-8 md:pt-0">
          <div class="flex flex-col gap-6">
            <div class="h-4 bg-surface-container w-1/3 rounded"></div>
            <div class="h-8 bg-surface-container w-3/4 rounded"></div>
            <div class="h-6 bg-surface-container w-1/4 rounded mt-2"></div>
            <div class="flex gap-3 mt-4">
              <div class="w-7 h-7 rounded-full bg-surface-container"></div>
              <div class="w-7 h-7 rounded-full bg-surface-container"></div>
              <div class="w-7 h-7 rounded-full bg-surface-container"></div>
            </div>
            <div class="grid grid-cols-4 gap-2 mt-4">
              <div class="h-12 bg-surface-container rounded"></div>
              <div class="h-12 bg-surface-container rounded"></div>
              <div class="h-12 bg-surface-container rounded"></div>
              <div class="h-12 bg-surface-container rounded"></div>
            </div>
            <div class="h-14 bg-surface-container mt-4 rounded"></div>
          </div>
        </div>
      </div>
      <div id="productError" class="hidden text-center py-20">
        <p class="font-headline-md text-headline-md text-secondary mb-4" id="productErrorText">Producto no encontrado</p>
        <a id="productErrorLink" href="/es/catalogo" class="inline-block bg-monolith-black text-on-primary font-label-caps text-label-caps tracking-widest h-12 px-8 leading-[48px] hover:bg-on-surface transition-all duration-300">
          VER CATÁLOGO
        </a>
      </div>
    </div>
  </main>

  <Footer lang="es" />

  <script src="/js/product-detail.js" is:inline></script>
  <script is:inline>
    (function () {
      var path = window.location.pathname;
      var match = path.match(/^\/(?:(en|es)\/)?producto\/(.+)$/);
      if (!match) return;

      var lang = match[1] || "es";
      var slug = decodeURIComponent(match[2]);

      // Hide default 404, show product container
      var default404 = document.getElementById("default404");
      if (default404) default404.style.display = "none";

      var productApp = document.getElementById("productApp");
      if (productApp) productApp.classList.remove("hidden");

      // Update error link with correct lang
      var errorLink = document.getElementById("productErrorLink");
      if (errorLink) errorLink.href = "/" + lang + "/catalogo";
      var errorText = document.getElementById("productErrorText");
      if (errorText) {
        errorText.textContent = lang === "es" ? "Producto no encontrado" : "Product not found";
      }

      // i18n translations for product detail
      var i18n = {
        selectSize: lang === "es" ? "Selecciona una talla" : "Select a size",
        addedToCart: lang === "es" ? "¡Añadido al carrito!" : "Added to cart!",
        addToCart: lang === "es" ? "Añadir al carrito" : "Add to cart",
        reviewsTitle: lang === "es" ? "Reseñas" : "Reviews",
        reviewsLeave: lang === "es" ? "Deja tu reseña" : "Leave a review",
        reviewsName: lang === "es" ? "Nombre" : "Name",
        reviewsEmail: lang === "es" ? "Email" : "Email",
        reviewsRating: lang === "es" ? "Puntuación" : "Rating",
        reviewsTitlePlaceholder: lang === "es" ? "Título (opcional)" : "Title (optional)",
        reviewsComment: lang === "es" ? "Comentario" : "Comment",
        reviewsSubmit: lang === "es" ? "Enviar reseña" : "Submit review",
        reviewsSending: lang === "es" ? "Enviando..." : "Sending...",
        reviewsSuccess: lang === "es" ? "Reseña enviada" : "Review submitted",
        reviewsError: lang === "es" ? "Error al enviar reseña" : "Error submitting review",
        reviewsNameRequired: lang === "es" ? "El nombre es obligatorio" : "Name is required",
        reviewsRatingRequired: lang === "es" ? "Selecciona una puntuación" : "Select a rating",
        reviewsAverage: lang === "es" ? "promedio" : "average",
        reviewsReview: lang === "es" ? "reseña" : "review",
        reviewsReviews: lang === "es" ? "reseñas" : "reviews",
        reviewsEmpty: lang === "es" ? "No hay reseñas aún" : "No reviews yet",
        reviewsAnonymous: lang === "es" ? "Anónimo" : "Anonymous",
        collection: lang === "es" ? "COLECCIÓN" : "COLLECTION",
        sizeGuideLabel: lang === "es" ? "Guía de talles" : "Size Guide",
        relatedTitle: lang === "es" ? "También te puede gustar" : "You may also like",
        relatedViewAll: lang === "es" ? "VER TODO" : "VIEW ALL",
        shippingText: lang === "es" ? "Envíos a todo el país" : "Shipping nationwide",
        descriptionLabel: lang === "es" ? "DESCRIPCIÓN" : "DESCRIPTION",
        careLabel: lang === "es" ? "CUIDADOS" : "CARE",
        shippingLabel: lang === "es" ? "ENVÍOS" : "SHIPPING",
        colorLabel: lang === "es" ? "COLOR" : "COLOR",
        sizeLabel: lang === "es" ? "TALLA" : "SIZE"
      };

      if (slug) {
        ProductDetail.init(slug, lang, i18n);
      }
    })();
  </script>
</BaseLayout>
