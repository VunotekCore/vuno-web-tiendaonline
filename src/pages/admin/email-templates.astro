---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Plantillas Email" currentPath="/admin/email-templates">
  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-4 w-full lg:w-auto">
      <div class="relative flex-1 lg:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <input type="text" id="searchInput" placeholder="Buscar plantillas..." aria-label="Buscar plantillas" class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md focus-visible:ring-2 focus-visible:ring-monolith-black" />
      </div>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="templateCount">0 plantillas</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
      <button id="reseedBtn" class="border border-monolith-black/20 text-secondary font-label-caps text-label-caps h-10 px-4 inline-flex items-center justify-center gap-1.5 rounded-md hover:border-monolith-black hover:text-monolith-black hover:bg-monolith-black/5 transition-all duration-200 shrink-0 w-full sm:w-auto">
        <span class="material-symbols-outlined text-lg" id="reseedIcon">refresh</span>
        RESEED
      </button>
      <a href="/admin/email-templates/nuevo" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 shrink-0 w-full sm:w-auto">
        <span class="material-symbols-outlined text-lg">add</span>
        NUEVA PLANTILLA
      </a>
    </div>
  </div>

  <!-- Desktop table -->
  <div class="hidden lg:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">CÓDIGO</th>
            <th class="p-4 font-medium">NOMBRE</th>
            <th class="p-4 font-medium">ASUNTO</th>
            <th class="p-4 font-medium">ESTADO</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="templatesTableBody">
          <tr>
            <td colspan="5" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="pagination" class="flex items-center justify-center gap-2 p-4 border-t border-outline-variant"></div>
  </div>

  <!-- Mobile cards -->
  <div id="mobileCards" class="block lg:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-error">warning</span>
        <h3 id="deleteModalTitle" class="font-headline text-headline-md">Eliminar Plantilla</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <p class="font-body text-body-md text-xs text-error/70 mb-6 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">info</span>
        Esta acción no se puede deshacer.
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="deleteIcon">delete</span>
          <span id="deleteBtnText">ELIMINAR</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #deleteModal:not(.hidden) {
      display: flex;
    }
  </style>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 10;
    let currentPage = 1;
    let templates = [];
    let deleteId = null;
    let searchTimeout = null;

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Procesando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "delete";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove("hidden");
      el.classList.add("flex");
      const content = el.querySelector(".modal-content");
      if (content) {
        content.style.animation = "none";
        void content.offsetHeight;
        content.style.animation = "";
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add("hidden");
      el.classList.remove("flex");
    }

    async function loadTemplates(page) {
      currentPage = page;
      const search = document.getElementById("searchInput").value.trim();
      let url = `/api/email-templates/list.php?page=${page}&limit=${PAGE_LIMIT}`;
      if (search) url += `&search=${encodeURIComponent(search)}`;

      try {
        const res = await fetch(url);
        const data = await res.json();
        templates = data.items || [];
        document.getElementById("templateCount").textContent = data.total + " plantillas";
        renderTable(templates);
        renderPagination(data.pages || 1);
        renderMobileCards(templates);
      } catch {
        document.getElementById("templatesTableBody").innerHTML = '<tr><td colspan="5" class="p-8 text-center text-error">Error loading templates</td></tr>';
      }
    }

    function renderTable(items) {
      const tbody = document.getElementById("templatesTableBody");
      if (!items.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-12 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-5xl text-secondary/30">mail</span><p class="font-body text-body-md text-secondary">No hay plantillas aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primera plantilla o usa el seed</p></div></td></tr>';
        return;
      }
      tbody.innerHTML = items.map(t => {
        const badgeClass = t.is_active ? "bg-monolith-black text-off-white" : "bg-monolith-black/10 text-monolith-black";
        return `<tr class="border-t border-outline-variant hover:bg-monolith-black/[0.02] transition-colors border-l-2 border-l-transparent hover:border-l-clay-accent/50">
          <td class="p-4 font-body text-body-sm font-mono text-clay-accent font-medium">${t.code || "—"}</td>
          <td class="p-4 font-body text-body-md text-monolith-black font-medium max-w-xs truncate">${t.name || "Untitled"}</td>
          <td class="p-4 font-body text-body-md text-secondary max-w-sm truncate">${t.subject || "—"}</td>
          <td class="p-4"><span class="inline-block font-label-caps text-label-caps px-2 py-1 rounded-sm ${badgeClass}">${t.is_active ? "active" : "inactive"}</span></td>
           <td class="p-4">
             <div class="flex gap-2">
               <a href="/admin/email-templates/editar?id=${t.id}" class="inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm">
                 <span class="material-symbols-outlined text-sm">edit</span>
                 EDITAR
               </a>
               <span class="inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm cursor-pointer" onclick="confirmDelete(${t.id}, '${t.name.replace(/'/g, "\\'")}')">
                 <span class="material-symbols-outlined text-sm">delete</span>
                 ELIMINAR
               </span>
             </div>
           </td>
        </tr>`;
      }).join("");
    }

    function renderMobileCards(items) {
      const container = document.getElementById("mobileCards");
      if (!items.length) {
        container.innerHTML = '<div class="flex flex-col items-center gap-3 p-12 text-center"><span class="material-symbols-outlined text-5xl text-secondary/30">mail</span><p class="font-body text-body-md text-secondary">No hay plantillas aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primera plantilla o usa el seed</p></div>';
        return;
      }
      container.innerHTML = items.map(t => {
        const badgeClass = t.is_active ? "bg-monolith-black text-off-white" : "bg-monolith-black/10 text-monolith-black";
        return `<div class="bg-off-white border border-outline-variant rounded-sm p-4 border-l-2 border-l-transparent hover:border-l-clay-accent/50 transition-all duration-200">
          <div class="flex justify-between items-start mb-2">
            <div class="min-w-0 flex-1">
              <h3 class="font-body text-body-md text-monolith-black font-medium truncate">${t.name || "Untitled"}</h3>
              <p class="font-body text-body-sm font-mono text-clay-accent mt-0.5">${t.code || "—"}</p>
            </div>
            <span class="font-label-caps text-label-caps px-2 py-0.5 rounded-sm shrink-0 ml-2 ${badgeClass}">${t.is_active ? "active" : "inactive"}</span>
          </div>
          <p class="font-body text-body-sm text-secondary truncate mb-3">${t.subject || "—"}</p>
          <div class="flex gap-2">
            <a href="/admin/email-templates/editar?id=${t.id}" class="flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm">
              <span class="material-symbols-outlined text-sm">edit</span> EDITAR
            </a>
            <span class="flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm cursor-pointer" onclick="confirmDelete(${t.id}, '${t.name.replace(/'/g, "\\'")}')">
              <span class="material-symbols-outlined text-sm">delete</span> ELIMINAR
            </span>
          </div>
        </div>`;
      }).join("");
    }

    function renderPagination(totalPages) {
      const container = document.getElementById("pagination");
      if (totalPages <= 1) { container.innerHTML = ""; return; }
      let html = '<button class="w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + ' onclick="loadTemplates(' + (currentPage - 1) + ')"><span class="material-symbols-outlined text-sm">chevron_left</span></button>';
      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant text-secondary hover:border-monolith-black hover:text-monolith-black';
        html += `<button class="w-9 h-9 flex items-center justify-center border rounded-sm transition-all font-body text-body-md text-sm ${active}" onclick="loadTemplates(${i})">${i}</button>`;
      }
      html += '<button class="w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + ' onclick="loadTemplates(' + (currentPage + 1) + ')"><span class="material-symbols-outlined text-sm">chevron_right</span></button>';
      container.innerHTML = html;
    }

    function confirmDelete(id, name) {
      deleteId = id;
      document.getElementById("deleteItemName").textContent = name;
      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
      openModal("deleteModal");
    }

    document.getElementById("deleteCancelBtn").addEventListener("click", () => closeModal("deleteModal"));
    document.getElementById("deleteModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeModal("deleteModal");
    });
    document.getElementById("deleteConfirmBtn").addEventListener("click", async () => {
      if (!deleteId) return;
      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", true, "Eliminando...");
      try {
        const res = await fetch("/api/email-templates/delete.php", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: deleteId }) });
        if (!res.ok) throw new Error("Delete failed");
        closeModal("deleteModal");
        loadTemplates(currentPage);
      } catch (err) {
        setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
        window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: err.message || "Error deleting template" });
      }
    });

    document.getElementById("searchInput").addEventListener("input", () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => loadTemplates(1), 300);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !document.getElementById("deleteModal").classList.contains("hidden")) {
        closeModal("deleteModal");
      }
    });

    document.getElementById("deleteIcon").dataset.origIcon = "delete";

    // Reseed from files
    document.getElementById("reseedBtn").addEventListener("click", async () => {
      const btn = document.getElementById("reseedBtn");
      const icon = document.getElementById("reseedIcon");
      btn.disabled = true;
      icon.textContent = "progress_activity";
      icon.classList.add("animate-spin");
      try {
        const res = await fetch("/api/email-templates/seed.php", { method: "POST" });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        window.VunoModal.alert({ type: "success", title: "Reseed completado", message: data.seeded + " nuevas, " + data.updated + " actualizadas" + (data.errors.length ? ". Errores: " + data.errors.join(", ") : "") });
        loadTemplates(1);
      } catch (err) {
        window.VunoModal.alert({ type: "error", title: "Error al reseed", message: err.message });
      }
      btn.disabled = false;
      icon.textContent = "refresh";
      icon.classList.remove("animate-spin");
    });

    loadTemplates(1);
  </script>
</AdminLayout>
