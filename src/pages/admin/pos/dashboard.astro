---
import AdminLayout from "../_layout.astro";
---
<AdminLayout title="Dashboard Mostrador" currentPath="/admin/pos/dashboard">
  <div id="loading" class="font-body text-body-md text-secondary p-4 text-center">
    <span class="material-symbols-outlined text-3xl block mb-2 animate-spin">progress_activity</span>
    Cargando dashboard...
  </div>
  <div id="error" class="hidden font-body text-body-md text-error bg-error/10 p-3 rounded-sm"></div>

  <div id="dashboardContent" class="hidden space-y-8">
    <!-- Stats cards -->
    <div id="statsCards" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-6"></div>

    <!-- Quick actions row -->
    <div class="flex items-center gap-4">
      <a href="/admin/pos"
         class="inline-flex items-center gap-2 bg-monolith-black text-off-white font-label-caps text-label-caps
                min-h-[44px] px-6 rounded-sm hover:bg-monolith-black/90 transition-all cursor-pointer">
        <span class="material-symbols-outlined text-lg">point_of_sale</span>
        Ir a Mostrador POS
      </a>
    </div>

    <!-- Two-column layout: Recent orders + Payment breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-6">
      <!-- Recent orders -->
      <div class="lg:col-span-2 bg-off-white border border-outline-variant">
        <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-outline-variant/50">
          <h2 class="font-headline text-headline-sm sm:text-headline-md">Últimas Ventas POS</h2>
        </div>
        <div id="recentOrders" class="p-3 sm:p-4">
          <p class="font-body text-body-sm sm:text-body-md text-secondary">Sin ventas recientes.</p>
        </div>
      </div>

      <!-- Payment method breakdown -->
      <div class="bg-off-white border border-outline-variant">
        <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-outline-variant/50">
          <h2 class="font-headline text-headline-sm sm:text-headline-md">Hoy por Método</h2>
        </div>
        <div id="paymentBreakdown" class="p-3 sm:p-4">
          <p class="font-body text-body-sm sm:text-body-md text-secondary">Sin ventas hoy.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    (async function () {
      try {
        const res = await fetch("/api/pos/stats.php");
        if (!res.ok) throw new Error("Failed to load stats");
        const data = await res.json();
        const sym = data.currency?.symbol || '$';

        // Cards
        const cancelled = data.cancelled || {};
        const cards = [
          {
            label: "Ventas Hoy",
            value: sym + formatPrice(data.today?.display_total_sales || 0),
            icon: "payments",
          },
          {
            label: "Pedidos Hoy",
            value: data.today?.order_count || 0,
            icon: "receipt_long",
          },
          {
            label: "Productos Vendidos",
            value: data.today?.total_items || 0,
            icon: "inventory_2",
          },
          {
            label: "Ticket Promedio",
            value: sym + formatPrice(data.today?.display_avg_ticket || 0),
            icon: "trending_up",
          },
          {
            label: "Canceladas",
            value: cancelled.count > 0
              ? cancelled.count + ' (' + sym + formatPrice(cancelled.display_total || 0) + ')'
              : 0,
            icon: "cancel",
            muted: cancelled.count === 0,
          },
        ];

        document.getElementById("statsCards").innerHTML = cards.map(c => `
          <div class="bg-off-white border ${c.label === 'Canceladas' && c.value !== 0 && !c.muted ? 'border-error/30' : 'border-outline-variant'} p-4 sm:p-5 flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="font-label-caps text-label-caps ${c.muted ? 'text-secondary/40' : 'text-secondary'}">${c.label}</span>
              <span class="material-symbols-outlined text-lg sm:text-xl ${c.muted ? 'text-secondary/20' : 'text-secondary'}">${c.icon}</span>
            </div>
            <span class="font-headline text-headline-md sm:text-headline-lg truncate ${c.muted ? 'text-secondary/40' : 'text-monolith-black'}">${c.value}</span>
          </div>
        `).join("");

        // Recent orders
        const orders = data.recent_orders || [];
        const ordersEl = document.getElementById("recentOrders");
        if (orders.length > 0) {
          ordersEl.innerHTML = orders.map(o => {
            const pmIcon = paymentIcon(o.payment_method_code);
            return `<div class="flex items-center justify-between py-2.5 sm:py-3 border-b border-outline-variant/30 last:border-0">
              <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <span class="material-symbols-outlined text-base sm:text-lg text-secondary/40 shrink-0">${pmIcon}</span>
                <div class="min-w-0">
                  <a href="/admin/pedidos/detalle?id=${encodeURIComponent(o.order_number)}"
                     class="font-body text-body-sm sm:text-body-md text-monolith-black hover:underline truncate block max-w-[140px] sm:max-w-none">${escHtml(o.order_number)}</a>
                  <p class="font-body text-body-xs sm:text-body-sm text-secondary truncate">${escHtml(o.customer_name || 'Mostrador')}</p>
                </div>
              </div>
              <div class="text-right shrink-0 ml-3 sm:ml-4">
                <span class="font-price-display text-price-display text-xs sm:text-sm">${o.display_symbol || sym}${formatPrice(o.display_total || 0)}</span>
                <p class="font-label-caps text-label-caps text-2xs sm:text-xs text-secondary">${o.items_count} ítem(s) · ${o.time}</p>
              </div>
            </div>`;
          }).join("");
        } else {
          ordersEl.innerHTML = '<p class="font-body text-body-md text-secondary">Sin ventas recientes.</p>';
        }

        // Payment method breakdown
        const pmData = data.payment_methods || [];
        const pmEl = document.getElementById("paymentBreakdown");
        if (pmData.length > 0) {
          const totalValue = pmData.reduce((s, p) => s + p.count, 0);
          pmEl.innerHTML = pmData.map(pm => {
            const pct = totalValue > 0 ? Math.round(pm.count / totalValue * 100) : 0;
            const pmIcon = paymentIcon(pm.code);
            return `<div class="py-2.5 sm:py-3 border-b border-outline-variant/30 last:border-0">
              <div class="flex items-center justify-between mb-1">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-base sm:text-lg text-secondary">${pmIcon}</span>
                  <span class="font-body text-body-sm sm:text-body-md">${escHtml(pm.name)}</span>
                </div>
                <span class="font-price-display text-price-display text-xs sm:text-sm">${sym}${formatPrice(pm.display_total || 0)}</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="flex-1 h-1.5 sm:h-2 bg-monolith-black/5 rounded-sm overflow-hidden">
                  <div class="h-full bg-monolith-black rounded-sm transition-all" style="width:${pct}%"></div>
                </div>
                <span class="font-label-caps text-label-caps text-2xs sm:text-xs text-secondary w-10 sm:w-12 text-right">${pm.count} · ${pct}%</span>
              </div>
            </div>`;
          }).join("");
        } else {
          pmEl.innerHTML = '<p class="font-body text-body-md text-secondary text-center py-6">No hay ventas hoy.</p>';
        }

        document.getElementById("loading").classList.add("hidden");
        document.getElementById("dashboardContent").classList.remove("hidden");
      } catch (err) {
        document.getElementById("loading").classList.add("hidden");
        const errEl = document.getElementById("error");
        errEl.classList.remove("hidden");
        errEl.textContent = "Error al cargar dashboard: " + err.message;
      }
    })();

    function paymentIcon(code) {
      const icons = {
        pos_cash: 'payments',
        pos_card: 'credit_card',
        pos_transfer: 'account_balance',
        stripe: 'credit_card',
        transfer: 'account_balance',
      };
      return icons[code] || 'receipt';
    }

    function formatPrice(val) {
      const fixed = (parseFloat(val) || 0).toFixed(2);
      const parts = fixed.split('.');
      parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return parts.join('.');
    }

    function escHtml(str) {
      const div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }
  </script>
</AdminLayout>
