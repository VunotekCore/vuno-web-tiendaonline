---
import AdminLayout from "../_layout.astro";
---

<AdminLayout title="Editar Plantilla Email" currentPath="/admin/email-templates">
  <form id="templateForm" class="max-w-3xl">
    <div id="loading" class="font-body text-body-md text-secondary p-4">Loading...</div>
    <div id="formContent" class="hidden">
      <div id="message" class="hidden font-body text-body-md p-3 mb-6 rounded-sm"></div>

      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6 space-y-6">
        <h2 class="font-headline text-headline-md flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">mail</span>
          Editar Plantilla
        </h2>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">CÓDIGO *</label>
          <div class="relative">
            <input type="text" id="fieldCode" required maxlength="100" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm transition-colors" />
            <span id="codeCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/100</span>
          </div>
        </div>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">NOMBRE *</label>
          <div class="relative">
            <input type="text" id="fieldName" required maxlength="200" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors" />
            <span id="nameCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/200</span>
          </div>
        </div>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">ASUNTO *</label>
          <div class="relative">
            <input type="text" id="fieldSubject" required maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none transition-colors" />
            <span id="subjectCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/255</span>
          </div>
          <p class="font-body text-body-sm text-secondary mt-1">Usa <code class="text-clay-accent">&#123;&#123;variable&#125;&#125;</code> para datos dinámicos</p>
        </div>

        <!-- ====== VISUAL EDITOR ====== -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="font-label-caps text-label-caps text-secondary">CUERPO DE LA PLANTILLA *</label>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button type="button" id="restoreBtn" class="font-label-caps text-label-caps text-clay-accent border border-clay-accent/30 rounded-md px-3 h-8 inline-flex items-center gap-1 hover:bg-clay-accent/5 transition-all text-xs" title="Restaurar desde archivo original">
                  <span class="material-symbols-outlined text-sm">restore</span>
                  ORIGINAL
                </button>
                <button type="button" id="previewBtn" class="font-label-caps text-label-caps text-monolith-black border border-monolith-black/20 rounded-md px-3 h-8 inline-flex items-center gap-1 hover:bg-monolith-black/5 transition-all text-xs">
                  <span class="material-symbols-outlined text-sm">visibility</span>
                  VISTA PREVIA
                </button>
              </div>
              <div class="flex items-center gap-0.5 border border-outline-variant rounded-sm overflow-hidden text-xs font-label-caps">
                <button type="button" id="modeVisual" class="mode-btn active px-2.5 h-7 flex items-center gap-1 transition-colors bg-monolith-black text-off-white">
                  <span class="material-symbols-outlined text-sm">palette</span>
                  Visual
                </button>
                <button type="button" id="modeHtml" class="mode-btn px-2.5 h-7 flex items-center gap-1 transition-colors text-secondary hover:text-monolith-black">
                  <span class="material-symbols-outlined text-sm">code</span>
                  HTML
                </button>
              </div>
            </div>
          </div>

          <!-- Toolbar (visual mode) -->
          <div id="editorToolbar" class="flex flex-wrap items-center gap-0.5 p-1.5 border border-outline-variant bg-off-white rounded-t-sm select-none">
            <button type="button" data-cmd="bold" title="Negrita" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black font-bold text-sm">B</button>
            <button type="button" data-cmd="italic" title="Itálica" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black italic text-sm">I</button>
            <button type="button" data-cmd="underline" title="Subrayado" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black underline text-sm">U</button>
            <span class="w-px h-5 bg-outline-variant mx-0.5"></span>
            <button type="button" data-cmd="formatBlock" data-value="h2" title="Título grande" class="toolbar-btn px-2 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black font-body text-xs font-semibold">H2</button>
            <button type="button" data-cmd="formatBlock" data-value="h3" title="Título mediano" class="toolbar-btn px-2 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black font-body text-xs font-semibold">H3</button>
            <button type="button" data-cmd="formatBlock" data-value="p" title="Párrafo" class="toolbar-btn px-2 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black font-body text-xs">¶</button>
            <span class="w-px h-5 bg-outline-variant mx-0.5"></span>
            <button type="button" data-cmd="insertUnorderedList" title="Lista con viñetas" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black">
              <span class="material-symbols-outlined text-base">format_list_bulleted</span>
            </button>
            <button type="button" data-cmd="insertOrderedList" title="Lista numerada" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black">
              <span class="material-symbols-outlined text-base">format_list_numbered</span>
            </button>
            <span class="w-px h-5 bg-outline-variant mx-0.5"></span>
            <button type="button" data-cmd="link" title="Insertar enlace" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-monolith-black">
              <span class="material-symbols-outlined text-base">link</span>
            </button>
            <button type="button" data-cmd="unlink" title="Quitar enlace" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-secondary">
              <span class="material-symbols-outlined text-base">link_off</span>
            </button>
            <span class="w-px h-5 bg-outline-variant mx-0.5"></span>
            <button type="button" data-cmd="removeFormat" title="Limpiar formato" class="toolbar-btn w-7 h-7 flex items-center justify-center rounded-sm hover:bg-monolith-black/10 transition-colors text-secondary">
              <span class="material-symbols-outlined text-base">format_clear</span>
            </button>
          </div>

          <!-- Visual contenteditable -->
          <div id="fieldBodyVisual" contenteditable="true" class="min-h-[320px] p-4 border-x border-b border-outline-variant bg-white text-monolith-black font-body text-body-md leading-relaxed focus:outline-none focus:border-clay-accent rounded-b-sm prose prose-sm max-w-none [&_h2]:font-headline [&_h2]:text-xl [&_h2]:mb-3 [&_h3]:font-headline [&_h3]:text-lg [&_h3]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_a]:text-clay-accent [&_a]:underline" data-placeholder="Escribe aquí el contenido de la plantilla..."></div>

          <!-- HTML textarea (hidden in visual mode) -->
          <textarea id="fieldBodyHtml" rows="20" class="hidden w-full border-x border-b border-outline-variant p-3 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm leading-relaxed resize-y rounded-b-sm"></textarea>

          <!-- Status bar -->
          <div class="flex items-center justify-between px-3 py-1.5 bg-off-white border border-t-0 border-outline-variant rounded-b-sm text-xs text-secondary">
            <span id="modeIndicator" class="font-label-caps">MODO VISUAL</span>
            <span id="bodyCounter">0 caracteres</span>
          </div>

          <!-- Variable insert buttons -->
          <div class="flex flex-wrap gap-1.5 mt-3">
            <span class="text-xs font-body text-secondary flex items-center">Insertar variable:</span>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="customer_name">customer_name</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="order_id">order_id</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="order_items_html">order_items_html</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="order_subtotal">order_subtotal</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="order_total">order_total</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="order_shipping">order_shipping</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="currency_symbol">currency_symbol</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="preheader">preheader</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="payment_method">payment_method</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="customer_email">customer_email</button>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-3">
            <span class="text-xs font-body text-secondary flex items-center">Globales:</span>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="store_name">store_name</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="store_slogan">store_slogan</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="store_logo_block">store_logo_block</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="store_email">store_email</button>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-2">
            <span class="text-xs font-body text-secondary flex items-center">Newsletter:</span>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="subscriber_name">subscriber_name</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="discount_block">discount_block</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="social_links_block">social_links_block</button>
            <button type="button" class="var-hint text-xs font-mono text-clay-accent hover:text-off-white hover:bg-clay-accent bg-clay-accent/10 px-2 py-1 rounded-sm transition-all cursor-pointer" data-var="unsubscribe_url">unsubscribe_url</button>
          </div>
        </div>

        <div>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="fieldActive" checked class="w-4 h-4 border border-outline rounded-sm text-monolith-black focus:ring-0 focus:border-clay-accent" />
            <span class="font-label-caps text-label-caps text-secondary">PLANTILLA ACTIVA</span>
          </label>
        </div>
      </div>

      <div class="flex justify-end gap-3 mt-8">
        <a href="/admin/email-templates" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-5 h-10 inline-flex items-center hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</a>
        <button type="submit" id="submitBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="submitIcon">save</span>
          <span id="submitText">GUARDAR</span>
        </button>
      </div>
    </div>
  </form>

  <!-- Preview Modal -->
  <div id="previewModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm w-full max-w-4xl max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between p-4 border-b border-outline-variant shrink-0">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <h3 class="font-headline text-headline-md flex items-center gap-2">
            <span class="material-symbols-outlined text-xl">visibility</span>
            Vista Previa
          </h3>
          <span id="previewSubject" class="font-body text-body-sm text-secondary truncate"></span>
        </div>
        <button id="previewCloseX" class="w-8 h-8 flex items-center justify-center text-secondary hover:text-monolith-black transition-colors rounded-sm hover:bg-monolith-black/5 cursor-pointer shrink-0 ml-4">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      <div class="flex-1 overflow-auto p-4 bg-white">
        <iframe id="previewIframe" class="w-full h-full border-0" sandbox="allow-same-origin" title="Preview"></iframe>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #previewModal:not(.hidden) {
      display: flex;
    }
    #fieldBodyVisual:empty::before {
      content: attr(data-placeholder);
      color: #9A9A9A;
      pointer-events: none;
    }
  </style>

  <script>
    // @ts-nocheck
    const CODE_MAX = 100;
    const NAME_MAX = 200;
    const SUBJECT_MAX = 255;
    let isVisualMode = true;

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Guardando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "save";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    function setupCharCount(inputId, counterId, max) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(counterId);
      if (!input || !counter) return;
      function update() {
        const len = input.value.length;
        counter.textContent = len + "/" + max;
        counter.className = "absolute right-0 bottom-2 text-xs font-body pointer-events-none transition-colors duration-200 " +
          (len >= max ? "text-error" : len >= max * 0.8 ? "text-clay-accent" : "text-secondary");
      }
      input.addEventListener("input", update);
      update();
    }

    function updateBodyCounter() {
      const visual = document.getElementById("fieldBodyVisual");
      const html = document.getElementById("fieldBodyHtml");
      const counter = document.getElementById("bodyCounter");
      const len = isVisualMode ? (visual.innerText || "").length : html.value.length;
      counter.textContent = len + " caracteres";
    }

    function syncVisualToHtml() {
      document.getElementById("fieldBodyHtml").value = document.getElementById("fieldBodyVisual").innerHTML;
      updateBodyCounter();
    }

    function syncHtmlToVisual() {
      document.getElementById("fieldBodyVisual").innerHTML = document.getElementById("fieldBodyHtml").value;
      updateBodyCounter();
    }

    function setMode(visual) {
      isVisualMode = visual;
      const visualEl = document.getElementById("fieldBodyVisual");
      const htmlEl = document.getElementById("fieldBodyHtml");
      const toolbar = document.getElementById("editorToolbar");
      const modeVisual = document.getElementById("modeVisual");
      const modeHtml = document.getElementById("modeHtml");
      const indicator = document.getElementById("modeIndicator");

      if (visual) {
        syncHtmlToVisual();
        visualEl.classList.remove("hidden");
        htmlEl.classList.add("hidden");
        toolbar.classList.remove("hidden");
        modeVisual.className = "mode-btn active px-2.5 h-7 flex items-center gap-1 transition-colors bg-monolith-black text-off-white";
        modeHtml.className = "mode-btn px-2.5 h-7 flex items-center gap-1 transition-colors text-secondary hover:text-monolith-black";
        indicator.textContent = "MODO VISUAL";
      } else {
        syncVisualToHtml();
        visualEl.classList.add("hidden");
        htmlEl.classList.remove("hidden");
        toolbar.classList.add("hidden");
        modeHtml.className = "mode-btn active px-2.5 h-7 flex items-center gap-1 transition-colors bg-monolith-black text-off-white";
        modeVisual.className = "mode-btn px-2.5 h-7 flex items-center gap-1 transition-colors text-secondary hover:text-monolith-black";
        indicator.textContent = "MODO HTML";
      }
      updateBodyCounter();
    }

    document.getElementById("modeVisual").addEventListener("click", () => setMode(true));
    document.getElementById("modeHtml").addEventListener("click", () => setMode(false));

    function getBodyHtml() {
      if (isVisualMode) return document.getElementById("fieldBodyVisual").innerHTML;
      return document.getElementById("fieldBodyHtml").value;
    }

    // Body change tracking
    document.getElementById("fieldBodyVisual").addEventListener("input", syncVisualToHtml);
    document.getElementById("fieldBodyVisual").addEventListener("blur", syncVisualToHtml);
    document.getElementById("fieldBodyHtml").addEventListener("input", function() {
      if (!isVisualMode) updateBodyCounter();
    });

    // --- Toolbar commands ---
    document.querySelectorAll(".toolbar-btn[data-cmd]").forEach(btn => {
      btn.addEventListener("click", function() {
        const cmd = this.dataset.cmd;
        const value = this.dataset.value || null;

        if (cmd === "link") {
          const url = prompt("URL del enlace:", "https://");
          if (url) document.execCommand("createLink", false, url);
          return;
        }

        document.execCommand(cmd, false, value);
        document.getElementById("fieldBodyVisual").focus();
        syncVisualToHtml();
      });
    });

    // --- Variable insertion ---
    document.querySelectorAll(".var-hint").forEach(btn => {
      btn.addEventListener("click", function() {
        const varText = "{{" + this.dataset.var + "}}";

        if (isVisualMode) {
          const visual = document.getElementById("fieldBodyVisual");
          visual.focus();
          document.execCommand("insertText", false, varText);
          syncVisualToHtml();
        } else {
          const html = document.getElementById("fieldBodyHtml");
          const start = html.selectionStart;
          const end = html.selectionEnd;
          html.value = html.value.substring(0, start) + varText + html.value.substring(end);
          html.selectionStart = html.selectionEnd = start + varText.length;
          html.focus();
          html.dispatchEvent(new Event("input"));
          updateBodyCounter();
        }
      });
    });

    // --- Preview ---
    function openPreviewModal() {
      document.getElementById("previewModal").classList.remove("hidden");
      document.getElementById("previewModal").classList.add("flex");
      const content = document.querySelector("#previewModal .modal-content");
      content.style.animation = "none";
      void content.offsetHeight;
      content.style.animation = "";
    }
    function closePreviewModal() {
      document.getElementById("previewModal").classList.add("hidden");
      document.getElementById("previewModal").classList.remove("flex");
    }

    document.getElementById("previewBtn").addEventListener("click", async function() {
      const code = document.getElementById("fieldCode").value.trim() || "preview";
      const subject = document.getElementById("fieldSubject").value.trim();
      const bodyHtml = getBodyHtml().trim();

      if (!bodyHtml) {
        document.getElementById("message").textContent = "Escribe contenido para previsualizar.";
        document.getElementById("message").className = "font-body text-body-md text-clay-accent bg-clay-accent/10 p-3 mb-6 rounded-sm block";
        return;
      }

      openPreviewModal();
      document.getElementById("previewSubject").textContent = "—";

      try {
        const res = await fetch("/api/email-templates/preview.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code, subject, body_html: bodyHtml }),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error);

        document.getElementById("previewSubject").textContent = data.subject;

        const iframe = document.getElementById("previewIframe");
        const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
        iframeDoc.open();
        iframeDoc.write(data.body_html);
        iframeDoc.close();
      } catch (err) {
        document.getElementById("previewSubject").textContent = "Error: " + err.message;
      }
    });

    document.getElementById("previewCloseX").addEventListener("click", closePreviewModal);
    document.getElementById("previewModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closePreviewModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !document.getElementById("previewModal").classList.contains("hidden")) {
        closePreviewModal();
      }
      if (e.ctrlKey && e.shiftKey && e.key === "M") {
        e.preventDefault();
        setMode(!isVisualMode);
      }
    });

    // --- Restore to original file ---
    document.getElementById("restoreBtn").addEventListener("click", async function() {
      if (!confirm("¿Restaurar esta plantilla a su versión original del archivo? Se perderán los cambios personalizados.")) return;

      const code = document.getElementById("fieldCode").value.trim();
      if (!code) return;

      const msg = document.getElementById("message");

      try {
        const res = await fetch("/api/email-templates/restore.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code }),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error);

        const tRes = await fetch("/api/email-templates/get.php?id=" + templateId);
        const t = await tRes.json();
        document.getElementById("fieldCode").value = t.code || "";
        document.getElementById("fieldName").value = t.name || "";
        document.getElementById("fieldSubject").value = t.subject || "";
        document.getElementById("fieldBodyHtml").value = t.body_html || "";
        document.getElementById("fieldBodyVisual").innerHTML = t.body_html || "";
        document.getElementById("fieldActive").checked = t.is_active ? true : false;
        setupCharCount("fieldCode", "codeCounter", CODE_MAX);
        setupCharCount("fieldName", "nameCounter", NAME_MAX);
        setupCharCount("fieldSubject", "subjectCounter", SUBJECT_MAX);
        updateBodyCounter();

        msg.textContent = "Plantilla restaurada a versión original.";
        msg.className = "font-body text-body-md text-green-700 bg-green-100/50 p-3 mb-6 rounded-sm block";
        msg.classList.remove("hidden");
      } catch (err) {
        msg.textContent = "Error: " + err.message;
        msg.className = "font-body text-body-md text-error bg-error/10 p-3 mb-6 rounded-sm block";
        msg.classList.remove("hidden");
      }
    });

    // --- Load template data ---
    const templateId = new URLSearchParams(window.location.search).get("id");
    if (!templateId) {
      document.getElementById("loading").textContent = "No template ID specified";
      document.getElementById("loading").classList.add("text-error");
    } else {
      (async function init() {
        try {
          const res = await fetch("/api/email-templates/get.php?id=" + templateId);
          if (!res.ok) throw new Error("Template not found");
          const t = await res.json();

          document.getElementById("fieldCode").value = t.code || "";
          document.getElementById("fieldName").value = t.name || "";
          document.getElementById("fieldSubject").value = t.subject || "";
          document.getElementById("fieldBodyHtml").value = t.body_html || "";
          document.getElementById("fieldBodyVisual").innerHTML = t.body_html || "";
          document.getElementById("fieldActive").checked = t.is_active ? true : false;

          setupCharCount("fieldCode", "codeCounter", CODE_MAX);
          setupCharCount("fieldName", "nameCounter", NAME_MAX);
          setupCharCount("fieldSubject", "subjectCounter", SUBJECT_MAX);
          updateBodyCounter();

          document.getElementById("loading").classList.add("hidden");
          document.getElementById("formContent").classList.remove("hidden");
        } catch (err) {
          document.getElementById("loading").textContent = "Error: " + err.message;
          document.getElementById("loading").classList.add("text-error");
        }
      })();
    }

    // --- Form submit ---
    document.getElementById("templateForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("message");
      const bodyHtml = getBodyHtml().trim();

      const data = {
        id: parseInt(templateId),
        code: document.getElementById("fieldCode").value.trim(),
        name: document.getElementById("fieldName").value.trim(),
        subject: document.getElementById("fieldSubject").value.trim(),
        body_html: bodyHtml,
        is_active: document.getElementById("fieldActive").checked ? true : false,
      };

      if (!data.code || !data.name || !data.subject || !data.body_html) {
        msg.textContent = "Completa todos los campos obligatorios.";
        msg.className = "font-body text-body-md text-error bg-error/10 p-3 mb-6 rounded-sm block";
        return;
      }

      setLoading("submitBtn", "submitIcon", "submitText", true, "Guardando...");

      try {
        const res = await fetch("/api/email-templates/update.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error((await res.json()).error || "Error");
        window.location.href = "/admin/email-templates";
      } catch (err) {
        msg.textContent = "Error: " + err.message;
        msg.className = "font-body text-body-md text-error bg-error/10 p-3 mb-6 rounded-sm block";
        setLoading("submitBtn", "submitIcon", "submitText", false);
      }
    });

    document.getElementById("submitIcon").dataset.origIcon = "save";

    // Prevent paste of rich content from external sources (paste as plain text)
    document.getElementById("fieldBodyVisual").addEventListener("paste", function(e) {
      e.preventDefault();
      const text = (e.clipboardData || window.clipboardData).getData("text/plain");
      document.execCommand("insertText", false, text);
      syncVisualToHtml();
    });
  </script>
</AdminLayout>
