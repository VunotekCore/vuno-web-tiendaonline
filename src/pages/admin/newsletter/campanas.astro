---
import AdminLayout from "../_layout.astro";
---

<AdminLayout title="Campañas" currentPath="/admin/newsletter/campanas">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

    <!-- Composer -->
    <div class="lg:col-span-2 bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
      <h2 class="font-headline text-headline-sm mb-6">Nueva Campaña</h2>

      <!-- Template selector -->
      <div class="mb-5">
        <label for="templateSelect" class="block font-label-caps text-label-caps text-secondary mb-2">PLANTILLA</label>
        <select id="templateSelect" class="w-full h-10 px-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md cursor-pointer">
          <option value="">Seleccionar plantilla...</option>
        </select>
      </div>

      <!-- Subject -->
      <div class="mb-5">
        <label for="subjectInput" class="block font-label-caps text-label-caps text-secondary mb-2">ASUNTO <span class="text-secondary/50 font-normal">(opcional — reemplaza el asunto de la plantilla)</span></label>
        <input type="text" id="subjectInput" placeholder="Dejar vacío para usar el asunto de la plantilla..." class="w-full h-10 px-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md" />
      </div>

      <!-- Preview -->
      <div id="previewArea" class="hidden mb-5">
        <label class="block font-label-caps text-label-caps text-secondary mb-2">VISTA PREVIA</label>
        <div class="border border-outline-variant rounded-sm overflow-hidden bg-white">
          <iframe id="previewFrame" class="w-full border-0" style="min-height:320px" sandbox="allow-same-origin"></iframe>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-5 border-t border-outline-variant">
        <div>
          <p id="subscriberCount" class="font-body text-body-md text-secondary">
            <span class="material-symbols-outlined align-middle text-lg mr-1">people</span>
            Cargando...
          </p>
        </div>
        <div class="flex gap-3 w-full sm:w-auto">
          <button id="testBtn" disabled class="flex-1 sm:flex-none font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 border border-monolith-black/20 text-secondary rounded-md hover:border-monolith-black hover:text-monolith-black transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
            <span class="material-symbols-outlined text-lg">bug_report</span>
            ENVIAR PRUEBA
          </button>
          <button id="campaignBtn" disabled class="flex-1 sm:flex-none bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
            <span class="material-symbols-outlined text-lg">campaign</span>
            ENVIAR CAMPAÑA
          </button>
        </div>
      </div>
    </div>

    <!-- Sidebar info -->
    <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6 space-y-5">
      <h3 class="font-label-caps text-label-caps text-secondary">VARIABLES DISPONIBLES</h3>
      <div class="space-y-3 text-body-md font-body">
        <div>
          <code class="bg-monolith-black/5 px-2 py-0.5 rounded text-sm font-mono">&#123;&#123;subscriber_name&#125;&#125;</code>
          <p class="text-secondary text-sm mt-1">Nombre del suscriptor</p>
        </div>
        <div>
          <code class="bg-monolith-black/5 px-2 py-0.5 rounded text-sm font-mono">&#123;&#123;unsubscribe_url&#125;&#125;</code>
          <p class="text-secondary text-sm mt-1">Link de baja personalizado</p>
        </div>
        <div>
          <code class="bg-monolith-black/5 px-2 py-0.5 rounded text-sm font-mono">&#123;&#123;title&#125;&#125;</code>
          <p class="text-secondary text-sm mt-1">Título del contenido</p>
        </div>
        <div>
          <code class="bg-monolith-black/5 px-2 py-0.5 rounded text-sm font-mono">&#123;&#123;message&#125;&#125;</code>
          <p class="text-secondary text-sm mt-1">Mensaje principal</p>
        </div>
        <div>
          <code class="bg-monolith-black/5 px-2 py-0.5 rounded text-sm font-mono">&#123;&#123;content_block&#125;&#125;</code>
          <p class="text-secondary text-sm mt-1">Bloque HTML personalizado</p>
        </div>
      </div>
      <p class="text-xs text-secondary/60 pt-3 border-t border-outline-variant">
        Las variables <code class="font-mono">&#123;&#123;store_name&#125;&#125;</code>, <code class="font-mono">&#123;&#123;store_logo_block&#125;&#125;</code> y <code class="font-mono">&#123;&#123;store_slogan&#125;&#125;</code> se inyectan automáticamente.
      </p>
    </div>

  </div>

  <!-- Progress Modal -->
  <div id="progressModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-4 mb-4">
        <span class="material-symbols-outlined text-2xl text-monolith-black animate-spin" id="progressIcon">progress_activity</span>
        <div class="flex-1 min-w-0">
          <p class="font-headline text-headline-md" id="progressTitle">Enviando campaña...</p>
          <p class="font-body text-body-md text-secondary mt-1" id="progressText">0 / 0 enviados</p>
        </div>
      </div>
      <div class="w-full bg-monolith-black/5 h-2 rounded-sm overflow-hidden">
        <div id="progressBar" class="bg-monolith-black h-2 rounded-sm transition-all duration-300" style="width:0%"></div>
      </div>
      <div id="progressErrors" class="mt-4 hidden">
        <p class="font-body text-body-sm text-error flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">warning</span>
          <span id="errorCount">0</span> errores — revisa el log del servidor
        </p>
      </div>
    </div>
  </div>

  <!-- Confirm Modal -->
  <div id="confirmModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-clay-accent">campaign</span>
        <div>
          <h3 class="font-headline text-headline-md">Enviar Campaña</h3>
          <p class="font-body text-body-md text-secondary text-sm">Esto enviará un email a <strong id="confirmCount">0</strong> suscriptores activos.</p>
        </div>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de enviar esta campaña utilizando la plantilla <strong id="confirmTemplateName" class="text-monolith-black"></strong>?
      </p>
      <div class="flex justify-end gap-3">
        <button id="confirmCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="confirmSendBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="confirmSendIcon">send</span>
          <span id="confirmSendText">ENVIAR</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Result Modal -->
  <div id="resultModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-start gap-3 mb-4">
        <span id="resultModalIcon" class="material-symbols-outlined text-3xl text-monolith-black">check_circle</span>
        <div class="flex-1 min-w-0">
          <h3 id="resultModalTitle" class="font-headline text-headline-md">Campaña enviada</h3>
          <p id="resultModalText" class="font-body text-body-md text-secondary mt-1">Se enviaron correctamente.</p>
        </div>
      </div>
      <div class="flex justify-end gap-3">
        <button id="resultModalNewBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">
          <span class="material-symbols-outlined text-lg align-middle mr-1">add</span>
          NUEVA CAMPAÑA
        </button>
        <button id="resultModalCloseBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps rounded-md px-4 h-10 hover:bg-monolith-black/90 transition-all">CERRAR</button>
      </div>
    </div>
  </div>

  <!-- Error Modal (reusable) -->
  <div id="errorModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-error">error</span>
        <h3 class="font-headline text-headline-md">Error</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6" id="errorModalMsg">Ocurrió un error.</p>
      <div class="flex justify-end">
        <button id="errorModalBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CERRAR</button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #confirmModal:not(.hidden), #errorModal:not(.hidden), #resultModal:not(.hidden), #progressModal:not(.hidden) {
      display: flex;
    }
  </style>

  <script>
    // @ts-nocheck
    const BATCH_SIZE = 20;
    let templates = [];
    let selectedTemplate = null;
    let isSending = false;
    let totalSubscribers = 0;

    // --- Modal helpers ---
    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove("hidden");
      el.classList.add("flex");
      const content = el.querySelector(".modal-content");
      if (content) {
        content.style.animation = "none";
        void content.offsetHeight;
        content.style.animation = "";
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add("hidden");
      el.classList.remove("flex");
    }

    function showError(msg) {
      document.getElementById("errorModalMsg").textContent = msg;
      openModal("errorModal");
    }

    // --- Loading state helpers ---
    function setBtnLoading(btnId, iconId, textId, loading, loadingText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = loadingText || "Enviando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.origText || "";
      }
    }

    // --- Load templates ---
    async function loadTemplates() {
      try {
        const res = await fetch("/api/email-templates/list.php?limit=50");
        const data = await res.json();
        templates = data.items || [];
        const select = document.getElementById("templateSelect");

        // Keep the "Select..." option
        select.innerHTML = '<option value="">Seleccionar plantilla...</option>';

        if (templates.length === 0) {
          select.innerHTML += '<option value="" disabled>— No hay plantillas —</option>';
          return;
        }

        templates.forEach(t => {
          const opt = document.createElement("option");
          opt.value = t.id;
          opt.textContent = t.name + (t.is_active ? "" : " (inactiva)");
          opt.disabled = !t.is_active;
          select.appendChild(opt);
        });
      } catch (err) {
        document.getElementById("templateSelect").innerHTML =
          '<option value="">Error al cargar plantillas</option>';
      }
    }

    // --- Load subscriber count ---
    async function loadSubscriberCount() {
      try {
        const res = await fetch("/api/suscriptores/list.php?limit=1&page=1&is_active=1");
        const data = await res.json();
        totalSubscribers = data.total || 0;
        document.getElementById("subscriberCount").innerHTML =
          '<span class="material-symbols-outlined align-middle text-lg mr-1">people</span>' +
          totalSubscribers + " suscriptores activos";
        document.getElementById("confirmCount").textContent = totalSubscribers;
      } catch {
        document.getElementById("subscriberCount").textContent = "—";
      }
    }

    // --- Preview ---
    async function loadPreview(code) {
      const area = document.getElementById("previewArea");
      const frame = document.getElementById("previewFrame");

      if (!code) {
        area.classList.add("hidden");
        frame.srcdoc = "";
        return;
      }

      try {
        const res = await fetch("/api/email-templates/preview.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code }),
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          frame.srcdoc = `<p style="padding:20px;color:#c00">Preview failed: ${data.error || "Unknown error"}</p>`;
        } else {
          frame.srcdoc = data.body_html;
        }
        area.classList.remove("hidden");
      } catch (err) {
        frame.srcdoc = `<p style="padding:20px;color:#c00">Error: ${err.message}</p>`;
        area.classList.remove("hidden");
      }
    }

    // --- Template selection handler ---
    document.getElementById("templateSelect").addEventListener("change", function () {
      const id = parseInt(this.value);
      selectedTemplate = templates.find(t => t.id === id) || null;

      const testBtn = document.getElementById("testBtn");
      const campaignBtn = document.getElementById("campaignBtn");

      if (selectedTemplate) {
        testBtn.disabled = false;
        campaignBtn.disabled = totalSubscribers === 0;
        loadPreview(selectedTemplate.code);
        document.getElementById("confirmTemplateName").textContent = selectedTemplate.name;

        // Pre-fill subject
        const subjectInput = document.getElementById("subjectInput");
        if (!subjectInput.dataset.userEdited) {
          subjectInput.placeholder = "Usar: " + selectedTemplate.subject;
          subjectInput.value = "";
        }
      } else {
        testBtn.disabled = true;
        campaignBtn.disabled = true;
        document.getElementById("previewArea").classList.add("hidden");
      }
    });

    // Track manual subject edits
    document.getElementById("subjectInput").addEventListener("input", function () {
      this.dataset.userEdited = this.value.length > 0 ? "true" : "";
    });

    // --- Send test ---
    document.getElementById("testBtn").addEventListener("click", async function () {
      if (!selectedTemplate) return;

      setBtnLoading("testBtn", "testBtn", "testBtn", true, "Enviando...");

      try {
        // Get admin email from session
        const verifyRes = await fetch("/api/admin/verify.php");
        const verifyData = await verifyRes.json();
        const adminEmail = verifyData.email;

        if (!adminEmail) {
          showError("No se pudo obtener el email del admin. Re-inicia sesión.");
          setBtnLoading("testBtn", "testBtn", "testBtn", false);
          return;
        }

        const res = await fetch("/api/newsletter/send-campaign.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            template_id: selectedTemplate.id,
            subject_override: document.getElementById("subjectInput").value.trim() || "",
            test_email: adminEmail,
          }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          showError(data.error || "Error al enviar prueba");
        } else {
          showError("✅ Prueba enviada a " + adminEmail);
        }
      } catch (err) {
        showError("Error de red: " + err.message);
      } finally {
        setBtnLoading("testBtn", "testBtn", "testBtn", false);
      }
    });

    // --- Send campaign flow ---
    async function sendCampaignBatch(offset) {
      const res = await fetch("/api/newsletter/send-campaign.php", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          template_id: selectedTemplate.id,
          subject_override: document.getElementById("subjectInput").value.trim() || "",
          offset,
          limit: BATCH_SIZE,
        }),
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error || "Error del servidor");
      }

      return await res.json();
    }

    function updateProgress(sent, total) {
      const pct = total > 0 ? Math.round((sent / total) * 100) : 0;
      document.getElementById("progressText").textContent = sent + " / " + total + " enviados";
      document.getElementById("progressBar").style.width = pct + "%";
    }

    function showProgress() {
      document.getElementById("progressTitle").textContent = "Enviando campaña...";
      document.getElementById("progressIcon").textContent = "progress_activity";
      document.getElementById("progressIcon").classList.add("animate-spin");
      document.getElementById("progressErrors").classList.add("hidden");
      updateProgress(0, totalSubscribers);
      openModal("progressModal");
    }

    function showResult(success, sent, failed, total) {
      closeModal("progressModal");

      const icon = document.getElementById("resultModalIcon");
      const title = document.getElementById("resultModalTitle");
      const text = document.getElementById("resultModalText");

      if (success && failed === 0) {
        icon.textContent = "check_circle";
        icon.className = "material-symbols-outlined text-3xl text-monolith-black";
        title.textContent = "Campaña enviada";
        text.textContent = "Se enviaron " + sent + " emails correctamente a " + total + " suscriptores.";
      } else if (success && failed > 0) {
        icon.textContent = "warning";
        icon.className = "material-symbols-outlined text-3xl text-clay-accent";
        title.textContent = "Campaña enviada con errores";
        text.textContent = "Se enviaron " + sent + " de " + total + " emails. " + failed + " fallaron (revisa el log del servidor).";
      } else {
        icon.textContent = "error";
        icon.className = "material-symbols-outlined text-3xl text-error";
        title.textContent = "Error al enviar";
        text.textContent = "No se pudo completar el envío.";
      }

      openModal("resultModal");
    }

    document.getElementById("campaignBtn").addEventListener("click", function () {
      if (!selectedTemplate || isSending) return;
      openModal("confirmModal");
    });

    document.getElementById("confirmCancelBtn").addEventListener("click", function () {
      closeModal("confirmModal");
    });

    document.getElementById("confirmModal").addEventListener("click", function (e) {
      if (e.target === e.currentTarget) closeModal("confirmModal");
    });

    document.getElementById("confirmSendBtn").addEventListener("click", async function () {
      closeModal("confirmModal");
      if (!selectedTemplate || isSending) return;

      isSending = true;
      document.getElementById("campaignBtn").disabled = true;
      document.getElementById("testBtn").disabled = true;

      showProgress();

      let offset = 0;
      let totalSent = 0;
      let totalFailed = 0;

      try {
        while (true) {
          const data = await sendCampaignBatch(offset);
          totalSent += data.sent || 0;
          totalFailed += data.failed || 0;

          // Show errors if any
          if (data.errors && data.errors.length > 0) {
            document.getElementById("progressErrors").classList.remove("hidden");
            document.getElementById("errorCount").textContent = totalFailed;
          }

          updateProgress(totalSent, data.total);

          if (data.done) break;
          offset = data.next_offset;

          // Small delay between batches to let the UI update
          await new Promise(r => setTimeout(r, 100));
        }

        showResult(true, totalSent, totalFailed, totalSubscribers);
      } catch (err) {
        document.getElementById("progressIcon").textContent = "error";
        document.getElementById("progressIcon").classList.remove("animate-spin");
        document.getElementById("progressTitle").textContent = "Error";
        document.getElementById("progressText").textContent = err.message;
        showResult(false, totalSent, totalFailed, totalSubscribers);
      } finally {
        isSending = false;
        document.getElementById("campaignBtn").disabled = false;
        document.getElementById("testBtn").disabled = false;
      }
    });

    // --- Reset form to initial state ---
    function resetForm() {
      document.getElementById("templateSelect").value = "";
      selectedTemplate = null;
      document.getElementById("subjectInput").value = "";
      document.getElementById("subjectInput").dataset.userEdited = "";
      document.getElementById("previewArea").classList.add("hidden");
      document.getElementById("testBtn").disabled = true;
      document.getElementById("campaignBtn").disabled = true;
      closeModal("progressModal");
    }

    document.getElementById("resultModalNewBtn").addEventListener("click", function () {
      closeModal("resultModal");
      resetForm();
    });

    // --- Global Escape key ---
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        if (!document.getElementById("confirmModal").classList.contains("hidden")) closeModal("confirmModal");
        if (!document.getElementById("errorModal").classList.contains("hidden")) closeModal("errorModal");
        if (!document.getElementById("resultModal").classList.contains("hidden")) closeModal("resultModal");
        if (!document.getElementById("progressModal").classList.contains("hidden")) closeModal("progressModal");
      }
    });

    // --- Modal close handlers ---
    document.getElementById("errorModalBtn").addEventListener("click", function () {
      closeModal("errorModal");
    });
    document.getElementById("errorModal").addEventListener("click", function (e) {
      if (e.target === e.currentTarget) closeModal("errorModal");
    });

    document.getElementById("resultModalCloseBtn").addEventListener("click", function () {
      closeModal("resultModal");
    });
    document.getElementById("resultModal").addEventListener("click", function (e) {
      if (e.target === e.currentTarget) closeModal("resultModal");
    });

    // --- Init ---
    document.getElementById("testBtn").querySelector("span:last-child").dataset.origText = "ENVIAR PRUEBA";
    document.getElementById("confirmSendBtn").querySelector("span:last-child").dataset.origText = "ENVIAR";
    document.getElementById("confirmSendIcon").dataset.origIcon = "send";

    loadTemplates();
    loadSubscriberCount();
  </script>
</AdminLayout>
