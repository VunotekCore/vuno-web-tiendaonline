---
import AdminLayout from "../_layout.astro";
---

<AdminLayout title="Editar Post" currentPath="/admin/blog">
  <form id="blogForm" class="max-w-2xl">
    <div id="loading" class="font-body text-body-md text-secondary p-4">Loading...</div>
    <div id="formContent" class="hidden">
      <div id="message" class="hidden font-body text-body-md p-3 mb-6 rounded-sm"></div>

      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6 space-y-6">
        <h2 class="font-headline text-headline-md flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">article</span>
          Editar Post
        </h2>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">TÍTULO *</label>
          <div class="relative">
            <input type="text" id="fieldTitle" required maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors" />
            <span id="titleCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/255</span>
          </div>
        </div>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">SLUG *</label>
          <div class="relative">
            <input type="text" id="fieldSlug" required maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm transition-colors" />
            <span id="slugCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/255</span>
          </div>
        </div>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">EXTRACTO</label>
          <div class="relative">
            <textarea id="fieldExcerpt" rows="3" maxlength="500" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none resize-none transition-colors"></textarea>
            <span id="excerptCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/500</span>
          </div>
        </div>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">CONTENIDO (HTML) *</label>
          <div class="relative">
            <textarea id="fieldContent" rows="16" required class="w-full bg-transparent border border-outline p-3 pb-8 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm leading-relaxed resize-y"></textarea>
            <span id="contentCounter" class="absolute right-2 bottom-2 text-xs font-body text-secondary pointer-events-none">0 caracteres</span>
          </div>
        </div>

        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">IMAGEN DESTACADA (URL)</label>
          <div class="relative">
            <input type="url" id="fieldImage" maxlength="500" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none transition-colors" placeholder="https://..." />
            <span id="imageCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/500</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">AUTOR</label>
            <div class="relative">
              <input type="text" id="fieldAuthor" maxlength="100" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none transition-colors" />
              <span id="authorCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/100</span>
            </div>
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">CATEGORÍA</label>
            <select id="fieldCategory" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none transition-colors">
              <option value="">Sin categoría</option>
            </select>
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">ESTADO</label>
            <select id="fieldStatus" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none transition-colors">
              <option value="draft">Borrador</option>
              <option value="published">Publicado</option>
            </select>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 mt-8">
        <a href="/admin/blog" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-5 h-10 inline-flex items-center hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</a>
        <button type="submit" id="submitBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="submitIcon">save</span>
          <span id="submitText">GUARDAR</span>
        </button>
      </div>
    </div>
  </form>

  <script>
    // @ts-nocheck
    const TITLE_MAX = 255;
    const SLUG_MAX = 255;
    const EXCERPT_MAX = 500;
    const IMAGE_MAX = 500;
    const AUTHOR_MAX = 100;

    let categories = [];

    function setupCharCount(inputId, counterId, max) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(counterId);
      if (!input || !counter) return;
      function update() {
        const len = input.value.length;
        counter.textContent = len + "/" + max;
        counter.className = "absolute right-0 bottom-2 text-xs font-body pointer-events-none transition-colors duration-200 " +
          (len >= max ? "text-error" : len >= max * 0.8 ? "text-clay-accent" : "text-secondary");
      }
      input.addEventListener("input", update);
      update();
    }

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Guardando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "save";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    const postId = new URLSearchParams(window.location.search).get("id");
    if (!postId) {
      document.getElementById("loading").textContent = "No post ID specified";
      document.getElementById("loading").classList.add("text-error");
    } else {
      (async function init() {
      try {
        // Load categories
        const catRes = await fetch("/api/blog/categories.php");
        categories = await catRes.json();
        const catSelect = document.getElementById("fieldCategory");
        (categories || []).forEach(c => {
          const opt = document.createElement("option");
          opt.value = c.id;
          opt.textContent = c.name;
          catSelect.appendChild(opt);
        });

        // Load post
        const res = await fetch("/api/blog/get.php?id=" + postId);
        if (!res.ok) throw new Error("Post not found");
        const post = await res.json();

        document.getElementById("fieldTitle").value = post.title || "";
        document.getElementById("fieldSlug").value = post.slug || "";
        document.getElementById("fieldExcerpt").value = post.excerpt || "";
        document.getElementById("fieldContent").value = post.content || "";
        document.getElementById("fieldImage").value = post.featured_image || "";
        document.getElementById("fieldAuthor").value = post.author || "Ram;Lop";
        document.getElementById("fieldStatus").value = post.status || "draft";
        if (post.category_id) document.getElementById("fieldCategory").value = post.category_id;

        // Re-init counters with loaded values
        setupCharCount("fieldTitle", "titleCounter", TITLE_MAX);
        setupCharCount("fieldSlug", "slugCounter", SLUG_MAX);
        setupCharCount("fieldExcerpt", "excerptCounter", EXCERPT_MAX);
        document.getElementById("fieldContent").addEventListener("input", function() {
          document.getElementById("contentCounter").textContent = this.value.length + " caracteres";
        });
        document.getElementById("contentCounter").textContent = (post.content || "").length + " caracteres";
        setupCharCount("fieldImage", "imageCounter", IMAGE_MAX);
        setupCharCount("fieldAuthor", "authorCounter", AUTHOR_MAX);

        document.getElementById("loading").classList.add("hidden");
        document.getElementById("formContent").classList.remove("hidden");
      } catch (err) {
        document.getElementById("loading").textContent = "Error: " + err.message;
        document.getElementById("loading").classList.add("text-error");
      }
    })();

    document.getElementById("blogForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("message");

      const data = {
        id: parseInt(postId),
        title: document.getElementById("fieldTitle").value.trim(),
        slug: document.getElementById("fieldSlug").value.trim(),
        excerpt: document.getElementById("fieldExcerpt").value.trim(),
        content: document.getElementById("fieldContent").value.trim(),
        featured_image: document.getElementById("fieldImage").value.trim(),
        author: document.getElementById("fieldAuthor").value.trim() || "Ram;Lop",
        category_id: document.getElementById("fieldCategory").value || null,
        status: document.getElementById("fieldStatus").value,
      };

      if (!data.title || !data.slug || !data.content) {
        msg.textContent = "Completa los campos obligatorios: título, slug y contenido.";
        msg.className = "font-body text-body-md text-error bg-error/10 p-3 mb-6 rounded-sm block";
        return;
      }

      setLoading("submitBtn", "submitIcon", "submitText", true, "Guardando...");

      try {
        const res = await fetch("/api/blog/update.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error((await res.json()).error || "Error");
        window.location.href = "/admin/blog";
      } catch (err) {
        msg.textContent = "Error: " + err.message;
        msg.className = "font-body text-body-md text-error bg-error/10 p-3 mb-6 rounded-sm block";
        setLoading("submitBtn", "submitIcon", "submitText", false);
      }
    })();

    document.getElementById("submitIcon").dataset.origIcon = "save";
    }
  </script>
</AdminLayout>
