---
import AdminLayout from "./_layout.astro";
---
<AdminLayout title="Mostrador POS" currentPath="/admin/pos">
  <div id="loading" class="font-body text-body-md text-secondary p-4 text-center">
    <span class="material-symbols-outlined text-3xl block mb-2 animate-spin">progress_activity</span>
    Cargando productos...
  </div>
  <div id="error" class="hidden font-body text-body-md text-error bg-error/10 p-3 rounded-sm"></div>

  <div id="posContent" class="hidden">
    <div class="flex items-center gap-1.5 sm:gap-2 mb-3 sm:mb-4">
      <a href="/admin/pos/dashboard" class="inline-flex items-center gap-1 text-xs sm:text-sm text-secondary hover:text-monolith-black transition-colors font-body">
        <span class="material-symbols-outlined text-base sm:text-lg">dashboard</span>
        <span class="hidden sm:inline">Dashboard</span>
      </a>
      <span class="text-secondary/30 text-xs sm:text-sm">/</span>
      <span class="text-xs sm:text-sm text-monolith-black font-body font-medium">Mostrador POS</span>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 pb-24 lg:pb-0">
      <!-- LEFT COLUMN: Products or Product Detail (3/5) -->
      <div class="lg:col-span-3 space-y-4">

        <!-- Search + Product grid -->
        <div id="productListPanel">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-end gap-3">
            <div class="relative flex-1">
              <span class="material-symbols-outlined absolute left-0 top-1/2 -translate-y-1/2 text-secondary text-lg">search</span>
              <input type="text" id="posSearch" placeholder="Buscar producto..."
                     class="w-full bg-transparent border-b border-outline pb-3 pl-8 pr-8 text-monolith-black
                            focus:border-monolith-black focus:outline-none placeholder:text-secondary
                            text-base sm:text-lg font-body" autocomplete="off" />
              <kbd class="absolute right-0 top-1/2 -translate-y-1/2 text-xs text-secondary/40 border border-outline/30
                          rounded-sm px-1.5 py-0.5 font-mono hidden sm:inline">/</kbd>
            </div>
            <div class="shrink-0">
              <label for="posCategory" class="sr-only">Categoría</label>
              <select id="posCategory"
                      class="h-[42px] w-full sm:w-auto bg-transparent border-b border-outline text-monolith-black text-sm
                             focus:border-monolith-black focus:outline-none cursor-pointer min-w-[140px]">
                <!-- Rendered by JS -->
              </select>
            </div>
          </div>

          <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 max-h-[calc(100dvh-340px)] lg:max-h-[calc(100vh-260px)] overflow-y-auto pr-2 mt-4">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- Product Detail panel (hidden until product selected) -->
        <div id="productDetail" class="hidden sm:mb-0 max-sm:pb-20">
          <button onclick="hideProductDetail()" class="inline-flex items-center gap-1.5 text-sm text-secondary
                  hover:text-monolith-black transition-colors mb-4 cursor-pointer font-body">
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            Volver a productos
          </button>
          <div id="productDetailContent">
            <!-- Rendered by JS -->
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Cart + Checkout (2/5) — desktop only -->
      <div class="hidden lg:block lg:col-span-2 bg-off-white border border-outline-variant shadow-sm rounded-sm p-5 flex flex-col h-fit sticky top-0">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-headline text-headline-md flex items-center gap-2">
            <span class="material-symbols-outlined text-xl">shopping_cart</span>
            Venta
          </h2>
          <span id="cartCountBadge" class="hidden font-label-caps text-label-caps bg-monolith-black text-off-white px-2 py-0.5 rounded-sm text-xs">0</span>
        </div>

        <div id="emptyCart" class="text-center py-8 text-secondary font-body">
          <span class="material-symbols-outlined text-4xl block mb-2">add_shopping_cart</span>
          Carrito vacío<br/>
          <span class="text-sm">Seleccioná un producto de la izquierda</span>
        </div>

        <div id="cartItems" class="hidden space-y-3 divide-y divide-outline-variant/50 max-h-[360px] overflow-y-auto">
          <!-- Rendered by JS -->
        </div>

        <div id="cartSummary" class="hidden mt-3 pt-3 border-t border-outline-variant space-y-2">
          <div class="flex justify-between font-body text-body-md">
            <span class="text-secondary">Subtotal</span>
            <span id="cartSubtotal" class="font-price-display text-price-display">$0.00</span>
          </div>
          <div class="flex justify-between font-body text-body-sm text-secondary">
            <span>IVA</span>
            <span id="cartTax" class="font-price-display text-price-display">$0.00</span>
          </div>
          <div class="flex justify-between font-headline text-headline-md border-t border-outline-variant/50 pt-2">
            <span>Total</span>
            <span id="cartTotal" class="font-price-display text-price-display text-monolith-black">$0.00</span>
          </div>
        </div>

        <!-- Customer name -->
        <div class="mt-3 space-y-3">
          <div>
            <label for="posCustomerName" class="font-label-caps text-label-caps text-secondary block mb-1">CLIENTE</label>
            <input type="text" id="posCustomerName" placeholder="Nombre del cliente"
                   class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black
                          focus:border-monolith-black focus:outline-none placeholder:text-secondary/50
                          font-body text-body-md"
                   value="Venta en Mostrador" />
          </div>
          <div>
            <label for="posCustomerEmail" class="font-label-caps text-label-caps text-secondary block mb-1">CORREO</label>
            <input type="email" id="posCustomerEmail" placeholder="correo@ejemplo.com"
                   class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black
                          focus:border-monolith-black focus:outline-none placeholder:text-secondary/50
                          font-body text-body-md" />
          </div>
        </div>

        <!-- Payment method selector -->
        <div class="mt-3 space-y-2">
          <label class="font-label-caps text-label-caps text-secondary block">MÉTODO DE PAGO</label>
          <div class="grid grid-cols-3 gap-2">
            <button data-payment="pos_cash" title="Efectivo" class="payment-btn selected bg-monolith-black text-off-white
                    font-label-caps text-label-caps min-h-[44px] px-4 rounded-sm flex items-center justify-center gap-2
                    hover:bg-monolith-black/90 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-lg">payments</span>
              <span class="hidden xl:inline">Efectivo</span>
            </button>
            <button data-payment="pos_card" title="Tarjeta" class="payment-btn bg-transparent border border-outline text-monolith-black
                    font-label-caps text-label-caps min-h-[44px] px-4 rounded-sm flex items-center justify-center gap-2
                    hover:bg-monolith-black/5 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-lg">credit_card</span>
              <span class="hidden xl:inline">Tarjeta</span>
            </button>
            <button data-payment="pos_transfer" title="Transferencia" class="payment-btn bg-transparent border border-outline text-monolith-black
                    font-label-caps text-label-caps min-h-[44px] px-4 rounded-sm flex items-center justify-center gap-2
                    hover:bg-monolith-black/5 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-lg">account_balance</span>
              <span class="hidden xl:inline">Transferencia</span>
            </button>
          </div>
        </div>

        <!-- Process button -->
        <button id="processSaleBtn" disabled
                class="mt-4 w-full bg-monolith-black text-off-white font-label-caps text-label-caps
                       min-h-[48px] px-6 rounded-sm flex items-center justify-center gap-2
                       hover:bg-monolith-black/90 transition-all duration-200
                       disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
          <span class="material-symbols-outlined text-xl">point_of_sale</span>
          <span>Procesar Venta</span>
        </button>
      </div>
    </div>

    <!-- Mobile floating cart bar (lg:hidden) -->
    <div id="mobileCartBar" class="lg:hidden fixed bottom-0 left-0 right-0 z-50
         bg-off-white border-t border-outline-variant shadow-lg
         px-4 py-3 flex items-center gap-3
         translate-y-full transition-transform duration-300 ease-out">
      <div class="flex items-center gap-2 shrink-0">
        <span class="material-symbols-outlined text-xl">shopping_cart</span>
        <span id="mobileCartCount" class="hidden font-label-caps text-label-caps bg-monolith-black text-off-white px-2 py-0.5 rounded-sm text-xs">0</span>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex justify-between items-center">
          <span id="mobileCartItems" class="font-body text-body-sm text-secondary">0 ítem(s)</span>
          <span id="mobileCartTotal" class="font-price-display text-price-display text-sm text-monolith-black">$0.00</span>
        </div>
      </div>
      <button id="mobileCartBtn"
              class="bg-monolith-black text-off-white font-label-caps text-label-caps min-h-[40px] px-4 rounded-sm
                     flex items-center gap-1.5 hover:bg-monolith-black/90 transition-all cursor-pointer
                     disabled:opacity-40 disabled:cursor-not-allowed"
              disabled>
        <span class="material-symbols-outlined text-lg">point_of_sale</span>
        <span class="hidden xs:inline sm:hidden">Ir</span>
        <span class="hidden sm:inline">Ver carrito</span>
      </button>
    </div>

    <!-- Mobile cart overlay (lg:hidden) -->
    <div id="cartOverlay" class="lg:hidden fixed inset-0 z-[60] opacity-0 pointer-events-none transition-opacity duration-300">
      <div class="absolute inset-0 bg-black/20" id="cartOverlayBackdrop"></div>
      <div id="cartOverlayPanel" class="absolute bottom-0 left-0 right-0
           bg-off-white rounded-t-lg max-h-[85dvh] overflow-y-auto
           px-5 py-6 translate-y-full transition-transform duration-300 ease-out
           shadow-2xl">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5">
          <h2 class="font-headline text-headline-md flex items-center gap-2">
            <span class="material-symbols-outlined text-xl">shopping_cart</span>
            Venta
          </h2>
          <button onclick="closeCartOverlay()" class="material-symbols-outlined text-2xl text-secondary hover:text-monolith-black cursor-pointer">close</button>
        </div>

        <!-- Overlay cart items -->
        <div id="overlayCartItems" class="space-y-3 divide-y divide-outline-variant/50 max-h-[40vh] overflow-y-auto">
          <p class="text-center py-8 text-secondary font-body text-body-md">Carrito vacío</p>
        </div>

        <!-- Overlay summary -->
        <div id="overlayCartSummary" class="hidden mt-3 pt-3 border-t border-outline-variant space-y-2">
          <div class="flex justify-between font-body text-body-md">
            <span class="text-secondary">Subtotal</span>
            <span id="overlayCartSubtotal" class="font-price-display text-price-display">$0.00</span>
          </div>
          <div class="flex justify-between font-body text-body-sm text-secondary">
            <span>IVA</span>
            <span id="overlayCartTax" class="font-price-display text-price-display">$0.00</span>
          </div>
          <div class="flex justify-between font-headline text-headline-md border-t border-outline-variant/50 pt-2">
            <span>Total</span>
            <span id="overlayCartTotal" class="font-price-display text-price-display text-monolith-black">$0.00</span>
          </div>
        </div>

        <!-- Customer (reuses same inputs as desktop) -->
        <div class="mt-4 space-y-3">
          <div>
            <label for="posCustomerName" class="font-label-caps text-label-caps text-secondary block mb-1">CLIENTE</label>
            <input type="text" id="posCustomerNameMobile" placeholder="Nombre del cliente"
                   class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black
                          focus:border-monolith-black focus:outline-none placeholder:text-secondary/50
                          font-body text-body-md"
                   value="Venta en Mostrador" />
          </div>
          <div>
            <label for="posCustomerEmail" class="font-label-caps text-label-caps text-secondary block mb-1">CORREO</label>
            <input type="email" id="posCustomerEmailMobile" placeholder="correo@ejemplo.com"
                   class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black
                          focus:border-monolith-black focus:outline-none placeholder:text-secondary/50
                          font-body text-body-md" />
          </div>
        </div>

        <!-- Payment method (mobile) -->
        <div class="mt-3 space-y-2">
          <label class="font-label-caps text-label-caps text-secondary block">MÉTODO DE PAGO</label>
          <div class="grid max-sm:grid-cols-1 grid-cols-3 gap-2">
            <button data-payment="pos_cash" title="Efectivo" class="payment-btn selected bg-monolith-black text-off-white
                    font-label-caps text-label-caps min-h-[44px] px-4 rounded-sm flex items-center justify-center gap-2
                    hover:bg-monolith-black/90 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-lg">payments</span>
              <span class="hidden sm:inline">Efectivo</span>
            </button>
            <button data-payment="pos_card" title="Tarjeta" class="payment-btn bg-transparent border border-outline text-monolith-black
                    font-label-caps text-label-caps min-h-[44px] px-4 rounded-sm flex items-center justify-center gap-2
                    hover:bg-monolith-black/5 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-lg">credit_card</span>
              <span class="hidden sm:inline">Tarjeta</span>
            </button>
            <button data-payment="pos_transfer" title="Transferencia" class="payment-btn bg-transparent border border-outline text-monolith-black
                    font-label-caps text-label-caps min-h-[44px] px-4 rounded-sm flex items-center justify-center gap-2
                    hover:bg-monolith-black/5 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-lg">account_balance</span>
              <span class="hidden sm:inline">Transferencia</span>
            </button>
          </div>
        </div>

        <!-- Process button (overlay) -->
        <button id="overlayProcessSaleBtn" disabled
                class="mt-5 w-full bg-monolith-black text-off-white font-label-caps text-label-caps
                       min-h-[48px] px-6 rounded-sm flex items-center justify-center gap-2
                       hover:bg-monolith-black/90 transition-all cursor-pointer
                       disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-xl">point_of_sale</span>
          <span>Procesar Venta</span>
        </button>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
// @ts-nocheck
// POS Module - State
let cart = [];
let products = [];
let paymentMethod = 'pos_cash';
let currencySymbol = '$';
let exchangeRate = 1;
let decimalPlaces = 2;
let taxRate = 0;
let selectedProduct = null;
let selectedColor = null;
let selectedSize = null;
let addQty = 1;

const $ = id => document.getElementById(id);
const productGrid = $('productGrid');
const productListPanel = $('productListPanel');
const productDetail = $('productDetail');
const productDetailContent = $('productDetailContent');
const cartItems = $('cartItems');
const emptyCart = $('emptyCart');
const cartSummary = $('cartSummary');
const cartSubtotal = $('cartSubtotal');
const cartTax = $('cartTax');
const cartTotal = $('cartTotal');
const cartCountBadge = $('cartCountBadge');
const processBtn = $('processSaleBtn');
const overlayProcessBtn = $('overlayProcessSaleBtn');
const searchInput = $('posSearch');
const categorySelect = $('posCategory');

// Mobile cart bar + overlay
const mobileCartBar = $('mobileCartBar');
const mobileCartCount = $('mobileCartCount');
const mobileCartItems = $('mobileCartItems');
const mobileCartTotal = $('mobileCartTotal');
const mobileCartBtn = $('mobileCartBtn');
const cartOverlay = $('cartOverlay');
const cartOverlayPanel = $('cartOverlayPanel');
const overlayCartItems = $('overlayCartItems');
const overlayCartSummary = $('overlayCartSummary');
const overlayCartSubtotal = $('overlayCartSubtotal');
const overlayCartTax = $('overlayCartTax');
const overlayCartTotal = $('overlayCartTotal');
const overlayBackdrop = $('cartOverlayBackdrop');

async function loadProducts() {
  try {
    const [prodRes, configRes] = await Promise.all([
      fetch('/api/productos/list.php?limit=200'),
      fetch('/api/configuracion/public.php'),
    ]);
    const prodData = await prodRes.json();
    const config = await configRes.json();
    products = prodData.items || [];

    // Currency and tax from config
    if (config?.currency?.symbol) currencySymbol = config.currency.symbol;
    if (config?.currency?.exchange_rate) exchangeRate = parseFloat(config.currency.exchange_rate) || 1;
    if (config?.currency?.decimal_places) decimalPlaces = parseInt(config.currency.decimal_places) || 2;
    const taxRateSetting = config?.tax?.rate;
    taxRate = taxRateSetting !== undefined && taxRateSetting !== '' ? parseFloat(taxRateSetting) / 100 : 0;

    populateCategoryDropdown();
    renderProducts();
    $('loading').classList.add('hidden');
    $('posContent').classList.remove('hidden');
    setTimeout(() => searchInput.focus(), 100);
  } catch (e) {
    $('loading').classList.add('hidden');
    const err = $('error');
    err.classList.remove('hidden');
    err.textContent = 'Error al cargar productos: ' + e.message;
  }
}

// ─────────────────────────────────────────────
// PRODUCT LIST
// ─────────────────────────────────────────────
function getFilteredProducts(filter) {
  filter = (filter || '').toLowerCase().trim();
  const cat = categorySelect ? categorySelect.value : '';
  return products.filter(p => {
    if (cat && (p.category || '') !== cat) return false;
    if (!filter) return true;
    const name = (p.name || '').toLowerCase();
    const colorMatch = (p.colors || []).some(c => (c.name || '').toLowerCase().includes(filter));
    const catMatch = (p.category || '').toLowerCase().includes(filter);
    return name.includes(filter) || colorMatch || catMatch;
  });
}

function populateCategoryDropdown() {
  const cats = new Set();
  products.forEach(p => { if (p.category) cats.add(p.category); });
  const sorted = Array.from(cats).sort();
  const sel = categorySelect;
  if (!sel) return;
  sel.innerHTML = '<option value="">Todas las categorías</option>'
    + sorted.map(c => `<option value="${escHtml(c)}">${escHtml(c)}</option>`).join('');
}

// Category filter change
if (categorySelect) {
  categorySelect.addEventListener('change', function () {
    renderProducts(searchInput.value);
  });
}

function renderProducts(filter) {
  const filtered = getFilteredProducts(filter);
  if (filtered.length === 0) {
    productGrid.innerHTML = '<div class="col-span-full text-center py-12 text-secondary font-body">Sin resultados</div>';
    return;
  }

  productGrid.innerHTML = filtered.map(p => {
    const img = p.images?.[0] || '';
    const displayPrice = parseFloat(p.display_price ?? p.price) || 0;
    const sym = p.display_symbol || currencySymbol;
    const hasStock = (p.totalStock || 0) > 0;

    return `<button onclick="showProductDetail('${escHtml(p.id)}')"
                class="text-left bg-off-white border border-outline-variant shadow-sm rounded-sm overflow-hidden
                       hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer
                       ${!hasStock ? 'opacity-40' : ''} group w-full">
              <div class="flex gap-2 sm:gap-3 p-2 sm:p-3">
                ${img ? `<img src="${escHtml(img)}" alt="" class="w-12 sm:w-16 h-12 sm:h-16 object-cover rounded-sm shrink-0"
                          onerror="this.style.display='none'" />`
                       : `<div class="w-12 sm:w-16 h-12 sm:h-16 bg-monolith-black/5 rounded-sm shrink-0 flex items-center justify-center">
                            <span class="material-symbols-outlined text-lg sm:text-xl text-secondary/30">inventory_2</span>
                          </div>`}
                <div class="flex-1 min-w-0">
                  <h4 class="font-body text-body-sm sm:text-body-md font-semibold truncate group-hover:text-clay-accent transition-colors">${escHtml(p.name)}</h4>
                  <p class="font-price-display text-price-display text-monolith-black mt-0.5">${sym}${formatPrice(displayPrice)}</p>
                  <p class="text-xs text-secondary mt-1">
                    <span class="${(p.totalStock || 0) <= 0 ? 'text-error' : (p.totalStock || 0) <= (p.lowStockThreshold || 5) ? 'text-clay-accent' : ''}">
                      ${(p.totalStock || 0)} en stock
                    </span>
                    ${p.category ? `<span class="text-secondary/50"> · ${escHtml(p.category)}</span>` : ''}
                  </p>
                </div>
                <span class="material-symbols-outlined text-lg text-secondary/30 self-center">chevron_right</span>
              </div>
            </button>`;
  }).join('');
}

// ─────────────────────────────────────────────
// PRODUCT DETAIL
// ─────────────────────────────────────────────
function showProductDetail(productId) {
  const p = products.find(x => String(x.id) === String(productId));
  if (!p) return;

  selectedProduct = p;
  selectedColor = null;
  selectedSize = null;
  addQty = 1;

  productListPanel.classList.add('hidden');
  productDetail.classList.remove('hidden');

  renderProductDetail();
}

function hideProductDetail() {
  selectedProduct = null;
  selectedColor = null;
  selectedSize = null;

  productDetail.classList.add('hidden');
  productListPanel.classList.remove('hidden');
  renderProducts(searchInput.value);
}

function renderProductDetail() {
  const p = selectedProduct;
  if (!p) return;

  const img = p.images?.[0] || p.imagesByColor?.[Object.keys(p.imagesByColor || {})[0]]?.[0] || '';
  const displayPrice = parseFloat(p.display_price ?? p.price) || 0;
  const sym = p.display_symbol || currencySymbol;

  // ── Group variants by color ──
  const colorMap = {}; // color_name → { stock: total, sizes: { size_value: stock } }
  for (const v of (p.variants || [])) {
    const c = v.color_name;
    if (!colorMap[c]) colorMap[c] = { stock: 0, sizes: {} };
    const s = parseInt(v.stock) || 0;
    colorMap[c].stock += s;
    if (!colorMap[c].sizes[v.size_value]) colorMap[c].sizes[v.size_value] = 0;
    colorMap[c].sizes[v.size_value] += s;
  }

  // ── Color selector ──
  const colorBtns = (p.colors || []).map(c => {
    const cStock = colorMap[c.name]?.stock || 0;
    const active = selectedColor === c.name;
    return `<button onclick="selectColor('${escHtml(c.name)}')"
                class="color-btn px-4 py-2.5 text-sm border rounded-sm transition-all duration-150 cursor-pointer font-body
                       ${active
                         ? 'bg-monolith-black text-off-white border-monolith-black'
                         : 'bg-transparent text-monolith-black border-outline-variant hover:border-monolith-black'}
                       ${cStock <= 0 ? 'opacity-30 cursor-not-allowed' : ''}"
                ${cStock <= 0 ? 'disabled' : ''}>
                <span class="font-medium">${escHtml(c.name)}</span>
                <span class="text-xs ml-1.5 px-1.5 py-0.5 rounded-sm font-medium ${active ? 'bg-off-white/20 text-off-white' : 'bg-monolith-black/10 text-monolith-black'}">${cStock}u</span>
              </button>`;
  }).join('');

  // ── Size selector (only when color selected) ──
  let sizeSection = '';
  if (selectedColor) {
    const sizes = colorMap[selectedColor]?.sizes || {};
    const sizeEntries = Object.entries(sizes);
    if (sizeEntries.length > 0) {
      const sizeBtns = sizeEntries.map(([size, stock]) => {
        const active = selectedSize === size;
        return `<button onclick="selectSize('${escHtml(size)}')"
                    class="size-btn px-4 py-2.5 text-sm border rounded-sm transition-all duration-150 cursor-pointer font-body
                           ${active
                             ? 'bg-monolith-black text-off-white border-monolith-black'
                             : 'bg-transparent text-monolith-black border-outline-variant hover:border-monolith-black'}
                           ${stock <= 0 ? 'opacity-30 cursor-not-allowed' : ''}"
                    ${stock <= 0 ? 'disabled' : ''}>
                    <span class="font-medium">${escHtml(size)}</span>
                    <span class="text-xs ml-1.5 px-1.5 py-0.5 rounded-sm font-medium ${active ? 'bg-off-white/20 text-off-white' : 'bg-monolith-black/10 text-monolith-black'}">${stock}u</span>
                  </button>`;
      }).join('');
      sizeSection = `
        <div class="space-y-2">
          <label class="font-label-caps text-label-caps text-secondary block">TALLE</label>
          <div class="flex flex-wrap gap-2">${sizeBtns}</div>
        </div>`;
    }
  }

  // ── Price display ──
  let priceDisplay = sym + formatPrice(displayPrice);
  const selectedColorSizes = selectedColor ? colorMap[selectedColor]?.sizes || {} : {};
  let selectedVariant = null;
  if (selectedColor && selectedSize) {
    selectedVariant = (p.variants || []).find(
      v => v.color_name === selectedColor && v.size_value === selectedSize
    );
    if (selectedVariant) {
      const override = selectedVariant.price_override ? parseFloat(selectedVariant.price_override) : null;
      priceDisplay = sym + (override !== null ? formatPrice(override * exchangeRate) : formatPrice(displayPrice));
    }
  }

  // ── Add to cart section ──
  let addSection = '';
  if (selectedVariant) {
    const stock = parseInt(selectedVariant.stock) || 0;
    const canAdd = stock > 0;
    addSection = `
      <div class="pt-4 border-t border-outline-variant space-y-3">
        <div class="flex items-center justify-between">
          <span class="font-label-caps text-label-caps text-secondary">STOCK DISPONIBLE</span>
          <span class="font-body text-body-md font-semibold ${stock <= (p.lowStockThreshold || 5) ? 'text-error' : ''}">${stock} unidad(es)</span>
        </div>
        <div class="flex items-center gap-3">
          <label class="font-label-caps text-label-caps text-secondary shrink-0">CANTIDAD</label>
          <div class="flex items-center gap-1">
            <button onclick="changeAddQty(-1)" class="w-9 h-9 flex items-center justify-center border border-outline rounded-sm text-sm cursor-pointer
                           hover:bg-monolith-black/5 transition-colors ${addQty <= 1 ? 'opacity-30' : ''}">−</button>
            <span class="w-10 text-center font-body text-body-md tabular-nums font-semibold">${addQty}</span>
            <button onclick="changeAddQty(1)" class="w-9 h-9 flex items-center justify-center border border-outline rounded-sm text-sm cursor-pointer
                           hover:bg-monolith-black/5 transition-colors
                           ${addQty >= stock ? 'opacity-30' : ''}">+</button>
          </div>
        </div>
        <button onclick="addDetailToCart(${selectedVariant.id})"
                class="w-full bg-monolith-black text-off-white font-label-caps text-label-caps min-h-[48px] px-5 rounded-sm
                       flex items-center justify-center gap-2 hover:bg-monolith-black/90 transition-all duration-200 cursor-pointer
                       ${!canAdd ? 'opacity-40 cursor-not-allowed' : ''}"
                ${!canAdd ? 'disabled' : ''}>
          <span class="material-symbols-outlined text-xl">add_shopping_cart</span>
          <span>Agregar al carrito — ${priceDisplay}</span>
        </button>
      </div>`;
  }

  // ── Render ──
  productDetailContent.innerHTML = `
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        ${img
          ? `<img src="${escHtml(img)}" alt="${escHtml(p.name)}"
                 class="w-full h-56 object-cover rounded-sm"
                 onerror="this.style.display='none'" />`
          : `<div class="w-full h-56 bg-monolith-black/5 rounded-sm flex items-center justify-center">
               <span class="material-symbols-outlined text-4xl text-secondary/20">inventory_2</span>
             </div>`}
        <div class="mt-3 space-y-1">
          <h3 class="font-headline text-headline-sm">${escHtml(p.name)}</h3>
          <p class="font-price-display text-price-display text-monolith-black">${priceDisplay}</p>
          <p class="text-xs text-secondary">Stock total: ${p.totalStock || 0} unidad(es)</p>
          ${p.description ? `<p class="text-sm text-secondary mt-2 line-clamp-3">${escHtml(p.description)}</p>` : ''}
        </div>
      </div>
      <div class="space-y-5">
        <div class="space-y-2">
          <label class="font-label-caps text-label-caps text-secondary block flex items-center gap-2">
            COLOR
            ${selectedColor ? `<span class="text-xs text-secondary/50">· seleccionado: <strong>${escHtml(selectedColor)}</strong></span>` : ''}
          </label>
          <div class="flex flex-wrap gap-2">${colorBtns || '<span class="text-sm text-secondary">Sin colores disponibles</span>'}</div>
        </div>

        ${sizeSection}

        ${addSection}
      </div>
    </div>`;
}

// ─────────────────────────────────────────────
// SELECTORS
// ─────────────────────────────────────────────
function selectColor(color) {
  if (selectedColor === color) {
    selectedColor = null;
    selectedSize = null;
  } else {
    selectedColor = color;
    selectedSize = null;
  }
  addQty = 1;
  renderProductDetail();
}

function selectSize(size) {
  selectedSize = selectedSize === size ? null : size;
  addQty = 1;
  renderProductDetail();
}

function changeAddQty(delta) {
  addQty = Math.max(1, addQty + delta);
  renderProductDetail();
}

// ─────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────
function addDetailToCart(variantId) {
  const existing = cart.find(c => c.variant_id === variantId);
  if (existing) {
    existing.quantity += addQty;
    renderCart();
    return;
  }

  const p = selectedProduct;
  const v = (p.variants || []).find(x => x.id === variantId);
  if (!v) return;

  const price = v.price_override ? parseFloat(v.price_override) : parseFloat(p.price);
  cart.push({
    variant_id: variantId,
    product_id: p.id,
    product_name: p.name,
    color_name: v.color_name,
    size_label: v.size_value,
    price: price,
    quantity: addQty,
    max_stock: parseInt(v.stock) || 0,
  });
  renderCart();

  if (window.VunoToast) {
    window.VunoToast.success('Agregado', `${addQty}x ${p.name} — ${v.color_name}/${v.size_value}`);
  }
}

function renderCart() {
  const hasItems = cart.length > 0;
  emptyCart.classList.toggle('hidden', hasItems);
  cartItems.classList.toggle('hidden', !hasItems);
  cartSummary.classList.toggle('hidden', !hasItems);
  processBtn.disabled = !hasItems;
  overlayProcessBtn.disabled = !hasItems;
  cartCountBadge.classList.toggle('hidden', !hasItems);
  mobileCartBtn.disabled = !hasItems;

  const totalQty = cart.reduce((s, i) => s + i.quantity, 0);
  const subtotal = cart.reduce((s, i) => s + i.price * i.quantity, 0) * exchangeRate;
  const taxAmount = subtotal * taxRate;
  const grandTotal = subtotal + taxAmount;

  // ── Desktop cart ──
  if (hasItems) {
    cartCountBadge.textContent = totalQty;
  }
  if (!hasItems) {
    cartItems.innerHTML = '';
  } else {
    cartItems.innerHTML = cart.map((item, idx) => {
      const st = item.price * item.quantity * exchangeRate;
      return `<div class="flex items-start gap-3 py-3 first:pt-0">
                <div class="flex-1 min-w-0">
                  <p class="font-body text-body-md font-semibold truncate">${escHtml(item.product_name)}</p>
                  <p class="text-sm text-secondary">${escHtml(item.color_name)} / ${escHtml(item.size_label)}</p>
                  <p class="font-price-display text-price-display text-monolith-black">${currencySymbol}${formatPrice(st)}</p>
                </div>
                <div class="flex items-center gap-0.5 shrink-0">
                  <button onclick="updateQty(${idx}, -1)" class="w-8 h-8 flex items-center justify-center
                          border border-outline rounded-sm hover:bg-monolith-black/5 text-sm cursor-pointer
                          ${item.quantity <= 1 ? 'opacity-30' : ''}">−</button>
                  <span class="w-8 text-center font-body text-body-md tabular-nums">${item.quantity}</span>
                  <button onclick="updateQty(${idx}, 1)" class="w-8 h-8 flex items-center justify-center
                          border border-outline rounded-sm hover:bg-monolith-black/5 text-sm cursor-pointer">+</button>
                  <button onclick="removeItem(${idx})" class="ml-1 text-error/60 hover:text-error cursor-pointer"
                          aria-label="Eliminar item">
                    <span class="material-symbols-outlined text-lg">delete</span>
                  </button>
                </div>
              </div>`;
    }).join('');
  }

  cartSubtotal.textContent = currencySymbol + formatPrice(subtotal);
  cartTax.textContent = currencySymbol + formatPrice(taxAmount);
  cartTotal.textContent = currencySymbol + formatPrice(grandTotal);

  // ── Mobile floating bar ──
  if (hasItems) {
    mobileCartBar.classList.remove('translate-y-full');
    mobileCartCount.classList.remove('hidden');
    mobileCartCount.textContent = totalQty;
    mobileCartItems.textContent = totalQty + ' ítem(s)';
    mobileCartTotal.textContent = currencySymbol + formatPrice(grandTotal);
  } else {
    mobileCartBar.classList.add('translate-y-full');
    mobileCartCount.classList.add('hidden');
    mobileCartItems.textContent = '0 ítem(s)';
    mobileCartTotal.textContent = '$0.00';
  }

  // ── Mobile overlay cart ──
  if (!hasItems) {
    overlayCartItems.innerHTML = '<p class="text-center py-8 text-secondary font-body text-body-md">Carrito vacío</p>';
    overlayCartSummary.classList.add('hidden');
  } else {
    overlayCartItems.innerHTML = cart.map((item, idx) => {
      const st = item.price * item.quantity * exchangeRate;
      return `<div class="flex items-start gap-3 py-3 first:pt-0">
                <div class="flex-1 min-w-0">
                  <p class="font-body text-body-md font-semibold truncate">${escHtml(item.product_name)}</p>
                  <p class="text-sm text-secondary">${escHtml(item.color_name)} / ${escHtml(item.size_label)}</p>
                  <p class="font-price-display text-price-display text-monolith-black">${currencySymbol}${formatPrice(st)}</p>
                </div>
                <div class="flex items-center gap-0.5 shrink-0">
                  <button onclick="updateQty(${idx}, -1)" class="w-8 h-8 flex items-center justify-center
                          border border-outline rounded-sm hover:bg-monolith-black/5 text-sm cursor-pointer
                          ${item.quantity <= 1 ? 'opacity-30' : ''}">−</button>
                  <span class="w-8 text-center font-body text-body-md tabular-nums">${item.quantity}</span>
                  <button onclick="updateQty(${idx}, 1)" class="w-8 h-8 flex items-center justify-center
                          border border-outline rounded-sm hover:bg-monolith-black/5 text-sm cursor-pointer">+</button>
                  <button onclick="removeItem(${idx})" class="ml-1 text-error/60 hover:text-error cursor-pointer"
                          aria-label="Eliminar item">
                    <span class="material-symbols-outlined text-lg">delete</span>
                  </button>
                </div>
              </div>`;
    }).join('');
    overlayCartSummary.classList.remove('hidden');
  }

  overlayCartSubtotal.textContent = currencySymbol + formatPrice(subtotal);
  overlayCartTax.textContent = currencySymbol + formatPrice(taxAmount);
  overlayCartTotal.textContent = currencySymbol + formatPrice(grandTotal);
}

function updateQty(idx, delta) {
  const newQty = cart[idx].quantity + delta;
  if (newQty <= 0) {
    cart.splice(idx, 1);
  } else if (newQty <= cart[idx].max_stock) {
    cart[idx].quantity = newQty;
  }
  renderCart();
}

function removeItem(idx) {
  cart.splice(idx, 1);
  renderCart();
}

// ─────────────────────────────────────────────
// MOBILE CART OVERLAY
// ─────────────────────────────────────────────
function openCartOverlay() {
  cartOverlay.classList.remove('opacity-0', 'pointer-events-none');
  cartOverlayPanel.classList.remove('translate-y-full');
  document.body.classList.add('overflow-hidden');
}

function closeCartOverlay() {
  cartOverlayPanel.classList.add('translate-y-full');
  cartOverlay.classList.add('opacity-0', 'pointer-events-none');
  document.body.classList.remove('overflow-hidden');
}

// Sync customer name/email between desktop and mobile inputs
function syncCustomerInputs(source, target) {
  const src = document.getElementById(source);
  const tgt = document.getElementById(target);
  if (src && tgt) {
    src.addEventListener('input', function () { tgt.value = this.value; });
    tgt.addEventListener('input', function () { src.value = this.value; });
  }
}
syncCustomerInputs('posCustomerName', 'posCustomerNameMobile');
syncCustomerInputs('posCustomerEmail', 'posCustomerEmailMobile');

// Mobile cart button → opens overlay
if (mobileCartBtn) {
  mobileCartBtn.addEventListener('click', openCartOverlay);
}

// Overlay backdrop click → close
if (overlayBackdrop) {
  overlayBackdrop.addEventListener('click', closeCartOverlay);
}

// ─────────────────────────────────────────────
// PAYMENT METHOD
// ─────────────────────────────────────────────
document.querySelectorAll('.payment-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.payment-btn').forEach(b => {
      b.classList.remove('selected', 'bg-monolith-black', 'text-off-white');
      b.classList.add('bg-transparent', 'border', 'border-outline', 'text-monolith-black');
    });
    this.classList.add('selected', 'bg-monolith-black', 'text-off-white');
    this.classList.remove('bg-transparent', 'border', 'border-outline', 'text-monolith-black');
    paymentMethod = this.dataset.payment;
  });
});

// ─────────────────────────────────────────────
// PROCESS SALE
// ─────────────────────────────────────────────
async function processSale(btnEl) {
  if (cart.length === 0) return;
  btnEl.disabled = true;
  const btnText = btnEl.querySelector('span:last-child');
  const origText = btnText.textContent;
  btnText.textContent = 'Procesando...';

  const nameDesktop = $('posCustomerName');
  const nameMobile = $('posCustomerNameMobile');
  const emailDesktop = $('posCustomerEmail');
  const emailMobile = $('posCustomerEmailMobile');
  const customerName = ((nameDesktop?.value || nameMobile?.value) || 'Venta en Mostrador').trim();
  const customerEmail = ((emailDesktop?.value || emailMobile?.value) || '').trim();

  try {
    const res = await fetch('/api/pedidos/create-pos.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        cart_items: cart.map(i => ({ variant_id: i.variant_id, quantity: i.quantity })),
        payment_method: paymentMethod,
        customer_name: customerName,
        customer_email: customerEmail || undefined,
      }),
    });
    const data = await res.json();

    if (!data.success) {
      throw new Error(data.error || 'Error al procesar venta');
    }

    if (window.VunoToast) {
      window.VunoToast.success(
        'Venta procesada',
        `#${data.id} — ${currencySymbol}${formatPrice(data.total * exchangeRate)} — ${data.items_count} ítem(s)`
      );
    }
    cart = [];
    renderCart();
    closeCartOverlay();
    hideProductDetail();

  } catch (e) {
    if (window.VunoToast) {
      window.VunoToast.error('Error', e.message);
    } else {
      alert(e.message);
    }
  } finally {
    btnEl.disabled = cart.length === 0;
    btnText.textContent = origText;
  }
}

processBtn.addEventListener('click', function () { processSale(this); });
overlayProcessBtn.addEventListener('click', function () { processSale(this); });

// ─────────────────────────────────────────────
// SEARCH
// ─────────────────────────────────────────────
let searchTimer;
searchInput.addEventListener('input', function () {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => renderProducts(this.value), 250);
});

// ─────────────────────────────────────────────
// KEYBOARD SHORTCUTS
// ─────────────────────────────────────────────
document.addEventListener('keydown', function (e) {
  if (e.key === '/' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
    e.preventDefault();
    searchInput.focus();
  }
  if (e.key === 'Enter' && e.target === searchInput) {
    const filtered = getFilteredProducts(searchInput.value);
    if (filtered.length > 0) {
      showProductDetail(filtered[0].id);
    }
  }
  if (e.key === 'Escape') {
    if (cartOverlay && !cartOverlay.classList.contains('opacity-0')) {
      closeCartOverlay();
    } else if (productDetail.classList.contains('hidden') === false) {
      hideProductDetail();
    } else if (document.activeElement === searchInput) {
      searchInput.blur();
    }
  }
});

function formatPrice(val) {
  const fixed = (parseFloat(val) || 0).toFixed(decimalPlaces);
  const parts = fixed.split('.');
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return parts.join('.');
}

function escHtml(str) {
  const div = document.createElement('div');
  div.textContent = str || '';
  return div.innerHTML;
}

loadProducts();

// Expose functions globally for inline onclick handlers
window.showProductDetail = showProductDetail;
window.hideProductDetail = hideProductDetail;
window.selectColor = selectColor;
window.selectSize = selectSize;
window.changeAddQty = changeAddQty;
window.addDetailToCart = addDetailToCart;
window.updateQty = updateQty;
window.removeItem = removeItem;
window.openCartOverlay = openCartOverlay;
window.closeCartOverlay = closeCartOverlay;
</script>

