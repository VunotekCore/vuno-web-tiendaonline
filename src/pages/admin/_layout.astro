---
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  title: string;
  currentPath?: string;
}

const { title, currentPath = "" } = Astro.props;

const navItems = [
  { href: "/admin", label: "Dashboard", icon: "dashboard" },
  { href: "/admin/productos", label: "Productos", icon: "inventory_2" },
  { href: "/admin/categorias", label: "Categorías", icon: "category" },
  { href: "/admin/cupones", label: "Cupones", icon: "confirmation_number" },
  { href: "/admin/resenas", label: "Reseñas", icon: "reviews" },
  { href: "/admin/blog", label: "Blog", icon: "article" },
  { href: "/admin/email-templates", label: "Plantillas Email", icon: "mail" },
  { href: "/admin/suscriptores", label: "Suscriptores", icon: "contacts" },
  { href: "/admin/pedidos", label: "Pedidos", icon: "receipt_long" },
  { href: "/admin/configuracion", label: "Configuración", icon: "settings" },
  { href: "/admin/seguridad", label: "Seguridad", icon: "security" },
  { href: "/admin/usuarios", label: "Usuarios", icon: "group", class: "nav-superadmin" },
];
---

<BaseLayout title={`${title} | Admin | Ram;Lop`}>
  <div class="min-h-screen flex bg-background">
    <!-- Sidebar -->
    <aside class="hidden md:flex md:flex-col w-64 bg-monolith-black text-off-white shrink-0">
      <div class="px-6 py-6 border-b border-white/10">
        <a href="/admin" class="font-headline text-headline-md tracking-tighter block">
          <img data-store-logo alt="" class="h-6 w-auto hidden object-contain brightness-0 invert mb-1" />
          <span data-store-name>Ram;Lop</span>
        </a>
        <span class="font-label-caps text-label-caps text-stone-gray mt-1 block">ADMIN PANEL</span>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
              currentPath === item.href
                ? "bg-white/10 text-off-white"
                : "text-stone-gray hover:text-off-white hover:bg-white/5"
            } ${item.class || ''}`}
          >
            <span class="material-symbols-outlined text-xl">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="px-4 py-4 border-t border-white/10 space-y-1">
        <a href="/" target="_blank" class="flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-off-white hover:bg-white/5 rounded-sm transition-colors">
          <span class="material-symbols-outlined text-xl">open_in_new</span>
          Sitio Público
        </a>
        <button id="logoutBtn" class="w-full flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-error hover:bg-white/5 rounded-sm transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-xl">logout</span>
          Cerrar Sesión
        </button>
      </div>
    </aside>

    <!-- Mobile top nav -->
    <nav class="md:hidden fixed top-0 left-0 right-0 bg-monolith-black text-off-white z-50">
      <div class="flex items-center justify-between px-4 h-14">
        <a href="/admin" class="font-headline text-headline-md tracking-tighter"><span data-store-name>Ram;Lop</span></a>
        <button id="mobileMenuBtn" class="material-symbols-outlined text-2xl cursor-pointer">menu</button>
      </div>
      <div id="mobileMenu" class="hidden px-4 pb-4 space-y-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
              currentPath === item.href
                ? "bg-white/10 text-off-white"
                : "text-stone-gray hover:text-off-white hover:bg-white/5"
            } ${item.class || ''}`}
          >
            <span class="material-symbols-outlined text-xl">{item.icon}</span>
            {item.label}
          </a>
        ))}
        <a href="/" target="_blank" class="flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-off-white hover:bg-white/5 rounded-sm transition-colors">
          <span class="material-symbols-outlined text-xl">open_in_new</span>
          Sitio Público
        </a>
        <button id="mobileLogoutBtn" class="w-full flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-error hover:bg-white/5 rounded-sm transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-xl">logout</span>
          Cerrar Sesión
        </button>
      </div>
    </nav>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-h-screen pt-14 md:pt-0">
      <div class="border-b border-outline-variant bg-off-white">
        <div class="px-6 py-4">
          <h1 class="font-headline text-headline-md text-monolith-black">{title}</h1>
        </div>
      </div>

      <div class="px-4 md:px-8 py-8 flex-grow">
        <slot />
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    // Auth guard
    (async function () {
      try {
        const res = await fetch("/api/admin/verify.php");
        const data = await res.json();
        if (!data.valid) window.location.href = "/admin/login";

        // Expose role globally for child pages
        window.adminRole = data.role;

        // Hide role-restricted nav items based on user role
        if (data.role !== "superadmin") {
          document.querySelectorAll(".nav-superadmin").forEach(el => el.remove());
        }
      } catch {
        window.location.href = "/admin/login";
      }
    })();

    function logout() {
      fetch("/api/admin/logout.php").then(() => { window.location.href = "/admin/login"; });
    }
    document.getElementById("logoutBtn")?.addEventListener("click", logout);
    document.getElementById("mobileLogoutBtn")?.addEventListener("click", logout);

    // Mobile menu toggle
    document.getElementById("mobileMenuBtn")?.addEventListener("click", function () {
      const menu = document.getElementById("mobileMenu");
      menu.classList.toggle("hidden");
      this.textContent = menu.classList.contains("hidden") ? "menu" : "close";
    });
  </script>
</BaseLayout>
