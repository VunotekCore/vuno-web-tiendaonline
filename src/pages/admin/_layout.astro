---
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  title: string;
  currentPath?: string;
}

const { title, currentPath = "" } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  icon: string;
  class?: string;
  children?: { href: string; label: string; icon?: string }[];
}

const navItems: NavItem[] = [
  { href: "/admin", label: "Dashboard", icon: "dashboard" },
  { href: "/admin/productos", label: "Productos", icon: "inventory_2" },
  { href: "/admin/resenas", label: "Reseñas", icon: "reviews" },
  {
    href: "/admin/blog",
    label: "Blog",
    icon: "article",
    children: [
      { href: "/admin/blog/categorias", label: "Categorías", icon: "category" },
    ],
  },
  { href: "/admin/suscriptores", label: "Suscriptores", icon: "contacts" },
  { href: "/admin/newsletter/campanas", label: "Campañas", icon: "campaign" },
  { href: "/admin/pedidos", label: "Pedidos", icon: "receipt_long" },
  {
    href: "/admin/configuracion",
    label: "Configuración",
    icon: "settings",
    children: [
      { href: "/admin/categorias", label: "Categorías", icon: "category" },
      { href: "/admin/cupones", label: "Cupones", icon: "confirmation_number" },
      { href: "/admin/email-templates", label: "Plantillas Email", icon: "mail" },
      { href: "/admin/seguridad", label: "Seguridad", icon: "security" },
    ],
  },
  { href: "/admin/usuarios", label: "Usuarios", icon: "group", class: "nav-superadmin" },
];

function isExpanded(item: NavItem): boolean {
  if (!item.children) return false;
  if (currentPath === item.href) return true;
  return item.children.some((c: { href: string }) => currentPath === c.href);
}
---

<BaseLayout title={`${title} | Admin | Ram;Lop`} seo={{ noindex: true }}>
  <a href="#admin-main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:bg-monolith-black focus:text-off-white focus:outline-none focus:ring-2 focus:ring-off-white" aria-label="Saltar al contenido principal">Saltar al contenido</a>
  <div class="min-h-screen flex bg-background">
    <!-- Sidebar -->
    <aside class="hidden lg:flex lg:flex-col w-64 bg-monolith-black text-off-white shrink-0">
      <div class="px-6 py-6 border-b border-white/10">
        <a href="/admin" class="font-headline text-headline-md tracking-tighter block">
          <img data-store-logo alt="" class="h-6 w-auto hidden object-contain brightness-0 invert mb-1" />
          <span data-store-name>Ram;Lop</span>
        </a>
        <span class="font-label-caps text-label-caps text-stone-gray mt-1 block">ADMIN PANEL</span>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-1">
        {navItems.map(item => (
          item.children ? (
            <div>
              <a
                href={item.href}
                class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                  currentPath === item.href
                    ? "bg-white/10 text-off-white"
                    : "text-stone-gray hover:text-off-white hover:bg-white/5"
                } ${item.class || ''}`}
                data-nav-parent
              >
                <span class="material-symbols-outlined text-xl">{item.icon}</span>
                {item.label}
                <button type="button" class="ml-auto cursor-pointer" data-nav-chevron aria-label="Toggle submenu">
                  <span class="material-symbols-outlined transition-transform">expand_more</span>
                </button>
              </a>
              <div class="ml-4 space-y-0.5 {isExpanded(item) ? '' : 'hidden'}" data-nav-children>
                {item.children.map(child => (
                  <a
                    href={child.href}
                    class={`flex items-center gap-4 px-3 py-2 font-label-caps text-label-caps rounded-sm transition-colors ${
                      currentPath === child.href
                        ? "bg-white/10 text-off-white"
                        : "text-stone-gray hover:text-off-white hover:bg-white/5"
                    }`}
                  >
                    <span class="material-symbols-outlined text-lg">{child.icon}</span>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                currentPath === item.href
                  ? "bg-white/10 text-off-white"
                  : "text-stone-gray hover:text-off-white hover:bg-white/5"
              } ${item.class || ''}`}
            >
              <span class="material-symbols-outlined text-xl">{item.icon}</span>
              {item.label}
            </a>
          )
        ))}
      </nav>

      <div class="px-4 py-4 border-t border-white/10 space-y-1">
        <a href="/" target="_blank" class="flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-off-white hover:bg-white/5 rounded-sm transition-colors">
          <span class="material-symbols-outlined text-xl">open_in_new</span>
          Sitio Público
        </a>
        <button id="logoutBtn" class="w-full flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-error hover:bg-white/5 rounded-sm transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-xl">logout</span>
          Cerrar Sesión
        </button>
      </div>
    </aside>

    <!-- Mobile top nav -->
    <nav class="lg:hidden fixed top-0 left-0 right-0 bg-monolith-black text-off-white z-50">
      <div class="flex items-center justify-between px-4 h-14">
        <a href="/admin" class="font-headline text-headline-md tracking-tighter"><span data-store-name>Ram;Lop</span></a>
        <button id="mobileMenuBtn" class="material-symbols-outlined text-2xl cursor-pointer">menu</button>
      </div>
      <div id="mobileMenu" class="hidden px-4 pb-4 space-y-1">
        {navItems.map(item => (
          item.children ? (
            <div>
              <a
                href={item.href}
                class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                  currentPath === item.href
                    ? "bg-white/10 text-off-white"
                    : "text-stone-gray hover:text-off-white hover:bg-white/5"
                }`}
                data-nav-parent
              >
                <span class="material-symbols-outlined text-xl">{item.icon}</span>
                {item.label}
                <button type="button" class="ml-auto cursor-pointer" data-nav-chevron aria-label="Toggle submenu">
                  <span class="material-symbols-outlined transition-transform">expand_more</span>
                </button>
              </a>
              <div class="ml-4 space-y-0.5 {isExpanded(item) ? '' : 'hidden'}" data-nav-children>
                {item.children.map(child => (
                  <a
                    href={child.href}
                    class={`flex items-center gap-4 px-3 py-2 font-label-caps text-label-caps rounded-sm transition-colors ${
                      currentPath === child.href
                        ? "bg-white/10 text-off-white"
                        : "text-stone-gray hover:text-off-white hover:bg-white/5"
                    }`}
                  >
                    <span class="material-symbols-outlined text-lg">{child.icon}</span>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                currentPath === item.href
                  ? "bg-white/10 text-off-white"
                  : "text-stone-gray hover:text-off-white hover:bg-white/5"
              }`}
            >
              <span class="material-symbols-outlined text-xl">{item.icon}</span>
              {item.label}
            </a>
          )
        ))}
        <a href="/" target="_blank" class="flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-off-white hover:bg-white/5 rounded-sm transition-colors">
          <span class="material-symbols-outlined text-xl">open_in_new</span>
          Sitio Público
        </a>
        <button id="mobileLogoutBtn" class="w-full flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-stone-gray hover:text-error hover:bg-white/5 rounded-sm transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-xl">logout</span>
          Cerrar Sesión
        </button>
      </div>
    </nav>

    <!-- Main content -->
    <main id="admin-main" class="flex-1 flex flex-col min-h-screen min-w-0 pt-14 lg:pt-0">
      <div class="border-b border-outline-variant bg-off-white">
        <div class="px-4 md:px-6 py-4">
          <h1 class="font-headline text-headline-md text-monolith-black">{title}</h1>
        </div>
      </div>

      <div class="px-4 md:px-8 py-8 flex-grow">
        <slot />
      </div>
    </main>
  </div>

  <script is:inline>
    // @ts-nocheck
    // Auth guard
    (async function () {
      try {
        const res = await fetch("/api/admin/verify.php");
        const data = await res.json();
        if (!data.valid) window.location.href = "/admin/login";

        // Expose role globally for child pages
        window.adminRole = data.role;

        // Hide role-restricted nav items based on user role
        if (data.role !== "superadmin") {
          document.querySelectorAll(".nav-superadmin").forEach(el => el.remove());
        }
      } catch {
        window.location.href = "/admin/login";
      }
    })();

    function logout() {
      fetch("/api/admin/logout.php").then(() => { window.location.href = "/admin/login"; });
    }
    document.getElementById("logoutBtn")?.addEventListener("click", logout);
    document.getElementById("mobileLogoutBtn")?.addEventListener("click", logout);

    // Mobile menu toggle
    document.getElementById("mobileMenuBtn")?.addEventListener("click", function () {
      const menu = document.getElementById("mobileMenu");
      menu.classList.toggle("hidden");
      this.textContent = menu.classList.contains("hidden") ? "menu" : "close";
    });

    // Sidebar expand/collapse — set initial chevron state for expanded sections
    document.querySelectorAll('[data-nav-children]').forEach(function (container) {
      if (!container.classList.contains('hidden')) {
        var chevron = container.previousElementSibling?.querySelector('[data-nav-chevron] .material-symbols-outlined');
        if (chevron) chevron.textContent = 'expand_less';
      }
    });

    document.querySelectorAll('[data-nav-chevron]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var parent = this.closest('[data-nav-parent]');
        if (!parent) return;
        var children = parent.nextElementSibling;
        if (!children || !children.hasAttribute('data-nav-children')) return;
        var isHidden = children.classList.toggle('hidden');
        var icon = this.querySelector('.material-symbols-outlined');
        if (icon) icon.textContent = isHidden ? 'expand_more' : 'expand_less';
      });
    });
  </script>
</BaseLayout>
