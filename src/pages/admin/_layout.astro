---
import "../../styles/base.css";
import "../../styles/admin.css";
import Modal from "../../components/molecules/Modal.astro";


interface Props {
  title: string;
  currentPath?: string;
}

const { title, currentPath = "" } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  icon: string;
  class?: string;
  children?: { href: string; label: string; icon?: string; class?: string }[];
}

const navItems: NavItem[] = [
  { href: "/admin/pos/dashboard", label: "Mostrador", icon: "point_of_sale", class: "nav-pos" },
  { href: "/admin/pos", label: "POS", icon: "point_of_sale", class: "nav-pos" },
  { href: "/admin", label: "Dashboard", icon: "dashboard", class: "nav-cashier-hide" },
  { href: "/admin/productos", label: "Productos", icon: "inventory_2", class: "nav-cashier-hide" },
  { href: "/admin/resenas", label: "Reseñas", icon: "reviews", class: "nav-cashier-hide" },
  { href: "/admin/clientes", label: "Clientes", icon: "group", class: "nav-cashier-hide" },
  {
    href: "/admin/blog",
    label: "Blog",
    icon: "article",
    class: "nav-cashier-hide",
    children: [
      { href: "/admin/blog/categorias", label: "Categorías", icon: "category", class: "nav-cashier-hide" },
    ],
  },
  { href: "/admin/suscriptores", label: "Suscriptores", icon: "contacts", class: "nav-cashier-hide" },
  { href: "/admin/newsletter/campanas", label: "Campañas", icon: "campaign", class: "nav-cashier-hide" },
  { href: "/admin/pedidos", label: "Pedidos", icon: "receipt_long" },
  {
    href: "/admin/configuracion",
    label: "Configuración",
    icon: "settings",
    class: "nav-cashier-hide",
    children: [
      { href: "/admin/categorias", label: "Categorías", icon: "category", class: "nav-cashier-hide" },
      { href: "/admin/cupones", label: "Cupones", icon: "confirmation_number", class: "nav-cashier-hide" },
      { href: "/admin/email-templates", label: "Plantillas Email", icon: "mail", class: "nav-cashier-hide" },
      { href: "/admin/seguridad", label: "Seguridad", icon: "security", class: "nav-cashier-hide" },
    ],
  },
  { href: "/admin/usuarios", label: "Usuarios", icon: "group", class: "nav-superadmin nav-cashier-hide" },
];

function isExpanded(item: NavItem): boolean {
  if (!item.children) return false;
  if (currentPath === item.href) return true;
  return item.children.some((c: { href: string }) => currentPath === c.href);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Admin | Ram;Lop</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b1326" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;500;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0a1022] text-[#dae2fd] antialiased min-h-screen flex">
    <a href="#admin-main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:bg-[#42b883] focus:text-white focus:outline-none focus:ring-2 focus:ring-white" aria-label="Saltar al contenido principal">Saltar al contenido</a>

    <!-- Sidebar (desktop) -->
    <aside class="hidden lg:flex lg:flex-col w-64 shrink-0 bg-[#0b1326] border-r border-[#1e293b]">
      <div class="px-6 py-6 border-b border-[#1e293b]">
        <a href="/admin" class="font-headline text-headline-md tracking-tighter block text-[#dae2fd]">
          <span data-store-name>Ram;Lop</span>
        </a>
        <span class="font-label-caps text-label-caps text-[#94a3b8] mt-1 block">ADMIN PANEL</span>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
        {navItems.map(item => (
          item.children ? (
            <div class={item.class || ''}>
              <a
                href={item.href}
                class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                  currentPath === item.href
                    ? "bg-white/10 text-[#dae2fd]"
                    : "text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5"
                }`}
                data-nav-parent
              >
                <span class="material-symbols-outlined text-xl">{item.icon}</span>
                {item.label}
                <button type="button" class="ml-auto cursor-pointer" data-nav-chevron aria-label="Toggle submenu">
                  <span class="material-symbols-outlined transition-transform text-[#94a3b8]">expand_more</span>
                </button>
              </a>
              <div class="ml-4 space-y-0.5 {isExpanded(item) ? '' : 'hidden'}" data-nav-children>
                {item.children.map(child => (
                  <a
                    href={child.href}
                    class={`flex items-center gap-4 px-3 py-2 font-label-caps text-label-caps rounded-sm transition-colors ${
                      currentPath === child.href
                        ? "bg-white/10 text-[#dae2fd]"
                        : "text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5"
                    }`}
                  >
                    <span class="material-symbols-outlined text-lg">{child.icon}</span>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                currentPath === item.href
                  ? "bg-white/10 text-[#dae2fd]"
                  : "text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5"
              } ${item.class || ''}`}
            >
              <span class="material-symbols-outlined text-xl">{item.icon}</span>
              {item.label}
            </a>
          )
        ))}
      </nav>

      <div class="px-4 py-4 border-t border-[#1e293b] space-y-1">
        <a href="/" target="_blank" class="flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5 rounded-sm transition-colors">
          <span class="material-symbols-outlined text-xl">open_in_new</span>
          Sitio Público
        </a>
        <button id="logoutBtn" class="w-full flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-[#94a3b8] hover:text-[#DC2626] hover:bg-white/5 rounded-sm transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-xl">logout</span>
          Cerrar Sesión
        </button>
      </div>
    </aside>

    <!-- Mobile top nav -->
    <nav class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-[#0b1326] border-b border-[#1e293b]">
      <div class="flex items-center justify-between px-4 h-14">
        <a href="/admin" class="font-headline text-headline-md tracking-tighter text-[#dae2fd]"><span data-store-name>Ram;Lop</span></a>
        <button id="mobileMenuBtn" class="material-symbols-outlined text-2xl cursor-pointer text-[#dae2fd]">menu</button>
      </div>
      <div id="mobileMenu" class="hidden px-4 pb-4 space-y-1">
        {navItems.map(item => (
          item.children ? (
            <div class={item.class || ''}>
              <a
                href={item.href}
                class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                  currentPath === item.href
                    ? "bg-white/10 text-[#dae2fd]"
                    : "text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5"
                }`}
                data-nav-parent
              >
                <span class="material-symbols-outlined text-xl">{item.icon}</span>
                {item.label}
                <button type="button" class="ml-auto cursor-pointer" data-nav-chevron aria-label="Toggle submenu">
                  <span class="material-symbols-outlined transition-transform text-[#94a3b8]">expand_more</span>
                </button>
              </a>
              <div class="ml-4 space-y-0.5 {isExpanded(item) ? '' : 'hidden'}" data-nav-children>
                {item.children.map(child => (
                  <a
                    href={child.href}
                    class={`flex items-center gap-4 px-3 py-2 font-label-caps text-label-caps rounded-sm transition-colors ${
                      currentPath === child.href
                        ? "bg-white/10 text-[#dae2fd]"
                        : "text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5"
                    }`}
                  >
                    <span class="material-symbols-outlined text-lg">{child.icon}</span>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps rounded-sm transition-colors ${
                currentPath === item.href
                  ? "bg-white/10 text-[#dae2fd]"
                  : "text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5"
              } ${item.class || ''}`}
            >
              <span class="material-symbols-outlined text-xl">{item.icon}</span>
              {item.label}
            </a>
          )
        ))}
        <a href="/" target="_blank" class="flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-[#94a3b8] hover:text-[#dae2fd] hover:bg-white/5 rounded-sm transition-colors">
          <span class="material-symbols-outlined text-xl">open_in_new</span>
          Sitio Público
        </a>
        <button id="mobileLogoutBtn" class="w-full flex items-center gap-4 px-3 py-3 font-label-caps text-label-caps text-[#94a3b8] hover:text-[#DC2626] hover:bg-white/5 rounded-sm transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-xl">logout</span>
          Cerrar Sesión
        </button>
      </div>
    </nav>

    <!-- Main content -->
    <main id="admin-main" class="flex-1 flex flex-col min-h-screen min-w-0 pt-14 lg:pt-0 relative">
      <div class="noise-overlay opacity-[0.025]"></div>
      <div class="border-b border-[#1e293b] bg-[#111d2e]">
        <div class="px-4 md:px-6 py-4">
          <h1 class="font-headline text-headline-md text-[#dae2fd]">{title}</h1>
        </div>
      </div>

      <div class="px-4 md:px-8 py-8 flex-grow">
        <slot />
      </div>
    </main>

    <Modal />

    <script is:inline>
      // @ts-nocheck
      // Auth guard + CSRF injection
      (async function () {
        try {
          const res = await fetch("/api/admin/verify.php");
          const data = await res.json();
          if (!data.valid) {
            window.location.href = "/admin/login";
            return;
          }

          // Inject CSRF token
          window.__csrfToken = data.csrf_token || '';
          window.adminRole = data.role;

          // Role-based navigation visibility
          if (data.role !== "superadmin") {
            document.querySelectorAll(".nav-superadmin").forEach(el => el.remove());
          }

          if (data.role === "cashier") {
            document.querySelectorAll(".nav-cashier-hide").forEach(el => el.remove());
            var allowedPaths = ["/admin/pos", "/admin/pedidos", "/admin/login"];
            var current = window.location.pathname;
            var isAllowed = allowedPaths.some(function (p) { return current === p || current.startsWith(p + "/"); });
            if (!isAllowed) {
              window.location.href = "/admin/pos/dashboard";
            }
          }
        } catch {
          window.location.href = "/admin/login";
        }
      })();

      function logout() {
        fetch("/api/admin/logout.php").then(function () {
          window.location.href = "/admin/login";
        });
      }
      document.getElementById("logoutBtn")?.addEventListener("click", logout);
      document.getElementById("mobileLogoutBtn")?.addEventListener("click", logout);

      // Mobile menu toggle
      document.getElementById("mobileMenuBtn")?.addEventListener("click", function () {
        const menu = document.getElementById("mobileMenu");
        menu.classList.toggle("hidden");
        this.textContent = menu.classList.contains("hidden") ? "menu" : "close";
      });

      // Sidebar expand/collapse
      document.querySelectorAll('[data-nav-children]').forEach(function (container) {
        if (!container.classList.contains('hidden')) {
          var chevron = container.previousElementSibling?.querySelector('[data-nav-chevron] .material-symbols-outlined');
          if (chevron) chevron.textContent = 'expand_less';
        }
      });

      document.querySelectorAll('[data-nav-chevron]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var parent = this.closest('[data-nav-parent]');
          if (!parent) return;
          var children = parent.nextElementSibling;
          if (!children || !children.hasAttribute('data-nav-children')) return;
          var isHidden = children.classList.toggle('hidden');
          var icon = this.querySelector('.material-symbols-outlined');
          if (icon) icon.textContent = isHidden ? 'expand_more' : 'expand_less';
        });
      });
    </script>
  </body>
</html>
