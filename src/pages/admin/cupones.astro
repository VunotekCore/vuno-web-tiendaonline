---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Cupones" currentPath="/admin/cupones">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
      <div class="relative flex-1 sm:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <input type="text" id="searchInput" placeholder="Buscar cupones..." aria-label="Buscar cupones" class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md focus-visible:ring-2 focus-visible:ring-monolith-black" />
      </div>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="couponCount">0 cupones</p>
    </div>
    <button id="openCreateBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 shrink-0 w-full sm:w-auto">
      <span class="material-symbols-outlined text-lg">add</span>
      NUEVO CUPÓN
    </button>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">CÓDIGO</th>
            <th class="p-4 font-medium">DESCUENTO</th>
            <th class="p-4 font-medium">VIGENCIA</th>
            <th class="p-4 font-medium">USOS</th>
            <th class="p-4 font-medium">ESTADO</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="couponsBody">
          <tr><td colspan="6" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile cards -->
  <div id="couponCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="hidden mt-6 flex items-center justify-center gap-2"></div>

  <!-- Create/Edit Modal -->
  <div id="formModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-headline text-headline-md flex items-center gap-2" id="formModalTitle">
          <span class="material-symbols-outlined text-xl">add_circle</span>
          Nuevo Cupón
        </h3>
        <button id="formCloseX" class="w-10 h-10 flex items-center justify-center text-secondary hover:text-monolith-black transition-colors rounded-sm hover:bg-monolith-black/5 cursor-pointer">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <div class="space-y-4">
        <div>
          <label for="formCode" class="font-label-caps text-label-caps text-secondary block mb-1">CÓDIGO *</label>
          <div class="relative">
            <input type="text" id="formCode" maxlength="50" class="w-full bg-transparent border-b-2 border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none text-lg uppercase transition-colors duration-200" placeholder="ej. BIENVENIDO10" autocomplete="off" />
            <span id="formCodeCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/50</span>
          </div>
        </div>
        <div>
          <label for="formDescription" class="font-label-caps text-label-caps text-secondary block mb-1">DESCRIPCIÓN</label>
          <div class="relative">
            <input type="text" id="formDescription" maxlength="255" class="w-full bg-transparent border-b-2 border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200" placeholder="Descripción interna" autocomplete="off" />
            <span id="formDescCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/255</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="formType" class="font-label-caps text-label-caps text-secondary block mb-1">TIPO *</label>
            <select id="formType" class="w-full bg-transparent border-b-2 border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200">
              <option value="percentage">Porcentaje (%)</option>
              <option value="fixed">Monto fijo ($)</option>
            </select>
          </div>
          <div>
            <label for="formValue" class="font-label-caps text-label-caps text-secondary block mb-1">VALOR *</label>
            <input type="number" step="0.01" min="0" id="formValue" class="w-full bg-transparent border-b-2 border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" placeholder="10" />
          </div>
        </div>
        <div>
          <label for="formMinAmount" class="font-label-caps text-label-caps text-secondary block mb-1">MONTO MÍNIMO DE PEDIDO</label>
            <input type="number" step="0.01" min="0" id="formMinAmount" class="w-full bg-transparent border-b-2 border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" placeholder="0 (sin mínimo)" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="formMaxUses" class="font-label-caps text-label-caps text-secondary block mb-1">USOS MÁXIMOS (TOTAL)</label>
            <input type="number" min="0" id="formMaxUses" class="w-full bg-transparent border-b-2 border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" placeholder="Ilimitado" />
          </div>
          <div>
            <label for="formMaxPerCustomer" class="font-label-caps text-label-caps text-secondary block mb-1">USOS POR CLIENTE</label>
            <input type="number" min="0" id="formMaxPerCustomer" class="w-full bg-transparent border-b-2 border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" placeholder="Ilimitado" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="formStartsAt" class="font-label-caps text-label-caps text-secondary block mb-1">VÁLIDO DESDE</label>
            <input type="datetime-local" id="formStartsAt" class="w-full bg-transparent border-b-2 border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" />
          </div>
          <div>
            <label for="formExpiresAt" class="font-label-caps text-label-caps text-secondary block mb-1">VÁLIDO HASTA</label>
            <input type="datetime-local" id="formExpiresAt" class="w-full bg-transparent border-b-2 border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" />
          </div>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <input type="checkbox" id="formActive" class="w-5 h-5 accent-monolith-black cursor-pointer" checked />
          <label for="formActive" class="font-body text-body-md text-monolith-black cursor-pointer select-none">Activo</label>
        </div>
      </div>

      <div id="formMsg" class="hidden font-body text-body-md text-sm mt-4" aria-live="polite"></div>
      <div class="flex justify-end gap-3 mt-6">
        <button id="formCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="formSaveBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="formSaveIcon">add</span>
          <span id="formSaveText">CREAR</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-error">warning</span>
        <h3 id="deleteModalTitle" class="font-headline text-headline-md">Eliminar Cupón</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <p class="font-body text-body-md text-xs text-error/70 mb-6 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">info</span>
        Esta acción no se puede deshacer.
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="deleteIcon">delete</span>
          <span id="deleteBtnText">ELIMINAR</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #formModal:not(.hidden), #deleteModal:not(.hidden) {
      display: flex;
    }
  </style>

  <script>
    // @ts-nocheck
    const CODE_MAX = 50;
    const DESC_MAX = 255;
    const PAGE_LIMIT = 10;
    let editTargetId = null;
    let deleteTargetId = null;
    let currentOffset = 0;
    let totalCoupons = 0;
    let searchTerm = "";
    let searchTimeout = null;

    // --- Character counter ---
    function setupCharCount(inputId, counterId, max) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(counterId);
      if (!input || !counter) return;
      function update() {
        const len = input.value.length;
        counter.textContent = len + "/" + max;
        counter.className = "absolute right-0 bottom-2 text-xs font-body pointer-events-none transition-colors duration-200 " +
          (len >= max ? "text-error" : len >= max * 0.8 ? "text-clay-accent" : "text-secondary");
      }
      input.addEventListener("input", update);
      update();
    }

    // --- Loading state helpers ---
    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Procesando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "add";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    // --- Modal controls ---
    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove("hidden");
      el.classList.add("flex");
      const content = el.querySelector(".modal-content");
      if (content) {
        content.style.animation = "none";
        void content.offsetHeight;
        content.style.animation = "";
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add("hidden");
      el.classList.remove("flex");
    }

    function openCreateModal() {
      editTargetId = null;
      document.getElementById("formModalTitle").innerHTML = '<span class="material-symbols-outlined text-xl">add_circle</span> Nuevo Cupón';
      document.getElementById("formSaveIcon").textContent = "add";
      document.getElementById("formSaveText").textContent = "CREAR";
      document.getElementById("formCode").value = "";
      document.getElementById("formDescription").value = "";
      document.getElementById("formType").value = "percentage";
      document.getElementById("formValue").value = "";
      document.getElementById("formMinAmount").value = "";
      document.getElementById("formMaxUses").value = "";
      document.getElementById("formMaxPerCustomer").value = "";
      document.getElementById("formStartsAt").value = "";
      document.getElementById("formExpiresAt").value = "";
      document.getElementById("formActive").checked = true;
      document.getElementById("formMsg").classList.add("hidden");
      // Refresh char counters after reset
      setupCharCount("formCode", "formCodeCounter", CODE_MAX);
      setupCharCount("formDescription", "formDescCounter", DESC_MAX);
      openModal("formModal");
      setTimeout(() => document.getElementById("formCode").focus(), 100);
      setLoading("formSaveBtn", "formSaveIcon", "formSaveText", false);
    }

    function openEditModal(coupon) {
      editTargetId = coupon.id;
      document.getElementById("formModalTitle").innerHTML = '<span class="material-symbols-outlined text-xl">edit</span> Editar Cupón';
      document.getElementById("formSaveIcon").textContent = "save";
      document.getElementById("formSaveText").textContent = "GUARDAR";
      document.getElementById("formCode").value = coupon.code;
      document.getElementById("formDescription").value = coupon.description || "";
      document.getElementById("formType").value = coupon.discount_type;
      document.getElementById("formValue").value = coupon.discount_value;
      document.getElementById("formMinAmount").value = coupon.min_order_amount || "";
      document.getElementById("formMaxUses").value = coupon.max_uses || "";
      document.getElementById("formMaxPerCustomer").value = coupon.max_uses_per_customer || "";
      document.getElementById("formStartsAt").value = coupon.starts_at ? coupon.starts_at.substring(0, 16) : "";
      document.getElementById("formExpiresAt").value = coupon.expires_at ? coupon.expires_at.substring(0, 16) : "";
      document.getElementById("formActive").checked = coupon.is_active;
      document.getElementById("formMsg").classList.add("hidden");
      setupCharCount("formCode", "formCodeCounter", CODE_MAX);
      setupCharCount("formDescription", "formDescCounter", DESC_MAX);
      openModal("formModal");
      setTimeout(() => document.getElementById("formCode").focus(), 100);
      setLoading("formSaveBtn", "formSaveIcon", "formSaveText", false);
    }

    function closeFormModal() { closeModal("formModal"); editTargetId = null; }

    function openDeleteModal(id, code) {
      deleteTargetId = id;
      document.getElementById("deleteItemName").textContent = code;
      openModal("deleteModal");
      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
    }
    function closeDeleteModal() { closeModal("deleteModal"); deleteTargetId = null; }

    function formatCurrency(n) {
      return "$" + parseFloat(n).toFixed(2);
    }

    function formatDateOnly(d) {
      if (!d) return "—";
      return new Date(d).toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" });
    }

    function renderCoupons(coupons) {
      const tbody = document.getElementById("couponsBody");
      const cards = document.getElementById("couponCards");

      if (coupons.length === 0) {
        const emptyHtml =
          '<tr><td colspan="6" class="p-12 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-5xl text-secondary/30">confirmation_number</span><p class="font-body text-body-md text-secondary">No hay cupones aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primer cupón para empezar</p></div></td></tr>';
        tbody.innerHTML = emptyHtml;
        cards.innerHTML =
          '<div class="flex flex-col items-center gap-3 p-12 text-center"><span class="material-symbols-outlined text-5xl text-secondary/30">confirmation_number</span><p class="font-body text-body-md text-secondary">No hay cupones aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primer cupón para empezar</p></div>';
        return;
      }

      function statusBadge(c) {
        const now = new Date();
        const expires = c.expires_at ? new Date(c.expires_at) : null;
        const starts = c.starts_at ? new Date(c.starts_at) : null;
        if (!c.is_active) return '<span class="inline-flex items-center gap-1 px-2.5 py-1 font-label-caps text-label-caps bg-monolith-black/10 text-secondary rounded-sm">INACTIVO</span>';
        if (expires && expires < now) return '<span class="inline-flex items-center gap-1 px-2.5 py-1 font-label-caps text-label-caps bg-error/10 text-error rounded-sm">VENCIDO</span>';
        if (starts && starts > now) return '<span class="inline-flex items-center gap-1 px-2.5 py-1 font-label-caps text-label-caps bg-clay-accent/20 text-clay-accent rounded-sm">PROGRAMADO</span>';
        return '<span class="inline-flex items-center gap-1 px-2.5 py-1 font-label-caps text-label-caps bg-monolith-black text-off-white rounded-sm">ACTIVO</span>';
      }

      function discountLabel(c) {
        if (c.discount_type === "percentage") return c.discount_value + "%";
        return formatCurrency(c.discount_value);
      }

      function actionButtons(c) {
        return `<div class="flex gap-2 w-full">
          <button class="edit-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm" data-coupon='${JSON.stringify(c).replace(/'/g, "&#39;")}'>
            <span class="material-symbols-outlined text-sm">edit</span>
            EDITAR
          </button>
          <button class="delete-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm" data-id="${c.id}" data-code="${c.code}">
            <span class="material-symbols-outlined text-sm">delete</span>
            ELIMINAR
          </button>
        </div>`;
      }

      // Desktop rows
      tbody.innerHTML = coupons.map(c => `
        <tr class="border-b border-outline-variant/50 hover:bg-monolith-black/[0.02] transition-colors border-l-2 border-l-transparent hover:border-l-clay-accent/50">
          <td class="p-4">
            <span class="font-body text-body-md text-monolith-black font-medium font-mono">${c.code}</span>
            ${c.description ? '<br><span class="font-body text-body-md text-secondary text-xs">' + c.description + '</span>' : ''}
          </td>
          <td class="p-4 font-price-display text-price-display text-sm">${discountLabel(c)}</td>
          <td class="p-4 font-body text-body-md text-secondary text-sm">
            ${c.starts_at ? 'Desde: ' + formatDateOnly(c.starts_at) + '<br>' : ''}
            ${c.expires_at ? 'Hasta: ' + formatDateOnly(c.expires_at) : '—'}
          </td>
          <td class="p-4 font-body text-body-md text-sm">
            ${c.use_count}${c.max_uses ? ' / ' + c.max_uses : ''}
          </td>
          <td class="p-4">${statusBadge(c)}</td>
          <td class="p-4">${actionButtons(c)}</td>
        </tr>
      `).join("");

      // Mobile cards
      cards.innerHTML = coupons.map(c => `
        <div class="bg-off-white border border-outline-variant border-l-2 border-l-monolith-black shadow-sm hover:shadow-md hover:border-l-clay-accent transition-all duration-200 rounded-sm p-4">
          <div class="flex items-center justify-between mb-2">
            <span class="font-body text-body-md text-monolith-black font-medium font-mono">${c.code}</span>
            ${statusBadge(c)}
          </div>
          ${c.description ? '<p class="font-body text-body-md text-secondary text-sm mb-2">' + c.description + '</p>' : ''}
          <div class="flex items-center gap-4 text-sm">
            <span class="font-price-display text-price-display">${discountLabel(c)}</span>
            <span class="font-body text-body-md text-secondary">Usos: ${c.use_count}${c.max_uses ? ' / ' + c.max_uses : ''}</span>
          </div>
          <div class="mt-3">${actionButtons(c)}</div>
        </div>
      `).join("");

      // Edit handlers
      document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const c = JSON.parse(btn.dataset.coupon);
          openEditModal(c);
        });
      });

      // Delete handlers
      document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          openDeleteModal(parseInt(btn.dataset.id), btn.dataset.code);
        });
      });
    }

    function renderPagination() {
      const container = document.getElementById("pagination");
      const totalPages = Math.ceil(totalCoupons / PAGE_LIMIT);
      const currentPage = Math.floor(currentOffset / PAGE_LIMIT) + 1;

      if (totalPages <= 1) { container.classList.add("hidden"); return; }
      container.classList.remove("hidden");

      let html = '<button class="pag-prev w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + '><span class="material-symbols-outlined text-sm">chevron_left</span></button>';

      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant text-secondary hover:border-monolith-black hover:text-monolith-black';
        html += `<button class="pag-page w-9 h-9 flex items-center justify-center border rounded-sm transition-all font-body text-body-md text-sm ${active}" data-page="${i}">${i}</button>`;
      }

      html += '<button class="pag-next w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + '><span class="material-symbols-outlined text-sm">chevron_right</span></button>';

      container.innerHTML = html;

      container.querySelectorAll(".pag-page").forEach(btn => {
        btn.addEventListener("click", () => {
          currentOffset = (parseInt(btn.dataset.page) - 1) * PAGE_LIMIT;
          loadCoupons();
        });
      });
      container.querySelector(".pag-prev")?.addEventListener("click", () => {
        if (currentOffset <= 0) return;
        currentOffset = Math.max(0, currentOffset - PAGE_LIMIT);
        loadCoupons();
      });
      container.querySelector(".pag-next")?.addEventListener("click", () => {
        if (currentOffset + PAGE_LIMIT >= totalCoupons) return;
        currentOffset += PAGE_LIMIT;
        loadCoupons();
      });
    }

    function searchCoupons() {
      searchTerm = document.getElementById("searchInput").value.trim();
      currentOffset = 0;
      loadCoupons();
    }

    document.getElementById("searchInput").addEventListener("input", () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(searchCoupons, 300);
    });

    async function loadCoupons() {
      try {
        let url = `/api/cupones/list.php?limit=${PAGE_LIMIT}&offset=${currentOffset}`;
        if (searchTerm) url += `&search=${encodeURIComponent(searchTerm)}`;
        const res = await fetch(url);
        const data = await res.json();
        const coupons = data.items || [];
        totalCoupons = data.total || coupons.length;

        document.getElementById("couponCount").textContent =
          Math.min(currentOffset + coupons.length, totalCoupons) + " de " + totalCoupons + " cupones";
        renderCoupons(coupons);
        renderPagination();
      } catch (err) {
        document.getElementById("couponsBody").innerHTML =
          `<tr><td colspan="6" class="p-8 text-center font-body text-body-md text-error">Error: ${err.message}</td></tr>`;
        document.getElementById("couponCards").innerHTML =
          `<p class="font-body text-body-md text-error p-4">Error: ${err.message}</p>`;
      }
    }

    // --- Open create modal ---
    document.getElementById("openCreateBtn").addEventListener("click", openCreateModal);

    // --- Form save handler ---
    document.getElementById("formSaveBtn").addEventListener("click", async () => {
      const code = document.getElementById("formCode").value.trim().toUpperCase();
      const type = document.getElementById("formType").value;
      const value = parseFloat(document.getElementById("formValue").value);
      const msg = document.getElementById("formMsg");

      // Client-side validation
      if (!code) { msg.textContent = "El código es obligatorio"; msg.className = "font-body text-body-md text-sm text-error block"; return; }
      if (code.length > CODE_MAX) { msg.textContent = "El código no puede exceder " + CODE_MAX + " caracteres"; msg.className = "font-body text-body-md text-sm text-error block"; return; }
      if (!value || value <= 0) { msg.textContent = "El valor del descuento debe ser mayor a 0"; msg.className = "font-body text-body-md text-sm text-error block"; return; }
      if (type === "percentage" && value > 100) { msg.textContent = "El porcentaje no puede superar 100%"; msg.className = "font-body text-body-md text-sm text-error block"; return; }

      // Validate dates
      const startsAt = document.getElementById("formStartsAt").value;
      const expiresAt = document.getElementById("formExpiresAt").value;
      if (startsAt && expiresAt && new Date(expiresAt) <= new Date(startsAt)) {
        msg.textContent = "La fecha de fin debe ser posterior a la fecha de inicio";
        msg.className = "font-body text-body-md text-sm text-error block";
        return;
      }

      setLoading("formSaveBtn", "formSaveIcon", "formSaveText", true, "Guardando...");

      const payload = {
        code: code,
        description: document.getElementById("formDescription").value.trim(),
        discount_type: type,
        discount_value: value,
        min_order_amount: document.getElementById("formMinAmount").value ? parseFloat(document.getElementById("formMinAmount").value) : null,
        max_uses: document.getElementById("formMaxUses").value ? parseInt(document.getElementById("formMaxUses").value) : null,
        max_uses_per_customer: document.getElementById("formMaxPerCustomer").value ? parseInt(document.getElementById("formMaxPerCustomer").value) : null,
        is_active: document.getElementById("formActive").checked,
        starts_at: startsAt ? new Date(startsAt).toISOString().slice(0, 19).replace("T", " ") : null,
        expires_at: expiresAt ? new Date(expiresAt).toISOString().slice(0, 19).replace("T", " ") : null,
      };

      if (editTargetId) payload.id = editTargetId;

      try {
        const endpoint = editTargetId ? "/api/cupones/update.php" : "/api/cupones/create.php";
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        closeFormModal();
        loadCoupons();
      } catch (err) {
        setLoading("formSaveBtn", "formSaveIcon", "formSaveText", false);
        msg.className = "font-body text-body-md text-sm text-error block";
        msg.textContent = err.message;
      }
    });

    document.getElementById("formCancelBtn").addEventListener("click", closeFormModal);
    document.getElementById("formCloseX").addEventListener("click", closeFormModal);
    document.getElementById("formModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeFormModal();
    });
    document.getElementById("formCode").addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeFormModal();
    });

    // --- Delete modal handlers ---
    document.getElementById("deleteConfirmBtn").addEventListener("click", async () => {
      if (!deleteTargetId) return;

      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", true, "Eliminando...");
      try {
        const res = await fetch("/api/cupones/delete.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: deleteTargetId }),
        });
        if (res.ok) {
          closeDeleteModal();
          loadCoupons();
        } else {
          setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
          const d = await res.json();
          window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: d.error || "Error al eliminar" });
        }
      } catch (err) {
        setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
        window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: err.message });
      }
    });

    document.getElementById("deleteCancelBtn").addEventListener("click", closeDeleteModal);
    document.getElementById("deleteModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeDeleteModal();
    });

    // --- Global Escape key ---
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (!document.getElementById("formModal").classList.contains("hidden")) closeFormModal();
        if (!document.getElementById("deleteModal").classList.contains("hidden")) closeDeleteModal();
      }
    });

    // --- Init ---
    setupCharCount("formCode", "formCodeCounter", CODE_MAX);
    setupCharCount("formDescription", "formDescCounter", DESC_MAX);
    document.getElementById("formSaveIcon").dataset.origIcon = "add";
    document.getElementById("deleteIcon").dataset.origIcon = "delete";

    loadCoupons();
  </script>
</AdminLayout>
