---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Categorías" currentPath="/admin/categorias">
  <div class="flex justify-between items-center mb-6">
    <p class="font-body text-body-md text-secondary" id="categoryCount">0 categorías</p>
    <button id="openCreateBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200">
      <span class="material-symbols-outlined text-lg">add</span>
      NUEVA CATEGORÍA
    </button>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">NOMBRE</th>
            <th class="p-4 font-medium">SLUG</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="categoriesBody">
          <tr><td colspan="3" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile cards -->
  <div id="categoryCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="hidden mt-6 flex items-center justify-center gap-2"></div>

  <!-- Create Modal -->
  <div id="createModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <h3 class="font-headline text-headline-md mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-xl">add_circle</span>
        Nueva Categoría
      </h3>
      <input type="text" id="createInput" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-monolith-black focus:outline-none mb-2 text-lg" placeholder="Nombre de la categoría" />
      <div id="createMsg" class="hidden font-body text-body-md text-sm mb-4"></div>
      <div class="flex justify-end gap-3">
        <button id="createCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="createConfirmBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps rounded-md px-4 h-10 inline-flex items-center gap-1.5 hover:bg-monolith-black/90 transition-all">
          <span class="material-symbols-outlined text-lg">add</span>
          CREAR
        </button>
      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <h3 class="font-headline text-headline-md mb-4">Editar Categoría</h3>
      <input type="text" id="editInput" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-monolith-black focus:outline-none mb-6 text-lg" placeholder="Nombre de la categoría" />
      <div class="flex justify-end gap-3">
        <button id="editCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="editConfirmBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps rounded-md px-4 h-10 inline-flex items-center gap-1.5 hover:bg-monolith-black/90 transition-all">
          <span class="material-symbols-outlined text-lg">save</span>
          GUARDAR
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-error">warning</span>
        <h3 class="font-headline text-headline-md">Eliminar Categoría</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-4 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 transition-all">
          <span class="material-symbols-outlined text-lg">delete</span>
          ELIMINAR
        </button>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 10;
    let editTargetId = null;
    let deleteTargetId = null;
    let currentOffset = 0;
    let totalCategories = 0;

    // --- Modal controls ---
    function openCreateModal() {
      document.getElementById("createInput").value = "";
      document.getElementById("createMsg").classList.add("hidden");
      document.getElementById("createModal").classList.remove("hidden");
      setTimeout(() => document.getElementById("createInput").focus(), 100);
    }
    function closeCreateModal() {
      document.getElementById("createModal").classList.add("hidden");
    }

    function openEditModal(id, name) {
      editTargetId = id;
      document.getElementById("editInput").value = name;
      document.getElementById("editModal").classList.remove("hidden");
      setTimeout(() => { document.getElementById("editInput").focus(); document.getElementById("editInput").select(); }, 100);
    }
    function closeEditModal() {
      document.getElementById("editModal").classList.add("hidden");
      editTargetId = null;
    }

    function openDeleteModal(id, name) {
      deleteTargetId = id;
      document.getElementById("deleteItemName").textContent = name;
      document.getElementById("deleteModal").classList.remove("hidden");
    }
    function closeDeleteModal() {
      document.getElementById("deleteModal").classList.add("hidden");
      deleteTargetId = null;
    }

    function renderCategories(cats) {
      const tbody = document.getElementById("categoriesBody");
      const cards = document.getElementById("categoryCards");

      if (cats.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" class="p-8 text-center font-body text-body-md text-secondary">No categories yet.</td></tr>';
        cards.innerHTML = '<p class="font-body text-body-md text-secondary p-4">No categories yet.</p>';
        return;
      }

      function actionButtons(c) {
        return `<div class="flex gap-2">
          <button class="edit-btn inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 border-monolith-black/20 text-secondary hover:border-monolith-black hover:text-monolith-black hover:bg-monolith-black/5" data-id="${c.id}" data-name="${c.name}">
            <span class="material-symbols-outlined text-sm">edit</span>
            EDITAR
          </button>
          <button class="delete-btn inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 border-error/20 text-secondary hover:border-error hover:text-error hover:bg-error/5" data-id="${c.id}" data-name="${c.name}">
            <span class="material-symbols-outlined text-sm">delete</span>
            ELIMINAR
          </button>
        </div>`;
      }

      // Desktop rows
      tbody.innerHTML = cats.map(c => `
        <tr class="border-b border-outline-variant/50 hover:bg-monolith-black/[0.02] transition-colors" data-id="${c.id}">
          <td class="p-4 font-body text-body-md text-monolith-black font-medium">${c.name}</td>
          <td class="p-4 font-body text-body-md text-secondary font-mono text-sm">${c.slug}</td>
          <td class="p-4">${actionButtons(c)}</td>
        </tr>
      `).join("");

      // Mobile cards
      cards.innerHTML = cats.map(c => `
        <div class="bg-off-white border border-outline-variant border-l-2 border-l-monolith-black shadow-sm hover:shadow-md transition-all duration-200 rounded-sm p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-xl text-monolith-black">category</span>
            <div>
              <p class="font-body text-body-md text-monolith-black font-medium">${c.name}</p>
              <p class="font-body text-body-md text-secondary text-sm font-mono">${c.slug}</p>
            </div>
          </div>
          <div class="flex gap-2 shrink-0 ml-3">${actionButtons(c)}</div>
        </div>
      `).join("");

      // Edit handlers
      document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          openEditModal(btn.dataset.id, btn.dataset.name);
        });
      });

      // Delete handlers
      document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          openDeleteModal(btn.dataset.id, btn.dataset.name);
        });
      });
    }

    function renderPagination() {
      const container = document.getElementById("pagination");
      const totalPages = Math.ceil(totalCategories / PAGE_LIMIT);
      const currentPage = Math.floor(currentOffset / PAGE_LIMIT) + 1;

      if (totalPages <= 1) { container.classList.add("hidden"); return; }
      container.classList.remove("hidden");

      let html = '<button class="pag-prev w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black transition-colors font-body text-body-md" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3"' : '') + '><span class="material-symbols-outlined text-sm">chevron_left</span></button>';

      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant hover:border-monolith-black';
        html += `<button class="pag-page w-9 h-9 flex items-center justify-center border rounded-sm transition-colors font-body text-body-md text-sm ${active}" data-page="${i}">${i}</button>`;
      }

      html += '<button class="pag-next w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black transition-colors font-body text-body-md" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3"' : '') + '><span class="material-symbols-outlined text-sm">chevron_right</span></button>';

      container.innerHTML = html;

      container.querySelectorAll(".pag-page").forEach(btn => {
        btn.addEventListener("click", () => {
          currentOffset = (parseInt(btn.dataset.page) - 1) * PAGE_LIMIT;
          loadCategories();
        });
      });
      container.querySelector(".pag-prev")?.addEventListener("click", () => {
        if (currentOffset <= 0) return;
        currentOffset = Math.max(0, currentOffset - PAGE_LIMIT);
        loadCategories();
      });
      container.querySelector(".pag-next")?.addEventListener("click", () => {
        if (currentOffset + PAGE_LIMIT >= totalCategories) return;
        currentOffset += PAGE_LIMIT;
        loadCategories();
      });
    }

    async function loadCategories() {
      try {
        const res = await fetch(`/api/categorias/list.php?limit=${PAGE_LIMIT}&offset=${currentOffset}`);
        const data = await res.json();
        const cats = data.items || [];
        totalCategories = data.total || cats.length;

        document.getElementById("categoryCount").textContent =
          Math.min(currentOffset + cats.length, totalCategories) + " de " + totalCategories + " categorías";
        renderCategories(cats);
        renderPagination();
      } catch (err) {
        document.getElementById("categoriesBody").innerHTML =
          `<tr><td colspan="3" class="p-8 text-center font-body text-body-md text-error">Error: ${err.message}</td></tr>`;
        document.getElementById("categoryCards").innerHTML =
          `<p class="font-body text-body-md text-error p-4">Error: ${err.message}</p>`;
      }
    }

    // --- Open create modal ---
    document.getElementById("openCreateBtn").addEventListener("click", openCreateModal);

    // --- Create modal handlers ---
    document.getElementById("createConfirmBtn").addEventListener("click", async () => {
      const name = document.getElementById("createInput").value.trim();
      if (!name) return;

      const msg = document.getElementById("createMsg");
      try {
        const res = await fetch("/api/categorias/create.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        closeCreateModal();
        loadCategories();
      } catch (err) {
        msg.className = "font-body text-body-md text-sm text-error block";
        msg.textContent = err.message;
        msg.classList.remove("hidden");
      }
    });

    document.getElementById("createCancelBtn").addEventListener("click", closeCreateModal);
    document.getElementById("createModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeCreateModal();
    });
    document.getElementById("createInput").addEventListener("keydown", (e) => {
      if (e.key === "Enter") document.getElementById("createConfirmBtn").click();
      if (e.key === "Escape") closeCreateModal();
    });

    // --- Edit modal handlers ---
    document.getElementById("editConfirmBtn").addEventListener("click", async () => {
      const newName = document.getElementById("editInput").value.trim();
      if (!newName || !editTargetId) return;

      try {
        const res = await fetch("/api/categorias/update.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: editTargetId, name: newName }),
        });
        if (res.ok) {
          closeEditModal();
          loadCategories();
        } else {
          const d = await res.json();
          window.VunoModal.alert({ type: "error", title: "Error al actualizar", message: d.error || "Error al actualizar" });
        }
      } catch (err) {
        window.VunoModal.alert({ type: "error", title: "Error al actualizar", message: err.message });
      }
    });

    document.getElementById("editCancelBtn").addEventListener("click", closeEditModal);
    document.getElementById("editModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeEditModal();
    });
    document.getElementById("editInput").addEventListener("keydown", (e) => {
      if (e.key === "Enter") document.getElementById("editConfirmBtn").click();
      if (e.key === "Escape") closeEditModal();
    });

    // --- Delete modal handlers ---
    document.getElementById("deleteConfirmBtn").addEventListener("click", async () => {
      if (!deleteTargetId) return;

      try {
        const res = await fetch("/api/categorias/delete.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: deleteTargetId }),
        });
        if (res.ok) {
          closeDeleteModal();
          loadCategories();
        } else {
          const d = await res.json();
          window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: d.error || "Error al eliminar" });
        }
      } catch (err) {
        window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: err.message });
      }
    });

    document.getElementById("deleteCancelBtn").addEventListener("click", closeDeleteModal);
    document.getElementById("deleteModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeDeleteModal();
    });

    // --- Global Escape key ---
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (!document.getElementById("createModal").classList.contains("hidden")) closeCreateModal();
        if (!document.getElementById("editModal").classList.contains("hidden")) closeEditModal();
        if (!document.getElementById("deleteModal").classList.contains("hidden")) closeDeleteModal();
      }
    });

    loadCategories();
  </script>
</AdminLayout>
