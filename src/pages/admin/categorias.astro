---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Categorías" currentPath="/admin/categorias">
  <div class="flex  flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="categoryCount">0 categorías</p>
      <div class="relative w-full sm:w-48">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <input type="text" id="searchInput" placeholder="Buscar..." aria-label="Buscar categorías" class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md focus-visible:ring-2 focus-visible:ring-monolith-black" />
      </div>
    </div>
    <button id="openCreateBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 shrink-0 w-full sm:w-auto">
      <span class="material-symbols-outlined text-lg">add</span>
      NUEVA CATEGORÍA
    </button>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">NOMBRE</th>
            <th class="p-4 font-medium">SLUG</th>
            <th class="p-4 font-medium">PRODUCTOS</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="categoriesBody">
          <tr><td colspan="4" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile cards -->
  <div id="categoryCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="hidden mt-6 flex items-center justify-center gap-2"></div>

  <!-- Create Modal -->
  <div id="createModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="createModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center justify-between mb-6">
        <h3 id="createModalTitle" class="font-headline text-headline-md flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">add_circle</span>
          Nueva Categoría
        </h3>
        <button id="createCloseX" class="w-10 h-10 flex items-center justify-center text-secondary hover:text-monolith-black transition-colors rounded-sm hover:bg-monolith-black/5 cursor-pointer">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      <div class="relative">
        <input type="text" id="createInput" maxlength="100" aria-label="Nombre de la categoría" class="w-full bg-transparent border-b-2 border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" placeholder="Nombre de la categoría" autocomplete="off" />
        <span id="createCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/100</span>
      </div>
      <div id="createMsg" class="hidden font-body text-body-md text-sm mt-3" aria-live="polite"></div>
      <div class="flex justify-end gap-3 mt-6">
        <button id="createCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="createConfirmBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="createIcon">add</span>
          <span id="createBtnText">CREAR</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="editModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center justify-between mb-6">
        <h3 id="editModalTitle" class="font-headline text-headline-md flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">edit</span>
          Editar Categoría
        </h3>
        <button id="editCloseX" class="w-10 h-10 flex items-center justify-center text-secondary hover:text-monolith-black transition-colors rounded-sm hover:bg-monolith-black/5 cursor-pointer">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      <div class="relative">
        <input type="text" id="editInput" maxlength="100" aria-label="Nombre de la categoría" class="w-full bg-transparent border-b-2 border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-monolith-black" placeholder="Nombre de la categoría" autocomplete="off" />
        <span id="editCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/100</span>
      </div>
      <div id="editMsg" class="hidden font-body text-body-md text-sm mt-3" aria-live="polite"></div>
      <div class="flex justify-end gap-3 mt-6">
        <button id="editCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="editConfirmBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="editIcon">save</span>
          <span id="editBtnText">GUARDAR</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-3xl text-error">warning</span>
        <h3 id="deleteModalTitle" class="font-headline text-headline-md">Eliminar Categoría</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <p class="font-body text-body-md text-xs text-error/70 mb-6 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">info</span>
        Esta acción no se puede deshacer.
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="deleteIcon">delete</span>
          <span id="deleteBtnText">ELIMINAR</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #createModal:not(.hidden), #editModal:not(.hidden), #deleteModal:not(.hidden) {
      display: flex;
    }
  </style>

  <script>
    // @ts-nocheck
    const CATEGORY_NAME_MAX = 100;
    const PAGE_LIMIT = 10;
    let editTargetId = null;
    let deleteTargetId = null;
    let currentOffset = 0;
    let totalCategories = 0;
    let allCategories = [];
    let searchTerm = "";
    let searchTimeout = null;

    // --- Character counter ---
    function setupCharCount(inputId, counterId) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(counterId);
      if (!input || !counter) return;
      function update() {
        const len = input.value.length;
        counter.textContent = len + "/" + CATEGORY_NAME_MAX;
        counter.className = "absolute right-0 bottom-2 text-xs font-body pointer-events-none transition-colors duration-200 " +
          (len >= CATEGORY_NAME_MAX ? "text-error" : len >= CATEGORY_NAME_MAX * 0.8 ? "text-clay-accent" : "text-secondary");
      }
      input.addEventListener("input", update);
      update();
    }

    // --- Loading state helpers ---
    function setLoading(btnId, iconId, textId, loading) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = text.textContent.replace(/^(\w+).*/, "$1") + "ndo...";
        text.dataset.original = text.textContent.replace("ndo...", "");
      } else {
        icon.textContent = icon.dataset.origIcon || "add";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || text.textContent;
      }
    }

    // --- Modal controls ---
    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove("hidden");
      el.classList.add("flex");
      // Re-trigger animation by removing and re-adding the content class
      const content = el.querySelector(".modal-content");
      if (content) {
        content.style.animation = "none";
        void content.offsetHeight;
        content.style.animation = "";
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add("hidden");
      el.classList.remove("flex");
    }

    function openCreateModal() {
      document.getElementById("createInput").value = "";
      document.getElementById("createMsg").classList.add("hidden");
      openModal("createModal");
      setTimeout(() => document.getElementById("createInput").focus(), 100);
      // Reset button
      setLoading("createConfirmBtn", "createIcon", "createBtnText", false);
    }
    function closeCreateModal() { closeModal("createModal"); }

    function openEditModal(id, name) {
      editTargetId = id;
      document.getElementById("editInput").value = name;
      document.getElementById("editMsg").classList.add("hidden");
      openModal("editModal");
      setTimeout(() => { document.getElementById("editInput").focus(); document.getElementById("editInput").select(); }, 100);
      setLoading("editConfirmBtn", "editIcon", "editBtnText", false);
    }
    function closeEditModal() {
      closeModal("editModal");
      editTargetId = null;
    }

    function openDeleteModal(id, name) {
      deleteTargetId = id;
      document.getElementById("deleteItemName").textContent = name;
      openModal("deleteModal");
      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
    }
    function closeDeleteModal() {
      closeModal("deleteModal");
      deleteTargetId = null;
    }

    function renderCategories(cats) {
      const tbody = document.getElementById("categoriesBody");
      const cards = document.getElementById("categoryCards");

      if (cats.length === 0) {
        const emptyHtml =
          '<tr><td colspan="4" class="p-12 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-5xl text-secondary/30">category</span><p class="font-body text-body-md text-secondary">No hay categorías aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primera categoría para empezar</p></div></td></tr>';
        tbody.innerHTML = emptyHtml;
        cards.innerHTML =
          '<div class="flex flex-col items-center gap-3 p-12 text-center"><span class="material-symbols-outlined text-5xl text-secondary/30">category</span><p class="font-body text-body-md text-secondary">No hay categorías aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primera categoría para empezar</p></div>';
        return;
      }

      function actionButtons(c) {
        return `<div class="flex gap-2 w-full">
          <button class="edit-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm" data-id="${c.id}" data-name="${c.name}">
            <span class="material-symbols-outlined text-sm">edit</span>
            EDITAR
          </button>
          <button class="delete-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm" data-id="${c.id}" data-name="${c.name}">
            <span class="material-symbols-outlined text-sm">delete</span>
            ELIMINAR
          </button>
        </div>`;
      }

      // Desktop rows
      tbody.innerHTML = cats.map(c => `
        <tr class="border-b border-outline-variant/50 hover:bg-monolith-black/[0.02] transition-colors border-l-2 border-l-transparent hover:border-l-clay-accent/50" data-id="${c.id}">
          <td class="p-4 font-body text-body-md text-monolith-black font-medium">${c.name}</td>
          <td class="p-4 font-body text-body-md text-secondary font-mono text-sm">${c.slug}</td>
          <td class="p-4 font-body text-body-md text-secondary">${c.productCount || "—"}</td>
          <td class="p-4">${actionButtons(c)}</td>
        </tr>
      `).join("");

      // Mobile cards
      cards.innerHTML = cats.map(c => `
        <div class="bg-off-white border border-outline-variant border-l-2 border-l-monolith-black shadow-sm hover:shadow-md hover:border-l-clay-accent transition-all duration-200 rounded-sm p-4 flex flex-col gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 rounded-sm bg-monolith-black/5 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-xl text-monolith-black">category</span>
            </div>
            <div class="min-w-0">
              <p class="font-body text-body-md text-monolith-black font-medium truncate">${c.name}</p>
              <p class="font-body text-body-md text-secondary text-sm font-mono truncate">${c.slug}</p>
            </div>
          </div>
          ${actionButtons(c)}
        </div>
      `).join("");

      // Edit handlers
      document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          openEditModal(btn.dataset.id, btn.dataset.name);
        });
      });

      // Delete handlers
      document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          openDeleteModal(btn.dataset.id, btn.dataset.name);
        });
      });
    }

    function renderPagination() {
      const container = document.getElementById("pagination");
      const totalPages = Math.ceil(totalCategories / PAGE_LIMIT);
      const currentPage = Math.floor(currentOffset / PAGE_LIMIT) + 1;

      if (totalPages <= 1) { container.classList.add("hidden"); return; }
      container.classList.remove("hidden");

      let html = '<button class="pag-prev w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + '><span class="material-symbols-outlined text-sm">chevron_left</span></button>';

      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant text-secondary hover:border-monolith-black hover:text-monolith-black';
        html += `<button class="pag-page w-9 h-9 flex items-center justify-center border rounded-sm transition-all font-body text-body-md text-sm ${active}" data-page="${i}">${i}</button>`;
      }

      html += '<button class="pag-next w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + '><span class="material-symbols-outlined text-sm">chevron_right</span></button>';

      container.innerHTML = html;

      container.querySelectorAll(".pag-page").forEach(btn => {
        btn.addEventListener("click", () => {
          currentOffset = (parseInt(btn.dataset.page) - 1) * PAGE_LIMIT;
          loadCategories();
        });
      });
      container.querySelector(".pag-prev")?.addEventListener("click", () => {
        if (currentOffset <= 0) return;
        currentOffset = Math.max(0, currentOffset - PAGE_LIMIT);
        loadCategories();
      });
      container.querySelector(".pag-next")?.addEventListener("click", () => {
        if (currentOffset + PAGE_LIMIT >= totalCategories) return;
        currentOffset += PAGE_LIMIT;
        loadCategories();
      });
    }

    function clientFilter(cats) {
      if (!searchTerm) return cats;
      const q = searchTerm.toLowerCase();
      return cats.filter(c => c.name.toLowerCase().includes(q) || c.slug.toLowerCase().includes(q));
    }

    async function loadCategories() {
      try {
        const res = await fetch(`/api/categorias/list.php?limit=${PAGE_LIMIT}&offset=${currentOffset}`);
        const data = await res.json();
        const cats = data.items || [];
        allCategories = cats;
        totalCategories = data.total || cats.length;

        const filtered = clientFilter(cats);

        document.getElementById("categoryCount").textContent =
          Math.min(currentOffset + filtered.length, totalCategories) + " de " + totalCategories + " categorías";
        renderCategories(filtered);
        renderPagination();
      } catch (err) {
        document.getElementById("categoriesBody").innerHTML =
          `<tr><td colspan="4" class="p-8 text-center font-body text-body-md text-error">Error: ${err.message}</td></tr>`;
        document.getElementById("categoryCards").innerHTML =
          `<p class="font-body text-body-md text-error p-4">Error: ${err.message}</p>`;
      }
    }

    // --- Search ---
    document.getElementById("searchInput").addEventListener("input", function () {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchTerm = this.value.trim();
        currentOffset = 0;
        loadCategories();
      }, 200);
    });

    // --- Open create modal ---
    document.getElementById("openCreateBtn").addEventListener("click", openCreateModal);

    // --- Create modal handlers ---
    document.getElementById("createConfirmBtn").addEventListener("click", async () => {
      const name = document.getElementById("createInput").value.trim();
      if (!name) return;
      if (name.length > CATEGORY_NAME_MAX) {
        document.getElementById("createMsg").className = "font-body text-body-md text-sm text-error block";
        document.getElementById("createMsg").textContent = "Máximo " + CATEGORY_NAME_MAX + " caracteres.";
        return;
      }

      setLoading("createConfirmBtn", "createIcon", "createBtnText", true);
      const msg = document.getElementById("createMsg");
      try {
        const res = await fetch("/api/categorias/create.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        closeCreateModal();
        loadCategories();
      } catch (err) {
        setLoading("createConfirmBtn", "createIcon", "createBtnText", false);
        msg.className = "font-body text-body-md text-sm text-error block";
        msg.textContent = err.message;
        msg.classList.remove("hidden");
      }
    });

    document.getElementById("createCancelBtn").addEventListener("click", closeCreateModal);
    document.getElementById("createCloseX").addEventListener("click", closeCreateModal);
    document.getElementById("createModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeCreateModal();
    });
    document.getElementById("createInput").addEventListener("keydown", (e) => {
      if (e.key === "Enter") document.getElementById("createConfirmBtn").click();
      if (e.key === "Escape") closeCreateModal();
    });

    // --- Edit modal handlers ---
    document.getElementById("editConfirmBtn").addEventListener("click", async () => {
      const newName = document.getElementById("editInput").value.trim();
      if (!newName || !editTargetId) return;
      if (newName.length > CATEGORY_NAME_MAX) {
        document.getElementById("editMsg").className = "font-body text-body-md text-sm text-error block";
        document.getElementById("editMsg").textContent = "Máximo " + CATEGORY_NAME_MAX + " caracteres.";
        return;
      }

      setLoading("editConfirmBtn", "editIcon", "editBtnText", true);
      try {
        const res = await fetch("/api/categorias/update.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: editTargetId, name: newName }),
        });
        if (res.ok) {
          closeEditModal();
          loadCategories();
        } else {
          setLoading("editConfirmBtn", "editIcon", "editBtnText", false);
          const d = await res.json();
          document.getElementById("editMsg").className = "font-body text-body-md text-sm text-error block";
          document.getElementById("editMsg").textContent = d.error || "Error al actualizar";
          document.getElementById("editMsg").classList.remove("hidden");
        }
      } catch (err) {
        setLoading("editConfirmBtn", "editIcon", "editBtnText", false);
        document.getElementById("editMsg").className = "font-body text-body-md text-sm text-error block";
        document.getElementById("editMsg").textContent = err.message;
        document.getElementById("editMsg").classList.remove("hidden");
      }
    });

    document.getElementById("editCancelBtn").addEventListener("click", closeEditModal);
    document.getElementById("editCloseX").addEventListener("click", closeEditModal);
    document.getElementById("editModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeEditModal();
    });
    document.getElementById("editInput").addEventListener("keydown", (e) => {
      if (e.key === "Enter") document.getElementById("editConfirmBtn").click();
      if (e.key === "Escape") closeEditModal();
    });

    // --- Delete modal handlers ---
    document.getElementById("deleteConfirmBtn").addEventListener("click", async () => {
      if (!deleteTargetId) return;

      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", true);
      try {
        const res = await fetch("/api/categorias/delete.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: deleteTargetId }),
        });
        if (res.ok) {
          closeDeleteModal();
          loadCategories();
        } else {
          setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
          const d = await res.json();
          window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: d.error || "Error al eliminar" });
        }
      } catch (err) {
        setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
        window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: err.message });
      }
    });

    document.getElementById("deleteCancelBtn").addEventListener("click", closeDeleteModal);
    document.getElementById("deleteModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeDeleteModal();
    });

    // --- Global Escape key ---
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (!document.getElementById("createModal").classList.contains("hidden")) closeCreateModal();
        if (!document.getElementById("editModal").classList.contains("hidden")) closeEditModal();
        if (!document.getElementById("deleteModal").classList.contains("hidden")) closeDeleteModal();
      }
    });

    // --- Init char counters ---
    setupCharCount("createInput", "createCounter");
    setupCharCount("editInput", "editCounter");

    // --- Init button icon originals ---
    document.getElementById("createIcon").dataset.origIcon = "add";
    document.getElementById("editIcon").dataset.origIcon = "save";
    document.getElementById("deleteIcon").dataset.origIcon = "delete";

    loadCategories();
  </script>
</AdminLayout>
