---
import AdminLayout from "./_layout.astro";

const tabs = [
  { id: "store", label: "Tienda", icon: "store" },
  { id: "receipt", label: "Recibo", icon: "receipt" },
  { id: "imagekit", label: "ImageKit", icon: "photo_library" },
  { id: "stripe", label: "Stripe", icon: "credit_card" },
  { id: "transfer", label: "Transferencia", icon: "account_balance" },
  { id: "smtp", label: "Email / SMTP", icon: "mail" },
  { id: "moneda", label: "Moneda", icon: "payments" },
];
---

<AdminLayout title="Configuración" currentPath="/admin/configuracion">
  <div id="loading" class="font-body text-body-md text-secondary p-4">Loading settings...</div>
  <div id="message" class="hidden font-body text-body-md p-3 mb-6 rounded-sm"></div>

  <div id="settingsContent" class="hidden">
    <!-- Tabs -->
    <div class="border-b border-outline-variant mb-8 overflow-x-auto">
      <div class="flex gap-1 min-w-max">
        {tabs.map(t => (
          <button
            class="tab-btn px-4 py-3 font-label-caps text-label-caps text-secondary hover:text-monolith-black border-b-2 border-transparent hover:border-monolith-black/30 transition-all whitespace-nowrap flex items-center gap-1.5"
            data-tab={t.id}
          >
            <span class="material-symbols-outlined text-lg">{t.icon}</span>
            {t.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Store Tab -->
    <div id="tab-store" class="tab-content max-w-2xl">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">store</span>
          Información de la Tienda
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">NOMBRE DE LA TIENDA</label>
            <input type="text" id="store-name" maxlength="200" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">LEMA / SLOGAN</label>
            <input type="text" id="store-slogan" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">EMAIL DE CONTACTO</label>
            <input type="email" id="store-email" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">DESCRIPCIÓN</label>
            <textarea id="store-description" maxlength="1000" class="w-full bg-transparent border border-outline p-3 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-24"></textarea>
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">URL DEL LOGOTIPO</label>
            <input type="text" id="store-logo" maxlength="500" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" placeholder="https://..." />
            <p class="font-body text-body-md text-xs text-secondary mt-1">URL pública de la imagen del logotipo</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Receipt Tab -->
    <div id="tab-receipt" class="tab-content hidden max-w-2xl">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">receipt</span>
          Datos de Facturación / Recibo
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">RAZÓN SOCIAL</label>
            <input type="text" id="receipt-businessName" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">RUC / NIT / TAX ID</label>
            <input type="text" id="receipt-taxId" maxlength="50" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">DIRECCIÓN</label>
            <input type="text" id="receipt-address" maxlength="500" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">CIUDAD</label>
            <input type="text" id="receipt-city" maxlength="100" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">ESTADO / PROVINCIA</label>
            <input type="text" id="receipt-state" maxlength="100" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">CÓDIGO POSTAL</label>
            <input type="text" id="receipt-zip" maxlength="20" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">TELÉFONO</label>
            <input type="text" id="receipt-phone" maxlength="50" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
        </div>
      </div>
    </div>

    <!-- ImageKit Tab -->
    <div id="tab-imagekit" class="tab-content hidden max-w-2xl">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">photo_library</span>
          ImageKit — Gestión de Imágenes
        </h2>
        <div class="space-y-6">
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">PUBLIC KEY</label>
            <input type="text" id="imagekit-publicKey" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">PRIVATE KEY</label>
            <input type="password" id="imagekit-privateKey" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">URL ENDPOINT</label>
            <input type="text" id="imagekit-urlEndpoint" maxlength="500" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" placeholder="https://ik.imagekit.io/your_id" />
          </div>
        </div>
      </div>
    </div>

    <!-- Stripe Tab -->
    <div id="tab-stripe" class="tab-content hidden max-w-2xl">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">credit_card</span>
          Stripe — Pasarela de Pago
        </h2>

        <div class="flex items-center justify-between pb-6 mb-6 border-b border-outline-variant">
          <div>
            <p class="font-body text-body-md text-monolith-black font-medium">Habilitar Stripe</p>
            <p class="font-body text-body-md text-sm text-secondary">Permite pagos con tarjeta vía Stripe</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="stripe-enabled" class="sr-only peer" />
            <div class="w-12 h-6.5 bg-outline-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[3px] after:start-[3px] after:bg-white after:border-outline-variant after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-monolith-black"></div>
          </label>
        </div>

        <div class="space-y-6">
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">PUBLISHABLE KEY</label>
            <input type="text" id="stripe-publishableKey" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" placeholder="pk_live_..." />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">SECRET KEY</label>
            <input type="password" id="stripe-secretKey" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" placeholder="sk_live_..." />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">WEBHOOK SECRET</label>
            <input type="password" id="stripe-webhookSecret" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" placeholder="whsec_..." />
          </div>
        </div>
      </div>
    </div>

    <!-- Transfer Tab -->
    <div id="tab-transfer" class="tab-content hidden max-w-3xl">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">account_balance</span>
          Transferencia Bancaria
        </h2>

        <div class="flex items-center justify-between pb-6 mb-6 border-b border-outline-variant">
          <div>
            <p class="font-body text-body-md text-monolith-black font-medium">Habilitar Transferencia</p>
            <p class="font-body text-body-md text-sm text-secondary">Permite pagos mediante transferencia bancaria</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="transfer-enabled" class="sr-only peer" />
            <div class="w-12 h-6.5 bg-outline-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[3px] after:start-[3px] after:bg-white after:border-outline-variant after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-monolith-black"></div>
          </label>
        </div>

        <div id="banks-container" class="space-y-6"></div>

        <button id="addBankBtn" class="mt-4 font-label-caps text-label-caps text-secondary hover:text-monolith-black inline-flex items-center gap-1.5 transition-colors">
          <span class="material-symbols-outlined text-lg">add_circle</span>
          AGREGAR BANCO
        </button>
      </div>
    </div>

    <!-- Bank entry template -->
    <template id="bank-template">
      <div class="bank-entry border border-outline-variant rounded-sm p-4 bg-white relative">
        <button type="button" class="delete-bank absolute top-2 right-2 w-8 h-8 flex items-center justify-center text-secondary hover:text-error transition-colors" title="Eliminar banco">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">NOMBRE DEL BANCO</label>
            <input type="text" data-bank-field="bankName" maxlength="200" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">TITULAR DE LA CUENTA</label>
            <input type="text" data-bank-field="accountHolder" maxlength="200" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">NÚMERO DE CUENTA</label>
            <input type="text" data-bank-field="accountNumber" maxlength="50" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">TIPO DE CUENTA</label>
            <select data-bank-field="accountType" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm">
              <option value="">Seleccionar...</option>
              <option value="Corriente">Corriente</option>
              <option value="Ahorro">Ahorro</option>
              <option value="Vista">Vista</option>
            </select>
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">RUT / ABA / CÓDIGO</label>
            <input type="text" data-bank-field="routingNumber" maxlength="50" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" />
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">INSTRUCCIONES</label>
            <textarea data-bank-field="instructions" maxlength="500" class="w-full bg-transparent border border-outline p-2 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-16 text-sm" placeholder="Ej: Realiza el depósito y envía el comprobante a ..."></textarea>
          </div>
        </div>
      </div>
    </template>

    <!-- SMTP Tab -->
    <div id="tab-smtp" class="tab-content hidden max-w-2xl">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">mail</span>
          Email / SMTP — Notificaciones
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">SMTP HOST</label>
            <input type="text" id="smtp-host" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" placeholder="smtp.gmail.com" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">SMTP PORT</label>
            <input type="text" id="smtp-port" maxlength="10" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" placeholder="587" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">SMTP USER</label>
            <input type="text" id="smtp-user" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">SMTP PASSWORD</label>
            <input type="password" id="smtp-pass" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none font-mono text-sm" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">FROM EMAIL</label>
            <input type="email" id="smtp-fromEmail" maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" placeholder="tienda@vuno.com" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">FROM NAME</label>
            <input type="text" id="smtp-fromName" maxlength="100" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" placeholder="Ram;Lop" />
          </div>
        </div>
      </div>
    </div>

    <!-- Moneda Tab -->
    <div id="tab-moneda" class="tab-content hidden max-w-4xl">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">payments</span>
          Moneda — Configuración de divisas
        </h2>

        <!-- Store Currency Selector -->
        <div class="pb-6 mb-6 border-b border-outline-variant">
          <label class="font-label-caps text-label-caps text-secondary block mb-2">MONEDA PRINCIPAL DE LA TIENDA</label>
          <p class="font-body text-body-md text-sm text-secondary mb-3">Los precios se convertirán automáticamente de USD a esta moneda usando la tasa de cambio</p>
          <select id="storeCurrencySelect" class="w-full max-w-xs bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none text-sm">
            <option value="">Seleccionar moneda...</option>
          </select>
        </div>

        <!-- Exchange Rates Table -->
        <div>
          <label class="font-label-caps text-label-caps text-secondary block mb-2">TASAS DE CAMBIO (vs USD)</label>
          <p class="font-body text-body-md text-sm text-secondary mb-3">Exchange rate = 1 USD en la moneda destino. Ej: 20.0 MXN = 1 USD</p>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm" id="ratesTable">
              <thead>
                <tr class="border-b border-outline-variant">
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">Código</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">Nombre</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">Símbolo</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">Tasa de Cambio</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">Decimales</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4">Activa</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2">Acción</th>
                </tr>
              </thead>
              <tbody id="ratesBody">
                <tr><td colspan="7" class="text-center text-secondary py-8">Cargando monedas...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Add Currency Modal trigger -->
        <button id="addCurrencyBtn" class="mt-4 font-label-caps text-label-caps text-secondary hover:text-monolith-black inline-flex items-center gap-1.5 transition-colors">
          <span class="material-symbols-outlined text-lg">add_circle</span>
          AGREGAR MONEDA
        </button>
      </div>
    </div>

    <!-- Add Currency Modal -->
    <div id="addCurrencyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <div class="bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md mx-4">
        <h3 class="font-headline text-headline-sm mb-4">Agregar Moneda</h3>
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">CÓDIGO (3 letras)</label>
              <input type="text" id="modal-currency-code" maxlength="3" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm uppercase font-mono" placeholder="EUR" />
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">SÍMBOLO</label>
              <input type="text" id="modal-currency-symbol" maxlength="10" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" placeholder="€" />
            </div>
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">NOMBRE</label>
            <input type="text" id="modal-currency-name" maxlength="100" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" placeholder="Euro" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">TASA DE CAMBIO (vs USD)</label>
              <input type="number" id="modal-currency-rate" step="0.000001" min="0.000001" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" placeholder="21.5" />
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">DECIMALES</label>
              <input type="number" id="modal-currency-decimals" min="0" max="6" value="2" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" />
            </div>
          </div>
          <p id="modal-error" class="font-body text-body-md text-sm text-red-600 hidden"></p>
        </div>
        <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-outline-variant">
          <button id="modalCancelBtn" class="font-label-caps text-label-caps text-secondary h-9 px-5 hover:text-monolith-black transition-colors">CANCELAR</button>
          <button id="modalConfirmBtn" onclick="setLoading('modalConfirmBtn', 'modalConfirmIcon', 'modalConfirmText', true, 'GUARDANDO...')" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-9 px-5 inline-flex items-center justify-center gap-1.5 rounded-sm hover:bg-monolith-black/90 transition-all duration-200">
            <span id="modalConfirmIcon" class="material-symbols-outlined text-lg">add</span>
            <span id="modalConfirmText">AGREGAR</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Save button -->
    <div class="mt-8 pt-6 border-t border-outline-variant">
      <button id="saveBtn" onclick="setLoading('saveBtn', 'saveIcon', 'saveText', true, 'GUARDANDO...')" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-12 px-8 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200">
        <span id="saveIcon" class="material-symbols-outlined text-lg">save</span>
        <span id="saveText">GUARDAR CONFIGURACIÓN</span>
      </button>
    </div>
  </div>

  <script>
    // @ts-nocheck
    const fieldMap = {
      store: ["name", "slogan", "email", "description", "logo"],
      receipt: ["businessName", "taxId", "address", "city", "state", "zip", "phone"],
      imagekit: ["publicKey", "privateKey", "urlEndpoint"],
      stripe: { text: ["publishableKey", "secretKey", "webhookSecret"], bool: ["enabled"] },
      smtp: ["host", "port", "user", "pass", "fromEmail", "fromName"],
    };

    const bankFields = ["bankName", "accountHolder", "accountNumber", "accountType", "routingNumber", "instructions"];

    function createBankEntry(data) {
      const tpl = document.getElementById("bank-template");
      const clone = tpl.content.cloneNode(true);
      const entry = clone.querySelector(".bank-entry");

      bankFields.forEach(f => {
        const el = entry.querySelector(`[data-bank-field="${f}"]`);
        if (el) el.value = data?.[f] ?? "";
      });

      entry.querySelector(".delete-bank").addEventListener("click", () => {
        entry.remove();
      });

      return entry;
    }

    function loadBanks(banks) {
      const container = document.getElementById("banks-container");
      container.innerHTML = "";
      if (!banks || banks.length === 0) {
        container.appendChild(createBankEntry({}));
        return;
      }
      banks.forEach(b => container.appendChild(createBankEntry(b)));
    }

    function collectBanks() {
      const entries = document.querySelectorAll("#banks-container .bank-entry");
      return Array.from(entries).map(entry => {
        const bank = {};
        bankFields.forEach(f => {
          const el = entry.querySelector(`[data-bank-field="${f}"]`);
          bank[f] = el ? el.value : "";
        });
        return bank;
      });
    }

    function loadSettings(settings) {
      for (const [section, fields] of Object.entries(fieldMap)) {
        const textFields = Array.isArray(fields) ? fields : (fields.text || []);
        const boolFields = Array.isArray(fields) ? [] : (fields.bool || []);

        for (const field of textFields) {
          const el = document.getElementById(`${section}-${field}`);
          if (el) el.value = settings[section]?.[field] ?? "";
        }
        for (const field of boolFields) {
          const el = document.getElementById(`${section}-${field}`);
          if (el) el.checked = settings[section]?.[field] ?? false;
        }
      }
      const transfer = settings.transfer || {};
      document.getElementById("transfer-enabled").checked = transfer.enabled ?? true;
      loadBanks(transfer.banks);
    }

    function collectSettings() {
      const settings = {};
      for (const [section, fields] of Object.entries(fieldMap)) {
        const textFields = Array.isArray(fields) ? fields : (fields.text || []);
        const boolFields = Array.isArray(fields) ? [] : (fields.bool || []);
        settings[section] = {};

        for (const field of textFields) {
          const el = document.getElementById(`${section}-${field}`);
          settings[section][field] = el ? el.value : "";
        }
        for (const field of boolFields) {
          const el = document.getElementById(`${section}-${field}`);
          settings[section][field] = el ? el.checked : false;
        }
      }
      settings.transfer = {
        enabled: document.getElementById("transfer-enabled").checked,
        banks: collectBanks(),
      };
      return settings;
    }

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "GUARDANDO...";
      } else {
        icon.textContent = "save";
        icon.classList.remove("animate-spin");
        text.textContent = "GUARDAR CONFIGURACIÓN";
      }
    }

    // --- Tab switching ---
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach(b => {
          b.classList.remove("text-monolith-black", "border-monolith-black");
          b.classList.add("text-secondary", "border-transparent");
        });
        btn.classList.remove("text-secondary", "border-transparent");
        btn.classList.add("text-monolith-black", "border-monolith-black");

        document.querySelectorAll(".tab-content").forEach(tc => tc.classList.add("hidden"));
        document.getElementById("tab-" + btn.dataset.tab).classList.remove("hidden");
      });
    });

    document.querySelector(".tab-btn")?.click();

    // --- Load settings ---
    (async function () {
      try {
        const res = await fetch("/api/configuracion/get.php");
        const settings = await res.json();
        loadSettings(settings);
        document.getElementById("loading").classList.add("hidden");
        document.getElementById("settingsContent").classList.remove("hidden");
      } catch (err) {
        document.getElementById("loading").textContent = "Error loading settings: " + err.message;
      }
    })();

    // --- Add Bank ---
    document.getElementById("addBankBtn").addEventListener("click", () => {
      const container = document.getElementById("banks-container");
      container.appendChild(createBankEntry({}));
    });

    // --- Save ---
    document.getElementById("saveBtn").addEventListener("click", async () => {
      const msg = document.getElementById("message");
      const settings = collectSettings();

      setLoading("saveBtn", "saveIcon", "saveText", true);

      try {
        const res = await fetch("/api/configuracion/update.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(settings),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error saving");
        msg.className = "font-body text-body-md p-3 mb-6 rounded-sm bg-green-100 text-green-800 block";
        msg.textContent = "Configuración guardada correctamente.";
        msg.classList.remove("hidden");
        setTimeout(() => msg.classList.add("hidden"), 4000);
      } catch (err) {
        msg.className = "font-body text-body-md p-3 mb-6 rounded-sm bg-red-100 text-error block";
        msg.textContent = err.message;
        msg.classList.remove("hidden");
      } finally {
        setLoading("saveBtn", "saveIcon", "saveText", false);
      }
    });

    // =========================================================================
    // Moneda (Currency) Tab
    // =========================================================================

    let currenciesData = [];

    async function loadCurrencies() {
      try {
        const res = await fetch("/api/monedas/list.php?all=1");
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        currenciesData = data.currencies || [];
        renderCurrencyTab(data.storeCurrency);
      } catch (err) {
        console.error("Error loading currencies:", err);
      }
    }

    function renderCurrencyTab(storeCurrencyCode) {
      const select = document.getElementById("storeCurrencySelect");
      const tbody = document.getElementById("ratesBody");

      // Populate dropdown
      select.innerHTML = '<option value="">Seleccionar moneda...</option>';
      currenciesData.forEach(c => {
        const opt = document.createElement("option");
        opt.value = c.code;
        opt.textContent = `${c.code} — ${c.name} (${c.symbol})`;
        if (c.code === storeCurrencyCode) opt.selected = true;
        select.appendChild(opt);
      });

      // Populate rates table
      tbody.innerHTML = "";
      currenciesData.forEach(c => {
        const tr = document.createElement("tr");
        tr.className = "border-b border-outline-variant/50 hover:bg-white/60 transition-colors";

        const activeChecked = c.is_active ? "checked" : "";

        tr.innerHTML = `
          <td class="py-3 pr-4 font-mono text-sm font-semibold">${c.code}</td>
          <td class="py-3 pr-4 text-sm">${c.name}</td>
          <td class="py-3 pr-4 text-sm font-mono">${c.symbol}</td>
          <td class="py-3 pr-4">
            <input type="number" step="0.000001" min="0.000001" value="${c.exchange_rate}"
              data-rate-code="${c.code}"
              class="rate-input w-28 bg-transparent border-b border-outline pb-1 text-monolith-black focus:border-clay-accent focus:outline-none text-sm font-mono" />
          </td>
          <td class="py-3 pr-4 text-sm">${c.decimal_places}</td>
          <td class="py-3 pr-4">
            <input type="checkbox" data-active-code="${c.code}" ${activeChecked}
              class="active-checkbox w-4 h-4 text-monolith-black border-outline rounded-sm focus:ring-monolith-black cursor-pointer" />
          </td>
          <td class="py-3 text-sm">
            ${c.code !== "USD" ? `<button data-delete-code="${c.code}" class="delete-currency w-7 h-7 flex items-center justify-center text-secondary hover:text-error transition-colors" title="Desactivar moneda">
              <span class="material-symbols-outlined text-lg">delete</span>
            </button>` : '<span class="text-secondary text-xs">Base</span>'}
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Attach delete events
      tbody.querySelectorAll(".delete-currency").forEach(btn => {
        btn.addEventListener("click", async () => {
          const code = btn.dataset.deleteCode;
          if (!confirm(`¿Desactivar moneda ${code}?`)) return;
          try {
            const res = await fetch("/api/monedas/delete.php", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ code }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Error");
            showToast("Moneda desactivada", "success");
            await loadCurrencies();
          } catch (err) {
            showToast(err.message, "error");
          }
        });
      });

      // Auto-save rates on change (debounced)
      let saveTimer;
      tbody.querySelectorAll(".rate-input, .active-checkbox").forEach(el => {
        el.addEventListener("change", () => {
          clearTimeout(saveTimer);
          saveTimer = setTimeout(saveCurrencyRates, 800);
        });
      });
    }

    async function saveCurrencyRates() {
      const rates = [];
      document.querySelectorAll(".rate-input").forEach(inp => {
        const code = inp.dataset.rateCode;
        const rate = parseFloat(inp.value);
        if (code && !isNaN(rate) && rate > 0) {
          const activeCheck = document.querySelector(`[data-active-code="${code}"]`);
          rates.push({
            code,
            exchange_rate: rate,
            is_active: activeCheck ? activeCheck.checked : true,
            sort_order: 0,
          });
        }
      });

      try {
        const res = await fetch("/api/monedas/update-rate.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ rates }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error saving rates");
      } catch (err) {
        console.error("Error saving rates:", err);
      }
    }

    // Store currency change → auto-save
    document.getElementById("storeCurrencySelect").addEventListener("change", async function () {
      const code = this.value;
      if (!code) return;
      try {
        const res = await fetch("/api/monedas/update-rate.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code, exchange_rate: 1.0, set_as_store: true }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error");
        // Re-fetch the actual rate for this currency
        await loadCurrencies();
        showToast(`Moneda cambiada a ${code}`, "success");
      } catch (err) {
        showToast(err.message, "error");
      }
    });

    // Add Currency Modal
    document.getElementById("addCurrencyBtn").addEventListener("click", () => {
      document.getElementById("addCurrencyModal").classList.remove("hidden");
      document.getElementById("modal-error").classList.add("hidden");
      ["code", "name", "symbol", "rate", "decimals"].forEach(f => {
        const el = document.getElementById("modal-currency-" + f);
        if (el) el.value = f === "decimals" ? "2" : f === "rate" ? "1.0" : "";
      });
    });

    document.getElementById("modalCancelBtn").addEventListener("click", () => {
      document.getElementById("addCurrencyModal").classList.add("hidden");
    });

    document.getElementById("addCurrencyModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) {
        document.getElementById("addCurrencyModal").classList.add("hidden");
      }
    });

    document.getElementById("modalConfirmBtn").addEventListener("click", async function () {
      const code = document.getElementById("modal-currency-code").value.trim().toUpperCase();
      const name = document.getElementById("modal-currency-name").value.trim();
      const symbol = document.getElementById("modal-currency-symbol").value.trim();
      const rate = parseFloat(document.getElementById("modal-currency-rate").value);
      const decimals = parseInt(document.getElementById("modal-currency-decimals").value) || 2;
      const errorEl = document.getElementById("modal-error");

      if (!code || code.length !== 3) {
        errorEl.textContent = "El código debe tener 3 letras";
        errorEl.classList.remove("hidden");
        return;
      }
      if (!name) {
        errorEl.textContent = "El nombre es requerido";
        errorEl.classList.remove("hidden");
        return;
      }
      if (!symbol) {
        errorEl.textContent = "El símbolo es requerido";
        errorEl.classList.remove("hidden");
        return;
      }
      if (isNaN(rate) || rate <= 0) {
        errorEl.textContent = "La tasa de cambio debe ser mayor a 0";
        errorEl.classList.remove("hidden");
        return;
      }

      setLoading("modalConfirmBtn", "modalConfirmIcon", "modalConfirmText", true, "GUARDANDO...");

      try {
        const res = await fetch("/api/monedas/create.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code, name, symbol, exchange_rate: rate, decimal_places: decimals }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error");
        document.getElementById("addCurrencyModal").classList.add("hidden");
        showToast(`Moneda ${code} agregada`, "success");
        await loadCurrencies();
      } catch (err) {
        errorEl.textContent = err.message;
        errorEl.classList.remove("hidden");
      } finally {
        setLoading("modalConfirmBtn", "modalConfirmIcon", "modalConfirmText", false);
      }
    });

    function showToast(msg, type) {
      const el = document.getElementById("message");
      el.className = `font-body text-body-md p-3 mb-6 rounded-sm block ${type === "error" ? "bg-red-100 text-error" : "bg-green-100 text-green-800"}`;
      el.textContent = msg;
      el.classList.remove("hidden");
      setTimeout(() => el.classList.add("hidden"), 4000);
    }

    // Load currencies when currency tab is first opened
    document.querySelector('[data-tab="moneda"]')?.addEventListener("click", function onFirstClick() {
      loadCurrencies();
    }, { once: true });
  </script>
</AdminLayout>
