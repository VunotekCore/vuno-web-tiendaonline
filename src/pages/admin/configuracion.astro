    function loadLandingCategories(sectionKey) {
      const sel = document.getElementById(`landing-${sectionKey}-cta_category_slug`);
      if (!sel || sel.dataset.loaded) return;
      fetch('/api/categorias/list.php')
        .then(r => r.json())
        .then(data => {
          const items = data.items || data || [];
          items.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.slug;
            opt.textContent = c.name;
            sel.appendChild(opt);
          });
          sel.dataset.loaded = '1';
          // Restore saved value for this section
          const saved = window.__landingData?.[sectionKey]?.cta_category_slug || '';
          if (saved) sel.value = saved;
          // Update preview without dispatching change (avoids markDirty on load)
          const preview = document.getElementById(`landing-${sectionKey}-cta-preview`);
          if (preview) {
            preview.textContent = saved
              ? 'Link: /es/catalogo?categoria=' + saved
              : 'Link: /es/catalogo';
          }
        })
        .catch(() => {});
    }

    // --- Testimonial items management ---
    function createTestimonialEntry(data) {
      const div = document.createElement('div');
      div.className = 'testimonial-entry border border-outline-variant rounded-sm p-4 bg-white relative';
      div.innerHTML = `
        <button type="button" class="delete-testimonial absolute top-2 right-2 w-8 h-8 flex items-center justify-center text-secondary hover:text-error transition-colors" title="Eliminar testimonio">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">NOMBRE</label>
            <input type="text" data-testimonial-field="name" maxlength="100" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" value="${escapeHtml(data?.name || '')}" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">PUNTUACIÓN (1-5)</label>
            <input type="number" data-testimonial-field="rating" min="1" max="5" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" value="${data?.rating || 5}" />
          </div>
          <div class="md:col-span-3">
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">TEXTO</label>
            <textarea data-testimonial-field="text" maxlength="500" class="w-full bg-transparent border border-outline p-2 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-16 text-sm">${escapeHtml(data?.text || '')}</textarea>
          </div>
        </div>
      `;
      div.querySelector('.delete-testimonial').addEventListener('click', () => {
        div.remove();
        markDirty('landing');
      });
      div.querySelectorAll('input, textarea').forEach(el => {
        el.addEventListener('change', () => markDirty('landing'));
        el.addEventListener('input', () => markDirty('landing'));
      });
      return div;
    }

    function loadTestimonialItems(items) {
      const container = document.getElementById('testimonial-items-container');
      if (!container) return;
      container.innerHTML = '';
      if (!items || items.length === 0) {
        container.appendChild(createTestimonialEntry({}));
        return;
      }
      items.forEach(item => container.appendChild(createTestimonialEntry(item)));
    }

    function collectTestimonialItems() {
      const entries = document.querySelectorAll('#testimonial-items-container .testimonial-entry');
      return Array.from(entries).map(entry => {
        const item = {};
        entry.querySelectorAll('[data-testimonial-field]').forEach(el => {
          item[el.dataset.testimonialField] = el.value;
        });
        return item;
      });
    }

    function collectLandingSettings() {
      const collected = {};
      for (const [key, section] of Object.entries(landingSections)) {
        // Check if this section has been rendered by looking for its first field
        const firstField = section.fields[0] + '_es';
        const hasDom = document.getElementById(`landing-${key}-${firstField}`) !== null;

        if (!hasDom) {
          // Section not rendered — preserve existing data instead of overwriting with {}
          collected[key] = window.__landingData?.[key] || {};
          continue;
        }

        collected[key] = {};
        const allFields = [
          ...section.fields.map(f => f + '_es'),
          ...section.fields.map(f => f + '_en'),
          ...section.extras,
        ];
        for (const f of allFields) {
          if (f === 'testimonial_items') {
            collected[key]['items'] = collectTestimonialItems();
            continue;
          }
          const el = document.getElementById(`landing-${key}-${f}`);
          if (el) {
            if (el.type === 'checkbox') {
              collected[key][f] = el.checked;
            } else {
              collected[key][f] = el.tagName === 'SELECT' ? el.value : el.value;
            }
          }
        }
      }
      return collected;
    }

    // ── Logo Uploader ──────────────────────────────────────────────────────
    const LOGO_MAX_SIZE = 1 * 1024 * 1024;
    const LOGO_MAX_W = 800;
    const LOGO_MAX_H = 400;
    const LOGO_MIN_W = 100;
    const LOGO_MIN_H = 50;
    const LOGO_ALLOWED_TYPES = ['image/png', 'image/jpeg', 'image/webp', 'image/svg+xml'];

    function showLogoPreview(url) {
      const zone = document.getElementById('logo-upload-zone');
      const preview = document.getElementById('logo-preview-area');
      const img = document.getElementById('logo-preview-img');
      const hidden = document.getElementById('store-logo');
      if (!zone || !preview || !img || !hidden) return;

      if (url) {
        zone.classList.add('hidden');
        preview.classList.remove('hidden');
        img.src = url;
        hidden.value = url;
      } else {
        zone.classList.remove('hidden');
        preview.classList.add('hidden');
        img.src = '';
        hidden.value = '';
      }
    }

    function setLogoError(msg) {
      const el = document.getElementById('logo-error');
      if (!el) return;
      if (msg) {
        el.textContent = msg;
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
        el.textContent = '';
      }
    }

    function setLogoProgress(pct, text) {
      const container = document.getElementById('logo-upload-progress');
      const bar = document.getElementById('logo-progress-bar');
      const label = document.getElementById('logo-progress-text');
      if (!container || !bar || !label) return;
      if (pct < 0) {
        container.classList.add('hidden');
        return;
      }
      container.classList.remove('hidden');
      bar.style.width = Math.min(100, Math.max(0, pct)) + '%';
      label.textContent = text || 'Subiendo...';
    }

    function validateLogoFile(file) {
      if (!file) return 'No se seleccionó ningún archivo';
      if (!LOGO_ALLOWED_TYPES.includes(file.type)) {
        return 'Formato no válido. Usá PNG, JPG, WEBP o SVG.';
      }
      if (file.size > LOGO_MAX_SIZE) {
        const mb = (file.size / (1024 * 1024)).toFixed(1);
        return 'El archivo pesa ' + mb + ' MB. El máximo es 1 MB.';
      }
      return null;
    }

    function validateLogoDimensions(file) {
      return new Promise(function (resolve) {
        if (file.type === 'image/svg+xml') {
          resolve(null);
          return;
        }
        var img = new Image();
        var url = URL.createObjectURL(file);
        img.onload = function () {
          URL.revokeObjectURL(url);
          if (img.naturalWidth > LOGO_MAX_W || img.naturalHeight > LOGO_MAX_H) {
            resolve('Dimensiones: ' + img.naturalWidth + '×' + img.naturalHeight + ' px. Máximo: ' + LOGO_MAX_W + '×' + LOGO_MAX_H + ' px.');
          } else if (img.naturalWidth < LOGO_MIN_W || img.naturalHeight < LOGO_MIN_H) {
            resolve('Dimensiones: ' + img.naturalWidth + '×' + img.naturalHeight + ' px. Mínimo: ' + LOGO_MIN_W + '×' + LOGO_MIN_H + ' px.');
          } else {
            resolve(null);
          }
        };
        img.onerror = function () {
          URL.revokeObjectURL(url);
          resolve('No se pudo leer la imagen.');
        };
        img.src = url;
      });
    }

    async function uploadLogo(file) {
      var formData = new FormData();
      formData.append('file', file);
      formData.append('folder', 'logos');

      setLogoProgress(10, 'Subiendo a ImageKit...');

      var res = await fetch('/api/imagekit/upload.php', {
        method: 'POST',
        body: formData,
      });

      setLogoProgress(80, 'Procesando...');

      var data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Error al subir la imagen');
      }

      if (!data.url) {
        throw new Error('La respuesta de ImageKit no incluye URL');
      }

      setLogoProgress(100, '¡Listo!');
      return data.url;
    }

    async function handleLogoFile(file) {
      setLogoError(null);
      setLogoProgress(-1);

      var basicErr = validateLogoFile(file);
      if (basicErr) {
        setLogoError(basicErr);
        return;
      }

      setLogoProgress(5, 'Validando dimensiones...');
      var dimErr = await validateLogoDimensions(file);
      if (dimErr) {
        setLogoError(dimErr);
        setLogoProgress(-1);
        return;
      }

      try {
        var url = await uploadLogo(file);
        await new Promise(function (r) { return setTimeout(r, 300); });
        showLogoPreview(url);
        markDirty('store');
      } catch (err) {
        setLogoError(err.message);
      } finally {
        setLogoProgress(-1);
      }
    }

    function initLogoUploader() {
      var zone = document.getElementById('logo-upload-zone');
      var fileInput = document.getElementById('logo-file-input');
      var replaceBtn = document.getElementById('logo-replace-btn');
      var removeBtn = document.getElementById('logo-remove-btn');

      if (!zone || !fileInput) return;

      zone.addEventListener('click', function () { fileInput.click(); });

      zone.addEventListener('dragover', function (e) {
        e.preventDefault();
        zone.classList.add('border-clay-accent', 'bg-clay-accent/5');
      });
      zone.addEventListener('dragleave', function () {
        zone.classList.remove('border-clay-accent', 'bg-clay-accent/5');
      });
      zone.addEventListener('drop', function (e) {
        e.preventDefault();
        zone.classList.remove('border-clay-accent', 'bg-clay-accent/5');
        var files = e.dataTransfer.files;
        if (files.length > 0) handleLogoFile(files[0]);
      });

      fileInput.addEventListener('change', function () {
        if (fileInput.files.length > 0) {
          handleLogoFile(fileInput.files[0]);
        }
        fileInput.value = '';
      });

      if (replaceBtn) {
        replaceBtn.addEventListener('click', function () { fileInput.click(); });
      }

      if (removeBtn) {
        removeBtn.addEventListener('click', function () {
          showLogoPreview(null);
          markDirty('store');
        });
      }
    }

    // ── Landing Image Uploader (Brand Values) ──────────────────────────────
    const BRAND_IMAGE_MAX_SIZE = 5 * 1024 * 1024;
    const BRAND_IMAGE_ALLOWED_TYPES = ['image/png', 'image/jpeg', 'image/webp'];

    function initLandingImageUpload(sectionKey) {
      var zone = document.getElementById('landing-' + sectionKey + '-image-zone');
      var fileInput = document.getElementById('landing-' + sectionKey + '-image-input');
      if (!zone || !fileInput) return;

      function setError(msg) {
        var el = document.getElementById('landing-' + sectionKey + '-image-error');
        if (!el) return;
        if (msg) { el.textContent = msg; el.classList.remove('hidden'); }
        else { el.classList.add('hidden'); el.textContent = ''; }
      }

      function setProgress(pct, text) {
        var container = document.getElementById('landing-' + sectionKey + '-image-progress');
        var bar = document.getElementById('landing-' + sectionKey + '-image-progress-bar');
        var label = document.getElementById('landing-' + sectionKey + '-image-progress-text');
        if (!container || !bar || !label) return;
        if (pct < 0) { container.classList.add('hidden'); return; }
        container.classList.remove('hidden');
        bar.style.width = Math.min(100, Math.max(0, pct)) + '%';
        label.textContent = text || 'Subiendo...';
      }

      function showPreview(url) {
        var zoneEl = document.getElementById('landing-' + sectionKey + '-image-zone');
        var previewEl = document.getElementById('landing-' + sectionKey + '-image-preview');
        var imgEl = document.getElementById('landing-' + sectionKey + '-image-preview-img');
        var hiddenEl = document.getElementById('landing-' + sectionKey + '-image_url');
        if (!zoneEl || !previewEl || !imgEl || !hiddenEl) return;
        if (url) {
          zoneEl.classList.add('hidden');
          previewEl.classList.remove('hidden');
          imgEl.src = url;
          hiddenEl.value = url;
        } else {
          zoneEl.classList.remove('hidden');
          previewEl.classList.add('hidden');
          imgEl.src = '';
          hiddenEl.value = '';
        }
      }

      async function handleFile(file) {
        setError(null);
        setProgress(-1);

        if (!file) { setError('No se seleccion\u00f3 ning\u00fan archivo'); return; }
        if (!BRAND_IMAGE_ALLOWED_TYPES.includes(file.type)) {
          setError('Formato no v\u00e1lido. Us\u00e1 PNG, JPG o WEBP.'); return;
        }
        if (file.size > BRAND_IMAGE_MAX_SIZE) {
          setError('El archivo pesa ' + (file.size / (1024 * 1024)).toFixed(1) + ' MB. El m\u00e1ximo es 5 MB.'); return;
        }

        setProgress(5, 'Validando...');

        try {
          var fd = new FormData();
          fd.append('file', file);
          fd.append('folder', 'brand-values');

          setProgress(10, 'Subiendo a ImageKit...');
          var res = await fetch('/api/imagekit/upload.php', { method: 'POST', body: fd });
          setProgress(80, 'Procesando...');
          var data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Error al subir la imagen');
          if (!data.url) throw new Error('La respuesta de ImageKit no incluye URL');

          setProgress(100, '\u00a1Listo!');
          await new Promise(function (r) { return setTimeout(r, 300); });
          showPreview(data.url);
          markDirty('landing');
        } catch (err) {
          setError(err.message);
        } finally {
          setProgress(-1);
        }
      }

      // Click upload zone
      zone.addEventListener('click', function () { fileInput.click(); });

      // Drag & drop
      zone.addEventListener('dragover', function (e) {
        e.preventDefault();
        zone.classList.add('border-clay-accent', 'bg-clay-accent/5');
      });
      zone.addEventListener('dragleave', function () {
        zone.classList.remove('border-clay-accent', 'bg-clay-accent/5');
      });
      zone.addEventListener('drop', function (e) {
        e.preventDefault();
        zone.classList.remove('border-clay-accent', 'bg-clay-accent/5');
        if (e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]);
      });

      // File input change
      fileInput.addEventListener('change', function () {
        if (fileInput.files.length > 0) handleFile(fileInput.files[0]);
        fileInput.value = '';
      });

      // Replace & Remove buttons (query each time since elements are dynamic)
      document.querySelectorAll('.landing-image-replace-btn[data-section="' + sectionKey + '"]').forEach(function (btn) {
        btn.addEventListener('click', function () { fileInput.click(); });
      });
      document.querySelectorAll('.landing-image-remove-btn[data-section="' + sectionKey + '"]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showPreview(null);
          markDirty('landing');
        });
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "GUARDANDO...";
      } else {
        icon.textContent = "save";
        icon.classList.remove("animate-spin");
        text.textContent = "GUARDAR CONFIGURACIÓN";
      }
    }

    // --- Tab groups ---
    function filterTabsByGroup(groupId) {
      const group = tabGroups.find(g => g.id === groupId);
      if (!group) return;
      currentGroup = groupId;
      document.querySelectorAll(".tab-btn").forEach(btn => {
        btn.classList.toggle("hidden", !group.tabs.includes(btn.dataset.tab));
      });
      var activeTab = document.querySelector(".tab-btn.text-monolith-black");
      if (!activeTab || !group.tabs.includes(activeTab.dataset.tab)) {
        var firstBtn = document.querySelector(".tab-btn:not(.hidden)");
        if (firstBtn) firstBtn.click();
      }
    }

    document.getElementById("tabGroupSelect")?.addEventListener("change", function () {
      filterTabsByGroup(this.value);
    });

    // --- Tab switching ---
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach(b => {
          b.classList.remove("text-monolith-black", "border-monolith-black");
          b.classList.add("text-secondary", "border-transparent");
        });
        btn.classList.remove("text-secondary", "border-transparent");
        btn.classList.add("text-monolith-black", "border-monolith-black");

        document.querySelectorAll(".tab-content").forEach(tc => tc.classList.add("hidden"));
        document.getElementById("tab-" + btn.dataset.tab).classList.remove("hidden");
      });
    });

    filterTabsByGroup("general");
    document.querySelector(".tab-btn:not(.hidden)")?.click();

    function loadCouponSelect() {
      const sel = document.getElementById("store-newsletter_discount_code");
      if (!sel || sel.dataset.loaded) return;
      fetch("/api/cupones/list-active.php")
        .then(r => r.json())
        .then(coupons => {
          if (!Array.isArray(coupons)) return;
          coupons.forEach(c => {
            const opt = document.createElement("option");
            opt.value = c.code;
            opt.textContent = c.code + " (" + (c.discount_type === "percentage" ? c.discount_value + "%" : "$" + c.discount_value.toFixed(2)) + ")" + (c.description ? " — " + c.description : "");
            sel.appendChild(opt);
          });
          sel.dataset.loaded = "1";
        })
        .catch(() => {});
    }

    // --- Load settings ---
    (async function () {
      try {
        await loadCouponSelect();
        const res = await fetch("/api/configuracion/get.php");
        const settings = await res.json();
        loadSettings(settings);
        showLogoPreview(settings?.store?.logo ?? '');
        // Attach change listeners to all static sections
        for (const section of Object.keys(fieldMap)) {
          attachFieldListeners(section);
        }
        setupTransferDirtyDelegation();
        setupInputValidation();
        document.getElementById("loading").classList.add("hidden");
        document.getElementById("settingsContent").classList.remove("hidden");
      } catch (err) {
        document.getElementById("loading").textContent = "Error loading settings: " + err.message;
      }
    })();

    // Initialize logo uploader event handlers
    initLogoUploader();

    // --- Add Bank ---
    document.getElementById("addBankBtn").addEventListener("click", () => {
      const container = document.getElementById("banks-container");
      container.appendChild(createBankEntry({}));
      markDirty('transfer');
    });

    // --- Save ---
    document.getElementById("saveBtn").addEventListener("click", async () => {
      if (dirtySections.size === 0) {
        showToast('Sin cambios que guardar', 'info');
        return;
      }

      const settings = {};
      for (const section of dirtySections) {
        const fields = fieldMap[section];
        if (!fields) continue; // Sections like 'landing' handled separately below
        const textFields = Array.isArray(fields) ? fields : (fields.text || []);
        const boolFields = Array.isArray(fields) ? [] : (fields.bool || []);
        settings[section] = {};

        for (const field of textFields) {
          const el = document.getElementById(`${section}-${field}`);
          settings[section][field] = el ? el.value : "";
        }
        for (const field of boolFields) {
          const el = document.getElementById(`${section}-${field}`);
          settings[section][field] = el ? el.checked : false;
        }
      }

      if (dirtySections.has('transfer')) {
        settings.transfer = {
          enabled: document.getElementById("transfer-enabled").checked,
          banks: collectBanks(),
        };
      }

      if (dirtySections.has('landing')) {
        settings.landing = collectLandingSettings();
      }

      setLoading("saveBtn", "saveIcon", "saveText", true);

      try {
        const res = await fetch("/api/configuracion/update.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(settings),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error saving");

        // Save size guide rows if dirty
        if (dirtySections.has('size_guide')) {
          const rows = collectSizeGuideRows();
          const rowsRes = await fetch("/api/size-guide/save-all.php", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rows }),
          });
          const rowsData = await rowsRes.json();
          if (!rowsRes.ok) throw new Error(rowsData.error || "Error saving rows");
        }

        clearDirty();
        showToast('Configuración guardada correctamente', 'success');
      } catch (err) {
        showToast(err.message, 'error');
      } finally {
        setLoading("saveBtn", "saveIcon", "saveText", false);
      }
    });

    // =========================================================================
    // Moneda (Currency) Tab
    // =========================================================================

    let currenciesData = [];

    async function loadCurrencies() {
      try {
        const res = await fetch("/api/monedas/list.php?all=1");
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        currenciesData = data.currencies || [];
        renderCurrencyTab(data.storeCurrency);
      } catch (err) {
        console.error("Error loading currencies:", err);
      }
    }

    function renderCurrencyTab(storeCurrencyCode) {
      const select = document.getElementById("storeCurrencySelect");
      const tbody = document.getElementById("ratesBody");

      // Populate dropdown
      select.innerHTML = '<option value="">Seleccionar moneda...</option>';
      currenciesData.forEach(c => {
        const opt = document.createElement("option");
        opt.value = c.code;
        opt.textContent = `${c.code} — ${c.name} (${c.symbol})`;
        if (c.code === storeCurrencyCode) opt.selected = true;
        select.appendChild(opt);
      });

      // Populate rates table
      tbody.innerHTML = "";
      currenciesData.forEach(c => {
        const tr = document.createElement("tr");
        tr.className = "border-b border-outline-variant/50 hover:bg-white/60 transition-colors";

        const activeChecked = c.is_active ? "checked" : "";

        tr.innerHTML = `
          <td class="py-3 pr-4 font-mono text-sm font-semibold">${c.code}</td>
          <td class="py-3 pr-4 text-sm">${c.name}</td>
          <td class="py-3 pr-4 text-sm font-mono">${c.symbol}</td>
          <td class="py-3 pr-4">
            <input type="number" step="0.000001" min="0.000001" value="${c.exchange_rate}"
              data-rate-code="${c.code}"
              class="rate-input w-28 bg-transparent border-b border-outline pb-1 text-monolith-black focus:border-clay-accent focus:outline-none text-sm font-mono" />
          </td>
          <td class="py-3 pr-4 text-sm">${c.decimal_places}</td>
          <td class="py-3 pr-4">
            <input type="checkbox" data-active-code="${c.code}" ${activeChecked}
              class="active-checkbox w-4 h-4 text-monolith-black border-outline rounded-sm focus:ring-monolith-black cursor-pointer" />
          </td>
          <td class="py-3 text-sm">
            ${c.code !== "USD" ? `<button data-delete-code="${c.code}" class="delete-currency w-7 h-7 flex items-center justify-center text-secondary hover:text-error transition-colors" title="Desactivar moneda">
              <span class="material-symbols-outlined text-lg">delete</span>
            </button>` : '<span class="text-secondary text-xs">Base</span>'}
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Attach delete events
      tbody.querySelectorAll(".delete-currency").forEach(btn => {
        btn.addEventListener("click", async () => {
          const code = btn.dataset.deleteCode;
          if (!window.VunoModal) return;
          window.VunoModal.show({
            type: 'warning',
            title: 'Desactivar moneda',
            message: '¿Desactivar moneda ' + code + '?',
            actions: [
              { label: 'CANCELAR', variant: 'secondary', onClick: function () {} },
              { label: 'DESACTIVAR', variant: 'danger', onClick: async function () {
                try {
                  const res = await fetch("/api/monedas/delete.php", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ code }),
                  });
                  const data = await res.json();
                  if (!res.ok) throw new Error(data.error || "Error");
                  if (window.VunoToast) window.VunoToast.show({ title: 'Moneda desactivada', type: 'success', duration: 3000 });
                  await loadCurrencies();
                } catch (err) {
                  if (window.VunoToast) window.VunoToast.show({ title: 'Error', message: err.message, type: 'error', duration: 5000 });
                }
              } },
            ],
          });
        });
      });

      // Auto-save rates on change (debounced)
      let saveTimer;
      tbody.querySelectorAll(".rate-input, .active-checkbox").forEach(el => {
        el.addEventListener("change", () => {
          clearTimeout(saveTimer);
          saveTimer = setTimeout(saveCurrencyRates, 800);
        });
      });
    }

    async function saveCurrencyRates() {
      const rates = [];
      document.querySelectorAll(".rate-input").forEach(inp => {
        const code = inp.dataset.rateCode;
        const rate = parseFloat(inp.value);
        if (code && !isNaN(rate) && rate > 0) {
          const activeCheck = document.querySelector(`[data-active-code="${code}"]`);
          rates.push({
            code,
            exchange_rate: rate,
            is_active: activeCheck ? activeCheck.checked : true,
            sort_order: 0,
          });
        }
      });

      try {
        const res = await fetch("/api/monedas/update-rate.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ rates }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error saving rates");
      } catch (err) {
        console.error("Error saving rates:", err);
      }
    }

    // Store currency change → auto-save
    document.getElementById("storeCurrencySelect").addEventListener("change", async function () {
      const code = this.value;
      if (!code) return;
      try {
        const res = await fetch("/api/monedas/update-rate.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code, exchange_rate: 1.0, set_as_store: true }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error");
        // Re-fetch the actual rate for this currency
        await loadCurrencies();
        showToast(`Moneda cambiada a ${code}`, "success");
      } catch (err) {
        showToast(err.message, "error");
      }
    });

    // Add Currency Modal
    document.getElementById("addCurrencyBtn").addEventListener("click", () => {
      document.getElementById("addCurrencyModal").classList.remove("hidden");
      document.getElementById("modal-error").classList.add("hidden");
      ["code", "name", "symbol", "rate", "decimals"].forEach(f => {
        const el = document.getElementById("modal-currency-" + f);
        if (el) el.value = f === "decimals" ? "2" : f === "rate" ? "1.0" : "";
      });
    });

    document.getElementById("modalCancelBtn").addEventListener("click", () => {
      document.getElementById("addCurrencyModal").classList.add("hidden");
    });

    document.getElementById("addCurrencyModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) {
        document.getElementById("addCurrencyModal").classList.add("hidden");
      }
    });

    document.getElementById("modalConfirmBtn").addEventListener("click", async function () {
      const code = document.getElementById("modal-currency-code").value.trim().toUpperCase();
      const name = document.getElementById("modal-currency-name").value.trim();
      const symbol = document.getElementById("modal-currency-symbol").value.trim();
      const rate = parseFloat(document.getElementById("modal-currency-rate").value);
      const decimals = parseInt(document.getElementById("modal-currency-decimals").value) || 2;
      const errorEl = document.getElementById("modal-error");

      if (!code || code.length !== 3) {
        errorEl.textContent = "El código debe tener 3 letras";
        errorEl.classList.remove("hidden");
        return;
      }
      if (!name) {
        errorEl.textContent = "El nombre es requerido";
        errorEl.classList.remove("hidden");
        return;
      }
      if (!symbol) {
        errorEl.textContent = "El símbolo es requerido";
        errorEl.classList.remove("hidden");
        return;
      }
      if (isNaN(rate) || rate <= 0) {
        errorEl.textContent = "La tasa de cambio debe ser mayor a 0";
        errorEl.classList.remove("hidden");
        return;
      }

      setLoading("modalConfirmBtn", "modalConfirmIcon", "modalConfirmText", true, "GUARDANDO...");

      try {
        const res = await fetch("/api/monedas/create.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code, name, symbol, exchange_rate: rate, decimal_places: decimals }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error");
        document.getElementById("addCurrencyModal").classList.add("hidden");
        showToast(`Moneda ${code} agregada`, "success");
        await loadCurrencies();
      } catch (err) {
        errorEl.textContent = err.message;
        errorEl.classList.remove("hidden");
      } finally {
        setLoading("modalConfirmBtn", "modalConfirmIcon", "modalConfirmText", false);
      }
    });

    function showToast(msg, type) {
      if (window.VunoToast) {
        window.VunoToast.show({ title: msg, type: type || 'info', duration: 3000 });
      } else {
        alert(msg);
      }
    }

    // Load currencies when currency tab is first opened
    document.querySelector('[data-tab="moneda"]')?.addEventListener("click", function onFirstClick() {
      loadCurrencies();
    }, { once: true });

    // Load size guide rows when tab is first opened
    document.querySelector('[data-tab="sizeguide"]')?.addEventListener("click", async function onFirstClick() {
      const tbody = document.getElementById('size-guide-rows-tbody');
      const tmpl = document.getElementById('size-guide-row-template');
      if (!tbody || !tmpl) return;
      try {
        const res = await fetch('/api/size-guide/public.php');
        const data = await res.json();
        if (!data || !Array.isArray(data.rows)) return;
        tbody.innerHTML = '';
        data.rows.forEach(function (r) {
          const tr = tmpl.content.cloneNode(true).querySelector('tr');
          tr.querySelector('.sg-us').value = r.us || '';
          tr.querySelector('.sg-eu').value = r.eu || '';
          tr.querySelector('.sg-uk').value = r.uk || '';
          tr.querySelector('.sg-cm').value = r.cm || '';
          tbody.appendChild(tr);
        });
      } catch (_) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-error py-4">Error al cargar</td></tr>';
      }
    }, { once: true });

    // Add size guide row
    document.getElementById('addSizeGuideRowBtn')?.addEventListener('click', function () {
      const tbody = document.getElementById('size-guide-rows-tbody');
      const tmpl = document.getElementById('size-guide-row-template');
      if (!tbody || !tmpl) return;
      const tr = tmpl.content.cloneNode(true).querySelector('tr');
      tbody.appendChild(tr);
      markDirty('size_guide');
    });

    // Delegate dirty tracking for size guide row changes
    document.getElementById('tab-sizeguide')?.addEventListener('input', function (e) {
      if (e.target.closest('.size-guide-row')) markDirty('size_guide');
    });

    function collectSizeGuideRows() {
      const rows = [];
      document.querySelectorAll('#size-guide-rows-tbody .size-guide-row').forEach(function (tr) {
        const us = tr.querySelector('.sg-us').value.trim();
        const eu = tr.querySelector('.sg-eu').value.trim();
        const uk = tr.querySelector('.sg-uk').value.trim();
        const cm = tr.querySelector('.sg-cm').value.trim();
        if (us || eu || uk || cm) {
          rows.push({ us: us || '', eu: eu || '', uk: uk || '', cm: cm || '' });
        }
      });
      return rows;
    }

    // Delete size guide row via delegation
    document.getElementById('tab-sizeguide')?.addEventListener('click', function (e) {
      var btn = e.target.closest('.sg-delete');
      if (!btn) return;
      var tr = btn.closest('.size-guide-row');
      if (tr && window.VunoModal) {
        window.VunoModal.show({
          type: 'warning',
          title: 'Eliminar fila',
          message: '¿Eliminar esta fila de la guía de talles?',
          actions: [
            { label: 'CANCELAR', variant: 'secondary', onClick: function () {} },
            { label: 'ELIMINAR', variant: 'danger', onClick: function () {
              tr.remove();
              markDirty('size_guide');
            } },
          ],
        });
      }
    });

    // --- Landing section selector ---
    document.getElementById('landing-section-selector')?.addEventListener('change', function () {
      renderLandingSection(this.value);
    });

    document.querySelector('[data-tab="landing"]')?.addEventListener("click", function () {
      markDirty('landing');
    });
  </script>
</AdminLayout>
