          html += '<button type="button" class="landing-image-remove-btn font-label-caps text-label-caps text-error hover:text-red-700 transition-colors inline-flex items-center gap-1 cursor-pointer" data-section="' + sectionKey + '">';
          html += '<span class="material-symbols-outlined text-lg">delete</span> ELIMINAR';
          html += '</button>';
          html += '</div></div>';

          // Hidden input
          html += '<input type="hidden" id="landing-' + sectionKey + '-image_url" value="' + escapeHtml(imgUrl) + '" />';

          // Progress
          html += '<div id="landing-' + sectionKey + '-image-progress" class="hidden mt-2">';
          html += '<div class="w-full bg-outline-variant rounded-full h-1">';
          html += '<div id="landing-' + sectionKey + '-image-progress-bar" class="bg-monolith-black h-1 rounded-full transition-all duration-300" style="width: 0%"></div>';
          html += '</div>';
          html += '<p id="landing-' + sectionKey + '-image-progress-text" class="font-body text-body-md text-xs text-secondary mt-1">Subiendo...</p>';
          html += '</div>';

          // Error + helper
          html += '<p id="landing-' + sectionKey + '-image-error" class="hidden font-body text-body-md text-xs text-error mt-1"></p>';
          if (landingFieldHelpers[ext]) {
            html += '<p class="font-body text-body-md text-xs text-secondary mt-1">' + landingFieldHelpers[ext] + '</p>';
          }
          html += '</div>';
        } else {
          html += '<div class="md:col-span-2">' +
            '<label class="font-label-caps text-label-caps text-secondary block mb-2">' + landingFieldLabels[ext] + '</label>' +
            '<input type="text" id="landing-' + sectionKey + '-' + ext + '" autocomplete="off" maxlength="500" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" placeholder="' + (landingFieldPlaceholders[ext] || '') + '" value="' + escapeHtml(data[ext] || '') + '" />' +
            (landingFieldHelpers[ext] ? '<p class="font-body text-body-md text-xs text-secondary mt-1">' + landingFieldHelpers[ext] + '</p>' : '') +
            '</div>';
