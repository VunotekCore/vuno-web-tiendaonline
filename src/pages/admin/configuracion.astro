    <!-- Size guide row template -->
    <template id="size-guide-row-template">
      <tr class="size-guide-row border-b border-outline-variant/50">
        <td class="py-1.5 pr-4"><input type="text" class="sg-us w-full bg-transparent border-b border-outline pb-1 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" maxlength="6" /></td>
        <td class="py-1.5 pr-4"><input type="text" class="sg-eu w-full bg-transparent border-b border-outline pb-1 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" maxlength="6" /></td>
        <td class="py-1.5 pr-4"><input type="text" class="sg-uk w-full bg-transparent border-b border-outline pb-1 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" maxlength="6" /></td>
        <td class="py-1.5 pr-4"><input type="text" class="sg-cm w-full bg-transparent border-b border-outline pb-1 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" maxlength="6" /></td>
        <td class="py-1.5"><button class="sg-delete w-7 h-7 flex items-center justify-center text-secondary hover:text-error transition-colors" title="Eliminar fila"><span class="material-symbols-outlined text-lg">remove_circle</span></button></td>
      </tr>
