            <label class="font-label-caps text-label-caps text-secondary block mb-2">PIE / FOOTER (ES)</label>
            <input type="text" id="size_guide-footer_es" maxlength="300" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
          <div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">PIE / FOOTER (EN)</label>
            <input type="text" id="size_guide-footer_en" maxlength="300" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" />
          </div>
        </div>
        <div class="mt-6 pt-6 border-t border-outline-variant">
          <p class="font-label-caps text-label-caps text-secondary mb-3">FILAS DE CONVERSIÓN</p>
          <div id="size-guide-rows-container" class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-outline-variant">
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4 w-20">US</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4 w-20">EU</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4 w-20">UK</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 pr-4 w-20">CM</th>
                  <th class="font-label-caps text-label-caps text-secondary pb-2 w-16"></th>
