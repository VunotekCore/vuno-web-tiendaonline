    <!-- Add Currency Modal -->
    <div id="addCurrencyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <div class="bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md mx-4">
        <h3 class="font-headline text-headline-sm mb-4">Agregar Moneda</h3>
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">CÓDIGO (3 letras)</label>
              <input type="text" id="modal-currency-code" maxlength="3" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm uppercase font-mono" placeholder="EUR" />
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">SÍMBOLO</label>
              <input type="text" id="modal-currency-symbol" maxlength="10" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" placeholder="€" />
            </div>
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">NOMBRE</label>
            <input type="text" id="modal-currency-name" maxlength="100" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" placeholder="Euro" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">TASA DE CAMBIO (vs USD)</label>
              <input type="number" id="modal-currency-rate" step="0.000001" min="0.000001" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" placeholder="21.5" />
            </div>
            <div>
              <label class="font-label-caps text-label-caps text-secondary block mb-1 text-xs">DECIMALES</label>
              <input type="number" id="modal-currency-decimals" min="0" max="6" value="2" class="w-full bg-transparent border-b border-outline pb-1.5 text-monolith-black focus:border-clay-accent focus:outline-none text-sm" />
            </div>
          </div>
          <p id="modal-error" class="font-body text-body-md text-sm text-red-600 hidden"></p>
        </div>
        <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-outline-variant">
          <button id="modalCancelBtn" class="font-label-caps text-label-caps text-secondary h-9 px-5 hover:text-monolith-black transition-colors">CANCELAR</button>
          <button id="modalConfirmBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-9 px-5 inline-flex items-center justify-center gap-1.5 rounded-sm hover:bg-monolith-black/90 transition-all duration-200">
            <span id="modalConfirmIcon" class="material-symbols-outlined text-lg">add</span>
            <span id="modalConfirmText">AGREGAR</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Save button -->
    <div class="mt-8 pt-6 border-t border-outline-variant">
      <button id="saveBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-12 px-8 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200">
        <span id="saveIcon" class="material-symbols-outlined text-lg">save</span>
        <span id="saveText">GUARDAR CONFIGURACIÓN</span>
      </button>
    </div>
  </div>

  <script>
    // @ts-nocheck
    const fieldMap = {
      store: ["name", "slogan", "email", "description", "logo", "newsletter_discount_code"],
      receipt: ["businessName", "taxId", "address", "city", "state", "zip", "phone"],
      imagekit: ["publicKey", "privateKey", "urlEndpoint"],
      stripe: { text: ["publishableKey", "secretKey", "webhookSecret"], bool: ["enabled"] },
      smtp: ["host", "port", "user", "pass", "fromEmail", "fromName"],
      transfer: { bool: ["enabled"] },
      size_guide: ["title_es", "title_en", "footer_es", "footer_en"],
    };

    const tabGroups = [
      { id: "general", label: "General", tabs: ["store", "receipt", "sizeguide", "moneda"] },
      { id: "pagos", label: "Pagos", tabs: ["stripe", "transfer"] },
      { id: "servicios", label: "Servicios", tabs: ["imagekit", "smtp"] },
      { id: "contenido", label: "Contenido", tabs: ["landing"] },
    ];

    let currentGroup = "general";

    const bankFields = ["bankName", "accountHolder", "accountNumber", "accountType", "routingNumber", "instructions"];

    // Dirty section tracking — only modified tabs are saved
    const dirtySections = new Set();

    function markDirty(section) {
      dirtySections.add(section);
      const tab = document.querySelector(`[data-tab="${section}"]`);
      if (tab && !tab.querySelector('.dirty-indicator')) {
        const dot = document.createElement('span');
        dot.className = 'dirty-indicator ml-1';
        dot.textContent = '\u25CF';
        dot.style.color = '#C18C7E';
        dot.style.fontSize = '10px';
        tab.appendChild(dot);
      }
    }

    function clearDirty(section) {
      if (section) {
        dirtySections.delete(section);
        const tab = document.querySelector(`[data-tab="${section}"]`);
        tab?.querySelector('.dirty-indicator')?.remove();
      } else {
        dirtySections.clear();
        document.querySelectorAll('.tab-btn .dirty-indicator').forEach(el => el.remove());
      }
    }

    function attachFieldListeners(section) {
      const fields = fieldMap[section];
      if (!fields) return;
      const textFields = Array.isArray(fields) ? fields : (fields.text || []);
      const boolFields = Array.isArray(fields) ? [] : (fields.bool || []);
      const handler = () => markDirty(section);
      for (const field of textFields) {
        const el = document.getElementById(`${section}-${field}`);
        if (el) {
          el.addEventListener('change', handler);
          el.addEventListener('input', handler);
        }
      }
      for (const field of boolFields) {
        const el = document.getElementById(`${section}-${field}`);
        if (el) el.addEventListener('change', handler);
      }
    }

    function setupTransferDirtyDelegation() {
      const container = document.getElementById('banks-container');
      if (!container) return;
      container.addEventListener('change', (e) => {
        if (e.target.closest('[data-bank-field]')) markDirty('transfer');
      });
      container.addEventListener('input', (e) => {
        if (e.target.closest('[data-bank-field]')) markDirty('transfer');
      });
    }

    function setupInputValidation() {
      document.querySelectorAll('#settingsContent input[maxlength], #settingsContent textarea[maxlength]').forEach(input => {
        if (input.closest('#banks-container') || input.closest('#addCurrencyModal')) return;
        const max = parseInt(input.maxLength);
        if (!max || max > 999) return;
        if (input.parentElement.querySelector('.char-counter')) return;
        const isTextarea = input.tagName === 'TEXTAREA';
        const parent = input.parentElement;

        if (isTextarea) {
          const counter = document.createElement('div');
          counter.className = 'char-counter text-right text-xs font-body transition-colors duration-200 text-secondary';
          const update = () => {
            const len = input.value.length;
            counter.textContent = len + '/' + max;
            counter.className = 'char-counter text-right text-xs font-body transition-colors duration-200 ' + (len >= max ? 'text-error' : len >= max * 0.8 ? 'text-clay-accent' : 'text-secondary');
          };
          input.addEventListener('input', update);
          parent.insertBefore(counter, input.nextSibling);
          update();
        } else {
          if (getComputedStyle(parent).position === 'static') parent.classList.add('relative');
          input.classList.add('pr-14');
          const counter = document.createElement('span');
          counter.className = 'char-counter absolute right-0 bottom-2 text-xs font-body pointer-events-none transition-colors duration-200 text-secondary';
          const update = () => {
            const len = input.value.length;
            counter.textContent = len + '/' + max;
            counter.className = 'char-counter absolute right-0 bottom-2 text-xs font-body pointer-events-none transition-colors duration-200 ' + (len >= max ? 'text-error' : len >= max * 0.8 ? 'text-clay-accent' : 'text-secondary');
          };
          input.addEventListener('input', update);
          parent.appendChild(counter);
          update();
        }
      });
    }

    function createBankEntry(data) {
      const tpl = document.getElementById("bank-template");
      const clone = tpl.content.cloneNode(true);
      const entry = clone.querySelector(".bank-entry");

      bankFields.forEach(f => {
        const el = entry.querySelector(`[data-bank-field="${f}"]`);
        if (el) el.value = data?.[f] ?? "";
      });

      // Bank fields have HTML maxlength — no char counters needed (avoids layout overlap)

      entry.querySelector(".delete-bank").addEventListener("click", () => {
        entry.remove();
        markDirty('transfer');
      });

      return entry;
    }

    function loadBanks(banks) {
      const container = document.getElementById("banks-container");
      container.innerHTML = "";
      if (!banks || banks.length === 0) {
        container.appendChild(createBankEntry({}));
        return;
      }
      banks.forEach(b => container.appendChild(createBankEntry(b)));
    }

    function collectBanks() {
      const entries = document.querySelectorAll("#banks-container .bank-entry");
      return Array.from(entries).map(entry => {
        const bank = {};
        bankFields.forEach(f => {
          const el = entry.querySelector(`[data-bank-field="${f}"]`);
          bank[f] = el ? el.value : "";
        });
        return bank;
      });
    }

    function loadSettings(settings) {
      for (const [section, fields] of Object.entries(fieldMap)) {
        const textFields = Array.isArray(fields) ? fields : (fields.text || []);
        const boolFields = Array.isArray(fields) ? [] : (fields.bool || []);

        for (const field of textFields) {
          const el = document.getElementById(`${section}-${field}`);
          if (el) el.value = settings[section]?.[field] ?? "";
        }
        for (const field of boolFields) {
          const el = document.getElementById(`${section}-${field}`);
          if (el) el.checked = settings[section]?.[field] ?? false;
        }
      }
      const transfer = settings.transfer || {};
      document.getElementById("transfer-enabled").checked = transfer.enabled ?? true;
      loadBanks(transfer.banks);
      // Store landing data and render first section
      window.__landingData = settings.landing || {};
      renderLandingSection('hero');
    }

    function collectSettings() {
      const settings = {};
      for (const [section, fields] of Object.entries(fieldMap)) {
        const textFields = Array.isArray(fields) ? fields : (fields.text || []);
        const boolFields = Array.isArray(fields) ? [] : (fields.bool || []);
        settings[section] = {};

        for (const field of textFields) {
          const el = document.getElementById(`${section}-${field}`);
          settings[section][field] = el ? el.value : "";
        }
        for (const field of boolFields) {
          const el = document.getElementById(`${section}-${field}`);
          settings[section][field] = el ? el.checked : false;
        }
      }
      settings.transfer = {
        enabled: document.getElementById("transfer-enabled").checked,
        banks: collectBanks(),
      };
      settings.landing = collectLandingSettings();
      return settings;
    }

    // --- Landing Page dynamic section editor ---
    const landingSections = {
      hero: { label: 'Hero', fields: ['label', 'title', 'subtitle', 'cta'], extras: ['cta_link', 'cta_category_slug'] },
      new_arrivals: { label: 'New Arrivals', fields: ['label', 'title', 'subtitle', 'cta'], extras: ['cta_link', 'cta_category_slug'] },
      categories: { label: 'Categories', fields: ['label', 'title'], extras: ['cta_link', 'cta_category_slug'] },
      brand_values: { label: 'Brand Values', fields: ['label', 'title', 'paragraph', 'cta'], extras: ['image_url', 'cta_link', 'cta_category_slug'] },
      closing_cta: { label: 'Closing CTA', fields: ['label', 'title', 'subtitle', 'cta'], extras: ['cta_link', 'cta_category_slug'] },
      social: { label: 'Social Media', fields: ['title'], extras: ['enabled', 'facebook_url', 'instagram_url', 'tiktok_url'] },
      testimonials: { label: 'Testimonials', fields: ['title', 'subtitle'], extras: ['enabled', 'testimonial_items'] },
      blog: { label: 'Blog Journal', fields: ['label', 'title', 'view_all'], extras: [] },
    };

    const landingFieldLabels = {
      label_es: 'ETIQUETA (ES)', label_en: 'LABEL (EN)',
      title_es: 'TÍTULO (ES)', title_en: 'TITLE (EN)',
      subtitle_es: 'SUBTÍTULO (ES)', subtitle_en: 'SUBTITLE (EN)',
      paragraph_es: 'PÁRRAFO (ES)', paragraph_en: 'PARAGRAPH (EN)',
      cta_es: 'CTA (ES)', cta_en: 'CTA (EN)',
      view_all_es: 'VER TODOS (ES)', view_all_en: 'VIEW ALL (EN)',
      image_url: 'IMAGEN (URL)',
      cta_link: 'CTA LINK (URL personalizada)',
      cta_category_slug: 'CTA LINK — CATEGORÍA',
      enabled: 'HABILITAR SECCIÓN',
      facebook_url: 'FACEBOOK URL',
      instagram_url: 'INSTAGRAM URL',
      tiktok_url: 'TIKTOK URL',
      testimonial_items: 'TESTIMONIOS',
    };

    const landingFieldPlaceholders = {
      image_url: 'https://ik.imagekit.io/...',
      cta_category_slug: 'Seleccionar categoría',
    };

    const landingFieldHelpers = {
      image_url: 'URL pública de la imagen. Relación 4:5 recomendada.',
      cta_category_slug: 'Link generado automáticamente: /es/catalogo?categoria=...',
    };

    function renderLandingSection(sectionKey) {
      const container = document.getElementById('landing-fields-container');
      const section = landingSections[sectionKey];
      if (!section || !container) return;

      const data = window.__landingData?.[sectionKey] || {};
      let html = '<div class="grid grid-cols-1 md:grid-cols-2 gap-6">';

      // Text fields rendered as ES/EN pairs
      const esFields = section.fields.map(f => f + '_es').filter(f => landingFieldLabels[f]);
      const enFields = section.fields.map(f => f + '_en').filter(f => landingFieldLabels[f]);

      if (esFields.length > 0) {
        html += '<div class="md:col-span-2"><div class="border-b border-outline-variant pb-4 mb-4"><span class="font-label-caps text-label-caps text-clay-accent tracking-[0.15em]">ESPAÑOL</span></div></div>';
        for (const f of esFields) {
          const isTextarea = f.startsWith('paragraph_');
          html += `<div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">${landingFieldLabels[f]}</label>
            ${isTextarea
              ? `<textarea id="landing-${sectionKey}-${f}" maxlength="500" class="w-full bg-transparent border border-outline p-3 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-20">${(data[f] || '')}</textarea>`
              : `<input type="text" id="landing-${sectionKey}-${f}" autocomplete="off" maxlength="${f.includes('title') ? '200' : '100'}" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" value="${escapeHtml(data[f] || '')}" />`
            }
          </div>`;
        }
      }

      if (enFields.length > 0) {
        html += '<div class="md:col-span-2"><div class="border-b border-outline-variant pb-4 mb-4"><span class="font-label-caps text-label-caps text-clay-accent tracking-[0.15em]">ENGLISH</span></div></div>';
        for (const f of enFields) {
          const isTextarea = f.startsWith('paragraph_');
          html += `<div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">${landingFieldLabels[f]}</label>
            ${isTextarea
              ? `<textarea id="landing-${sectionKey}-${f}" maxlength="500" class="w-full bg-transparent border border-outline p-3 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-20">${(data[f] || '')}</textarea>`
              : `<input type="text" id="landing-${sectionKey}-${f}" autocomplete="off" maxlength="${f.includes('title') ? '200' : '100'}" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none" value="${escapeHtml(data[f] || '')}" />`
            }
          </div>`;
        }
      }

      // Extra fields (image_url, cta_category_slug, enabled, social urls, etc.)
      for (const ext of section.extras) {
        if (ext === 'cta_category_slug') {
          html += `<div class="md:col-span-2">
            <label class="font-label-caps text-label-caps text-secondary block mb-2">${landingFieldLabels[ext]}</label>
            <select id="landing-${sectionKey}-${ext}" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-clay-accent focus:outline-none">
              <option value="">Catálogo general</option>
            </select>
            <p class="font-body text-body-md text-xs text-secondary mt-1" id="landing-${sectionKey}-cta-preview">Link: /es/catalogo</p>
          </div>`;
        } else if (ext === 'enabled') {
          html += `<div class="md:col-span-2">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="landing-${sectionKey}-${ext}" class="sr-only peer" ${data[ext] ? 'checked' : ''} />
              <div class="w-12 h-6.5 bg-outline-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[3px] after:start-[3px] after:bg-white after:border-outline-variant after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-monolith-black"></div>
              <span class="ml-3 font-body text-body-md text-monolith-black">${landingFieldLabels[ext]}</span>
            </label>
          </div>`;
        } else if (ext === 'testimonial_items') {
