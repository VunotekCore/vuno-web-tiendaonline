    <!-- Size Guide Tab -->
    <div id="tab-sizeguide" class="tab-content hidden">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">straighten</span>
          Guía de Talles
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl">
