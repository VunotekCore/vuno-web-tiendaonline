          html += '<p class="font-body text-body-md text-secondary mb-1">Arrastrá la imagen o <span class="text-clay-accent underline">seleccioná un archivo</span></p>';
          html += '<p class="font-body text-body-md text-xs text-secondary">PNG, JPG o WEBP — Máx 5 MB</p>';
          html += '</div>';

          // Preview area
          html += '<div id="landing-' + sectionKey + '-image-preview" class="border border-outline-variant rounded-sm p-3 bg-white flex items-center gap-4' + (imgUrl ? '' : ' hidden') + '">';
          html += '<div class="w-24 h-24 flex items-center justify-center bg-sand-nude/30 rounded-sm overflow-hidden flex-shrink-0">';
          html += '<img id="landing-' + sectionKey + '-image-preview-img" class="max-w-full max-h-full object-contain" src="' + escapeHtml(imgUrl) + '" alt="" />';
          html += '</div>';
          html += '<div class="flex flex-col gap-1.5">';
          html += '<button type="button" class="landing-image-replace-btn font-label-caps text-label-caps text-clay-accent hover:text-monolith-black transition-colors inline-flex items-center gap-1 cursor-pointer" data-section="' + sectionKey + '">';
          html += '<span class="material-symbols-outlined text-lg">refresh</span> REEMPLAZAR';
