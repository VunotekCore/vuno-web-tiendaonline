      if (section.extras.includes('testimonial_items')) {
        loadTestimonialItems(data.items || []);
      }

      // Initialize image upload for sections with image_url
      if (section.extras.includes('image_url')) {
        initLandingImageUpload(sectionKey);
      }

      // Attach change listeners to all new fields
      container.querySelectorAll('input, textarea, select').forEach(el => {
        if (el.type === 'checkbox') {
          el.addEventListener('change', () => markDirty('landing'));
        } else {
          el.addEventListener('change', () => markDirty('landing'));
          el.addEventListener('input', () => markDirty('landing'));
        }
      });

      // cta_category_slug preview + restore
      const catSelect = document.getElementById(`landing-${sectionKey}-cta_category_slug`);
      if (catSelect) {
        catSelect.addEventListener('change', () => {
          const preview = document.getElementById(`landing-${sectionKey}-cta-preview`);
          if (preview) {
            preview.textContent = catSelect.value
              ? 'Link: /es/catalogo?categoria=' + catSelect.value
              : 'Link: /es/catalogo';
          }
          markDirty('landing');
        });
        const savedSlug = data['cta_category_slug'] || '';
        if (savedSlug) catSelect.value = savedSlug;
        // Update preview without dispatching change (avoids markDirty on load)
        const initPreview = document.getElementById(`landing-${sectionKey}-cta-preview`);
        if (initPreview) {
          initPreview.textContent = savedSlug
            ? 'Link: /es/catalogo?categoria=' + savedSlug
            : 'Link: /es/catalogo';
        }
      }

      // Add testimonial button
      const addBtn = document.getElementById('addTestimonialBtn');
      if (addBtn) {
        addBtn.addEventListener('click', () => {
          const container = document.getElementById('testimonial-items-container');
          container.appendChild(createTestimonialEntry({}));
          markDirty('landing');
        });
