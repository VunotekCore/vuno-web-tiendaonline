---
import AdminLayout from "../_layout.astro";
import VariantsMatrix from "../../../components/admin/VariantsMatrix.astro";

const allSizes = ["36", "37", "38", "39", "40", "41"];
const allColors = [
  { name: "Noir", hex: "#1A1A1A" },
  { name: "White", hex: "#FFFFFF" },
  { name: "Nude", hex: "#E6DED5" },
  { name: "Arcilla", hex: "#C18C7E" },
];

const tabs = [
  { id: "info", label: "Información", icon: "description" },
  { id: "pricing", label: "Precio & Categoría", icon: "sell" },
  { id: "images", label: "Imágenes", icon: "photo_library" },
  { id: "variants", label: "Variantes", icon: "palette" },
];
---

<AdminLayout title="Editar Producto" currentPath="/admin/productos">
  <div id="loading" class="font-body text-body-md text-secondary p-4">Cargando producto...</div>

  <form id="productForm" class="hidden max-w-2xl">
    <input type="hidden" id="fieldId" />

    <!-- Tabs -->
    <div class="border-b border-outline-variant mb-8 overflow-x-auto">
      <div class="flex gap-1 min-w-max">
        {tabs.map(t => (
          <button
            type="button"
            class="tab-btn px-4 py-3 font-label-caps text-label-caps text-secondary hover:text-monolith-black border-b-2 border-transparent hover:border-monolith-black/30 transition-all whitespace-nowrap flex items-center gap-1.5"
            data-tab={t.id}
          >
            <span class="material-symbols-outlined text-lg">{t.icon}</span>
            {t.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Tab: Información -->
    <div id="tab-info" class="tab-content">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">description</span>
          Información del Producto
        </h2>
        <div class="space-y-6">
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">NOMBRE DEL PRODUCTO</label>
            <div class="relative">
              <input type="text" id="fieldName" required maxlength="255" class="w-full bg-transparent border-b border-outline pb-2 pr-16 text-monolith-black focus:border-clay-accent focus:outline-none text-lg transition-colors" />
              <span id="nameCounter" class="absolute right-0 bottom-2 text-xs font-body text-secondary pointer-events-none">0/255</span>
            </div>
            <div id="slugPreview" class="font-body text-body-sm text-secondary mt-1 hidden">
              <span class="text-clay-accent">/producto/</span><span id="slugText"></span>
            </div>
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">DESCRIPCIÓN</label>
            <div class="relative">
              <textarea id="fieldDescription" class="w-full bg-transparent border border-outline p-3 pb-8 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-32"></textarea>
              <span id="descCounter" class="absolute right-2 bottom-2 text-xs font-body text-secondary pointer-events-none">0 caracteres</span>
            </div>
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">DETALLES (uno por línea)</label>
            <textarea id="fieldDetails" class="w-full bg-transparent border border-outline p-3 text-monolith-black focus:border-clay-accent focus:outline-none resize-none h-24"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: Precio & Categoría -->
    <div id="tab-pricing" class="tab-content hidden">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">sell</span>
          Precio y Categoría
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">PRECIO (USD)</label>
            <input type="number" step="0.01" id="fieldPrice" required class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-monolith-black focus:outline-none" />
          </div>
          <div>
            <label class="font-label-caps text-label-caps text-secondary block mb-2">CATEGORÍA</label>
            <select id="fieldCategory" class="w-full bg-transparent border-b border-outline pb-2 text-monolith-black focus:border-monolith-black focus:outline-none">
              <option value="" disabled selected>Cargando...</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: Imágenes -->
    <div id="tab-images" class="tab-content hidden">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <h2 class="font-headline text-headline-md mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-xl">photo_library</span>
          Imágenes del Producto
        </h2>
        <div id="imageUploadZone" class="border-2 border-dashed border-outline-variant rounded-sm p-8 text-center cursor-pointer hover:border-monolith-black transition-colors bg-white mb-4">
          <span class="material-symbols-outlined text-4xl text-secondary mb-2 block">cloud_upload</span>
          <p class="font-body text-body-md text-secondary mb-1">Arrastra imágenes aquí o haz clic para seleccionar</p>
          <p class="font-body text-body-md text-secondary text-sm">JPG, PNG, WebP · Máximo 5MB cada una</p>
          <input type="file" id="imageInput" accept="image/jpeg,image/png,image/webp" multiple class="hidden" />
        </div>
        <div class="flex items-center justify-between mb-4">
          <div id="imageCounter" class="font-body text-body-sm text-secondary">0/5 imágenes</div>
        </div>
        <div id="imagePreviewList" class="grid grid-cols-2 md:grid-cols-4 gap-4"></div>
      </div>
    </div>

    <!-- Tab: Variantes -->
    <div id="tab-variants" class="tab-content hidden">
      <div class="bg-off-white border border-outline-variant shadow-sm rounded-sm p-6">
        <VariantsMatrix id="edit" colors={allColors} sizes={allSizes} />
      </div>
    </div>

    <!-- Submit -->
    <div class="mt-8 pt-6 border-t border-outline-variant flex items-center gap-4">
      <button type="submit" id="submitBtn" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-12 px-8 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
        <span class="material-symbols-outlined text-lg" id="submitIcon">save</span>
        <span id="submitText">GUARDAR CAMBIOS</span>
      </button>
      <a href="/admin/productos" class="font-label-caps text-label-caps text-secondary hover:text-monolith-black transition-colors">CANCELAR</a>
    </div>
  </form>

  <div id="error" class="hidden font-body text-body-md text-error bg-error/10 p-3 rounded-sm"></div>

  <script>
    // @ts-nocheck
    const allSizes = ["36", "37", "38", "39", "40", "41"];

    // --- Tab switching ---
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach(b => {
          b.classList.remove("text-monolith-black", "border-monolith-black");
          b.classList.add("text-secondary", "border-transparent");
        });
        btn.classList.remove("text-secondary", "border-transparent");
        btn.classList.add("text-monolith-black", "border-monolith-black");

        document.querySelectorAll(".tab-content").forEach(tc => tc.classList.add("hidden"));
        document.getElementById("tab-" + btn.dataset.tab).classList.remove("hidden");
      });
    });

    // --- Slug auto-preview ---
    function slugify(text) {
      return text.toLowerCase()
        .replace(/[^\w\s-]/g, "")
        .replace(/[\s_]+/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, "")
        .substring(0, 80);
    }
    document.getElementById("fieldName").addEventListener("input", function () {
      const preview = document.getElementById("slugPreview");
      const slugText = document.getElementById("slugText");
      const slug = slugify(this.value);
      if (slug) {
        slugText.textContent = slug;
        preview.classList.remove("hidden");
      } else {
        preview.classList.add("hidden");
      }
    });

    // --- Viewer role guard ---
    if (window.adminRole === "viewer") {
      document.getElementById("productForm").innerHTML = '<div class="font-body text-body-md text-error bg-error/10 p-4 rounded-sm">No tienes permisos para editar productos.</div>';
    }

    // --- Image Upload ---
    const MAX_IMAGES = 5;
    const uploadedImages = [];
    const imageInput = document.getElementById("imageInput");
    const imageZone = document.getElementById("imageUploadZone");
    const imagePreviewList = document.getElementById("imagePreviewList");
    const imageCounter = document.getElementById("imageCounter");

    function updateImageUI() {
      const count = uploadedImages.length;
      const remaining = MAX_IMAGES - count;
      imageCounter.textContent = count + "/" + MAX_IMAGES + " imágenes";
      if (remaining <= 0) {
        imageZone.style.pointerEvents = "none";
        imageZone.style.opacity = "0.4";
      } else {
        imageZone.style.pointerEvents = "";
        imageZone.style.opacity = "";
      }
    }

    function addImages(newImages) {
      const remaining = MAX_IMAGES - uploadedImages.length;
      if (remaining <= 0) {
        window.VunoModal.alert({
          type: "warning",
          title: "Límite de imágenes",
          message: "Máximo " + MAX_IMAGES + " imágenes permitidas por producto.",
        });
        return [];
      }
      return newImages.slice(0, remaining);
    }

    function showUploadSuccess(name) {
      window.VunoToast.success("Imagen subida", name);
    }

    function showUploadError(fileName, message) {
      window.VunoModal.alert({
        type: "error",
        title: "Error al subir imagen",
        message: fileName + ": " + message,
      });
    }

    function renderImagePreviews() {
      if (!uploadedImages.length) {
        imagePreviewList.innerHTML = '<p class="font-body text-body-md text-secondary col-span-full text-center py-4">No hay imágenes subidas</p>';
        updateImageUI();
        return;
      }
      imagePreviewList.innerHTML = uploadedImages.map((img, i) => `
        <div class="relative group border border-outline-variant rounded-sm overflow-hidden bg-white">
          <img src="${img.url}" alt="${img.name}" class="w-full h-32 object-cover" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-center justify-center">
            <button type="button" class="delete-image-btn opacity-0 group-hover:opacity-100 bg-error text-off-white rounded-full w-8 h-8 flex items-center justify-center transition-all" data-index="${i}">
              <span class="material-symbols-outlined text-sm">close</span>
            </button>
          </div>
          <p class="text-xs truncate px-2 py-1 text-secondary">${img.name}</p>
        </div>
      `).join("");

      document.querySelectorAll(".delete-image-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.dataset.index);
          uploadedImages.splice(idx, 1);
          renderImagePreviews();
        });
      });
      updateImageUI();
    }

    async function uploadFile(file) {
      if (uploadedImages.length >= MAX_IMAGES) {
        window.VunoModal.alert({
          type: "warning",
          title: "Límite de imágenes",
          message: "Máximo " + MAX_IMAGES + " imágenes alcanzado. Elimina alguna antes de subir más.",
        });
        return;
      }
      const formData = new FormData();
      formData.append("file", file);
      formData.append("folder", "products");
      try {
        const res = await fetch("/api/imagekit/upload.php", { method: "POST", body: formData });
        const data = await res.json();
        if (!res.ok) {
          const isImageKit = res.status >= 500 || (data.error || "").toLowerCase().includes("imagekit");
          showUploadError(
            file.name,
            isImageKit
              ? "El servicio de ImageKit no respondió correctamente. Intenta de nuevo en unos segundos."
              : (data.error || "Error desconocido")
          );
          return;
        }
        uploadedImages.push({ url: data.url, name: data.name || file.name, fileId: data.fileId });
        renderImagePreviews();
        showUploadSuccess(data.name || file.name);
      } catch (err) {
        showUploadError(file.name, "Sin conexión con el servicio de imágenes. Verifica tu red.");
      }
    }

    imageInput.addEventListener("change", () => {
      const allowed = addImages(Array.from(imageInput.files));
      allowed.forEach(f => uploadFile(f));
      imageInput.value = "";
    });

    imageZone.addEventListener("click", () => {
      if (uploadedImages.length < MAX_IMAGES) imageInput.click();
    });

    imageZone.addEventListener("dragover", (e) => {
      if (uploadedImages.length >= MAX_IMAGES) return;
      e.preventDefault();
      imageZone.classList.add("border-monolith-black", "bg-monolith-black/5");
    });
    imageZone.addEventListener("dragleave", () => {
      imageZone.classList.remove("border-monolith-black", "bg-monolith-black/5");
    });
    imageZone.addEventListener("drop", (e) => {
      e.preventDefault();
      imageZone.classList.remove("border-monolith-black", "bg-monolith-black/5");
      const allowed = addImages(Array.from(e.dataTransfer.files).filter(f => f.type.startsWith("image/")));
      allowed.forEach(f => uploadFile(f));
    });

    renderImagePreviews();

    // --- Char counters ---
    const NAME_MAX = 255;

    function setupCharCount(inputId, counterId, max) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(counterId);
      if (!input || !counter) return;
      function update() {
        const len = input.value.length;
        counter.textContent = len + "/" + max;
        counter.className = "absolute right-0 bottom-2 text-xs font-body pointer-events-none transition-colors duration-200 " +
          (len >= max ? "text-error" : len >= max * 0.8 ? "text-clay-accent" : "text-secondary");
      }
      input.addEventListener("input", update);
      update();
    }

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Guardando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "save";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    document.getElementById("submitIcon").dataset.origIcon = "save";

    // --- Load product + categories ---
    (async function () {
      const params = new URLSearchParams(window.location.search);
      const productId = params.get("id");

      if (!productId) {
        document.getElementById("loading").textContent = "No product ID specified.";
        return;
      }

      // Load categories first
      try {
        const catRes = await fetch("/api/categorias/list.php");
        const data = await catRes.json();
        const cats = data.items || [];
        const select = document.getElementById("fieldCategory");
        select.innerHTML = cats.map(c => `<option value="${c.name}">${c.name}</option>`).join("") || '<option value="" disabled>No categories</option>';
      } catch {
        document.getElementById("fieldCategory").innerHTML = '<option value="" disabled>Error loading</option>';
      }

      try {
        const res = await fetch("/api/productos/get.php?id=" + encodeURIComponent(productId));
        if (!res.ok) throw new Error("Product not found");
        const p = await res.json();

        document.getElementById("fieldId").value = p.id;
        document.getElementById("fieldName").value = p.name;
        document.getElementById("fieldDescription").value = p.description || "";
        document.getElementById("fieldDetails").value = (p.details || []).join("\n");
        document.getElementById("fieldPrice").value = p.price;
        if (p.category) {
          const opt = document.getElementById("fieldCategory").querySelector(`option[value="${p.category}"]`);
          if (opt) document.getElementById("fieldCategory").value = p.category;
        }

        // Variants: populate stock matrix
        const initialStocks = {};
        (p.variants || []).forEach(v => {
          initialStocks[v.color_name + "_" + v.size_value] = v.stock;
        });
        if (window.stockMatrix?.edit) {
          if (typeof p.lowStockThreshold === "number") {
            const thresholdInput = document.querySelector('[data-vm="threshold"]');
            if (thresholdInput) {
              thresholdInput.value = p.lowStockThreshold;
              thresholdInput.dispatchEvent(new Event("input", { bubbles: true }));
            }
          }
          window.stockMatrix.edit.setInitial(initialStocks);
        }

        // Images: load existing
        (p.images || []).forEach(url => {
          uploadedImages.push({ url, name: url.split("/").pop() || "image", fileId: "" });
        });
        renderImagePreviews();

        // Init char counters with loaded values
        setupCharCount("fieldName", "nameCounter", NAME_MAX);
        document.getElementById("fieldDescription").addEventListener("input", function() {
          document.getElementById("descCounter").textContent = this.value.length + " caracteres";
        });
        document.getElementById("descCounter").textContent = (p.description || "").length + " caracteres";

        document.getElementById("loading").classList.add("hidden");
        document.getElementById("productForm").classList.remove("hidden");
        document.querySelector(".tab-btn")?.click();
      } catch (err) {
        document.getElementById("loading").textContent = "Error loading product.";
        document.getElementById("error").textContent = err.message;
        document.getElementById("error").classList.remove("hidden");
      }
    })();

    // --- Submit ---
    document.getElementById("productForm").addEventListener("submit", async (e) => {
      e.preventDefault();

      const allColors = [{"name":"Noir","hex":"#1A1A1A"},{"name":"White","hex":"#FFFFFF"},{"name":"Nude","hex":"#E6DED5"},{"name":"Arcilla","hex":"#C18C7E"}];
      const allSizes = ["36","37","38","39","40","41"];

      const details = document.getElementById("fieldDetails").value
        .split("\n").map(l => l.trim()).filter(Boolean);

      const matrixPayload = window.stockMatrix?.edit?.toPayload() || { stocks: {}, activeColors: [], threshold: 5 };
      const colors = matrixPayload.activeColors.length ? matrixPayload.activeColors : allColors;

      const payload = {
        id: document.getElementById("fieldId").value,
        name: document.getElementById("fieldName").value,
        description: document.getElementById("fieldDescription").value,
        details: details.length ? details : null,
        price: parseFloat(document.getElementById("fieldPrice").value),
        category: document.getElementById("fieldCategory").value,
        colors,
        sizes: allSizes.map(s => ({ label: s, value: s })),
        stocks: matrixPayload.stocks,
        lowStockThreshold: matrixPayload.threshold,
        images: uploadedImages.map(i => i.url),
      };

      setLoading("submitBtn", "submitIcon", "submitText", true, "Guardando...");
      try {
        const res = await fetch("/api/productos/update.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error al guardar el producto");
        setLoading("submitBtn", "submitIcon", "submitText", false);
        window.VunoToast.success("Producto actualizado", "Los cambios se han guardado correctamente.");
      } catch (err) {
        setLoading("submitBtn", "submitIcon", "submitText", false);
        window.VunoModal.alert({
          type: "error",
          title: "Error al guardar",
          message: err.message || "No se pudo actualizar el producto. Intenta de nuevo.",
        });
      }
    });
  </script>
</AdminLayout>
