---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Blog" currentPath="/admin/blog">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
    <div class="flex items-center gap-4 w-full md:w-auto">
      <div class="relative flex-1 md:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <input type="text" id="searchInput" placeholder="Buscar posts..." class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md" />
      </div>
      <select id="statusFilter" class="h-10 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md">
        <option value="">Todos</option>
        <option value="published">Publicado</option>
        <option value="draft">Borrador</option>
      </select>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="postCount">0 posts</p>
    </div>
    <div class="flex gap-2">
      <a href="/admin/blog/nuevo" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 shrink-0">
        <span class="material-symbols-outlined text-lg">add</span>
        NUEVO POST
      </a>
    </div>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">TÍTULO</th>
            <th class="p-4 font-medium">AUTOR</th>
            <th class="p-4 font-medium">CATEGORÍA</th>
            <th class="p-4 font-medium">ESTADO</th>
            <th class="p-4 font-medium">FECHA</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="postsTableBody">
          <tr>
            <td colspan="6" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="pagination" class="flex items-center justify-center gap-2 p-4 border-t border-outline-variant"></div>
  </div>

  <!-- Mobile cards -->
  <div id="mobileCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-error">warning</span>
        <h3 class="font-headline text-headline-md">Eliminar Post</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-4 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 transition-all">ELIMINAR</button>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 10;
    let currentPage = 1;
    let posts = [];
    let deleteId = null;

    async function loadPosts(page) {
      currentPage = page;
      const status = document.getElementById("statusFilter").value;
      const search = document.getElementById("searchInput").value.trim();
      let url = `/api/blog/list.php?page=${page}&limit=${PAGE_LIMIT}`;
      if (status) url += `&status=${status}`;
      if (search) url += `&search=${encodeURIComponent(search)}`;

      try {
        const res = await fetch(url);
        const data = await res.json();
        posts = data.items || [];
        document.getElementById("postCount").textContent = data.total + " posts";
        renderTable(posts);
        renderPagination(data.pages || 1);
        renderMobileCards(posts);
      } catch {
        document.getElementById("postsTableBody").innerHTML = '<tr><td colspan="6" class="p-8 text-center text-error">Error loading posts</td></tr>';
      }
    }

    function renderTable(items) {
      const tbody = document.getElementById("postsTableBody");
      if (!items.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center font-body text-body-md text-secondary">No posts found</td></tr>';
        return;
      }
      tbody.innerHTML = items.map(p => {
        const badgeClass = p.status === "published" ? "bg-monolith-black text-off-white" : "bg-monolith-black/10 text-monolith-black";
        const date = p.published_at ? new Date(p.published_at).toLocaleDateString() : (p.created_at ? new Date(p.created_at).toLocaleDateString() : "-");
        return `<tr class="border-t border-outline-variant hover:bg-monolith-black/[0.02] transition-colors">
          <td class="p-4 font-body text-body-md text-monolith-black font-medium max-w-xs truncate">${p.title || "Untitled"}</td>
          <td class="p-4 font-body text-body-md text-secondary">${p.author || "—"}</td>
          <td class="p-4 font-body text-body-md text-secondary">${p.category_name || "—"}</td>
          <td class="p-4"><span class="inline-block font-label-caps text-label-caps px-2 py-1 rounded-sm ${badgeClass}">${p.status}</span></td>
          <td class="p-4 font-body text-body-md text-secondary">${date}</td>
          <td class="p-4">
            <div class="flex items-center gap-2">
              <a href="/admin/blog/editar?id=${p.id}" class="material-symbols-outlined text-lg text-secondary hover:text-monolith-black transition-colors cursor-pointer">edit</a>
              <span class="material-symbols-outlined text-lg text-secondary hover:text-error transition-colors cursor-pointer" onclick="confirmDelete(${p.id}, '${p.title.replace(/'/g, "\\'")}')">delete</span>
            </div>
          </td>
        </tr>`;
      }).join("");
    }

    function renderMobileCards(items) {
      const container = document.getElementById("mobileCards");
      if (!items.length) {
        container.innerHTML = '<p class="font-body text-body-md text-secondary p-4">No posts found</p>';
        return;
      }
      container.innerHTML = items.map(p => {
        const badgeClass = p.status === "published" ? "bg-monolith-black text-off-white" : "bg-monolith-black/10 text-monolith-black";
        return `<div class="bg-off-white border border-outline-variant rounded-sm p-4">
          <div class="flex justify-between items-start mb-2">
            <h3 class="font-body text-body-md text-monolith-black font-medium truncate">${p.title || "Untitled"}</h3>
            <span class="font-label-caps text-label-caps px-2 py-0.5 rounded-sm shrink-0 ${badgeClass}">${p.status}</span>
          </div>
          <p class="font-body text-body-sm text-secondary mb-3">${p.author || "—"} · ${p.category_name || "Sin categoría"}</p>
          <div class="flex items-center gap-3">
            <a href="/admin/blog/editar?id=${p.id}" class="flex items-center gap-1 font-label-caps text-label-caps text-monolith-black hover:text-secondary transition-colors">
              <span class="material-symbols-outlined text-lg">edit</span> EDITAR
            </a>
            <span class="flex items-center gap-1 font-label-caps text-label-caps text-error cursor-pointer hover:text-error/80 transition-colors" onclick="confirmDelete(${p.id}, '${p.title.replace(/'/g, "\\'")}')">
              <span class="material-symbols-outlined text-lg">delete</span> ELIMINAR
            </span>
          </div>
        </div>`;
      }).join("");
    }

    function renderPagination(totalPages) {
      const container = document.getElementById("pagination");
      if (totalPages <= 1) { container.innerHTML = ""; return; }
      let html = "";
      for (let i = 1; i <= totalPages; i++) {
        html += `<button class="px-3 py-1 font-body text-body-md rounded-sm transition-colors ${i === currentPage ? 'bg-monolith-black text-off-white' : 'text-secondary hover:text-monolith-black hover:bg-monolith-black/5'}" onclick="loadPosts(${i})">${i}</button>`;
      }
      container.innerHTML = html;
    }

    function confirmDelete(id, name) {
      deleteId = id;
      document.getElementById("deleteItemName").textContent = name;
      document.getElementById("deleteModal").classList.remove("hidden");
    }

    document.getElementById("deleteCancelBtn").addEventListener("click", () => document.getElementById("deleteModal").classList.add("hidden"));
    document.getElementById("deleteConfirmBtn").addEventListener("click", async () => {
      if (!deleteId) return;
      try {
        const res = await fetch("/api/blog/delete.php", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: deleteId }) });
        if (!res.ok) throw new Error("Delete failed");
        document.getElementById("deleteModal").classList.add("hidden");
        loadPosts(currentPage);
      } catch (err) {
        window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: err.message || "Error deleting post" });
      }
    });

    document.getElementById("statusFilter").addEventListener("change", () => loadPosts(1));
    document.getElementById("searchInput").addEventListener("input", () => loadPosts(1));

    loadPosts(1);
  </script>
</AdminLayout>
