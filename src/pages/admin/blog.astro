---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Blog" currentPath="/admin/blog">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-4 w-full md:w-auto">
      <div class="relative flex-1 md:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <input type="text" id="searchInput" placeholder="Buscar posts..." aria-label="Buscar posts" class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md focus-visible:ring-2 focus-visible:ring-monolith-black" />
      </div>
      <select id="statusFilter" aria-label="Filtrar por estado" class="h-10 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md focus-visible:ring-2 focus-visible:ring-monolith-black">
        <option value="">Todos</option>
        <option value="published">Publicado</option>
        <option value="draft">Borrador</option>
      </select>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="postCount">0 posts</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
      <a href="/admin/blog/nuevo" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 shrink-0 w-full sm:w-auto">
        <span class="material-symbols-outlined text-lg">add</span>
        NUEVO POST
      </a>
    </div>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">TÍTULO</th>
            <th class="p-4 font-medium">AUTOR</th>
            <th class="p-4 font-medium">CATEGORÍA</th>
            <th class="p-4 font-medium">ESTADO</th>
            <th class="p-4 font-medium">FECHA</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="postsTableBody">
          <tr>
            <td colspan="6" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="pagination" class="flex items-center justify-center gap-2 p-4 border-t border-outline-variant"></div>
  </div>

  <!-- Mobile cards -->
  <div id="mobileCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-error">warning</span>
        <h3 id="deleteModalTitle" class="font-headline text-headline-md">Eliminar Post</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <p class="font-body text-body-md text-xs text-error/70 mb-6 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">info</span>
        Esta acción no se puede deshacer.
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="deleteIcon">delete</span>
          <span id="deleteBtnText">ELIMINAR</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #deleteModal:not(.hidden) {
      display: flex;
    }
  </style>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 10;
    let currentPage = 1;
    let posts = [];
    let deleteId = null;
    let searchTimeout = null;

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Procesando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "delete";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove("hidden");
      el.classList.add("flex");
      const content = el.querySelector(".modal-content");
      if (content) {
        content.style.animation = "none";
        void content.offsetHeight;
        content.style.animation = "";
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add("hidden");
      el.classList.remove("flex");
    }

    async function loadPosts(page) {
      currentPage = page;
      const status = document.getElementById("statusFilter").value;
      const search = document.getElementById("searchInput").value.trim();
      let url = `/api/blog/list.php?page=${page}&limit=${PAGE_LIMIT}`;
      if (status) url += `&status=${status}`;
      if (search) url += `&search=${encodeURIComponent(search)}`;

      try {
        const res = await fetch(url);
        const data = await res.json();
        posts = data.items || [];
        document.getElementById("postCount").textContent = data.total + " posts";
        renderTable(posts);
        renderPagination(data.pages || 1);
        renderMobileCards(posts);
      } catch {
        document.getElementById("postsTableBody").innerHTML = '<tr><td colspan="6" class="p-8 text-center text-error">Error loading posts</td></tr>';
      }
    }

    function renderTable(items) {
      const tbody = document.getElementById("postsTableBody");
      if (!items.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-12 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-5xl text-secondary/30">article</span><p class="font-body text-body-md text-secondary">No hay posts aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primer post para empezar</p></div></td></tr>';
        return;
      }
      tbody.innerHTML = items.map(p => {
        const badgeClass = p.status === "published" ? "bg-monolith-black text-off-white" : "bg-monolith-black/10 text-monolith-black";
        const date = p.published_at ? new Date(p.published_at).toLocaleDateString() : (p.created_at ? new Date(p.created_at).toLocaleDateString() : "-");
        return `<tr class="border-t border-outline-variant hover:bg-monolith-black/[0.02] transition-colors border-l-2 border-l-transparent hover:border-l-clay-accent/50">
          <td class="p-4 font-body text-body-md text-monolith-black font-medium max-w-xs truncate">${p.title || "Untitled"}</td>
          <td class="p-4 font-body text-body-md text-secondary">${p.author || "—"}</td>
          <td class="p-4 font-body text-body-md text-secondary">${p.category_name || "—"}</td>
          <td class="p-4"><span class="inline-block font-label-caps text-label-caps px-2 py-1 rounded-sm ${badgeClass}">${p.status}</span></td>
          <td class="p-4 font-body text-body-md text-secondary">${date}</td>
           <td class="p-4">
             <div class="flex gap-2">
               <a href="/admin/blog/editar?id=${p.id}" class="inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm">
                 <span class="material-symbols-outlined text-sm">edit</span>
                 EDITAR
               </a>
               <span class="inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm cursor-pointer" onclick="confirmDelete(${p.id}, '${p.title.replace(/'/g, "\\'")}')">
                 <span class="material-symbols-outlined text-sm">delete</span>
                 ELIMINAR
               </span>
             </div>
           </td>
        </tr>`;
      }).join("");
    }

    function renderMobileCards(items) {
      const container = document.getElementById("mobileCards");
      if (!items.length) {
        container.innerHTML = '<div class="flex flex-col items-center gap-3 p-12 text-center"><span class="material-symbols-outlined text-5xl text-secondary/30">article</span><p class="font-body text-body-md text-secondary">No hay posts aún</p><p class="font-body text-body-sm text-secondary/60">Crea tu primer post para empezar</p></div>';
        return;
      }
      container.innerHTML = items.map(p => {
        const badgeClass = p.status === "published" ? "bg-monolith-black text-off-white" : "bg-monolith-black/10 text-monolith-black";
        return `<div class="bg-off-white border border-outline-variant rounded-sm p-4 border-l-2 border-l-transparent hover:border-l-clay-accent/50 transition-all duration-200">
          <div class="flex justify-between items-start mb-2">
            <h3 class="font-body text-body-md text-monolith-black font-medium truncate">${p.title || "Untitled"}</h3>
            <span class="font-label-caps text-label-caps px-2 py-0.5 rounded-sm shrink-0 ${badgeClass}">${p.status}</span>
          </div>
          <p class="font-body text-body-sm text-secondary mb-3">${p.author || "—"} · ${p.category_name || "Sin categoría"}</p>
          <div class="flex gap-2">
            <a href="/admin/blog/editar?id=${p.id}" class="flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm">
              <span class="material-symbols-outlined text-sm">edit</span> EDITAR
            </a>
            <span class="flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm cursor-pointer" onclick="confirmDelete(${p.id}, '${p.title.replace(/'/g, "\\'")}')">
              <span class="material-symbols-outlined text-sm">delete</span> ELIMINAR
            </span>
          </div>
        </div>`;
      }).join("");
    }

    function renderPagination(totalPages) {
      const container = document.getElementById("pagination");
      if (totalPages <= 1) { container.innerHTML = ""; return; }
      let html = '<button class="w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + ' onclick="loadPosts(' + (currentPage - 1) + ')"><span class="material-symbols-outlined text-sm">chevron_left</span></button>';
      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant text-secondary hover:border-monolith-black hover:text-monolith-black';
        html += `<button class="w-9 h-9 flex items-center justify-center border rounded-sm transition-all font-body text-body-md text-sm ${active}" onclick="loadPosts(${i})">${i}</button>`;
      }
      html += '<button class="w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + ' onclick="loadPosts(' + (currentPage + 1) + ')"><span class="material-symbols-outlined text-sm">chevron_right</span></button>';
      container.innerHTML = html;
    }

    function confirmDelete(id, name) {
      deleteId = id;
      document.getElementById("deleteItemName").textContent = name;
      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
      openModal("deleteModal");
    }

    document.getElementById("deleteCancelBtn").addEventListener("click", () => closeModal("deleteModal"));
    document.getElementById("deleteModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeModal("deleteModal");
    });
    document.getElementById("deleteConfirmBtn").addEventListener("click", async () => {
      if (!deleteId) return;
      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", true, "Eliminando...");
      try {
        const res = await fetch("/api/blog/delete.php", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: deleteId }) });
        if (!res.ok) throw new Error("Delete failed");
        closeModal("deleteModal");
        loadPosts(currentPage);
      } catch (err) {
        setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
        window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: err.message || "Error deleting post" });
      }
    });

    document.getElementById("statusFilter").addEventListener("change", () => loadPosts(1));
    document.getElementById("searchInput").addEventListener("input", () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => loadPosts(1), 300);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !document.getElementById("deleteModal").classList.contains("hidden")) {
        closeModal("deleteModal");
      }
    });

    // --- Init ---
    document.getElementById("deleteIcon").dataset.origIcon = "delete";
    loadPosts(1);
  </script>
</AdminLayout>
