---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { verifyToken } from "../../lib/admin";
import { getTokenFromCookies } from "../../lib/cookie";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const token = getTokenFromCookies(Astro.request.headers.get("cookie"));
const user = token ? verifyToken(token) : null;

if (!user) {
  return Astro.redirect("/admin/login");
}

const adminLinks = [
  { label: "PRODUCTOS", href: "/admin/productos" },
  { label: "PEDIDOS", href: "/admin/pedidos" },
];
---

<BaseLayout title={`${title} | Admin | Ram;Lop`}>
  <div class="min-h-screen flex flex-col bg-background">
    <nav class="bg-monolith-black text-off-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex items-center justify-between h-14">
        <div class="flex items-center gap-8">
          <a href="/admin/productos" class="font-headline text-headline-md tracking-tighter">Ram;Lop</a>
          <span class="font-label-caps text-label-caps text-stone-gray">ADMIN</span>
        </div>
        <div class="flex items-center gap-6 font-label-caps text-label-caps">
          {adminLinks.map((link) => (
            <a
              href={link.href}
              class={`transition-colors ${currentPath === link.href ? "text-off-white" : "hover:text-off-white/70"}`}
            >
              {link.label}
            </a>
          ))}
          <a href="/" class="text-stone-gray hover:text-off-white transition-colors">SITIO</a>
          <a href="/api/admin/logout" class="text-stone-gray hover:text-error transition-colors">SALIR</a>
        </div>
      </div>
    </nav>

    <div class="border-b border-outline-variant bg-off-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-4">
        <h1 class="font-headline text-headline-md text-monolith-black">{title}</h1>
      </div>
    </div>

    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8 flex-grow">
      <slot />
    </div>
  </div>
</BaseLayout>
