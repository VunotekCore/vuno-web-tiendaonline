---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Dashboard" currentPath="/admin">
  <div id="loading" class="font-body text-body-md text-secondary p-4">Loading dashboard...</div>

  <div id="dashboardContent" class="hidden space-y-8">
    <!-- Stats cards -->
    <div id="statsCards" class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6"></div>

    <!-- Charts / secondary -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Recent orders -->
      <div class="bg-off-white border border-outline-variant">
        <div class="px-6 py-4 border-b border-outline-variant/50">
          <h2 class="font-headline text-headline-md">Pedidos Recientes</h2>
        </div>
        <div id="recentOrders" class="p-4">
          <p class="font-body text-body-md text-secondary">No recent orders.</p>
        </div>
      </div>

      <!-- Stock alerts -->
      <div class="bg-off-white border border-outline-variant">
        <div class="px-6 py-4 border-b border-outline-variant/50">
          <h2 class="font-headline text-headline-md">Alertas de Stock</h2>
        </div>
        <div id="stockAlerts" class="p-4">
          <p class="font-body text-body-md text-secondary">All products well stocked.</p>
        </div>
      </div>
    </div>
  </div>

  <div id="error" class="hidden font-body text-body-md text-error bg-error/10 p-3"></div>

  <script>
    // @ts-nocheck
    (async function () {
      try {
        const res = await fetch("/api/dashboard/stats.php");
        if (!res.ok) throw new Error("Failed to load stats");
        const stats = await res.json();

        // Cards
        const cards = [
          { label: "Productos", value: stats.totalProducts || 0, icon: "inventory_2" },
          { label: "Pedidos Total", value: stats.totalOrders || 0, icon: "receipt_long" },
          { label: "Ingresos del Mes", value: (stats.displaySymbol || "$") + ((stats.displayMonthlyRevenue ?? stats.monthlyRevenue) || 0).toFixed(2), icon: "trending_up" },
          { label: "Pedidos del Mes", value: stats.monthlyOrderCount || 0, icon: "shopping_cart" },
        ];

        document.getElementById("statsCards").innerHTML = cards.map(c => `
          <div class="bg-off-white border border-outline-variant p-5 flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="font-label-caps text-label-caps text-secondary">${c.label}</span>
              <span class="material-symbols-outlined text-xl text-secondary">${c.icon}</span>
            </div>
            <span class="font-headline text-headline-lg text-monolith-black">${c.value}</span>
          </div>
        `).join("");

        // Recent orders
        const orders = stats.recentOrders || [];
        const ordersEl = document.getElementById("recentOrders");
        if (orders.length > 0) {
          ordersEl.innerHTML = orders.map(o => `
            <div class="flex items-center justify-between py-3 border-b border-outline-variant/30 last:border-0">
              <div>
                <a href="/admin/pedidos/detalle?id=${encodeURIComponent(o.id)}" class="font-body text-body-md text-monolith-black hover:underline">${o.id}</a>
                <p class="font-body text-body-md text-secondary text-sm">${o.customerName || '—'}</p>
              </div>
              <div class="text-right">
                <span class="font-price-display text-price-display text-sm">${o.displaySymbol || '$'}${((o.displayTotal ?? o.total) || 0).toFixed(2)}</span>
                <span class="font-label-caps text-label-caps text-xs text-secondary block capitalize">${o.status}</span>
              </div>
            </div>
          `).join("");
        } else {
          ordersEl.innerHTML = '<p class="font-body text-body-md text-secondary">No recent orders.</p>';
        }

        // Stock alerts
        const lowStock = stats.lowStockProducts || [];
        const stockEl = document.getElementById("stockAlerts");
        if (lowStock.length > 0) {
          stockEl.innerHTML = lowStock.map(p => {
            const inStock = (p.sizes || []).filter(s => s.inStock).length;
            return `
              <div class="flex items-center justify-between py-3 border-b border-outline-variant/30 last:border-0">
                <span class="font-body text-body-md text-monolith-black">${p.name}</span>
                <span class="font-label-caps text-label-caps text-xs ${inStock === 0 ? 'text-error' : 'text-clay-accent'}">
                  ${inStock === 0 ? 'AGOTADO' : inStock + ' talles'}
                </span>
              </div>
            `;
          }).join("");
        } else {
          stockEl.innerHTML = '<p class="font-body text-body-md text-secondary">All products well stocked.</p>';
        }

        document.getElementById("loading").classList.add("hidden");
        document.getElementById("dashboardContent").classList.remove("hidden");
      } catch (err) {
        document.getElementById("loading").textContent = "Error loading dashboard.";
        document.getElementById("error").textContent = err.message;
        document.getElementById("error").classList.remove("hidden");
      }
    })();
  </script>
</AdminLayout>
