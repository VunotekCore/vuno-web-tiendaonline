---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Suscriptores" currentPath="/admin/suscriptores">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div class="flex items-center gap-4 w-full sm:w-auto">
      <div class="relative flex-1 sm:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <input type="text" id="searchInput" placeholder="Buscar por email..." class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md" />
      </div>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="subscriberCount">0 suscriptores</p>
    </div>
    <a href="/api/suscriptores/export.php" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 shrink-0">
      <span class="material-symbols-outlined text-lg">download</span>
      EXPORTAR CSV
    </a>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">EMAIL</th>
            <th class="p-4 font-medium">FECHA SUSCRIPCIÓN</th>
            <th class="p-4 font-medium">ESTADO</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="subscribersBody">
          <tr><td colspan="4" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile cards -->
  <div id="subscriberCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="hidden mt-6 flex items-center justify-center gap-2"></div>

  <!-- Unsubscribe Modal -->
  <div id="unsubscribeModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-3xl text-clay-accent">contact_mail</span>
        <h3 class="font-headline text-headline-md">Desuscribir</h3>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de desuscribir a <strong id="unsubscribeEmail" class="text-monolith-black"></strong>?
      </p>
      <p class="font-body text-body-md text-xs text-secondary/70 mb-6 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">info</span>
        El suscriptor dejará de recibir correos del newsletter.
      </p>
      <div class="flex justify-end gap-3">
        <button id="unsubscribeCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="unsubscribeConfirmBtn" class="bg-clay-accent text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-clay-accent/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="unsubIcon">block</span>
          <span id="unsubBtnText">DESUSCRIBIR</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #unsubscribeModal:not(.hidden) {
      display: flex;
    }
  </style>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 10;
    let currentPage = 1;
    let totalSubscribers = 0;
    let searchTerm = "";
    let searchTimeout = null;
    let unsubscribeTargetId = null;
    let unsubscribeTargetEmail = "";

    // --- Loading state helpers ---
    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Procesando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    // --- Modal controls ---
    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove("hidden");
      el.classList.add("flex");
      const content = el.querySelector(".modal-content");
      if (content) {
        content.style.animation = "none";
        void content.offsetHeight;
        content.style.animation = "";
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add("hidden");
      el.classList.remove("flex");
    }

    function openUnsubModal(id, email) {
      unsubscribeTargetId = id;
      unsubscribeTargetEmail = email;
      document.getElementById("unsubscribeEmail").textContent = email;
      openModal("unsubscribeModal");
      setLoading("unsubscribeConfirmBtn", "unsubIcon", "unsubBtnText", false);
    }

    function closeUnsubModal() {
      closeModal("unsubscribeModal");
      unsubscribeTargetId = null;
      unsubscribeTargetEmail = "";
    }

    function formatDateOnly(d) {
      if (!d) return "—";
      return new Date(d).toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" });
    }

    function renderSubscribers(items) {
      const tbody = document.getElementById("subscribersBody");
      const cards = document.getElementById("subscriberCards");

      if (items.length === 0) {
        const emptyHtml =
          '<tr><td colspan="4" class="p-12 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-5xl text-secondary/30">contacts</span><p class="font-body text-body-md text-secondary">No hay suscriptores aún</p></div></td></tr>';
        tbody.innerHTML = emptyHtml;
        cards.innerHTML =
          '<div class="flex flex-col items-center gap-3 p-12 text-center"><span class="material-symbols-outlined text-5xl text-secondary/30">contacts</span><p class="font-body text-body-md text-secondary">No hay suscriptores aún</p></div>';
        return;
      }

      function statusBadge(s) {
        if (s.is_active) return '<span class="inline-flex items-center gap-1 px-2.5 py-1 font-label-caps text-label-caps bg-monolith-black text-off-white rounded-sm">ACTIVO</span>';
        return '<span class="inline-flex items-center gap-1 px-2.5 py-1 font-label-caps text-label-caps bg-monolith-black/10 text-secondary rounded-sm">INACTIVO</span>';
      }

      function actionButtons(s) {
        if (!s.is_active) return '<span class="font-body text-body-md text-secondary text-sm">—</span>';
        return `<button class="unsub-btn inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 border-clay-accent/30 text-secondary hover:border-clay-accent hover:text-clay-accent hover:bg-clay-accent/5" data-id="${s.id}" data-email="${s.email}">
          <span class="material-symbols-outlined text-sm">block</span>
          DESUSCRIBIR
        </button>`;
      }

      // Desktop rows
      tbody.innerHTML = items.map(s => `
        <tr class="border-b border-outline-variant/50 hover:bg-monolith-black/[0.02] transition-colors border-l-2 border-l-transparent hover:border-l-clay-accent/50">
          <td class="p-4">
            <span class="font-body text-body-md text-monolith-black">${s.email}</span>
          </td>
          <td class="p-4 font-body text-body-md text-secondary text-sm">${formatDateOnly(s.subscribed_at)}</td>
          <td class="p-4">${statusBadge(s)}</td>
          <td class="p-4">${actionButtons(s)}</td>
        </tr>
      `).join("");

      // Mobile cards
      cards.innerHTML = items.map(s => `
        <div class="bg-off-white border border-outline-variant border-l-2 border-l-monolith-black shadow-sm hover:shadow-md hover:border-l-clay-accent transition-all duration-200 rounded-sm p-4">
          <div class="flex items-center justify-between mb-2">
            <span class="font-body text-body-md text-monolith-black">${s.email}</span>
            ${statusBadge(s)}
          </div>
          <p class="font-body text-body-md text-secondary text-sm mb-3">Suscrito: ${formatDateOnly(s.subscribed_at)}</p>
          ${actionButtons(s)}
        </div>
      `).join("");

      // Unsubscribe handlers
      document.querySelectorAll(".unsub-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          openUnsubModal(parseInt(btn.dataset.id), btn.dataset.email);
        });
      });
    }

    function renderPagination() {
      const container = document.getElementById("pagination");
      const totalPages = Math.ceil(totalSubscribers / PAGE_LIMIT);

      if (totalPages <= 1) { container.classList.add("hidden"); return; }
      container.classList.remove("hidden");

      let html = '<button class="pag-prev w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + '><span class="material-symbols-outlined text-sm">chevron_left</span></button>';

      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant text-secondary hover:border-monolith-black hover:text-monolith-black';
        html += `<button class="pag-page w-9 h-9 flex items-center justify-center border rounded-sm transition-all font-body text-body-md text-sm ${active}" data-page="${i}">${i}</button>`;
      }

      html += '<button class="pag-next w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black hover:text-monolith-black transition-all font-body text-body-md text-secondary" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3;cursor:default;pointer-events:none"' : '') + '><span class="material-symbols-outlined text-sm">chevron_right</span></button>';

      container.innerHTML = html;

      container.querySelectorAll(".pag-page").forEach(btn => {
        btn.addEventListener("click", () => {
          currentPage = parseInt(btn.dataset.page);
          loadSubscribers();
        });
      });
      container.querySelector(".pag-prev")?.addEventListener("click", () => {
        if (currentPage <= 1) return;
        currentPage--;
        loadSubscribers();
      });
      container.querySelector(".pag-next")?.addEventListener("click", () => {
        const totalPages = Math.ceil(totalSubscribers / PAGE_LIMIT);
        if (currentPage >= totalPages) return;
        currentPage++;
        loadSubscribers();
      });
    }

    function searchSubscribers() {
      searchTerm = document.getElementById("searchInput").value.trim();
      currentPage = 1;
      loadSubscribers();
    }

    document.getElementById("searchInput").addEventListener("input", () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(searchSubscribers, 300);
    });

    async function loadSubscribers() {
      try {
        let url = `/api/suscriptores/list.php?limit=${PAGE_LIMIT}&page=${currentPage}`;
        if (searchTerm) url += `&search=${encodeURIComponent(searchTerm)}`;
        const res = await fetch(url);
        const data = await res.json();
        const items = data.items || [];
        totalSubscribers = data.total || items.length;

        document.getElementById("subscriberCount").textContent =
          Math.min((currentPage - 1) * PAGE_LIMIT + items.length, totalSubscribers) + " de " + totalSubscribers + " suscriptores";
        renderSubscribers(items);
        renderPagination();
      } catch (err) {
        document.getElementById("subscribersBody").innerHTML =
          `<tr><td colspan="4" class="p-8 text-center font-body text-body-md text-error">Error: ${err.message}</td></tr>`;
        document.getElementById("subscriberCards").innerHTML =
          `<p class="font-body text-body-md text-error p-4">Error: ${err.message}</p>`;
      }
    }

    // --- Unsubscribe handler ---
    document.getElementById("unsubscribeConfirmBtn").addEventListener("click", async () => {
      if (!unsubscribeTargetId) return;

      setLoading("unsubscribeConfirmBtn", "unsubIcon", "unsubBtnText", true, "Desuscribiendo...");
      try {
        const res = await fetch("/api/suscriptores/unsubscribe.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: unsubscribeTargetId }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error al desuscribir");

        closeUnsubModal();
        loadSubscribers();
      } catch (err) {
        setLoading("unsubscribeConfirmBtn", "unsubIcon", "unsubBtnText", false);
        window.VunoModal.alert({ type: "error", title: "Error", message: err.message });
      }
    });

    document.getElementById("unsubscribeCancelBtn").addEventListener("click", closeUnsubModal);
    document.getElementById("unsubscribeModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeUnsubModal();
    });

    // --- Global Escape key ---
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (!document.getElementById("unsubscribeModal").classList.contains("hidden")) closeUnsubModal();
      }
    });

    // --- Init ---
    document.getElementById("unsubIcon").dataset.origIcon = "block";

    loadSubscribers();
  </script>
</AdminLayout>
