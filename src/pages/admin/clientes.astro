---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Clientes" currentPath="/admin/clientes">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-4 w-full md:w-auto">
      <div class="relative flex-1 md:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <label for="searchInput" class="sr-only">Buscar clientes</label>
        <input type="text" id="searchInput" placeholder="Buscar clientes..." class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none focus-visible:ring-2 focus-visible:ring-monolith-black focus-visible:ring-offset-1 font-body text-body-md" />
      </div>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="customerCount" aria-live="polite" aria-atomic="true">0 clientes</p>
    </div>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">CLIENTE</th>
            <th class="p-4 font-medium">EMAIL</th>
            <th class="p-4 font-medium">TELÉFONO</th>
            <th class="p-4 font-medium">PEDIDOS</th>
            <th class="p-4 font-medium">REGISTRADO</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="customersTableBody">
          <tr>
            <td colspan="6" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile cards -->
  <div id="customerCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-3xl text-error">warning</span>
          <h3 id="deleteModalTitle" class="font-headline text-headline-md">Eliminar Cliente</h3>
        </div>
        <button id="deleteCloseX" class="w-10 h-10 flex items-center justify-center text-secondary hover:text-monolith-black transition-colors rounded-sm hover:bg-monolith-black/5 cursor-pointer">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar a <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <p class="font-body text-body-md text-xs text-error/70 mb-6 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">info</span>
        Los datos del cliente se eliminarán permanentemente. Los pedidos existentes quedarán sin asociación.
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="deleteIcon">delete</span>
          <span id="deleteBtnText">ELIMINAR</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #deleteModal:not(.hidden) {
      display: flex;
    }
  </style>

  <!-- Pagination -->
  <div id="pagination" class="hidden mt-6 flex items-center justify-center gap-2"></div>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 10;
    let deleteTargetId = null;

    const isViewer = window.adminRole === "viewer";

    function escapeHtml(str) {
      if (!str) return "";
      var div = document.createElement("div");
      div.appendChild(document.createTextNode(str));
      return div.innerHTML;
    }

    function loadCustomers() {
      var params = new URLSearchParams();
      params.set("limit", PAGE_LIMIT);
      params.set("offset", currentOffset);
      var search = document.getElementById("searchInput").value.trim();
      if (search) params.set("search", search);

      fetch("/api/clientes/list.php?" + params.toString())
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var items = data.items || [];
          var total = data.total || 0;
          renderCustomers(items);
          renderPagination(total);
          document.getElementById("customerCount").textContent = total + " cliente" + (total !== 1 ? "s" : "");
        })
        .catch(function () {
          document.getElementById("customersTableBody").innerHTML =
            '<tr><td colspan="6" class="p-8 text-center font-body text-body-md text-error">Error al cargar clientes</td></tr>';
        });
    }

    function renderCustomers(items) {
      var tbody = document.getElementById("customersTableBody");
      var cards = document.getElementById("customerCards");

      if (!items.length) {
        var empty = '<tr><td colspan="6" class="p-8 text-center font-body text-body-md text-secondary">No se encontraron clientes</td></tr>';
        tbody.innerHTML = empty;
        cards.innerHTML = '<p class="font-body text-body-md text-secondary text-center p-8">No se encontraron clientes</p>';
        return;
      }

      var rows = "";
      var cardHtml = "";
      for (var i = 0; i < items.length; i++) {
        var c = items[i];
        var name = escapeHtml(c.name);
        var email = escapeHtml(c.email);
        var phone = escapeHtml(c.phone || "—");
        var ordersCount = c.orders_count || 0;
        var date = c.created_at ? new Date(c.created_at).toLocaleDateString() : "—";
        var detailUrl = "/admin/clientes/detalle?id=" + c.id;

        // Desktop row
        rows += '<tr class="border-b border-outline-variant/50 hover:bg-monolith-black/[0.02] transition-colors">';
        rows += '<td class="p-4"><a href="' + detailUrl + '" class="font-medium text-monolith-black hover:text-clay-accent transition-colors">' + name + '</a></td>';
        rows += '<td class="p-4 text-secondary">' + email + '</td>';
        rows += '<td class="p-4 text-secondary">' + phone + '</td>';
        rows += '<td class="p-4 text-secondary">' + ordersCount + '</td>';
        rows += '<td class="p-4 text-secondary">' + date + '</td>';
        rows += '<td class="p-4">';
        rows += '<div class="flex items-center gap-2">';
        rows += '<a href="' + detailUrl + '" class="font-label-caps text-label-caps text-monolith-black hover:text-clay-accent transition-colors inline-flex items-center gap-1">';
        rows += '<span class="material-symbols-outlined text-lg">visibility</span> VER</a>';
        if (!isViewer) {
          rows += '<button class="delete-btn font-label-caps text-label-caps text-error hover:text-red-700 transition-colors inline-flex items-center gap-1 cursor-pointer" data-id="' + c.id + '" data-name="' + escapeHtml(name) + '">';
          rows += '<span class="material-symbols-outlined text-lg">delete</span> ELIMINAR</button>';
        }
        rows += '</div></td></tr>';

        // Mobile card
        cardHtml += '<a href="' + detailUrl + '" class="block bg-off-white border border-outline-variant shadow-sm rounded-sm p-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">';
        cardHtml += '<div class="flex items-start justify-between mb-2">';
        cardHtml += '<div><p class="font-headline text-headline-sm text-monolith-black">' + name + '</p>';
        cardHtml += '<p class="font-body text-body-md text-secondary text-sm">' + email + '</p></div>';
        cardHtml += '<span class="font-label-caps text-label-caps text-secondary">' + ordersCount + ' pedidos</span>';
        cardHtml += '</div>';
        cardHtml += '<div class="flex items-center gap-4 text-xs text-secondary mt-2">';
        cardHtml += '<span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">phone</span>' + phone + '</span>';
        cardHtml += '<span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">calendar_today</span>' + date + '</span>';
        cardHtml += '</div></a>';
      }
      tbody.innerHTML = rows;
      cards.innerHTML = cardHtml;

      // Attach delete handlers
      document.querySelectorAll(".delete-btn").forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          deleteTargetId = parseInt(btn.dataset.id);
          document.getElementById("deleteItemName").textContent = btn.dataset.name;
          document.getElementById("deleteModal").classList.remove("hidden");
          document.getElementById("deleteConfirmBtn").focus();
        });
      });
    }

    function renderPagination(total) {
      var container = document.getElementById("pagination");
      var totalPages = Math.ceil(total / PAGE_LIMIT);
      if (totalPages <= 1) {
        container.classList.add("hidden");
        return;
      }
      container.classList.remove("hidden");
      var currentPage = Math.floor(currentOffset / PAGE_LIMIT) + 1;
      var html = "";
      if (currentPage > 1) {
        html += '<button class="page-btn px-3 py-1.5 font-label-caps text-label-caps text-monolith-black hover:bg-monolith-black/5 rounded-sm transition-colors" data-page="' + (currentPage - 1) + '">ANTERIOR</button>';
      }
      for (var p = 1; p <= totalPages; p++) {
        var cls = p === currentPage ? "bg-monolith-black text-off-white" : "text-monolith-black hover:bg-monolith-black/5";
        html += '<button class="page-btn w-8 h-8 ' + cls + ' rounded-sm font-body text-body-md text-sm transition-colors" data-page="' + p + '">' + p + '</button>';
      }
      if (currentPage < totalPages) {
        html += '<button class="page-btn px-3 py-1.5 font-label-caps text-label-caps text-monolith-black hover:bg-monolith-black/5 rounded-sm transition-colors" data-page="' + (currentPage + 1) + '">SIGUIENTE</button>';
      }
      container.innerHTML = html;
      container.querySelectorAll(".page-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var page = parseInt(btn.dataset.page);
          currentOffset = (page - 1) * PAGE_LIMIT;
          loadCustomers();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      });
    }

    let currentOffset = 0;
    let searchTimeout = null;

    document.getElementById("searchInput").addEventListener("input", function () {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(function () {
        currentOffset = 0;
        loadCustomers();
      }, 300);
    });

    // Delete modal controls
    document.getElementById("deleteCancelBtn").addEventListener("click", function () {
      document.getElementById("deleteModal").classList.add("hidden");
    });
    document.getElementById("deleteCloseX").addEventListener("click", function () {
      document.getElementById("deleteModal").classList.add("hidden");
    });
    document.getElementById("deleteModal").addEventListener("click", function (e) {
      if (e.target === this) this.classList.add("hidden");
    });
    document.getElementById("deleteConfirmBtn").addEventListener("click", function () {
      if (!deleteTargetId) return;
      var btn = this;
      btn.disabled = true;
      document.getElementById("deleteBtnText").textContent = "ELIMINANDO...";

      fetch("/api/clientes/delete.php", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: deleteTargetId }),
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res.success) {
            document.getElementById("deleteModal").classList.add("hidden");
            loadCustomers();
          } else {
            alert("Error al eliminar: " + (res.error || "unknown"));
          }
        })
        .catch(function () {
          alert("Error de red al eliminar cliente");
        })
        .finally(function () {
          btn.disabled = false;
          document.getElementById("deleteBtnText").textContent = "ELIMINAR";
        });
    });

    // Initial load
    setTimeout(loadCustomers, 50);
  </script>
</AdminLayout>
