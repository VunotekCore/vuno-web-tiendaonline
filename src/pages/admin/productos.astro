---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Productos" currentPath="/admin/productos">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-4 w-full md:w-auto">
      <div class="relative flex-1 md:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <label for="searchInput" class="sr-only">Buscar productos</label>
        <input type="text" id="searchInput" placeholder="Buscar productos..." class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none focus-visible:ring-2 focus-visible:ring-monolith-black focus-visible:ring-offset-1 font-body text-body-md" />
      </div>
      <label for="categoryFilter" class="sr-only">Filtrar por categoría</label>
      <select id="categoryFilter" class="h-10 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none focus-visible:ring-2 focus-visible:ring-monolith-black focus-visible:ring-offset-1 font-body text-body-md">
        <option value="">Todas las categorías</option>
      </select>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="productCount" aria-live="polite" aria-atomic="true">0 productos</p>
    </div>
    <a href="/admin/productos/nuevo" class="bg-monolith-black text-off-white font-label-caps text-label-caps h-10 px-5 inline-flex items-center justify-center gap-1.5 rounded-md hover:bg-monolith-black/90 hover:shadow-sm transition-all duration-200 shrink-0 w-full sm:w-auto">
      <span class="material-symbols-outlined text-lg">add</span>
      NUEVO PRODUCTO
    </a>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">PRODUCTO</th>
            <th class="p-4 font-medium">PRECIO</th>
            <th class="p-4 font-medium">CATEGORÍA</th>
            <th class="p-4 font-medium">STOCK</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="productsTableBody">
          <tr>
            <td colspan="5" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile cards -->
  <div id="productCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="modal-content bg-off-white border border-outline-variant shadow-lg rounded-sm p-6 w-full max-w-md">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-3xl text-error">warning</span>
          <h3 id="deleteModalTitle" class="font-headline text-headline-md">Eliminar Producto</h3>
        </div>
        <button id="deleteCloseX" class="w-10 h-10 flex items-center justify-center text-secondary hover:text-monolith-black transition-colors rounded-sm hover:bg-monolith-black/5 cursor-pointer">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      <p class="font-body text-body-md text-secondary mb-6">
        ¿Estás seguro de eliminar <strong id="deleteItemName" class="text-monolith-black"></strong>?
      </p>
      <p class="font-body text-body-md text-xs text-error/70 mb-6 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">info</span>
        Esta acción no se puede deshacer.
      </p>
      <div class="flex justify-end gap-3">
        <button id="deleteCancelBtn" class="font-label-caps text-label-caps text-secondary border border-monolith-black/20 rounded-md px-4 h-10 hover:border-monolith-black hover:text-monolith-black transition-all">CANCELAR</button>
        <button id="deleteConfirmBtn" class="bg-error text-off-white font-label-caps text-label-caps rounded-md px-5 h-10 inline-flex items-center gap-1.5 hover:bg-error/90 hover:shadow-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
          <span class="material-symbols-outlined text-lg" id="deleteIcon">delete</span>
          <span id="deleteBtnText">ELIMINAR</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .modal-content {
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    #deleteModal:not(.hidden) {
      display: flex;
    }
  </style>

  <!-- Pagination -->
  <div id="pagination" class="hidden mt-6 flex items-center justify-center gap-2"></div>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 10;
    let deleteTargetId = null;
    let deleteTargetEncodedId = null;
    let currentOffset = 0;
    let totalProducts = 0;
    let searchTerm = "";
    let categoryFilter = "";
    let searchTimeout = null;

    let previousActiveElement = null;

    function focusTrap(e, modal) {
      const focusable = modal.querySelectorAll('button, a, input, select, textarea, [tabindex]:not([tabindex="-1"])');
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.key === "Tab") {
        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    }

    function openDeleteModal(id, name) {
      previousActiveElement = document.activeElement;
      deleteTargetId = id;
      deleteTargetEncodedId = encodeURIComponent(id);
      document.getElementById("deleteItemName").textContent = name;
      const el = document.getElementById("deleteModal");
      el.classList.remove("hidden");
      el.classList.add("flex");
      const content = el.querySelector(".modal-content");
      if (content) {
        content.style.animation = "none";
        void content.offsetHeight;
        content.style.animation = "";
      }
      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
      // Focus first focusable element
      setTimeout(() => {
        const firstFocusable = el.querySelector('button, a, input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (firstFocusable) firstFocusable.focus();
      }, 50);
      // Attach focus trap
      el.addEventListener("keydown", (e) => focusTrap(e, el));
    }

    function closeDeleteModal() {
      document.getElementById("deleteModal").classList.add("hidden");
      document.getElementById("deleteModal").classList.remove("flex");
      deleteTargetId = null;
      deleteTargetEncodedId = null;
      // Restore focus to trigger element
      if (previousActiveElement) {
        previousActiveElement.focus();
        previousActiveElement = null;
      }
    }

    function setLoading(btnId, iconId, textId, loading, actionText) {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      if (!btn || !icon || !text) return;
      btn.disabled = loading;
      if (loading) {
        icon.textContent = "progress_activity";
        icon.classList.add("animate-spin");
        text.textContent = actionText || "Procesando...";
      } else {
        icon.textContent = icon.dataset.origIcon || "delete";
        icon.classList.remove("animate-spin");
        text.textContent = text.dataset.original || "";
      }
    }

    function stockBadge(stock) {
      const cls = stock === 0 ? 'bg-error/20 text-error' : 'bg-monolith-black/10 text-monolith-black';
      const label = stock === 0 ? 'AGOTADO' : stock + ' uds.';
      return `<span class="font-label-caps text-label-caps text-xs px-2 py-1 rounded-sm ${cls}">${label}</span>`;
    }

    const isViewer = window.adminRole === "viewer";

    function actionLinks(p) {
      if (isViewer) {
        return '<span class="font-body text-body-sm text-secondary italic">Solo lectura</span>';
      }
      const id = encodeURIComponent(p.id);
      const name = p.name;
      return `<div class="flex gap-2">
        <a href="/admin/productos/editar?id=${id}" class="inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm">
          <span class="material-symbols-outlined text-sm">edit</span>
          EDIT
        </a>
        <button data-delete-id="${id}" data-delete-name="${name}" class="delete-btn inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm">
          <span class="material-symbols-outlined text-sm">delete</span>
          DELETE
        </button>
      </div>`;
    }

    function renderProducts(products) {
      const tbody = document.getElementById("productsTableBody");
      const cards = document.getElementById("productCards");

      const rowsHtml = products.map(p => `
        <tr class="border-b border-outline-variant/50 hover:bg-monolith-black/[0.02] transition-colors">
          <td class="p-4 font-body text-body-md text-monolith-black font-medium">${p.name}</td>
          <td class="p-4 font-price-display text-price-display">${p.display_symbol || '$'}${window.formatPrice(p.display_price || p.price)}</td>
          <td class="p-4 font-body text-body-md text-secondary">${p.category || '—'}</td>
          <td class="p-4">${stockBadge(p.totalStock || 0)}</td>
          <td class="p-4">${actionLinks(p)}</td>
        </tr>
      `).join("");

      const cardsHtml = products.map(p => {
        const pid = encodeURIComponent(p.id);
        return `
          <div class="bg-off-white border border-outline-variant border-l-2 border-l-monolith-black shadow-sm hover:shadow-md transition-all duration-200 rounded-sm p-4 flex flex-col gap-3">
            <div class="flex items-start gap-3 min-w-0">
              <span class="material-symbols-outlined text-xl text-monolith-black mt-0.5 shrink-0">inventory_2</span>
              <div class="min-w-0">
                <p class="font-body text-body-md text-monolith-black font-medium break-words">${p.name}</p>
                <p class="font-body text-body-md text-secondary text-sm">${p.category || '—'}</p>
              </div>
            </div>
            <span class="font-price-display text-price-display text-center">${p.display_symbol || '$'}${window.formatPrice(p.display_price || p.price)}</span>
            <div>${stockBadge(p.totalStock || 0)}</div>
            ${isViewer
              ? '<span class="font-body text-body-sm text-secondary italic">Solo lectura</span>'
              : `
              <div class="flex gap-2">
                <a href="/admin/productos/editar?id=${pid}" class="flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps rounded-md transition-all duration-200 bg-neutral-600 text-off-white hover:bg-neutral-700 hover:shadow-sm">
                  <span class="material-symbols-outlined text-sm">edit</span>
                  EDIT
                </a>
                <button data-delete-id="${pid}" data-delete-name="${p.name}" class="delete-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm">
                  <span class="material-symbols-outlined text-sm">delete</span>
                  DELETE
                </button>
              </div>`
            }
          </div>`;
      }).join("");

      tbody.innerHTML = rowsHtml || '<tr><td colspan="5" class="p-8 text-center font-body text-body-md text-secondary">No products yet</td></tr>';
      cards.innerHTML = cardsHtml || '<p class="font-body text-body-md text-secondary p-4">No products yet</p>';

      document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.removeEventListener("click", deleteBtnHandler);
        btn.addEventListener("click", deleteBtnHandler);
      });
    }

    function deleteBtnHandler() {
      openDeleteModal(decodeURIComponent(this.dataset.deleteId), this.dataset.deleteName);
    }

    function renderPagination() {
      const container = document.getElementById("pagination");
      const totalPages = Math.ceil(totalProducts / PAGE_LIMIT);
      const currentPage = Math.floor(currentOffset / PAGE_LIMIT) + 1;

      if (totalPages <= 1) { container.classList.add("hidden"); return; }
      container.classList.remove("hidden");

      let html = '<button class="pag-prev w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black transition-colors font-body text-body-md" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3"' : '') + '><span class="material-symbols-outlined text-sm">chevron_left</span></button>';

      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant hover:border-monolith-black';
        html += `<button class="pag-page w-9 h-9 flex items-center justify-center border rounded-sm transition-colors font-body text-body-md text-sm ${active}" data-page="${i}">${i}</button>`;
      }

      html += '<button class="pag-next w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black transition-colors font-body text-body-md" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3"' : '') + '><span class="material-symbols-outlined text-sm">chevron_right</span></button>';

      container.innerHTML = html;

      container.querySelectorAll(".pag-page").forEach(btn => {
        btn.addEventListener("click", () => {
          currentOffset = (parseInt(btn.dataset.page) - 1) * PAGE_LIMIT;
          loadProducts();
        });
      });
      container.querySelector(".pag-prev")?.addEventListener("click", () => {
        if (currentOffset <= 0) return;
        currentOffset = Math.max(0, currentOffset - PAGE_LIMIT);
        loadProducts();
      });
      container.querySelector(".pag-next")?.addEventListener("click", () => {
        if (currentOffset + PAGE_LIMIT >= totalProducts) return;
        currentOffset += PAGE_LIMIT;
        loadProducts();
      });
    }

    function searchProducts() {
      searchTerm = document.getElementById("searchInput").value.trim();
      categoryFilter = document.getElementById("categoryFilter").value;
      currentOffset = 0;
      loadProducts();
    }

    function debounceSearch() {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(searchProducts, 300);
    }

    document.getElementById("searchInput").addEventListener("input", debounceSearch);
    document.getElementById("categoryFilter").addEventListener("change", searchProducts);

    async function loadProducts() {
      try {
        let url = `/api/productos/list.php?limit=${PAGE_LIMIT}&offset=${currentOffset}`;
        if (searchTerm) url += `&search=${encodeURIComponent(searchTerm)}`;
        if (categoryFilter) url += `&category=${encodeURIComponent(categoryFilter)}`;
        const res = await fetch(url);
        const data = await res.json();
        const products = data.items || data;
        totalProducts = data.total || products.length;

        renderProducts(products, false);
        document.getElementById("productCount").textContent =
          Math.min(currentOffset + products.length, totalProducts) + " de " + totalProducts + " productos registrados";
        renderPagination();
      } catch (err) {
        document.getElementById("productsTableBody").innerHTML =
          `<tr><td colspan="5" class="p-8 text-center font-body text-body-md text-error">Error: ${err.message}</td></tr>`;
        document.getElementById("productCards").innerHTML =
          `<p class="font-body text-body-md text-error p-4">Error: ${err.message}</p>`;
      }
    }

    // Load categories for filter dropdown
    (async function loadCategoryFilter() {
      try {
        const res = await fetch("/api/categorias/list.php");
        const data = await res.json();
        const cats = data.items || data;
        const select = document.getElementById("categoryFilter");
        (Array.isArray(cats) ? cats : []).forEach(c => {
          const opt = document.createElement("option");
          opt.value = c.name;
          opt.textContent = c.name;
          select.appendChild(opt);
        });
      } catch {}
    })();

    // --- Delete modal handlers ---
    document.getElementById("deleteConfirmBtn").addEventListener("click", async () => {
      if (!deleteTargetId) return;

      setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", true, "Eliminando...");
      try {
        const res = await fetch("/api/productos/delete.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: deleteTargetId }),
        });
        if (res.ok) {
          closeDeleteModal();
          currentOffset = 0;
          loadProducts();
        } else {
          setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
          const data = await res.json();
          window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: data.error || "Delete failed" });
        }
      } catch (err) {
        setLoading("deleteConfirmBtn", "deleteIcon", "deleteBtnText", false);
        window.VunoModal.alert({ type: "error", title: "Error al eliminar", message: err.message });
      }
    });

    document.getElementById("deleteCancelBtn").addEventListener("click", closeDeleteModal);
    document.getElementById("deleteCloseX").addEventListener("click", closeDeleteModal);
    document.getElementById("deleteModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeDeleteModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeDeleteModal();
    });

    document.getElementById("deleteIcon").dataset.origIcon = "delete";
    loadProducts();

    if (isViewer) {
      document.querySelector('a[href="/admin/productos/nuevo"]')?.remove();
    }
  </script>
</AdminLayout>
