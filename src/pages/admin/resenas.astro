---
import AdminLayout from "./_layout.astro";
---

<AdminLayout title="Reseñas" currentPath="/admin/resenas">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-4 w-full md:w-auto">
      <select id="statusFilter" aria-label="Filtrar por estado" class="h-10 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md focus-visible:ring-2 focus-visible:ring-monolith-black">
        <option value="">Todas</option>
        <option value="pending">Pendientes</option>
        <option value="approved">Aprobadas</option>
      </select>
      <div class="relative flex-1 md:w-56">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-secondary pointer-events-none">search</span>
        <input type="text" id="searchInput" placeholder="Buscar producto, cliente o comentario..." aria-label="Buscar reseñas" class="w-full h-10 pl-10 pr-3 bg-transparent border-b border-outline text-monolith-black focus:border-monolith-black focus:outline-none font-body text-body-md focus-visible:ring-2 focus-visible:ring-monolith-black" />
      </div>
      <p class="font-body text-body-md text-secondary whitespace-nowrap" id="reviewCount">0 reseñas</p>
    </div>
  </div>

  <!-- Desktop table -->
  <div class="hidden md:block bg-off-white border border-outline-variant shadow-sm rounded-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-monolith-black/5 font-label-caps text-label-caps text-secondary">
            <th class="p-4 font-medium">PRODUCTO</th>
            <th class="p-4 font-medium">CLIENTE</th>
            <th class="p-4 font-medium">RATING</th>
            <th class="p-4 font-medium">COMENTARIO</th>
            <th class="p-4 font-medium">FECHA</th>
            <th class="p-4 font-medium">ESTADO</th>
            <th class="p-4 font-medium">ACCIONES</th>
          </tr>
        </thead>
        <tbody id="reviewsBody">
          <tr><td colspan="7" class="p-8 text-center font-body text-body-md text-secondary">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile cards -->
  <div id="reviewCards" class="block md:hidden space-y-3">
    <p class="font-body text-body-md text-secondary p-4">Loading...</p>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="hidden mt-6 flex items-center justify-center gap-2"></div>

  <script>
    // @ts-nocheck
    const PAGE_LIMIT = 15;
    let currentOffset = 0;
    let totalReviews = 0;
    let statusFilter = "";
    let searchTerm = "";
    let searchTimeout = null;

    function starsHtml(rating) {
      return Array(5).fill(0).map((_, i) =>
        `<span class="material-symbols-outlined text-sm ${i < rating ? 'text-clay-accent' : 'text-outline'}" style="font-variation-settings: 'FILL' ${i < rating ? 1 : 0}">star</span>`
      ).join("");
    }

    function statusBadge(approved) {
      return approved
        ? '<span class="inline-flex items-center gap-1 font-label-caps text-label-caps text-xs px-2 py-1 rounded-sm bg-monolith-black text-off-white">APROBADA</span>'
        : '<span class="inline-flex items-center gap-1 font-label-caps text-label-caps text-xs px-2 py-1 rounded-sm bg-clay-accent/20 text-clay-accent">PENDIENTE</span>';
    }

    function renderReviews(reviews) {
      const tbody = document.getElementById("reviewsBody");
      const cards = document.getElementById("reviewCards");

      const rowsHtml = reviews.map(r => `
        <tr class="border-b border-outline-variant/50 hover:bg-monolith-black/[0.02] transition-colors">
          <td class="p-4">
            <a href="/producto/${r.productSlug}" target="_blank" class="font-body text-body-md text-monolith-black font-medium hover:underline">${r.productName}</a>
          </td>
          <td class="p-4 font-body text-body-md text-secondary">${r.reviewerName || 'Anónimo'}</td>
          <td class="p-4">
            <div class="flex items-center gap-0.5">${starsHtml(r.rating)}</div>
          </td>
          <td class="p-4 max-w-xs">
            ${r.title ? '<strong class="font-body text-body-md text-monolith-black block text-sm">' + r.title + '</strong>' : ''}
            ${r.comment ? '<span class="font-body text-body-md text-secondary text-sm line-clamp-2">' + r.comment + '</span>' : '<span class="text-secondary italic text-sm">Sin comentario</span>'}
          </td>
          <td class="p-4 font-body text-body-md text-secondary text-sm">${new Date(r.createdAt).toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" })}</td>
          <td class="p-4">${statusBadge(r.isApproved)}</td>
          <td class="p-4">
            <div class="flex gap-2">
              ${!r.isApproved ? `
                <button class="approve-btn inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 border-monolith-black/20 text-secondary hover:border-monolith-black hover:text-monolith-black hover:bg-monolith-black/5" data-id="${r.id}">
                  <span class="material-symbols-outlined text-sm">check</span>
                  APROBAR
                </button>
              ` : ''}
              <button class="delete-btn inline-flex items-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm" data-id="${r.id}">
                <span class="material-symbols-outlined text-sm">delete</span>
                ELIMINAR
              </button>
            </div>
          </td>
        </tr>
      `).join("");

      const cardsHtml = reviews.map(r => `
        <div class="bg-off-white border border-outline-variant border-l-2 ${r.isApproved ? 'border-l-monolith-black' : 'border-l-clay-accent'} shadow-sm hover:shadow-md transition-all duration-200 rounded-sm p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-0.5">${starsHtml(r.rating)}</div>
            ${statusBadge(r.isApproved)}
          </div>
          <a href="/producto/${r.productSlug}" target="_blank" class="font-body text-body-md text-monolith-black font-medium hover:underline">${r.productName}</a>
          <p class="font-body text-body-md text-secondary text-sm">por ${r.reviewerName || 'Anónimo'} · ${new Date(r.createdAt).toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" })}</p>
          ${r.title ? '<p class="font-body text-body-md text-monolith-black text-sm mt-1 font-medium">' + r.title + '</p>' : ''}
          ${r.comment ? '<p class="font-body text-body-md text-secondary text-sm mt-1 line-clamp-2">' + r.comment + '</p>' : ''}
          <div class="flex flex-col sm:flex-row gap-2 mt-3">
            ${!r.isApproved ? `
              <button class="approve-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 border-monolith-black/20 text-secondary hover:border-monolith-black hover:text-monolith-black hover:bg-monolith-black/5" data-id="${r.id}">
                <span class="material-symbols-outlined text-sm">check</span>
                APROBAR
              </button>
            ` : ''}
            <button class="delete-btn flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 font-label-caps text-label-caps border rounded-md transition-all duration-200 bg-error text-off-white hover:bg-error/90 hover:shadow-sm" data-id="${r.id}">
              <span class="material-symbols-outlined text-sm">delete</span>
              ELIMINAR
            </button>
          </div>
        </div>
      `).join("");

      tbody.innerHTML = rowsHtml || '<tr><td colspan="7" class="p-8 text-center font-body text-body-md text-secondary">No reviews yet</td></tr>';
      cards.innerHTML = cardsHtml || '<p class="font-body text-body-md text-secondary p-4">No reviews yet</p>';

      document.querySelectorAll(".approve-btn").forEach(btn => {
        btn.addEventListener("click", async () => {
          try {
            const res = await fetch("/api/resenas/approve.php", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id: parseInt(btn.dataset.id) }),
            });
            if (res.ok) loadReviews();
            else window.VunoModal.alert({ type: "error", title: "Error", message: "Error approving review" });
          } catch (err) { window.VunoModal.alert({ type: "error", title: "Error", message: err.message }); }
        });
      });

      document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = parseInt(btn.dataset.id);
          window.VunoModal.confirm({
            type: "warning",
            title: "Eliminar reseña",
            message: "¿Eliminar esta reseña?",
            confirmText: "ELIMINAR",
            cancelText: "CANCELAR",
            onConfirm: async () => {
              try {
                const res = await fetch("/api/resenas/delete.php", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ id }),
                });
                if (res.ok) loadReviews();
                else window.VunoModal.alert({ type: "error", title: "Error", message: "Error deleting review" });
              } catch (err) { window.VunoModal.alert({ type: "error", title: "Error", message: err.message }); }
            },
          });
        });
      });
    }

    function renderPagination() {
      const container = document.getElementById("pagination");
      const totalPages = Math.ceil(totalReviews / PAGE_LIMIT);
      const currentPage = Math.floor(currentOffset / PAGE_LIMIT) + 1;

      if (totalPages <= 1) { container.classList.add("hidden"); return; }
      container.classList.remove("hidden");

      let html = '<button class="pagination-prev w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black transition-colors font-body text-body-md" ' + (currentPage <= 1 ? 'disabled style="opacity:0.3"' : '') + '><span class="material-symbols-outlined text-sm">chevron_left</span></button>';

      for (let i = 1; i <= totalPages; i++) {
        const active = i === currentPage ? 'bg-monolith-black text-off-white border-monolith-black' : 'border-outline-variant hover:border-monolith-black';
        html += `<button class="pagination-page w-9 h-9 flex items-center justify-center border rounded-sm transition-colors font-body text-body-md text-sm ${active}" data-page="${i}">${i}</button>`;
      }

      html += '<button class="pagination-next w-9 h-9 flex items-center justify-center border border-outline-variant rounded-sm hover:border-monolith-black transition-colors font-body text-body-md" ' + (currentPage >= totalPages ? 'disabled style="opacity:0.3"' : '') + '><span class="material-symbols-outlined text-sm">chevron_right</span></button>';

      container.innerHTML = html;

      container.querySelectorAll(".pagination-page").forEach(btn => {
        btn.addEventListener("click", () => {
          currentOffset = (parseInt(btn.dataset.page) - 1) * PAGE_LIMIT;
          loadReviews();
        });
      });
      container.querySelector(".pagination-prev")?.addEventListener("click", () => {
        if (currentOffset <= 0) return;
        currentOffset = Math.max(0, currentOffset - PAGE_LIMIT);
        loadReviews();
      });
      container.querySelector(".pagination-next")?.addEventListener("click", () => {
        if (currentOffset + PAGE_LIMIT >= totalReviews) return;
        currentOffset += PAGE_LIMIT;
        loadReviews();
      });
    }

    function filterReviews() {
      statusFilter = document.getElementById("statusFilter").value;
      searchTerm = document.getElementById("searchInput").value.trim();
      currentOffset = 0;
      loadReviews();
    }

    document.getElementById("statusFilter").addEventListener("change", filterReviews);
    document.getElementById("searchInput").addEventListener("input", () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(filterReviews, 300);
    });

    async function loadReviews() {
      try {
        let url = `/api/resenas/admin-list.php?limit=${PAGE_LIMIT}&offset=${currentOffset}`;
        if (statusFilter) url += `&status=${encodeURIComponent(statusFilter)}`;
        if (searchTerm) url += `&search=${encodeURIComponent(searchTerm)}`;
        const res = await fetch(url);
        const data = await res.json();
        const reviews = data.items || [];
        totalReviews = data.total || reviews.length;

        document.getElementById("reviewCount").textContent = totalReviews + " reseñas";
        renderReviews(reviews);
        renderPagination();
      } catch (err) {
        document.getElementById("reviewsBody").innerHTML =
          `<tr><td colspan="7" class="p-8 text-center font-body text-body-md text-error">Error: ${err.message}</td></tr>`;
        document.getElementById("reviewCards").innerHTML =
          `<p class="font-body text-body-md text-error p-4">Error: ${err.message}</p>`;
      }
    }

    loadReviews();
  </script>
</AdminLayout>
