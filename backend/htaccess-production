# =============================================================================
# Vunotek — Production .htaccess
# Copy this file to dist/.htaccess (or rename to .htaccess on the server)
# Place in the web root (public_html/)
# =============================================================================

# --- Enable Rewrite Engine ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (uncomment for production)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove trailing slash for non-file routes (optional)
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Block access to sensitive PHP directories
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^vendor/ - [F,L]
  RewriteRule ^database/ - [F,L]
  RewriteRule ^email-templates/ - [F,L]
</IfModule>

# --- Security: Block Sensitive Files ---
<FilesMatch "^\.">
  Deny from all
</FilesMatch>
<FilesMatch "\.(env|lock|key|md|log|bak|old|sql|swp|save|config\.php|composer\.json|composer\.lock)$">
  Deny from all
</FilesMatch>

# --- Security Headers ---
<IfModule mod_headers.c>
  # Protect against clickjacking
  Header always set X-Frame-Options "DENY"
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Enable HSTS (uncomment for production after HTTPS is confirmed working)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Disable Directory Listing ---
Options -Indexes

# --- Custom Error Pages ---
ErrorDocument 404 /404.html

# --- Cache Static Assets (hashed filenames = long cache) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  # HTML and PHP should not be cached
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Cache-Control Headers ---
<IfModule mod_headers.c>
  # _astro/ assets have content hashes — cache forever
  <FilesMatch "^_astro/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Static images
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fonts
  <FilesMatch "\.(woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # CSS/JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Block access to install.php after setup ---
# Uncomment these lines after installation to block install.php:
# <Files "install.php">
#   Deny from all
# </Files>
